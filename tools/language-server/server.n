using System;
using System.IO;
using System.Linq;
using System.Threading;
using System.Text.RegularExpressions;
using System.Text.Json.Nodes;
using System.Collections.Concurrent;
using SCG = System.Collections.Generic;
using Nemerle.Imperative;
using analysis;
using checker;
using index;
using transport;

public sealed class Document
{
  public Uri : string; public Path : string; public mutable Text : string; public mutable Version : int;
  public this(uri : string, text : string, version : int)
  {
    Uri = uri; Text = text; Version = version;
    Path = try { System.Uri(uri).LocalPath } catch { | _ => uri };
  }
}

public variant Job
{
  | Analyze { Uri : string; Version : int; }
  | Request { Id : JsonNode; Method : string; Params : JsonNode; }
  | Close { Uri : string; }
  /// A typed check finished: its diagnostics and facts, by file.
  | Typed { Result : JsonObject; }
}

/// Reads messages on the calling thread; all analysis runs on one worker thread, in arrival order, so a request
/// always sees the edits sent before it. Superseded analyses are skipped.
public sealed class Server
{
  transport : Transport;
  references : string;
  mutable root : string;
  fileNameNamespaces : bool;
  documents : SCG.Dictionary[string, Document] = SCG.Dictionary();
  jobs : BlockingCollection[Job] = BlockingCollection();
  results : SCG.Dictionary[string, AnalysisResult] = SCG.Dictionary(); // worker thread only
  mutable analyzer : Analyzer;                                          // worker thread only
  mutable shutdownRequested : bool;
  log : TextWriter;
  // the typed check (a `--check` process): requested after edits, run on its own thread, its result handed to the
  // worker, which alone publishes
  typecheck : bool;
  libraries : SCG.List[string];
  checkWanted : AutoResetEvent = AutoResetEvent(false);
  mutable lastEdit : DateTime = DateTime.MinValue;
  mutable checkGeneration : int;
  mutable checking : Diagnostics.Process;
  typedDiagnostics : SCG.Dictionary[string, SCG.List[JsonObject]] = SCG.Dictionary(); // worker thread only
  typedFacts : SCG.Dictionary[string, SCG.List[JsonObject]] = SCG.Dictionary();       // worker thread only
  // the symbol index (index.n): find-references and rename read it; its own thread keeps it up to date with the
  // files on disk (at the start, and after each save), checking again only what changed
  mutable index : SymbolIndex;
  indexWanted : AutoResetEvent = AutoResetEvent(false);
  // the names each workspace file declares at its top level, by the hash of its text (worker thread only): the
  // modules a quick fix may import, those the typed check did not compile among them
  declared : SCG.Dictionary[string, string * SCG.HashSet[string]] = SCG.Dictionary();

  public this(input : Stream, output : Stream, references : string, root : string, fileNameNamespaces : bool, log : TextWriter,
              typecheck : bool, libraries : SCG.List[string])
  {
    transport = Transport(input, output); this.references = references; this.log = log;
    this.root = root; this.fileNameNamespaces = fileNameNamespaces;
    this.typecheck = typecheck; this.libraries = libraries;
  }

  /// Source root for file modules: --source-root, else the first workspace folder, else the root URI.
  static RootOf(parameters : JsonNode) : string
  {
    def local(uri : string) { if (uri == null) null else try { Path.GetFullPath(System.Uri(uri).LocalPath) } catch { | _ => null } }
    def folders = if (parameters == null) null else parameters["workspaceFolders"];
    if (folders != null && folders is JsonArray && folders.AsArray().Count > 0) local(Str(folders.AsArray()[0]["uri"]))
    else if (parameters != null) local(Str(parameters["rootUri"]))
    else null
  }

  public Run() : int
  {
    def worker = Thread(Work, 64 * 1024 * 1024); // the parsers recurse deeply on long inputs
    worker.IsBackground = true; worker.Start();
    when (typecheck) { def checker = Thread(CheckLoop); checker.IsBackground = true; checker.Start(); }
    mutable exitCode = 1;
    mutable running = true;
    while (running)
    {
      def message = try { transport.Read() } catch { | e is Exception => log.WriteLine("read: " + e.Message); null };
      if (message == null) running = false
      else
      {
        def method = Str(message["method"]);
        def id = message["id"];
        try
        {
          match (method)
          {
            | "initialize" =>
              when (root == null) root = RootOf(message["params"]);
              log.WriteLine("source root: " + (root ?? "<per file>"));
              transport.Respond(id, Capabilities())
            | "initialized" =>
              when (typecheck && root != null && index == null)
              {
                index = SymbolIndex(root);
                def indexer = Thread(IndexLoop); indexer.IsBackground = true; indexer.Start();
                _ = indexWanted.Set();
              }
            | "textDocument/didSave" => when (index != null) _ = indexWanted.Set()
            | "shutdown" => shutdownRequested = true; transport.Respond(id, null)
            | "exit" => exitCode = if (shutdownRequested) 0 else 1; running = false
            | "textDocument/didOpen" =>
              def d = message["params"]["textDocument"];
              def doc = Document(Str(d["uri"]), Str(d["text"]), Int(d["version"]));
              lock (documents) documents[doc.Uri] = doc;
              jobs.Add(Job.Analyze(doc.Uri, doc.Version))
            | "textDocument/didChange" =>
              def p = message["params"]; def uri = Str(p["textDocument"]["uri"]); def version = Int(p["textDocument"]["version"]);
              def changes = p["contentChanges"].AsArray();
              when (changes.Count > 0)
              {
                // each change in order: a range of the text as it is after the ones before it, or the whole text
                lock (documents)
                  when (documents.ContainsKey(uri))
                  { def doc = documents[uri]; foreach (change in changes) doc.Text = Changed(doc.Text, change); doc.Version = version; }
                jobs.Add(Job.Analyze(uri, version))
              }
            | "textDocument/didClose" =>
              def uri = Str(message["params"]["textDocument"]["uri"]);
              lock (documents) _ = documents.Remove(uri);
              jobs.Add(Job.Close(uri))
            | "textDocument/semanticTokens/full" | "textDocument/foldingRange" | "textDocument/documentSymbol"
            | "textDocument/hover" | "textDocument/definition" | "textDocument/completion" | "textDocument/references"
            | "textDocument/prepareRename" | "textDocument/rename" | "textDocument/documentHighlight" | "textDocument/inlayHint"
            | "textDocument/signatureHelp" | "workspace/symbol" | "textDocument/formatting" | "textDocument/rangeFormatting"
            | "textDocument/codeAction" =>
              jobs.Add(Job.Request(id.DeepClone(), method, message["params"].DeepClone()))
            | _ => when (id != null) transport.RespondError(id, -32601, "method not supported: " + method)
          }
        }
        catch { | e is Exception => log.WriteLine(method + ": " + e); when (id != null) transport.RespondError(id, -32603, e.Message) }
      }
    }
    jobs.CompleteAdding();
    exitCode
  }

  static Str(n : JsonNode) : string { if (n == null) null else n.GetValue.[string]() }

  /// A text after a change: its range replaced by the change's text (positions are lines and UTF-16 columns), or the
  /// change's text when it has no range.
  static Changed(text : string, change : JsonNode) : string
  {
    def range = change["range"];
    if (range == null) Str(change["text"])
    else
    {
      def lines = LineMap(text);
      def offset(p : JsonNode)
      {
        def line = Int(p["line"]);
        if (line >= lines.LineCount) text.Length
        else Math.Min(lines.LineStart(line) + Int(p["character"]), lines.LineEnd(line))
      }
      def start = offset(range["start"]); def stop = Math.Max(start, offset(range["end"]));
      text.Substring(0, start) + Str(change["text"]) + text.Substring(stop)
    }
  }
  static Int(n : JsonNode) : int { if (n == null) 0 else n.GetValue.[int]() }

  Capabilities() : JsonNode
  {
    def legend = JsonObject();
    def types = JsonArray(); foreach (t in Legend.Types) types.Add(JsonValue.Create(t));
    def modifiers = JsonArray(); foreach (m in Legend.Modifiers) modifiers.Add(JsonValue.Create(m));
    legend["tokenTypes"] = types; legend["tokenModifiers"] = modifiers;
    def tokens = JsonObject(); tokens["legend"] = legend; tokens["full"] = JsonValue.Create(true);
    def caps = JsonObject();
    // the changed ranges on change; saves are told too (the index follows the files on disk)
    def sync = JsonObject(); sync["openClose"] = JsonValue.Create(true); sync["change"] = JsonValue.Create(2 : int);
    def save = JsonObject(); save["includeText"] = JsonValue.Create(false); sync["save"] = save;
    caps["textDocumentSync"] = sync;
    caps["semanticTokensProvider"] = tokens;
    caps["foldingRangeProvider"] = JsonValue.Create(true);
    caps["documentSymbolProvider"] = JsonValue.Create(true);
    caps["hoverProvider"] = JsonValue.Create(true);
    caps["definitionProvider"] = JsonValue.Create(true);
    caps["documentHighlightProvider"] = JsonValue.Create(true);
    caps["workspaceSymbolProvider"] = JsonValue.Create(true);
    caps["inlayHintProvider"] = JsonValue.Create(true);
    caps["documentFormattingProvider"] = JsonValue.Create(true);
    caps["documentRangeFormattingProvider"] = JsonValue.Create(true);
    when (typecheck)
    {
      def completion = JsonObject(); completion["triggerCharacters"] = JsonArray(array[JsonValue.Create(".") : JsonNode]);
      caps["completionProvider"] = completion;
      caps["referencesProvider"] = JsonValue.Create(true);
      def rename = JsonObject(); rename["prepareProvider"] = JsonValue.Create(true);
      caps["renameProvider"] = rename;
      def signature = JsonObject();
      signature["triggerCharacters"] = JsonArray(array[JsonValue.Create("(") : JsonNode, JsonValue.Create(",")]);
      caps["signatureHelpProvider"] = signature;
      def actions = JsonObject(); actions["codeActionKinds"] = JsonArray(array[JsonValue.Create("quickfix") : JsonNode]);
      caps["codeActionProvider"] = actions;
    }
    def info = JsonObject(); info["name"] = JsonValue.Create("nemerle-lsp"); info["version"] = JsonValue.Create("0.2");
    def r = JsonObject(); r["capabilities"] = caps; r["serverInfo"] = info; r
  }

  // ---- worker thread ----

  Work() : void
  {
    foreach (job in jobs.GetConsumingEnumerable())
      try
      {
        match (job)
        {
          | Job.Analyze(uri, version) =>
            Thread.Sleep(100); // let a burst of edits settle; a newer version makes this job obsolete
            def doc = Current(uri);
            when (doc != null && doc.Version == version) { Publish(uri, Ensure(doc)); RequestCheck() }
          | Job.Typed(result) => ApplyCheck(result)
          | Job.Close(uri) =>
            _ = results.Remove(uri);
            def p = JsonObject(); p["uri"] = JsonValue.Create(uri); p["diagnostics"] = JsonArray();
            transport.Notify("textDocument/publishDiagnostics", p)
          | Job.Request(id, "workspace/symbol", parameters) => transport.Respond(id, WorkspaceSymbols(Str(parameters["query"]) ?? ""))
          | Job.Request(id, method, parameters) =>
            def doc = Current(Str(parameters["textDocument"]["uri"]));
            if (doc == null) transport.Respond(id, null)
            else
            {
              def r = Ensure(doc);
              match (method)
              {
                | "textDocument/semanticTokens/full" => transport.Respond(id, SemanticTokens(r, PathOf(doc.Uri)))
                | "textDocument/foldingRange" => transport.Respond(id, Folding(r))
                | "textDocument/hover" => transport.Respond(id, Hover(doc, r, parameters["position"]))
                | "textDocument/definition" => transport.Respond(id, Definition(doc, parameters["position"]))
                | "textDocument/completion" => transport.Respond(id, Completions(doc, parameters["position"]))
                | "textDocument/documentHighlight" => transport.Respond(id, Highlights(doc, r, parameters["position"]))
                | "textDocument/inlayHint" => transport.Respond(id, InlayHints(doc, r, parameters["range"]))
                | "textDocument/signatureHelp" => transport.Respond(id, SignatureHelp(doc, r, parameters["position"]))
                | "textDocument/formatting" => transport.Respond(id, Formatting(r, parameters["options"], 0, int.MaxValue))
                | "textDocument/rangeFormatting" =>
                  def range = parameters["range"];
                  transport.Respond(id, Formatting(r, parameters["options"], Int(range["start"]["line"]), Int(range["end"]["line"])))
                | "textDocument/codeAction" => transport.Respond(id, CodeActions(doc, r, parameters["range"]))
                | "textDocument/references" =>
                  def context = parameters["context"];
                  transport.Respond(id, References(doc, parameters["position"], context != null && context["includeDeclaration"] != null && context["includeDeclaration"].GetValue.[bool]()))
                | "textDocument/prepareRename" => transport.Respond(id, PrepareRename(doc, parameters["position"]))
                | "textDocument/rename" =>
                  match (Rename(doc, parameters["position"], Str(parameters["newName"])))
                  {
                    | (null, message) => transport.RespondError(id, -32803, message)
                    | (edit, _) => transport.Respond(id, edit)
                  }
                | _ => transport.Respond(id, Symbols(r))
              }
            }
        }
      }
      catch
      {
        | e is Exception =>
          log.WriteLine("worker: " + e);
          match (job) { | Job.Request(id, _, _) => transport.RespondError(id, -32603, e.Message) | _ => () }
      }
  }

  Current(uri : string) : Document
  {
    lock (documents)
      if (uri != null && documents.ContainsKey(uri))
      { def d = documents[uri]; Document(d.Uri, d.Text, d.Version) }
      else null
  }

  Ensure(doc : Document) : AnalysisResult
  {
    mutable r;
    if (results.TryGetValue(doc.Uri, out r) && r.Version == doc.Version && r.Text == doc.Text) r
    else
    {
      when (analyzer == null) analyzer = Analyzer(references, root, fileNameNamespaces);
      def started = Diagnostics.Stopwatch.StartNew();
      r = analyzer.Analyze(doc.Path, doc.Version, doc.Text);
      log.WriteLine("analyzed " + doc.Path + " v" + doc.Version.ToString() + " in " + started.ElapsedMilliseconds.ToString() + " ms");
      results[doc.Uri] = r; r
    }
  }

  Position(r : AnalysisResult, offset : int) : JsonNode
  {
    def o = Math.Max(0, Math.Min(offset, r.Text.Length));
    def p = JsonObject(); p["line"] = JsonValue.Create(r.Lines.Line(o)); p["character"] = JsonValue.Create(r.Lines.Column(o)); p
  }
  Range(r : AnalysisResult, start : int, end : int) : JsonNode
  { def x = JsonObject(); x["start"] = Position(r, start); x["end"] = Position(r, Math.Max(start, end)); x }

  Publish(uri : string, r : AnalysisResult) : void
  {
    def items = JsonArray();
    def seen = SCG.HashSet.[string]();
    def add(start : int, end : int, severity : int, source : string, message : string) : void
    {
      // a parse error is found by both passes: report it once
      when (seen.Add(r.Lines.Line(start).ToString() + ":" + message))
      {
        def x = JsonObject();
        x["range"] = Range(r, start, end); x["severity"] = JsonValue.Create(severity);
        x["source"] = JsonValue.Create(source); x["message"] = JsonValue.Create(message);
        items.Add(x);
      }
    }
    foreach (d in r.Diagnostics) add(d.Start, d.End, d.Severity :> int, d.Source, d.Message);
    def path = PathOf(uri);
    when (path != null && typedDiagnostics.ContainsKey(path))
      foreach (d in typedDiagnostics[path])
      {
        def start = r.Lines.Offset(Int(d["line"]), Int(d["column"]));
        def end = r.Lines.Offset(Int(d["endLine"]), Int(d["endColumn"]));
        add(start, Math.Max(start + 1, end), Int(d["severity"]), "nemerle", Str(d["message"]));
      }
    def p = JsonObject(); p["uri"] = JsonValue.Create(uri);
    p["version"] = JsonValue.Create(r.Version); p["diagnostics"] = items;
    transport.Notify("textDocument/publishDiagnostics", p)
  }

  static PathOf(uri : string) : string { try { Path.GetFullPath(System.Uri(uri).LocalPath) } catch { | _ => null } }
  static UriOf(path : string) : string { System.Uri(path).AbsoluteUri }

  // ---- the typed check ----

  /// Called by the worker after an edit: the check thread starts one once edits settle.
  RequestCheck() : void
  {
    when (typecheck && root != null)
    {
      lock (checkWanted) { lastEdit = DateTime.UtcNow; checkGeneration++; def running = checking; when (running != null) try { running.Kill() } catch { | _ => () } }
      _ = checkWanted.Set();
    }
  }

  /// A request for the checker: the workspace and the open documents' text.
  CheckRequest() : JsonObject
  {
    def request = JsonObject();
    request["root"] = JsonValue.Create(root); request["references"] = JsonValue.Create(references);
    request["fileNameNamespaces"] = JsonValue.Create(fileNameNamespaces);
    request["libraries"] = JsonArray(libraries.Select(l => JsonValue.Create(l) : JsonNode).ToArray());
    def files = JsonArray();
    lock (documents)
      foreach (d in documents.Values)
        match (PathOf(d.Uri)) { | null => () | path => def f = JsonObject(); f["path"] = JsonValue.Create(path); f["text"] = JsonValue.Create(d.Text); files.Add(f) }
    request["files"] = files;
    request
  }

  /// Runs a checker process (`nemerle-lsp --check`) on a request; null when it fails.
  RunChecker(request : JsonObject, track : bool) : JsonObject
  {
    def info = Diagnostics.ProcessStartInfo(Environment.ProcessPath);
    // the same server, as `dotnet nemerle-lsp.exe --check` (or the apphost itself)
    when (Path.GetFileNameWithoutExtension(Environment.ProcessPath) == "dotnet") info.ArgumentList.Add(typeof(Server).Assembly.Location);
    info.ArgumentList.Add("--check");
    info.RedirectStandardInput = true; info.RedirectStandardOutput = true; info.RedirectStandardError = true; info.UseShellExecute = false;
    def process = Diagnostics.Process.Start(info);
    when (track) lock (checkWanted) checking = process;
    process.StandardInput.Write(request.ToJsonString()); process.StandardInput.Close();
    def errors = process.StandardError.ReadToEndAsync();
    def output = process.StandardOutput.ReadToEnd();
    process.WaitForExit();
    when (track) lock (checkWanted) checking = null;
    if (process.ExitCode == 0 && output.Length > 0) JsonNode.Parse(output).AsObject()
    else { log.WriteLine("check failed (" + process.ExitCode.ToString() + "): " + errors.Result); null }
  }

  /// Keeps the symbol index up to date: each time it is wanted (the start, a save), the files that changed on disk
  /// since it was last built, and those importing them, are checked again in a checker process; nothing else is.
  IndexLoop() : void
  {
    log.WriteLine("symbol index kept in " + index.File);
    index.Load();
    while (true)
    {
      _ = indexWanted.WaitOne();
      try
      {
        def current = index.Workspace();
        def stale = index.Stale(current);
        if (stale.Count == 0) index.Ready = true
        else
        {
          def started = Diagnostics.Stopwatch.StartNew();
          def request = JsonObject();
          request["root"] = JsonValue.Create(root); request["references"] = JsonValue.Create(references);
          request["fileNameNamespaces"] = JsonValue.Create(fileNameNamespaces);
          request["libraries"] = JsonArray(libraries.Select(l => JsonValue.Create(l) : JsonNode).ToArray());
          def files = JsonArray();
          foreach (path in stale) { def f = JsonObject(); f["path"] = JsonValue.Create(path); f["text"] = JsonValue.Create(current[path]); files.Add(f) }
          request["files"] = files;
          when (stale.Count == current.Count) request["all"] = JsonValue.Create(true);
          match (RunChecker(request, false))
          {
            | null => ()
            | answer =>
              def facts = SCG.Dictionary.[string, SCG.List[JsonObject]](StringComparer.Ordinal);
              foreach (f in answer["facts"].AsArray())
              {
                def path = Str(f["path"]);
                unless (facts.ContainsKey(path)) facts[path] = SCG.List();
                facts[path].Add(f.AsObject());
              }
              // every file the check typed is up to date: the stale ones and the files they import
              def typed = SCG.HashSet.[string](stale, StringComparer.Ordinal);
              foreach (f in answer["files"].AsArray()) _ = typed.Add(Str(f));
              // a check stopped by an error typed only part of the files: one without facts is not marked as done
              def failed = answer["diagnostics"].AsArray().Any(d => Int(d["severity"]) == 1);
              foreach (path in typed)
                when (current.ContainsKey(path))
                {
                  def mine = if (facts.ContainsKey(path)) facts[path] else SCG.List();
                  if (failed && mine.Count == 0) index.Update(path, "", mine) else index.Update(path, current[path], mine)
                }
              match (index.Save()) { | null => () | why => log.WriteLine("index: not kept (" + why + ")") }
              index.Ready = true;
              log.WriteLine("index: " + stale.Count.ToString() + " file(s) checked again in " + started.ElapsedMilliseconds.ToString() + " ms");
              // the open files may use what changed on disk: their live facts are checked again too
              RequestCheck()
          }
        }
      }
      catch { | e is Exception => log.WriteLine("index: " + e.Message) }
    }
  }

  CheckLoop() : void
  {
    while (true)
    {
      _ = checkWanted.WaitOne();
      // wait until edits have paused
      mutable settled = false;
      while (!settled) { def wait = 600 - (DateTime.UtcNow - lastEdit).TotalMilliseconds; if (wait > 0) Thread.Sleep(wait :> int) else settled = true; }
      def generation = lock (checkWanted) checkGeneration;
      def request = CheckRequest();
      try
      {
        def started = Diagnostics.Stopwatch.StartNew();
        def result = RunChecker(request, true);
        def current = lock (checkWanted) checkGeneration;
        when (result != null && current == generation)
        {
          log.WriteLine("checked " + request["files"].AsArray().Count.ToString() + " open file(s) in " + started.ElapsedMilliseconds.ToString() + " ms");
          jobs.Add(Job.Typed(result))
        }
      }
      catch { | e is Exception => log.WriteLine("check: " + e.Message) }
    }
  }

  /// The worker applies a check: new typed diagnostics and facts, and republishes every file they change.
  ApplyCheck(result : JsonObject) : void
  {
    def before = SCG.HashSet.[string](typedDiagnostics.Keys);
    // a compilation with errors stops before typing the rest: a file it typed no fact of keeps its earlier facts
    def failed = result["diagnostics"].AsArray().Any(d => Int(d["severity"]) == 1);
    def earlier = SCG.Dictionary(typedFacts);
    typedDiagnostics.Clear(); typedFacts.Clear();
    foreach (d in result["diagnostics"].AsArray())
    {
      def path = Str(d["path"]);
      unless (typedDiagnostics.ContainsKey(path)) typedDiagnostics[path] = SCG.List();
      typedDiagnostics[path].Add(d.AsObject());
    }
    foreach (f in result["facts"].AsArray())
    {
      def path = Str(f["path"]);
      unless (typedFacts.ContainsKey(path)) typedFacts[path] = SCG.List();
      typedFacts[path].Add(f.AsObject());
    }
    when (failed) foreach (e in earlier) unless (typedFacts.ContainsKey(e.Key)) typedFacts[e.Key] = e.Value;
    def affected = SCG.HashSet.[string](before); affected.UnionWith(typedDiagnostics.Keys);
    foreach (path in affected)
    {
      // an open file is matched by path: an editor's URI spelling (an escaped drive letter) can differ from ours
      def open = lock (documents) documents.Values.FirstOrDefault(d => PathOf(d.Uri) == path);
      def uri = if (open != null) open.Uri else UriOf(path);
      match (Current(uri))
      {
        | null =>
          // a file that is not open: its typed diagnostics alone
          def items = JsonArray();
          when (typedDiagnostics.ContainsKey(path))
            foreach (d in typedDiagnostics[path])
            {
              def position(line : int, column : int) { def p = JsonObject(); p["line"] = JsonValue.Create(Math.Max(0, line - 1)); p["character"] = JsonValue.Create(Math.Max(0, column - 1)); p }
              def range = JsonObject(); range["start"] = position(Int(d["line"]), Int(d["column"])); range["end"] = position(Int(d["endLine"]), Int(d["endColumn"]));
              def x = JsonObject(); x["range"] = range; x["severity"] = JsonValue.Create(Int(d["severity"]));
              x["source"] = JsonValue.Create("nemerle"); x["message"] = JsonValue.Create(Str(d["message"])); items.Add(x);
            }
          def p = JsonObject(); p["uri"] = JsonValue.Create(uri); p["diagnostics"] = items;
          transport.Notify("textDocument/publishDiagnostics", p)
        | doc => Publish(uri, Ensure(doc))
      }
    }
  }

  /// The innermost fact of the latest check at an LSP position.
  FactAt(doc : Document, position : JsonNode) : JsonObject
  {
    def path = PathOf(doc.Uri);
    def line = Int(position["line"]) + 1; def column = Int(position["character"]) + 1;
    mutable best = null; mutable bestSize = int.MaxValue;
    when (path != null && typedFacts.ContainsKey(path))
      foreach (f in typedFacts[path])
      {
        def (sl, sc, el, ec) = (Int(f["line"]), Int(f["column"]), Int(f["endLine"]), Int(f["endColumn"]));
        def inside = (line > sl || line == sl && column >= sc) && (line < el || line == el && column <= ec);
        def size = (el - sl) * 10000 + (ec - sc);
        when (inside && size < bestSize) { best = f; bestSize = size; }
      }
    best
  }

  /// The edits that format the lines from `first' to `last' (see format.n): one per line that changes.
  Formatting(r : AnalysisResult, options : JsonNode, first : int, last : int) : JsonNode
  {
    def tabSize = if (options != null && options["tabSize"] != null) Int(options["tabSize"]) else 2;
    def spaces = options == null || options["insertSpaces"] == null || options["insertSpaces"].GetValue.[bool]();
    def edits = JsonArray();
    foreach ((line, text) in format.Lines(r, tabSize, spaces, first, last))
    {
      def start = r.Lines.LineStart(line);
      def stop = { def e = r.Lines.LineEnd(line); if (e > start && r.Text[e - 1] == '\r') e - 1 else e };
      def x = JsonObject(); x["range"] = Range(r, start, stop); x["newText"] = JsonValue.Create(text);
      edits.Add(x);
    }
    edits
  }

  static Unbound : Regex = Regex(@"^unbound (?:type )?name `([A-Za-z_][A-Za-z0-9_]*)'(?!\s+in\s)");

  /// The workspace modules (other than the file at `path') declaring `name' at their top level.
  ModulesWith(name : string, path : string) : SCG.List[string]
  {
    def found = SCG.List();
    when (root != null)
    {
      when (analyzer == null) analyzer = Analyzer(references, root, fileNameNamespaces);
      foreach (file in (if (index != null) index else SymbolIndex(root)).Workspace())
        when (file.Key.EndsWith(".n", StringComparison.Ordinal) && file.Key != path)
        {
          def hash = SymbolIndex.HashOf(file.Value);
          mutable known;
          unless (declared.TryGetValue(file.Key, out known) && known[0] == hash)
          {
            known = (hash, SCG.HashSet(analyzer.Analyze(file.Key, 0, file.Value).Symbols.Select(x => x.Name)));
            declared[file.Key] = known;
          }
          when (known[1].Contains(name))
            found.Add(Path.ChangeExtension(Path.GetRelativePath(root, file.Key), null).Replace(Path.DirectorySeparatorChar, '.'))
        }
    }
    found
  }

  static UnusedValue : Regex = Regex(@"^(?:N168: )?.* ([A-Za-z_][A-Za-z0-9_']*) was never used");
  static UsingLine : Regex = Regex(@"^\s*using\s[^;]*;");

  /// The quick fixes for the latest check's diagnostics in a range: a name it could not find gets a `using' of each
  /// namespace or module that has it (or the name written with it), an unused value its name prefixed with `_'.
  CodeActions(doc : Document, r : AnalysisResult, range : JsonNode) : JsonNode
  {
    def actions = JsonArray();
    def path = PathOf(doc.Uri);
    def first = Int(range["start"]["line"]); def last = Int(range["end"]["line"]);
    def action(title : string, diagnostic : JsonObject, edits : list[int * int * string], preferred : bool) : void
    {
      def changes = JsonObject(); def items = JsonArray();
      foreach ((start, stop, text) in edits) { def e = JsonObject(); e["range"] = Range(r, start, stop); e["newText"] = JsonValue.Create(text); items.Add(e) }
      changes[doc.Uri] = items;
      def edit = JsonObject(); edit["changes"] = changes;
      def x = JsonObject(); x["title"] = JsonValue.Create(title); x["kind"] = JsonValue.Create("quickfix");
      x["diagnostics"] = JsonArray(array[diagnostic.DeepClone()]); x["edit"] = edit;
      when (preferred) x["isPreferred"] = JsonValue.Create(true);
      actions.Add(x)
    }
    // where a `using' goes: after the file's last one at its start, else before its first line of code
    def usingAt() : int * string
    {
      mutable line = 0; mutable after = -1; mutable code = -1;
      while (code < 0 && line < r.Lines.LineCount)
      {
        def text = r.Text.Substring(r.Lines.LineStart(line), r.Lines.LineEnd(line) - r.Lines.LineStart(line)).Trim();
        if (UsingLine.IsMatch(text)) after = line
        else unless (text.Length == 0 || text.StartsWith("//", StringComparison.Ordinal)) code = line;
        ++line
      }
      if (after >= 0) (r.Lines.LineEnd(after) + 1, "")
      else if (code >= 0) (r.Lines.LineStart(code), "\n")
      else (r.Text.Length, "")
    }
    when (path != null && typedDiagnostics.ContainsKey(path))
      foreach (d in typedDiagnostics[path])
        when (Int(d["line"]) - 1 <= last && Int(d["endLine"]) - 1 >= first)
        {
          def start = r.Lines.Offset(Int(d["line"]), Int(d["column"]));
          def stop = r.Lines.Offset(Int(d["endLine"]), Int(d["endColumn"]));
          def written = r.Text.Substring(start, Math.Max(0, stop - start));
          def diagnostic = JsonObject();
          diagnostic["range"] = Range(r, start, stop); diagnostic["severity"] = JsonValue.Create(Int(d["severity"]));
          diagnostic["source"] = JsonValue.Create("nemerle"); diagnostic["message"] = JsonValue.Create(Str(d["message"]));
          def unused = UnusedValue.Match(Str(d["message"]));
          // (the check may be of an older text: a fix is offered only where the text still says what it found)
          if (unused.Success && written == unused.Groups[1].Value)
            action("Prefix `" + written + "' with `_'", diagnostic, [(start, stop, "_" + written)], true)
          else
          {
            def unbound = Unbound.Match(Str(d["message"]));
            when (unbound.Success && written == unbound.Groups[1].Value)
            {
              // what the check found (namespaces, the modules it compiled), and the workspace's other modules
              def found = SCG.List.[string]();
              when (d["imports"] != null) foreach (from in d["imports"].AsArray()) found.Add(Str(from));
              foreach (from in ModulesWith(written, path)) unless (found.Contains(from)) found.Add(from);
              def (at, blank) = usingAt();
              foreach (from in found)
                action("Add `using " + from + ";'", diagnostic, [(at, at, "using " + from + ";\n" + blank)], found.Count == 1);
              foreach (from in found)
                action("Write `" + from + "." + written + "'", diagnostic, [(start, stop, from + "." + written)], false)
            }
          }
        }
    actions
  }

  Hover(doc : Document, r : AnalysisResult, position : JsonNode) : JsonNode
  {
    match (FactAt(doc, position))
    {
      | null => null
      | f =>
        def contents = JsonObject(); contents["kind"] = JsonValue.Create("markdown");
        contents["value"] = JsonValue.Create("```nemerle\n" + Str(f["hover"]) + "\n```");
        def x = JsonObject(); x["contents"] = contents;
        def start = r.Lines.Offset(Int(f["line"]), Int(f["column"])); def end = r.Lines.Offset(Int(f["endLine"]), Int(f["endColumn"]));
        x["range"] = Range(r, start, end); x
    }
  }

  Definition(doc : Document, position : JsonNode) : JsonNode
  {
    match (FactAt(doc, position))
    {
      | null => null
      | f when f["target"] == null => null
      | f =>
        def t = f["target"];
        def position(line : int, column : int) { def p = JsonObject(); p["line"] = JsonValue.Create(Math.Max(0, line - 1)); p["character"] = JsonValue.Create(Math.Max(0, column - 1)); p }
        def range = JsonObject(); range["start"] = position(Int(t["line"]), Int(t["column"])); range["end"] = position(Int(t["endLine"]), Int(t["endColumn"]));
        def x = JsonObject(); x["uri"] = JsonValue.Create(UriOf(Str(t["path"]))); x["range"] = range; x
    }
  }

  // ---- document highlight, inlay hints, workspace symbols, signature help ----

  /// The other places in the file of what is at the position: the uses (and declaration) of the symbol the latest
  /// check typed there, or in a grammar block, of the rule (or module) name there.
  Highlights(doc : Document, r : AnalysisResult, position : JsonNode) : JsonNode
  {
    def items = JsonArray(); def seen = SCG.HashSet.[string]();
    def add(range : JsonObject) : void
    {
      when (range != null && seen.Add(range.ToJsonString())) { def x = JsonObject(); x["range"] = range; x["kind"] = JsonValue.Create(1 : int); items.Add(x) }
    }
    def path = PathOf(doc.Uri);
    def offset = r.Lines.Offset(Int(position["line"]) + 1, Int(position["character"]) + 1);
    match (FactAt(doc, position))
    {
      | f when f != null && f["id"] != null && path != null =>
        def id = Str(f["id"]);
        foreach (g in typedFacts[path])
          when (Str(g["id"]) == id)
          {
            add(NameRange(g));
            def t = g["target"];
            when (t != null && Str(t["path"]) == path) add(NameRange(t))
          }
      | _ =>
        foreach (block in r.Grammars)
          when (offset >= block.Start && offset <= block.End)
          {
            mutable name = null;
            foreach ((n, s, e, _) in block.Names) when (name == null && offset >= s && offset <= e) name = n;
            when (name != null) foreach ((other, s, e, _) in block.Names) when (other == name) add(Range(r, s, e).AsObject())
          }
    }
    items
  }

  /// The types the latest check inferred, after the names declared without one (`def x = ...', `mutable y = ...').
  InlayHints(doc : Document, r : AnalysisResult, range : JsonNode) : JsonNode
  {
    def items = JsonArray();
    def path = PathOf(doc.Uri);
    def first = if (range != null) Int(range["start"]["line"]) + 1 else 1;
    def last = if (range != null) Int(range["end"]["line"]) + 1 else int.MaxValue;
    def lines = doc.Text.Split('\n');
    def seen = SCG.HashSet.[string]();
    when (path != null && typedFacts.ContainsKey(path))
      foreach (f in typedFacts[path])
        when (f["nameLine"] != null && (Str(f["kind"]) == "local" || Str(f["kind"]) == "field"))
        {
          def line = Int(f["nameLine"]);
          def (column, end) = (Int(f["nameColumn"]), Int(f["nameEndColumn"]));
          when (line >= first && line <= last && line <= lines.Length)
          {
            def text = lines[line - 1];
            when (end - 1 <= text.Length && column >= 1)
            {
              def before = text.Substring(0, column - 1);
              def after = text.Substring(end - 1).TrimStart();
              def hover = Str(f["hover"]);
              def at = hover.IndexOf(" : ", StringComparison.Ordinal);
              when (Regex.IsMatch(before, @"(?:^|[\s;{(])(?:def|mutable)\s+$") && !after.StartsWith(":") && at > 0 && seen.Add(line.ToString() + ":" + end.ToString()))
              {
                def p = JsonObject(); p["line"] = JsonValue.Create(line - 1); p["character"] = JsonValue.Create(end - 1);
                def x = JsonObject(); x["position"] = p; x["label"] = JsonValue.Create(": " + hover.Substring(at + 3));
                x["kind"] = JsonValue.Create(1 : int); x["paddingLeft"] = JsonValue.Create(false);
                items.Add(x)
              }
            }
          }
        }
    items
  }

  /// The workspace's files, each with its outline (its Nemerle declarations, and its grammar blocks' modules and
  /// rules), kept while its text is the same.
  outlines : SCG.Dictionary[string, string * AnalysisResult] = SCG.Dictionary(StringComparer.Ordinal);

  WorkspaceSymbols(query : string) : JsonNode
  {
    def items = JsonArray();
    def texts = SCG.Dictionary.[string, string](StringComparer.Ordinal);
    when (root != null)
      try
        foreach (file in Directory.EnumerateFiles(root, "*.n", SearchOption.AllDirectories))
        {
          def relative = Path.GetRelativePath(root, file).Split(Path.DirectorySeparatorChar);
          unless (relative.Take(relative.Length - 1).Any(d => d.StartsWith(".") || d == "out" || d == "bin" || d == "obj" || d == "node_modules"))
            texts[Path.GetFullPath(file)] = try { File.ReadAllText(file) } catch { | _ => null }
        }
      catch { | _ => () }
    lock (documents) foreach (d in documents.Values) match (PathOf(d.Uri)) { | null => () | path => texts[path] = d.Text }
    // (each letter of the query, in order, ignoring case)
    def wanted(name : string) : bool
    {
      mutable i = 0;
      foreach (c in name) when (i < query.Length && char.ToLowerInvariant(c) == char.ToLowerInvariant(query[i])) i++;
      i == query.Length
    }
    foreach (pair in texts)
      when (pair.Value != null)
      {
        mutable known;
        def r = if (outlines.TryGetValue(pair.Key, out known) && known[0] == pair.Value) known[1]
                else
                {
                  when (analyzer == null) analyzer = Analyzer(references, root, fileNameNamespaces);
                  def analyzed = analyzer.Analyze(pair.Key, 0, pair.Value);
                  outlines[pair.Key] = (pair.Value, analyzed); analyzed
                };
        def uri = UriOf(pair.Key);
        def visit(s : SymbolInfo, container : string) : void
        {
          when (wanted(s.Name))
          {
            def location = JsonObject(); location["uri"] = JsonValue.Create(uri); location["range"] = Range(r, s.NameStart, s.NameEnd);
            def x = JsonObject(); x["name"] = JsonValue.Create(s.Name); x["kind"] = JsonValue.Create(s.Kind); x["location"] = location;
            when (container != null) x["containerName"] = JsonValue.Create(container);
            items.Add(x)
          }
          foreach (c in s.Children) visit(c, s.Name)
        }
        foreach (s in r.Symbols) visit(s, Path.GetFileNameWithoutExtension(pair.Key))
      }
    items
  }

  /// The call the position is in the arguments of: what its name can call (each overload's parameters), and which
  /// argument the position is at.
  SignatureHelp(doc : Document, r : AnalysisResult, position : JsonNode) : JsonNode
  {
    def path = PathOf(doc.Uri);
    def text = doc.Text;
    def offset = Math.Min(text.Length, r.Lines.Offset(Int(position["line"]) + 1, Int(position["character"]) + 1));
    // back to the call's `(': its arguments before the position are counted by their commas
    mutable depth = 0; mutable commas = 0; mutable open = -1; mutable i = offset - 1;
    while (open < 0 && i >= 0)
    {
      match (text[i])
      {
        | ')' | ']' => depth++
        | '(' when depth == 0 => open = i
        | '(' | '[' => depth--
        | ',' when depth == 0 => commas++
        | ';' | '{' | '}' when depth == 0 => i = -1
        | '"' => i--; while (i >= 0 && text[i] != '"') i--
        | _ => ()
      }
      i--;
    }
    mutable stop = open; while (stop > 0 && char.IsWhiteSpace(text[stop - 1])) stop--;
    mutable start = stop; while (start > 0 && (char.IsLetterOrDigit(text[start - 1]) || text[start - 1] == '_')) start--;
    if (!typecheck || root == null || path == null || open < 0 || start == stop) null
    else
    {
      // (the call's arguments made `()', where an unfinished one would stop the parse)
      mutable close = -1; mutable d = 0; mutable j = open + 1;
      while (close < 0 && j < text.Length)
      {
        match (text[j]) { | '(' => d++ | ')' when d == 0 => close = j | ')' => d-- | ';' | '{' | '}' when d == 0 => j = text.Length | _ => () }
        j++
      }
      def called = text.Substring(0, open) + "()" + (if (close >= 0) text.Substring(close + 1) else text.Substring(offset));
      def request = CheckRequest();
      foreach (f in request["files"].AsArray()) when (Str(f["path"]) == path) f["text"] = JsonValue.Create(called);
      def at = JsonObject(); at["path"] = JsonValue.Create(path);
      at["line"] = JsonValue.Create(r.Lines.Line(stop) + 1); at["column"] = JsonValue.Create(r.Lines.Column(stop) + 1);
      request["complete"] = at; request["signature"] = JsonValue.Create(true);
      match (RunChecker(request, false))
      {
        | null => null
        | answer when answer["signatures"] == null || answer["signatures"].AsArray().Count == 0 => null
        | answer =>
          def signatures = answer["signatures"].AsArray().DeepClone().AsArray();
          mutable active = 0;
          for (mutable k = signatures.Count - 1; k >= 0; k--)
            when (signatures[k]["parameters"].AsArray().Count > commas) active = k;
          def x = JsonObject(); x["signatures"] = signatures;
          x["activeSignature"] = JsonValue.Create(active); x["activeParameter"] = JsonValue.Create(commas); x
      }
    }
  }

  // ---- completion, references, rename ----

  /// Nemerle's basic forms, as snippets (LSP snippet syntax): offered for the word being typed, with no compile.
  static Forms : array[string * string * string] = array[
    ("def", "def ${1:name} = ${2:value};", "a value"),
    ("mutable", "mutable ${1:name} = ${2:value};", "a variable"),
    ("if", "if (${1:condition}) ${2:then} else ${3:otherwise}", "if / else (both branches)"),
    ("when", "when (${1:condition}) ${2:body}", "when (no else)"),
    ("unless", "unless (${1:condition}) ${2:body}", "unless (no else)"),
    ("match", "match (${1:value})\n{\n  | ${2:pattern} => ${3:result}\n  | _ => ${4:otherwise}\n}", "match with cases"),
    ("foreach", "foreach (${1:x} in ${2:items})\n{\n  $0\n}", "foreach over a collection"),
    ("for", "for (mutable ${1:i} = 0; $1 < ${2:n}; $1++)\n{\n  $0\n}", "counting loop"),
    ("while", "while (${1:condition})\n{\n  $0\n}", "while loop"),
    ("try", "try\n{\n  $0\n}\ncatch\n{\n  | e is ${1:System.Exception} => ${2:()}\n}", "try / catch"),
    ("fun", "fun (${1:x}) { $0 }", "a function value"),
    ("function", "${1:Name}(${2:x} : ${3:int}) : ${4:int}\n{\n  $0\n}", "a function of the file"),
    ("async", "async ${1:Name}(${2:x} : ${3:int}) : System.Threading.Tasks.Task[${4:int}]\n{\n  $0\n}", "an async function (await waits in it)"),
    ("class", "class ${1:Name}\n{\n  public this() { }\n  $0\n}", "a class"),
    ("export", "export class ${1:Name}\n{\n  $0\n}", "a type for the whole program"),
    ("variant", "variant ${1:Name}\n{\n  | ${2:First}\n  | ${3:Second} { ${4:value} : ${5:int} }\n}", "a variant (closed set of cases)"),
    ("using", "using ${1:System};", "open a namespace or file"),
    ("macro", "macro ${1:Name}(${2:expr})\n{\n  <[ \\$${2:expr} ]>\n}", "a macro"),
  ];
  static Words : array[string] = array["def", "mutable", "if", "else", "when", "unless", "match", "foreach", "for", "while", "do",
    "async", "await", "yield",
    "using", "fun", "true", "false", "null", "this", "base", "try", "catch", "finally", "throw", "is", "as", "in", "with",
    "public", "private", "protected", "internal", "static", "class", "struct", "variant", "interface", "module", "mask",
    "export", "macro", "syntax", "grammar", "space", "scope", "dial", "lock", "typeof", "array", "list", "option", "void",
    "abstract", "override", "virtual", "sealed", "ref", "out", "params", "implements", "where"];

  /// The keywords and forms that start with the word before the cursor (none after a dot).
  static Basics(text : string, offset : int) : JsonArray
  {
    def items = JsonArray();
    def ident(c : char) { char.IsLetterOrDigit(c) || c == '_' }
    mutable start = Math.Min(offset, text.Length); while (start > 0 && ident(text[start - 1])) start--;
    def word = text.Substring(start, Math.Min(offset, text.Length) - start);
    def afterDot = start > 0 && text[start - 1] == '.';
    unless (afterDot)
    {
      foreach ((label, body, detail) when label.StartsWith(word, StringComparison.Ordinal) in Forms)
      {
        def x = JsonObject(); x["label"] = JsonValue.Create(label); x["kind"] = JsonValue.Create(15 : int); // snippet
        x["detail"] = JsonValue.Create(detail); x["insertText"] = JsonValue.Create(body); x["insertTextFormat"] = JsonValue.Create(2 : int);
        x["sortText"] = JsonValue.Create("1" + label);
        items.Add(x);
      }
      foreach (k when k.StartsWith(word, StringComparison.Ordinal) in Words)
      {
        def x = JsonObject(); x["label"] = JsonValue.Create(k); x["kind"] = JsonValue.Create(14 : int); x["sortText"] = JsonValue.Create("2" + k);
        items.Add(x);
      }
    }
    items
  }

  Completions(doc : Document, position : JsonNode) : JsonNode
  {
    def result = JsonObject(); result["isIncomplete"] = JsonValue.Create(false);
    def items = JsonArray();
    def path = PathOf(doc.Uri);
    // what the compiler offers first (members, names in scope), then the keywords and forms, each label once
    def basics = Basics(doc.Text, Ensure(doc).Lines.Offset(Int(position["line"]) + 1, Int(position["character"]) + 1));
    when (typecheck && root != null && path != null)
    {
      def request = CheckRequest();
      def at = JsonObject(); at["path"] = JsonValue.Create(path);
      at["line"] = JsonValue.Create(Int(position["line"]) + 1); at["column"] = JsonValue.Create(Int(position["character"]) + 1);
      request["complete"] = at;
      def started = Diagnostics.Stopwatch.StartNew();
      match (RunChecker(request, false))
      {
        | null => ()
        | answer =>
          when (answer["completion"] != null) foreach (item in answer["completion"].AsArray()) items.Add(item.DeepClone());
          log.WriteLine("completion: " + items.Count.ToString() + " item(s) in " + started.ElapsedMilliseconds.ToString() + " ms")
      }
    }
    // a check that stopped before the cursor (a broken line elsewhere) offers no names: the file's last good check
    // does (its facts name what the file declares and uses), except after a dot, where the type decides
    when (items.Count == 0 && path != null && typedFacts.ContainsKey(path))
      match (PrefixAt(doc, position))
      {
        | null => ()
        | prefix =>
          def offered = SCG.HashSet.[string]();
          foreach (f in typedFacts[path])
          {
            def name = Str(f["name"]); def kind = Str(f["kind"]);
            when (name != null && name.Length > 0 && name.StartsWith(prefix, StringComparison.Ordinal) && kind != "constructor" && offered.Add(name))
            {
              def item = JsonObject(); item["label"] = JsonValue.Create(name);
              item["kind"] = JsonValue.Create(match (kind) { | "method" => 2 | "field" => 5 | "property" => 10 | "event" => 23 | _ => 6 } : int);
              item["detail"] = JsonValue.Create(Str(f["hover"]));
              items.Add(item);
            }
          }
      }
    def labels = SCG.HashSet.[string](items.Select(i => Str(i["label"]) + "/" + Int(i["kind"]).ToString()));
    def typedWords = SCG.HashSet.[string](items.Where(i => Int(i["kind"]) == 14).Select(i => Str(i["label"])));
    foreach (b in basics)
      when (Int(b["kind"]) == 15 || !typedWords.Contains(Str(b["label"])))
        when (labels.Add(Str(b["label"]) + "/" + Int(b["kind"]).ToString())) items.Add(b.DeepClone());
    result["items"] = items;
    result
  }

  /// The identifier being written at a position (possibly empty), or null right after a dot (a member's place).
  static PrefixAt(doc : Document, position : JsonNode) : string
  {
    def lines = doc.Text.Split('\n');
    def line = Int(position["line"]);
    if (line < 0 || line >= lines.Length) ""
    else
    {
      def l = lines[line]; def at = Math.Min(Int(position["character"]), l.Length);
      mutable start = at; while (start > 0 && (char.IsLetterOrDigit(l[start - 1]) || l[start - 1] == '_')) start--;
      if (start > 0 && l[start - 1] == '.') null else l.Substring(start, at - start)
    }
  }

  /// A span of the check's JSON (1-based lines and columns) as an LSP range.
  static RangeOf(line : int, column : int, endLine : int, endColumn : int) : JsonObject
  {
    def position(l : int, c : int) { def p = JsonObject(); p["line"] = JsonValue.Create(Math.Max(0, l - 1)); p["character"] = JsonValue.Create(Math.Max(0, c - 1)); p }
    def range = JsonObject(); range["start"] = position(line, column); range["end"] = position(endLine, endColumn); range
  }

  /// The name span of a fact or target ("name" fields), if it has one.
  static NameRange(node : JsonNode) : JsonObject
  {
    if (node["nameLine"] == null) null
    else RangeOf(Int(node["nameLine"]), Int(node["nameColumn"]), Int(node["nameLine"]), Int(node["nameEndColumn"]))
  }

  static Key(target : JsonNode) : string { Str(target["path"]) + ":" + Int(target["line"]).ToString() + ":" + Int(target["column"]).ToString() }

  static Inside(line : int, column : int, l : int, c : int, el : int, ec : int) : bool
  {
    (line > l || line == l && column >= c) && (line < el || line == el && column <= ec)
  }

  /// The symbol at a position, from a whole-workspace check: its declaration (target), its name and kind, and the
  /// facts of the check; null when there is none.
  /// The identifier at a position (for a type: its name), with its range.
  static WordAt(doc : Document, position : JsonNode) : string * JsonObject
  {
    def lines = doc.Text.Split('\n');
    def line = Int(position["line"]);
    if (line < 0 || line >= lines.Length) (null, null)
    else
    {
      def l = lines[line]; def at = Math.Min(Int(position["character"]), l.Length);
      def ident(c : char) { char.IsLetterOrDigit(c) || c == '_' }
      mutable start = at; while (start > 0 && ident(l[start - 1])) start--;
      mutable stop = at; while (stop < l.Length && ident(l[stop])) stop++;
      if (stop == start) (null, null) else (l.Substring(start, stop - start), RangeOf(line + 1, start + 1, line + 1, stop + 1))
    }
  }

  /// The latest whole-workspace check, with the type-rename places of the word at the position.
  mutable lastWorkspaceCheck : JsonObject;

  Symbol(doc : Document, position : JsonNode) : JsonObject * string * string * JsonArray
  {
    def path = PathOf(doc.Uri);
    if (!typecheck || root == null || path == null) (null, null, null, null)
    else
    {
      def request = CheckRequest(); request["all"] = JsonValue.Create(true);
      // the word at the cursor, in case it names a type of the workspace (a type has no facts of its own)
      match (WordAt(doc, position))
      {
        | (null, _) => ()
        | (word, _) =>
          request["renameType"] = JsonValue.Create(word);
          // (and where it is: which type of that name the word means there)
          def at = JsonObject();
          at["path"] = JsonValue.Create(path);
          at["line"] = JsonValue.Create(Int(position["line"]) + 1); at["column"] = JsonValue.Create(Int(position["character"]) + 1);
          request["renameAt"] = at
      }
      def answer = RunChecker(request, false);
      lastWorkspaceCheck = answer;
      match (answer)
      {
        | null => (null, null, null, null)
        | answer =>
          def facts = answer["facts"].AsArray();
          def line = Int(position["line"]) + 1; def column = Int(position["character"]) + 1;
          mutable found = null;
          foreach (f in facts)
            when (found == null && f["target"] != null)
            {
              // on a use (its name, or its whole span), or on the declaration's name
              def onUse = Str(f["path"]) == path && (if (f["nameLine"] != null) Inside(line, column, Int(f["nameLine"]), Int(f["nameColumn"]), Int(f["nameLine"]), Int(f["nameEndColumn"]))
                                                   else Inside(line, column, Int(f["line"]), Int(f["column"]), Int(f["endLine"]), Int(f["endColumn"])));
              def t = f["target"];
              def onDeclaration = Str(t["path"]) == path && t["nameLine"] != null && Inside(line, column, Int(t["nameLine"]), Int(t["nameColumn"]), Int(t["nameLine"]), Int(t["nameEndColumn"]));
              when (onUse || onDeclaration) found = f.AsObject();
            }
          if (found == null) (null, null, null, facts) else (found["target"].AsObject(), Str(found["name"]), Str(found["kind"]), facts)
      }
    }
  }

  /// The fact at a position in an open file, from its latest check (the live facts): a use of a symbol, or its
  /// declaration's name; null when there is none (or the file has not been checked yet).
  LiveFactAt(doc : Document, position : JsonNode) : JsonObject
  {
    def path = PathOf(doc.Uri);
    if (path == null || !typedFacts.ContainsKey(path)) null
    else
    {
      def line = Int(position["line"]) + 1; def column = Int(position["character"]) + 1;
      mutable found = null;
      foreach (f when found == null && f["target"] != null && f["id"] != null in typedFacts[path])
      {
        def onUse = if (f["nameLine"] != null) Inside(line, column, Int(f["nameLine"]), Int(f["nameColumn"]), Int(f["nameLine"]), Int(f["nameEndColumn"]))
                    else Inside(line, column, Int(f["line"]), Int(f["column"]), Int(f["endLine"]), Int(f["endColumn"]));
        def t = f["target"];
        def onDeclaration = Str(t["path"]) == path && t["nameLine"] != null && Inside(line, column, Int(t["nameLine"]), Int(t["nameColumn"]), Int(t["nameLine"]), Int(t["nameEndColumn"]));
        when (onUse || onDeclaration) found = f;
      }
      found
    }
  }

  /// Every use of symbol `id`: the live facts of the files the latest check typed, and the index for the others.
  UsesOf(id : string) : SCG.List[JsonObject]
  {
    def uses = index.Uses(id, typedFacts.Keys);
    foreach (pair in typedFacts) foreach (f when f["id"] != null && Str(f["id"]) == id in pair.Value) uses.Add(f);
    uses
  }

  /// The symbol at a position, from the index when it is built and the open file has been checked (no compilation);
  /// else from a whole-workspace check.
  /// The symbol at a position and its uses: from the index when it is built and the open file has been checked (no
  /// compilation; the uses are exactly the symbol's), else from a whole-workspace check (facts to match by target).
  SymbolFast(doc : Document, position : JsonNode) : JsonObject * SCG.List[JsonNode] * bool
  {
    def live = if (index != null && index.Ready) LiveFactAt(doc, position) else null;
    if (live != null) (live["target"].AsObject(), UsesOf(Str(live["id"])).Select(f => f : JsonNode).ToList(), true)
    else
    {
      def (target, _, _, facts) = Symbol(doc, position);
      (target, if (facts == null) SCG.List() else facts.ToList(), false)
    }
  }

  References(doc : Document, position : JsonNode, declaration : bool) : JsonNode
  {
    def (target, facts, exact) = SymbolFast(doc, position);
    def result = JsonArray();
    when (target != null)
    {
      def key = Key(target);
      // a top-level value's binding is also a write of its field, at the declaration: each place once
      def seen = SCG.HashSet.[string]();
      def add(path : string, range : JsonObject)
      {
        when (seen.Add(path + range.ToJsonString())) { def l = JsonObject(); l["uri"] = JsonValue.Create(UriOf(path)); l["range"] = range; result.Add(l) }
      }
      when (declaration) add(Str(target["path"]), NameRange(target) ?? RangeOf(Int(target["line"]), Int(target["column"]), Int(target["endLine"]), Int(target["endColumn"])));
      foreach (f when exact || f["target"] != null && Key(f["target"]) == key in facts)
        add(Str(f["path"]), NameRange(f) ?? RangeOf(Int(f["line"]), Int(f["column"]), Int(f["endLine"]), Int(f["endColumn"])));
    }
    result
  }

  static Renamable : array[string] = array["local", "parameter", "function", "field", "property", "method", "event"];

  /// A type of the workspace at the position: its rename places (or why not), from the latest workspace check.
  TypeAt(doc : Document, position : JsonNode) : JsonArray * string
  {
    def answer = lastWorkspaceCheck;
    if (answer == null) (null, null)
    else if (answer["typeRenameError"] != null) (null, Str(answer["typeRenameError"]))
    else if (answer["typeRename"] != null && answer["typeRename"].AsArray().Count > 0)
    {
      // the word must be one of the places (on a use or the declaration of the type)
      def path = PathOf(doc.Uri); def line = Int(position["line"]) + 1; def column = Int(position["character"]) + 1;
      def places = answer["typeRename"].AsArray();
      if (places.Any(s => Str(s["path"]) == path && Int(s["line"]) == line && column >= Int(s["column"]) && column <= Int(s["endColumn"]))) (places, null)
      else (null, null)
    }
    else (null, null)
  }

  PrepareRename(doc : Document, position : JsonNode) : JsonNode
  {
    // a member or a local, from the index; a type (it has no facts of its own) from a whole-workspace check
    def fast = if (index != null && index.Ready) LiveFactAt(doc, position) else null;
    if (fast != null && Renamable.Contains(Str(fast["kind"])) && fast["target"]["nameLine"] != null)
    {
      def x = JsonObject(); x["range"] = NameRange(fast) ?? NameRange(fast["target"]); x["placeholder"] = JsonValue.Create(Str(fast["name"])); x
    }
    else PrepareRenameChecked(doc, position)
  }

  PrepareRenameChecked(doc : Document, position : JsonNode) : JsonNode
  {
    def symbol = Symbol(doc, position);
    def (word, range) = WordAt(doc, position);
    match (TypeAt(doc, position))
    {
      | (places, _) when places != null =>
        def x = JsonObject(); x["range"] = range; x["placeholder"] = JsonValue.Create(word); x
      | _ =>
        match (symbol)
        {
          | (null, _, _, _) => null
          | (target, name, kind, facts) when Renamable.Contains(kind) && target["nameLine"] != null =>
            // the range at the cursor: the use's or the declaration's name
            def line = Int(position["line"]) + 1; def column = Int(position["character"]) + 1;
            def path = PathOf(doc.Uri);
            mutable range = null;
            foreach (f when f["nameLine"] != null && Str(f["path"]) == path in facts)
              when (range == null && Inside(line, column, Int(f["nameLine"]), Int(f["nameColumn"]), Int(f["nameLine"]), Int(f["nameEndColumn"]))) range = NameRange(f);
            when (range == null) range = NameRange(target);
            def x = JsonObject(); x["range"] = range; x["placeholder"] = JsonValue.Create(name); x
          | _ => null
        }
    }
  }

  static Identifier : Text.RegularExpressions.Regex = Text.RegularExpressions.Regex(@"^[A-Za-z_][A-Za-z0-9_']*$");
  static Keywords : array[string] = array["def", "mutable", "if", "else", "when", "unless", "match", "foreach", "for", "while", "do",
    "using", "fun", "true", "false", "null", "this", "base", "try", "catch", "finally", "throw", "is", "as", "in", "with",
    "public", "private", "protected", "internal", "static", "class", "struct", "variant", "interface", "module", "macro",
    "where", "namespace", "type", "void", "array", "list", "lock", "typeof", "abstract", "override", "virtual", "sealed", "extern"];

  /// A workspace edit renaming the symbol at a position everywhere, or (null, why not).
  Rename(doc : Document, position : JsonNode, newName : string) : JsonNode * string
  {
    if (newName == null || !Identifier.IsMatch(newName) || Keywords.Contains(newName)) (null, "`" + newName + "' is not a name")
    else
    {
      // a member or a local: its uses from the index, with no compilation
      def fast = if (index != null && index.Ready) LiveFactAt(doc, position) else null;
      if (fast != null && Renamable.Contains(Str(fast["kind"])) && fast["target"]["nameLine"] != null)
        RenameUses(fast["target"].AsObject(), UsesOf(Str(fast["id"])), newName)
      else
      {
        def symbol = Symbol(doc, position);
        match (TypeAt(doc, position))
        {
          | (null, why) when why != null => (null, why)
          | (places, _) when places != null =>
            // a type: every place its name is written
            def changes = JsonObject();
            foreach (s in places)
            {
              def uri = UriOf(Str(s["path"]));
              unless (changes.ContainsKey(uri)) changes[uri] = JsonArray();
              def e = JsonObject(); e["range"] = RangeOf(Int(s["line"]), Int(s["column"]), Int(s["line"]), Int(s["endColumn"]));
              e["newText"] = JsonValue.Create(newName); changes[uri].AsArray().Add(e);
            }
            def x = JsonObject(); x["changes"] = changes; (x, null)
          | _ =>
            match (symbol)
            {
              | (null, _, _, _) => (null, "there is nothing to rename here")
              | (_, _, kind, _) when !Renamable.Contains(kind) => (null, "a " + kind + " cannot be renamed here")
              | (target, _, _, _) when target["nameLine"] == null => (null, "the declaration's name is not found in its source")
              | (target, _, _, facts) =>
                def key = Key(target);
                RenameUses(target, facts.Where(f => f["target"] != null && Key(f["target"]) == key).Select(f => f.AsObject()).ToList(), newName)
            }
        }
      }
    }
  }

  /// The workspace edit renaming a symbol: its declaration's name and every use's.
  RenameUses(target : JsonObject, uses : SCG.List[JsonObject], newName : string) : JsonNode * string
  {
    if (uses.Any(f => f["nameLine"] == null)) (null, "some uses of it are not plain names (generated code); rename them by hand")
    else
    {
      def edits = SCG.Dictionary.[string, JsonArray]();
      def seen = SCG.HashSet.[string]();
      def edit(path : string, range : JsonObject) : void
      {
        when (seen.Add(path + range.ToJsonString()))
        {
          unless (edits.ContainsKey(path)) edits[path] = JsonArray();
          def e = JsonObject(); e["range"] = range; e["newText"] = JsonValue.Create(newName); edits[path].Add(e);
        }
      }
      edit(Str(target["path"]), NameRange(target));
      foreach (f in uses) edit(Str(f["path"]), NameRange(f));
      def changes = JsonObject();
      foreach (pair in edits) changes[UriOf(pair.Key)] = pair.Value;
      def x = JsonObject(); x["changes"] = changes; (x, null)
    }
  }

  /// The names the latest check typed, by what they are (a local, a parameter, a field, a method, a type), and a
  /// grammar block's rule names: over the parse's tokens (a `$"..."' string's names cut its token).
  Meanings(r : AnalysisResult, path : string) : SCG.List[int * int * int * int]
  {
    def found = SCG.List();
    foreach (block in r.Grammars)
      foreach ((_, start, end, declaration) in block.Names)
        found.Add((start, end - start, Legend.Type, if (declaration) Legend.Declaration else 0));
    when (path != null && typedFacts.ContainsKey(path))
      foreach (f in typedFacts[path])
        when (f["nameLine"] != null)
        {
          def name = Str(f["name"]);
          def start = r.Lines.Offset(Int(f["nameLine"]), Int(f["nameColumn"]));
          def length = Int(f["nameEndColumn"]) - Int(f["nameColumn"]);
          // (a fact of an earlier text: only where the name still is)
          when (length > 0 && start + length <= r.Text.Length && name != null && string.CompareOrdinal(r.Text, start, name, 0, length) == 0)
          {
            def kind = match (Str(f["kind"]))
            {
              | "local" => Legend.Variable | "parameter" => Legend.Parameter | "function" => Legend.Function
              | "method" => Legend.Method | "field" | "property" => Legend.Property | "event" => Legend.Event
              | "constructor" => Legend.Type | _ => -1
            };
            def t = f["target"];
            def declaration = t != null && t["nameLine"] != null && Str(t["path"]) == path
                              && Int(t["nameLine"]) == Int(f["nameLine"]) && Int(t["nameColumn"]) == Int(f["nameColumn"]);
            when (kind >= 0) found.Add((start, length, kind, if (declaration) Legend.Declaration else 0));
          }
        }
    found
  }

  SemanticTokens(r : AnalysisResult, path : string) : JsonNode
  {
    // the parse's tokens, cut where a name's meaning goes over them, then the names
    def meanings = Meanings(r, path);
    def tokens = SCG.List.[int * int * int * int]();
    foreach ((offset, length, kind) in r.Tokens)
    {
      mutable pieces = SCG.List.[int * int](); pieces.Add((offset, offset + length));
      foreach ((m, ml, _, _) in meanings)
        when (m < offset + length && m + ml > offset)
        {
          def cut = SCG.List.[int * int]();
          foreach ((a, b) in pieces)
            if (m >= b || m + ml <= a) cut.Add((a, b))
            else { when (m > a) cut.Add((a, m)); when (b > m + ml) cut.Add((m + ml, b)) }
          pieces = cut
        }
      foreach ((a, b) in pieces) tokens.Add((a, b - a, kind, 0));
    }
    def seen = SCG.HashSet.[int]();
    foreach ((m, ml, kind, mods) in meanings) when (seen.Add(m)) tokens.Add((m, ml, kind, mods));
    // sorted, non-overlapping, split at line ends, delta encoded
    def sorted = tokens.OrderBy(t => t[0]).ThenByDescending(t => t[1]).ToList();
    def data = JsonArray();
    mutable lastLine = 0; mutable lastChar = 0; mutable covered = 0;
    foreach ((offset, length, kind, mods) in sorted)
      when (offset >= covered && length > 0 && offset < r.Text.Length)
      {
        def end = Math.Min(offset + length, r.Text.Length);
        covered = end;
        mutable s = offset;
        while (s < end)
        {
          def line = r.Lines.Line(s);
          def lineEnd = Math.Min(end, r.Lines.LineEnd(line));
          def piece = lineEnd - s;
          when (piece > 0)
          {
            def ch = s - r.Lines.LineStart(line);
            def dl = line - lastLine; def dc = if (dl == 0) ch - lastChar else ch;
            data.Add(JsonValue.Create(dl)); data.Add(JsonValue.Create(dc)); data.Add(JsonValue.Create(piece));
            data.Add(JsonValue.Create(kind)); data.Add(JsonValue.Create(mods));
            lastLine = line; lastChar = ch;
          }
          s = r.Lines.LineEnd(line) + 1;
        }
      }
    def x = JsonObject(); x["data"] = data; x
  }

  Folding(r : AnalysisResult) : JsonNode
  {
    def items = JsonArray(); def seen = SCG.HashSet.[int * int]();
    foreach ((a, b) in r.Folds)
      when (seen.Add((a, b)))
      { def x = JsonObject(); x["startLine"] = JsonValue.Create(a); x["endLine"] = JsonValue.Create(b); items.Add(x); }
    items
  }

  Symbols(r : AnalysisResult) : JsonNode
  {
    def convert(s : SymbolInfo) : JsonNode
    {
      def x = JsonObject();
      x["name"] = JsonValue.Create(s.Name); x["kind"] = JsonValue.Create(s.Kind);
      x["range"] = Range(r, s.Start, s.End); x["selectionRange"] = Range(r, s.NameStart, s.NameEnd);
      def children = JsonArray(); foreach (c in s.Children) children.Add(convert(c));
      x["children"] = children; x
    }
    def items = JsonArray(); foreach (s in r.Symbols.OrderBy(s => s.Start)) items.Add(convert(s)); items
  }
}

internal module Program
{
  Main(args : array[string]) : int
  {
    mutable references = null;
    mutable logPath = null;
    mutable root = null;
    mutable shortNames = false;
    mutable typecheck = true;
    def libraries = SCG.List.[string]();
    when (args.Contains("--check")) return Checker.Run(Console.In, Console.Out);
    for (mutable i = 0; i < args.Length; ++i)
      match (args[i])
      {
        | "--library" when i + 1 < args.Length => ++i; libraries.Add(Path.GetFullPath(args[i]))
        | "--no-typecheck" => typecheck = false
        | "--references" when i + 1 < args.Length => ++i; references = args[i]
        | "--log" when i + 1 < args.Length => ++i; logPath = args[i]
        | "--source-root" when i + 1 < args.Length => ++i; root = Path.GetFullPath(args[i])
        | "--file-name-namespaces" => shortNames = true
        | "--stdio" => ()
        | _ => ()
      }
    when (references == null) references = DefaultReferences();
    // written as it happens (each line flushed), from the server's threads at once
    def log = if (logPath != null) { def w = StreamWriter(logPath, true); w.AutoFlush = true; TextWriter.Synchronized(w) } else TextWriter.Synchronized(Console.Error);
    log.WriteLine("nemerle-lsp: references " + (references ?? "<none>"));
    def server = Server(Console.OpenStandardInput(), Console.OpenStandardOutput(), references, root, shortNames, TextWriter.Synchronized(log),
                        typecheck, libraries);
    def code = server.Run();
    log.Flush();
    code
  }

  /// <exe dir>/references, else the newest Microsoft.NETCore.App.Ref pack next to the running runtime.
  DefaultReferences() : string
  {
    def local = Path.Combine(AppContext.BaseDirectory, "references");
    if (Directory.Exists(local)) local
    else
    {
      def runtime = Path.GetDirectoryName(typeof(object).Assembly.Location); // <dotnet>/shared/Microsoft.NETCore.App/<v>
      def root = Directory.GetParent(runtime).Parent.Parent.FullName;
      def packs = Path.Combine(root, "packs", "Microsoft.NETCore.App.Ref");
      if (!Directory.Exists(packs)) null
      else
      {
        def tfm = "net" + Environment.Version.Major.ToString() + ".0";
        def candidates = Directory.GetDirectories(packs).Select(d => Path.Combine(d, "ref", tfm)).Where(Directory.Exists)
                           .OrderByDescending(d => Version.Parse(Path.GetFileName(Path.GetDirectoryName(Path.GetDirectoryName(d))))).ToList();
        if (candidates.Count > 0) candidates[0] else null
      }
    }
  }
}
