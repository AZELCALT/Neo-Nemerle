using System;
using System.IO;
using System.Text;
using System.Text.Json.Nodes;
using Nemerle.Imperative;

/// JSON-RPC over stdio with LSP `Content-Length` framing.
public sealed class Transport
{
  input : Stream;
  output : Stream;
  writeLock : object = object();

  public this(input : Stream, output : Stream) { this.input = input; this.output = output; }

  /// Next message, or null at end of input.
  public Read() : JsonNode
  {
    mutable length = -1;
    mutable reading = true;
    while (reading)
    {
      def line = ReadLine();
      when (line == null) return null;
      if (line.Length == 0) reading = false;
      else when (line.StartsWith("Content-Length:", StringComparison.OrdinalIgnoreCase))
        length = int.Parse(line.Substring("Content-Length:".Length).Trim());
    }
    when (length < 0) return null;
    def body = array(length) : array[byte];
    mutable offset = 0;
    while (offset < length)
    {
      def n = input.Read(body, offset, length - offset);
      when (n <= 0) return null;
      offset += n;
    }
    JsonNode.Parse(Encoding.UTF8.GetString(body))
  }

  ReadLine() : string
  {
    def b = StringBuilder();
    mutable c = input.ReadByte();
    when (c < 0) return null;
    while (c >= 0 && c != '\n' :> int)
    {
      unless (c == '\r' :> int) _ = b.Append(c :> char);
      c = input.ReadByte();
    }
    b.ToString()
  }

  public Write(message : JsonNode) : void
  {
    def body = Encoding.UTF8.GetBytes(message.ToJsonString());
    def header = Encoding.ASCII.GetBytes("Content-Length: " + body.Length.ToString() + "\r\n\r\n");
    lock (writeLock)
    {
      output.Write(header, 0, header.Length);
      output.Write(body, 0, body.Length);
      output.Flush();
    }
  }

  public Respond(id : JsonNode, result : JsonNode) : void
  {
    def m = JsonObject();
    m["jsonrpc"] = JsonValue.Create("2.0");
    m["id"] = id.DeepClone();
    m["result"] = result;
    Write(m)
  }

  public RespondError(id : JsonNode, code : int, text : string) : void
  {
    def m = JsonObject(); def e = JsonObject();
    e["code"] = JsonValue.Create(code); e["message"] = JsonValue.Create(text);
    m["jsonrpc"] = JsonValue.Create("2.0"); m["id"] = id.DeepClone(); m["error"] = e;
    Write(m)
  }

  public Notify(method : string, parameters : JsonNode) : void
  {
    def m = JsonObject();
    m["jsonrpc"] = JsonValue.Create("2.0"); m["method"] = JsonValue.Create(method); m["params"] = parameters;
    Write(m)
  }
}
