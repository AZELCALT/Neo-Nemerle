using System;
using System.IO;
using System.Linq;
using System.Text.Json.Nodes;
using System.Text.RegularExpressions;
using SCG = System.Collections.Generic;
using Nemerle.Collections;
using Nemerle.Imperative;
using transport;
using Nemerle.Compiler.AST;
using Nemerle.Compiler.compilation_options;
using Nemerle.Compiler.manager_class;
using Nemerle.Compiler.Source;
using Nemerle.Compiler.Typedtree;
using Nemerle.Compiler.typer;
using Nemerle.Compiler.type_builder;
using Nemerle.Compiler.type_info;
using Nemerle.Compiler.expr_walker;
using Nemerle.Compiler.project;
using Nemerle.Compiler.Parsetree;
using Nemerle.Compiler.ClassMembers;
using Nemerle.Compiler.namespace_tree;
using Nemerle.Compiler.global_env;
using Nemerle.Compiler.CodeCompletionEngine;
using Nemerle.Compiler.type_var;
using Nemerle.Compiler.fixed_type;
using Nemerle.Compiler.Lexer;
using scripts;
using Nemerle.Compiler.local_value;

/// `nemerle-lsp --check`: one typed compilation of the workspace files an editor needs, in a process of its own (the
/// server starts it, and kills it when a newer edit arrives). It reads a request on stdin and writes the diagnostics,
/// and the facts for hover and go-to-definition, on stdout, as JSON.
///
/// The files are the open ones (with their unsaved text), the files they import (`using`, followed transitively), and
/// every workspace file that exports a type. A script (`.ns`, or a `.n` file that names `DependsOn`) is left out of
/// that compilation: the scripting host compiles each open one on its own (scripts.n).
public module Checker
{
  UsingLine : Regex = Regex(@"^\s*using\s+(?:[A-Za-z_]\w*\s*=\s*)?([A-Za-z_][\w.]*)\s*;", RegexOptions.Multiline);
  ExportLine : Regex = Regex(@"^\s*export\s", RegexOptions.Multiline);
  Skipped : array[string] = array["out", "bin", "obj", "node_modules", ".git"];

  /// The place of the name of the type to rename (path, line, column; 1-based), when the editor gives it.
  /// A signature help request: the completion marker is on the name called.
  public mutable Signature : bool;
  public mutable RenameAtPath : string = null;
  public mutable RenameAtLine : int;
  public mutable RenameAtColumn : int;

  public Run(input : TextReader, output : TextWriter) : int
  {
    def request = JsonNode.Parse(input.ReadToEnd()) :> JsonNode;
    def str(n : JsonNode) { if (n == null) null else n.GetValue.[string]() }
    def root = Path.GetFullPath(str(request["root"]));
    def overlay = SCG.Dictionary.[string, string](StringComparer.Ordinal);
    foreach (f in request.Field("files").AsArray()) overlay[Path.GetFullPath(str(f["path"]))] = str(f["text"]);
    def libraries = if (request["libraries"] is JsonArray) request.Field("libraries").AsArray().Select(l => str(l)).ToList() else SCG.List();
    def flag(name : string) { match (request[name]) { | null => false | v => v.GetValue.[bool]() } }
    // (a type's rename: where its name is, to tell which type of that name it is)
    when (request["renameAt"] != null)
    {
      RenameAtPath = Path.GetFullPath(str(request.Field("renameAt")["path"]));
      RenameAtLine = request.Field("renameAt").Field("line").GetValue.[int]();
      RenameAtColumn = request.Field("renameAt").Field("column").GetValue.[int]()
    }
    // completion: the marker goes where the cursor is, and the typer says what fits there
    mutable completion = null;
    mutable completing = null;
    mutable cursorLine = 0;
    // signature help: the marker goes at the end of the name called, and the typer lists what that name can call
    when (request["signature"] != null) Signature = true;
    when (request["complete"] != null)
    {
      def at = request.Field("complete");
      def path = Path.GetFullPath(str(at["path"]));
      cursorLine = at.Field("line").GetValue.[int]();
      def (text, prefix) = Mark(Text(path, overlay) ?? "", cursorLine, at.Field("column").GetValue.[int]());
      overlay[path] = text;
      completion = prefix; completing = path;
    }
    // a script is checked by the scripting host (scripts.n), a workspace file by the workspace's compilation
    def completingScript = completing != null && Scripts.IsScript(completing, overlay[completing]);
    def checkOnce() : JsonObject
    {
      if (completingScript) Scripts.Check(completing, overlay, completion)
      else Check(root, overlay, str(request["references"]), libraries.NToList(), flag("fileNameNamespaces"), flag("all"), completion,
                 str(request["renameType"]))
    }
    mutable result = checkOnce();
    // an unfinished line elsewhere in the file stops the compiler before the cursor: without the lines its errors are
    // on (blanked, so lines keep their numbers), the typer gets to the cursor
    when (completing != null && (result["completion"] == null || result.Field("completion").AsArray().Count == 0))
    {
      def broken = SCG.HashSet.[int]();
      foreach (d in result.Field("diagnostics").AsArray())
        when (d.Field("severity").GetValue.[int]() == 1 && Path.GetFullPath(str(d["path"])) == completing && d.Field("line").GetValue.[int]() != cursorLine)
          for (mutable l = d.Field("line").GetValue.[int](); l <= d.Field("endLine").GetValue.[int](); l++) when (l != cursorLine) _ = broken.Add(l);
      when (broken.Count > 0)
      {
        def lines = overlay[completing].Split('\n');
        foreach (l when l >= 1 && l <= lines.Length in broken) lines[l - 1] = string(' ', lines[l - 1].Length);
        overlay[completing] = string.Join("\n", lines);
        def retry = checkOnce();
        when (retry["completion"] != null && retry.Field("completion").AsArray().Count > 0) result = retry;
      }
    }
    // the open scripts, which the workspace check leaves out: each compiled by the scripting host, for its diagnostics
    // and the facts of its typed code (hover, go-to-definition)
    when (completing == null && request["renameType"] == null)
      foreach (pair in overlay.ToArray())
        when (Scripts.IsScript(pair.Key, pair.Value))
        {
          def script = Scripts.Check(pair.Key, overlay, null);
          foreach (d in script.Field("diagnostics").AsArray().ToArray()) { _ = script.Field("diagnostics").AsArray().Remove(d); result.Field("diagnostics").AsArray().Add(d) }
          foreach (f in script.Field("facts").AsArray().ToArray()) { _ = script.Field("facts").AsArray().Remove(f); result.Field("facts").AsArray().Add(f) }
        }
    output.Write(result.ToJsonString());
    output.Flush();
    0
  }

  /// The text with the completion marker at (line, column) (1-based), in place of the identifier there; and the
  /// identifier's part before the cursor (the prefix to complete).
  public Mark(text : string, line : int, column : int) : string * string
  {
    def lines = text.Split('\n');
    if (line < 1 || line > lines.Length) (text, "")
    else
    {
      def l = lines[line - 1];
      def at = Math.Min(Math.Max(column - 1, 0), l.Length);
      def ident(c : char) { char.IsLetterOrDigit(c) || c == '_' }
      mutable start = at; while (start > 0 && ident(l[start - 1])) start--;
      mutable stop = at; while (stop < l.Length && ident(l[stop])) stop++;
      def prefix = l.Substring(start, at - start);
      lines[line - 1] = l.Substring(0, start) + prefix + CompletionManager.Marker + l.Substring(stop);
      (string.Join("\n", lines), prefix)
    }
  }

  Text(path : string, overlay : SCG.Dictionary[string, string]) : string
  {
    mutable text;
    if (overlay.TryGetValue(path, out text)) text else try { File.ReadAllText(path) } catch { | _ => null }
  }

  /// The files to compile: the open files, what they import, and the workspace's exporters.
  public Files(root : string, overlay : SCG.Dictionary[string, string]) : SCG.List[string] { Files(root, overlay, false) }

  /// With `all`, every workspace file (find-references and rename look at the whole workspace).
  public Files(root : string, overlay : SCG.Dictionary[string, string], all : bool) : SCG.List[string]
  {
    def files = SCG.List.[string]();
    def seen = SCG.HashSet.[string](StringComparer.Ordinal);
    def queue = SCG.Queue.[string]();
    def add(path : string) : void
    {
      def text = Text(path, overlay);
      // a script is nscript's, not a module of the workspace: a .ns file, or a .n file run as a script (one that
      // declares its dependencies)
      when (text != null && path.EndsWith(".n", StringComparison.Ordinal) && !Scripts.IsScript(path, text) && seen.Add(path)) { files.Add(path); queue.Enqueue(path) }
    }
    foreach (path in overlay.Keys) when (path.StartsWith(root, StringComparison.Ordinal)) add(path);
    // the workspace's global types are reached without a `using`
    def workspace = try
      {
        Directory.EnumerateFiles(root, "*.n", SearchOption.AllDirectories)
          .Where(p => !Skipped.Any(s => p.Substring(root.Length).Split(Path.DirectorySeparatorChar).Contains(s)))
          .Take(5000).ToList()
      }
      catch { | _ => SCG.List() };
    foreach (path in workspace)
      when (!seen.Contains(path)) { def text = Text(path, overlay); when (text != null && (all || ExportLine.IsMatch(text))) add(path) }
    while (queue.Count > 0)
    {
      def text = Text(queue.Dequeue(), overlay);
      foreach (m is Match in UsingLine.Matches(text))
      {
        def file = Path.Combine(root, m.Groups[1].Value.Replace('.', Path.DirectorySeparatorChar) + ".n");
        when (File.Exists(file) || overlay.ContainsKey(file)) add(file)
      }
    }
    files
  }

  public Check(root : string, overlay : SCG.Dictionary[string, string], references : string, libraries : list[string],
               fileNameNamespaces : bool) : JsonObject
  { Check(root, overlay, references, libraries, fileNameNamespaces, false, null) }

  public Check(root : string, overlay : SCG.Dictionary[string, string], references : string, libraries : list[string],
               fileNameNamespaces : bool, all : bool, completion : string) : JsonObject
  { Check(root, overlay, references, libraries, fileNameNamespaces, all, completion, null) }

  /// `completion` (the prefix at the marker) asks for what can be written at the marker instead of diagnostics;
  /// `renameType` (a type's name) for the places to edit to rename that type of the workspace.
  public Check(root : string, overlay : SCG.Dictionary[string, string], references : string, libraries : list[string],
               fileNameNamespaces : bool, all : bool, completion : string, renameType : string) : JsonObject
  {
    def files = Files(root, overlay, all);
    def diagnostics = JsonArray();
    def facts = JsonArray();
    def result = JsonObject();
    result["files"] = JsonArray(files.Select(f => JsonValue.Create(f) : JsonNode).ToArray());
    result["diagnostics"] = diagnostics; result["facts"] = facts;
    when (files.Count > 0)
    {
      def options = CompilationOptions();
      options.CompileToMemory = true; options.TargetIsSet = true;
      // a project says what it is and what it references (the references its last build resolved, packages included);
      // otherwise a workspace with main.n is a program and its files are a library
      def project = try { if (Project.Find(root) != null) Project.Load(root) else null } catch { | _ => null };
      mutable libraries = libraries;
      if (project != null)
      {
        options.TargetIsLibrary = !project.IsProgram;
        when (project.IsProgram && project.Main != "main.n")
          options.MainClass = (Path.ChangeExtension(project.Main, null) :> string).Replace('/', '.').Replace('\\', '.');
        def resolved = if (File.Exists(project.ReferencesFile)) File.ReadAllLines(project.ReferencesFile).Where(l => l.Length > 0).ToArray()
                       else project.Assemblies.Select(a => Path.GetFullPath(Path.Combine(project.Root, a))).ToArray();
        foreach (r in resolved) when (File.Exists(r)) libraries = r :: libraries;
      }
      else options.TargetIsLibrary = !files.Contains(Path.Combine(root, "main.n"));
      options.OutputFileName = if (options.TargetIsLibrary) "nemerle-lsp-check.dll" else "nemerle-lsp-check.exe";
      options.SourceRoot = root; options.FileNameNamespaces = fileNameNamespaces;
      options.ProgressBar = false; options.ColorMessages = false; options.IgnoreConfusion = true;
      options.TargetReferenceDirectory = references;
      options.ReferencedLibraries = libraries;
      options.Sources = files.Select(f => StringSource(Location.GetFileIndex(f), Text(f, overlay)) : ISource).NToList();
      def completer = if (completion != null) CompletionManager(options, completion, Signature) else null;
      def manager = if (completer != null) completer : ManagerClass else ManagerClass(options);
      def types = SCG.List.[string * string * Location]();
      Instrument(manager, files, overlay, diagnostics, facts, types, true);
      def previous = ManagerClass.Instance;
      try { manager.Run() }
      catch { | e => when (Environment.GetEnvironmentVariable("NEMERLE_CHECK_DEBUG") != null) Console.Error.WriteLine("run: " + e.ToString()) } // the errors were reported; the facts gathered so far still help (and completion stops here)
      finally { ManagerClass.Instance = previous; }
      when (completer != null) { result["completion"] = completer.Items; result["signatures"] = completer.Signatures }
      when (renameType != null) RenameType(manager, files, overlay, facts, types, renameType, result);
      when (completer == null && renameType == null) Imports(manager, files, diagnostics);
    }
    result
  }

  static Unbound : Regex = Regex(@"^unbound (?:type )?name `([A-Za-z_][A-Za-z0-9_]*)'(?!\s+in\s)");

  /// For each name the compilation could not find, what a `using' of which would find it (the code actions offer
  /// them): a namespace with a public type of that name, or a workspace module with a type or function of that name.
  static Imports(manager : ManagerClass, files : SCG.List[string], diagnostics : JsonArray) : void
  {
    def wanted = SCG.Dictionary.[string, SCG.List[string]](StringComparer.Ordinal);
    foreach (d in diagnostics)
    {
      def m = Unbound.Match(d.Field("message").GetValue.[string]());
      when (m.Success && !wanted.ContainsKey(m.Groups[1].Value)) wanted[m.Groups[1].Value] = SCG.List();
    }
    when (wanted.Count > 0)
    {
      def modules = SCG.HashSet.[string](StringComparer.Ordinal);
      foreach (f in files)
      {
        def index = Location.GetFileIndex(f);
        when (manager.FileModuleRegistry.IsModule(index)) _ = modules.Add(manager.FileModuleRegistry.Name(index));
      }
      def add(name : string, from : string) : void { unless (wanted[name].Contains(from)) wanted[name].Add(from) }
      def walk(node : NamespaceTree.Node, path : string, depth : int) : void
      {
        when (depth < 12 && node.Children != null)
          foreach (child in node.Children.Values)
          {
            def name = child.PartName;
            def full = if (path == "") name else path + "." + name;
            match (child.Value)
            {
              | NamespaceTree.TypeInfoCache.NamespaceReference => walk(child, full, depth + 1)
              | NamespaceTree.TypeInfoCache.Cached(ti) when modules.Contains(full) =>
                // a module: its types and its functions
                foreach (n in wanted.Keys.ToArray())
                  when (ti.GetNestedTypes().Exists(t => t.Name == n && t.IsPublic) || ti.LookupMember(n).Exists(m => m.IsStatic && !m.IsPrivate))
                    add(n, full);
                walk(child, full, depth + 1)
              | NamespaceTree.TypeInfoCache.Cached(ti) when wanted.ContainsKey(name) && path != "" && !modules.Contains(path) =>
                when (ti.IsPublic && ti.DeclaringType == null) add(name, path)
              // (a guard would be the last alternative's only)
              | NamespaceTree.TypeInfoCache.NotLoaded(_) | NamespaceTree.TypeInfoCache.NotLoadedList(_) | NamespaceTree.TypeInfoCache.CachedAmbiguous(_) =>
                when (wanted.ContainsKey(name) && path != "" && !modules.Contains(path)) add(name, path)
              | NamespaceTree.TypeInfoCache.No => walk(child, full, depth + 1)
              | _ => ()
            }
          }
      }
      def previous = ManagerClass.Instance;
      ManagerClass.Instance = manager;
      try { walk(manager.NameTree.NamespaceTree, "", 0) } catch { | e => when (Environment.GetEnvironmentVariable("NEMERLE_CHECK_DEBUG") != null) Console.Error.WriteLine("imports: " + e) }
      finally { ManagerClass.Instance = previous }
      foreach (d in diagnostics)
      {
        def m = Unbound.Match(d.Field("message").GetValue.[string]());
        when (m.Success && wanted[m.Groups[1].Value].Count > 0)
        {
          def found = wanted[m.Groups[1].Value].OrderBy(x => x, StringComparer.Ordinal).Take(8);
          d["imports"] = JsonArray(found.Select(x => JsonValue.Create(x) : JsonNode).ToArray());
        }
      }
    }
  }

  static LocalId(decl : LocalValue) : string
  {
    def at = decl.Location;
    "local:" + Location.GetFileName(at.FileIndex) + ":" + at.Line.ToString() + ":" + at.Column.ToString() + ":" + decl.Name
  }

  /// Hooks a compilation for the editor: its diagnostics (with `reportDiagnostics`), the facts of its typed code (for
  /// hover and go-to-definition), and the types `files` declare (into `types`). The workspace check and the check of
  /// a script (scripts.n, whose compilation the scripting host runs) both use it.
  public Instrument(manager : ManagerClass, files : SCG.List[string], overlay : SCG.Dictionary[string, string],
                    diagnostics : JsonArray, facts : JsonArray, types : SCG.List[string * string * Location],
                    reportDiagnostics : bool) : void
  {
    manager.InitOutput(StringWriter());
    def place(node : JsonObject, loc : Location) : void
    {
      node["path"] = JsonValue.Create(Location.GetFileName(loc.FileIndex));
      node["line"] = JsonValue.Create(loc.Line); node["column"] = JsonValue.Create(loc.Column);
      node["endLine"] = JsonValue.Create(loc.EndLine); node["endColumn"] = JsonValue.Create(loc.EndColumn);
    }
    def report(loc : Location, message : string, severity : int) : void
    {
      when (loc.FileIndex > 0 && loc.Line > 0)
      {
        def d = JsonObject(); place(d, loc); d["severity"] = JsonValue.Create(severity); d["message"] = JsonValue.Create(message);
        diagnostics.Add(d);
      }
    }
    when (reportDiagnostics)
    {
      manager.ErrorOccured += fun(loc, msg) { report(loc, msg, 1) };
      manager.WarningOccured += fun(loc, msg) { report(loc, msg, 2) };
    }
    // facts: each typed reference, with its type or member and where that is declared
    // a `using` line holds no code of its own: what is located there is the import's generated initializer call
    def lines = SCG.Dictionary.[string, array[string]]();
    def onUsing(at : Location) : bool
    {
      def path = Location.GetFileName(at.FileIndex);
      mutable text;
      unless (lines.TryGetValue(path, out text)) { text = (Text(path, overlay) ?? "").Split('\n'); lines[path] = text; }
      at.Line <= text.Length && text[at.Line - 1].TrimStart().StartsWith("using ", StringComparison.Ordinal)
    }
    def lineOf(path : string, line : int) : string
    {
      mutable text;
      unless (lines.TryGetValue(path, out text)) { text = (Text(path, overlay) ?? "").Split('\n'); lines[path] = text; }
      if (line >= 1 && line <= text.Length) text[line - 1].TrimEnd('\r') else ""
    }
    // the span of `name` itself in a reference (`p.Width` ends with it, `Square(...)` starts with it) or in a
    // declaration (its first whole-word occurrence on the declaration's line)
    def nameSpan(loc : Location, name : string, declaration : bool) : option[int * int * int]
    {
      def path = Location.GetFileName(loc.FileIndex);
      def word(l : string, from : int) : option[int * int * int]
      {
        def m = Regex.Match(if (from <= l.Length) l.Substring(from) else "", @"(?<![\w])" + Regex.Escape(name) + @"(?![\w])");
        if (m.Success) Some((loc.Line, from + m.Index + 1, from + m.Index + 1 + name.Length)) else None()
      }
      if (name.Length == 0) None()
      else if (declaration) word(lineOf(path, loc.Line), Math.Max(0, loc.Column - 1))
      else
      {
        def last = lineOf(path, loc.EndLine);
        def first = lineOf(path, loc.Line);
        if (loc.EndColumn - 1 <= last.Length && loc.EndColumn - 1 >= name.Length && last.Substring(loc.EndColumn - 1 - name.Length, name.Length) == name)
          Some((loc.EndLine, loc.EndColumn - name.Length, loc.EndColumn))
        else if (loc.Column - 1 + name.Length <= first.Length && first.Substring(loc.Column - 1, name.Length) == name)
          Some((loc.Line, loc.Column, loc.Column + name.Length))
        else None()
      }
    }
    def span(node : JsonObject, prefix : string, s : option[int * int * int]) : void
    {
      | (_, _, Some((l, c, e))) => node[prefix + "Line"] = JsonValue.Create(l); node[prefix + "Column"] = JsonValue.Create(c); node[prefix + "EndColumn"] = JsonValue.Create(e)
      | _ => ()
    }
    // `id': what the fact refers to, the same in every file and across edits (a member by its owner, name and
    // signature; a local by where it is declared, as it is only seen in its file), the key of the server's index
    def fact(at : Location, hover : string, target : Location, name : string, kind : string, id : string) : void
    {
      // (not of what the compiler made: a `$"..."' string's parts, an async function's state machine)
      when (at.FileIndex > 0 && at.Line > 0 && !at.IsGenerated && files.Contains(Location.GetFileName(at.FileIndex)) && !onUsing(at)
            && !name.StartsWith("_N_", StringComparison.Ordinal))
      {
        def f = JsonObject(); place(f, at); f["hover"] = JsonValue.Create(hover);
        f["name"] = JsonValue.Create(name); f["kind"] = JsonValue.Create(kind); f["id"] = JsonValue.Create(id);
        span(f, "name", nameSpan(at, name, false));
        when (target.FileIndex > 0 && target.Line > 0 && target.IsSourceAvailable)
        {
          def t = JsonObject(); place(t, target);
          span(t, "name", nameSpan(target, name, true));
          f["target"] = t;
        }
        facts.Add(f);
      }
    }
    def member(at : Location, m : IMember, ty : object) : void
    {
      def owner = if (m.DeclaringType != null) m.DeclaringType.FullName else "";
      def shown = if (ty != null) ty.ToString() else m.GetMemType().ToString();
      if (m.Name == ".ctor")
      {
        // a constructor without source of its own (the default one) leads to its type
        def target = if (m.Location.Line > 0 && !m.Location.IsGenerated || m.DeclaringType == null) m.Location else m.DeclaringType.Location;
        def parameters = if (shown.Contains(" -> ")) shown.Substring(0, shown.LastIndexOf(" -> ")) else "";
        fact(at, owner + "(" + (if (parameters == "void") "" else parameters) + ")", target, if (m.DeclaringType != null) m.DeclaringType.Name else "", "constructor",
             "ctor:" + owner + "(" + m.GetMemType().ToString() + ")")
      }
      else
      {
        // a member's declaration is named where its name is (its whole span starts at its modifiers)
        // (a generated member, as a top-level value's field, has no declaration of its own: NameLocation throws)
        def nameLocation(b : MemberBuilder) { try { b.NameLocation } catch { | _ => Location.Default } }
        def declared = match (m) { | b is MemberBuilder when nameLocation(b).Line > 0 => nameLocation(b) | _ => m.Location };
        def kind = match (m.MemberKind) { | MemberKinds.Field => "field" | MemberKinds.Property => "property" | MemberKinds.Event => "event" | _ => "method" };
        fact(at, (if (owner != "") owner + "." else "") + m.Name + " : " + shown, declared, m.Name, kind,
             kind + ":" + owner + "::" + m.Name + (if (kind == "method") ":" + m.GetMemType().ToString() else ""))
      }
    }
    def walk(body : TExpr) : void
    {
      ExprWalker().Walk(body, info =>
        match (info.Node)
        {
          // (a parameter's kind is its own: the editor colours it as one)
          | TExpr.LocalRef(decl) as e =>
            fact(e.Location, decl.Name + " : " + e.Type.ToString(), decl.Location, decl.Name,
                 if (decl.ValKind is LocalValue.Kind.FunParm) "parameter" else "local", LocalId(decl))
          // where a local is declared: its name there is the local too (hover, rename)
          | TExpr.DefValIn(decl, _, _) when decl.NameLocation.Line > 0 && decl.Type != null =>
            fact(decl.NameLocation, decl.Name + " : " + decl.Type.ToString(), decl.Location, decl.Name, "local", LocalId(decl))
          | TExpr.LocalFunRef(decl, _) as e => fact(e.Location, decl.Name + " : " + e.Type.ToString(), decl.Location, decl.Name, "function", LocalId(decl))
          | TExpr.StaticRef(_, m, _) as e => member(e.Location, m, e.Type)
          | TExpr.FieldMember(_, f) as e => member(e.Location, f, e.Type)
          | TExpr.PropertyMember(_, p) as e => member(e.Location, p, e.Type)
          | TExpr.MethodRef(_, m, _, _) as e => member(e.Location, m, e.Type)
          | TExpr.EventMember(_, ev) as e => member(e.Location, ev, e.Type)
          | _ => ()
        });
    }
    // the workspace's types (the compiler clears its type tree at the end of a run)
    manager.TypeTreeBuildFinish += fun(_)
    {
      try
        manager.Hierarchy.Iter(tb =>
          when (tb.Location.FileIndex > 0 && files.Contains(Location.GetFileName(tb.Location.FileIndex))
                && !manager.FileModuleRegistry.Usings.Contains(tb.FullName))
            types.Add((tb.Name, tb.FullName, tb.Location)))
      catch { | e => when (Environment.GetEnvironmentVariable("NEMERLE_CHECK_DEBUG") != null) Console.Error.WriteLine("types: " + e.ToString()) }
      when (Environment.GetEnvironmentVariable("NEMERLE_CHECK_DEBUG") != null) Console.Error.WriteLine("types: " + string.Join(", ", types.Select(x => { def (n, f, _) = x; n + "=" + f }).ToArray()));
      // a member's declaration is a fact too, where its name is (hover and go-to-definition there, and its place among
      // the references): a method's when it is typed, the type's fields and properties with its first one
      def declarations = SCG.HashSet.[string]();
      def declaration(m : IMember) : void
      {
        match (m)
        {
          | b is MemberBuilder when !b.Name.StartsWith("_N_", StringComparison.Ordinal) =>
            // (where its name is: its NameLocation, or the name's first place in its declaration, as a file's function
            // has no NameLocation)
            def named = try { b.NameLocation } catch { | _ => Location.Default };
            def at = if (named.Line > 0) named
                     else match (if (b.Location.FileIndex > 0 && b.Location.Line > 0) nameSpan(b.Location, b.Name, true) else None())
                     {
                       | Some((line, column, end)) => Location(b.Location.FileIndex, line, column, line, end)
                       | None => Location.Default
                     };
            when (at.Line > 0 && !at.IsGenerated && declarations.Add(b.DeclaringType.FullName + "::" + b.Name + "@" + at.ToString()))
              try { member(at, b, null) } catch { | _ => () }
          | _ => ()
        }
      }
      manager.Hierarchy.Iter(tb => tb.MethodBeforeStage2 += fun(_, args)
        {
          def method = args.Typer.CurrentMethodBuilder;
          when (method != null && args.Typer.CurrentFunction.decl == null)
          {
            declaration(method);
            when (declarations.Add("type:" + tb.FullName))
              foreach (m in tb.GetDirectMembers())
                when (m.MemberKind == MemberKinds.Field || m.MemberKind == MemberKinds.Property || m.MemberKind == MemberKinds.Event) declaration(m)
          }
          match (args.Typer.CurrentFunction.Body)
          {
            | FunBody.Typed(body) => try { walk(body) } catch { | e => when (Environment.GetEnvironmentVariable("NEMERLE_CHECK_DEBUG") != null) Console.Error.WriteLine("walk: " + e.ToString()) }
            | _ => ()
          }
        });
    };
  }

  /// The places to edit to rename the workspace type `name`: every identifier token with its name in the workspace's
  /// files (the compiler's lexer: not strings or comments), except those a fact shows to be something else (a local,
  /// a member of that name). Only a type whose name is unique, in the workspace and among the referenced libraries'
  /// types, is renamed this way; otherwise the reason is given.
  RenameType(manager : ManagerClass, files : SCG.List[string], overlay : SCG.Dictionary[string, string], facts : JsonArray,
             types : SCG.List[string * string * Location], name : string, result : JsonObject) : void
  {
    // the workspace's types of that name (not the classes of the files themselves)
    def declared = SCG.List.[string]();
    foreach ((n, full, _) in types) when (n == name) declared.Add(full);
    _ = files;
    def refuse(why : string) : void { result["typeRenameError"] = JsonValue.Create(why) }
    // what an identifier of that name means where it is: the type its file sees by that name (or path, `a.b.Name'), from
    // the type it is written in; the rename edits the names that mean the type at the editor's place
    // (a file's, after its `using's, as its members are typed in)
    def env(fileIndex : int) : GlobalEnv
    {
      mutable after;
      if (manager.FileModuleRegistry.MemberEnvironments.TryGetValue(fileIndex, out after)) after
      else if (manager.FileModuleRegistry.IsModule(fileIndex)) manager.FileModuleRegistry.Environment(fileIndex)
      else manager.CoreEnv
    }
    def enclosing(at : Location) : TypeBuilder
    {
      mutable best = null; mutable size = int.MaxValue;
      foreach ((_, full, loc) in types)
        when (loc.FileIndex == at.FileIndex && loc.Contains(at) && loc.EndLine - loc.Line < size)
          match (manager.CoreEnv.LookupType(NList.FromArray(full.Split('.'))))
          {
            | Some(tb is TypeBuilder) => best = tb; size = loc.EndLine - loc.Line
            | _ => ()
          }
      when (best == null && manager.FileModuleRegistry.IsModule(at.FileIndex))
        match (manager.CoreEnv.LookupType(NList.FromArray(manager.FileModuleRegistry.Name(at.FileIndex).Split('.'))))
        {
          | Some(tb is TypeBuilder) => best = tb
          | _ => ()
        }
      best
    }
    def meaning(path : list[string], at : Location) : string
    {
      def previous = ManagerClass.Instance;
      ManagerClass.Instance = manager;
      try
      {
        def from = enclosing(at);
        // (in a type of the file: that type's environment)
        def scope = if (from != null && from.DeclaringType != null) from.GlobalEnv else env(at.FileIndex);
        def r = match (scope.LookupType(path, from, -1))
        {
          | Some(ti) => ti.FullName
          | None => null
        };
        r
      }
      catch { | _ => null }
      finally { ManagerClass.Instance = previous }
    }
    // the identifiers of that name in a file, each with the path it ends (`a.b.Name')
    def named(path : string) : list[list[string] * Location]
    {
      mutable found = [];
      def text = Text(path, overlay);
      when (text != null && text.Contains(name))
      {
        def previous = ManagerClass.Instance;
        ManagerClass.Instance = manager;
        try
        {
          def fileIndex = Location.GetFileIndex(path);
          def lexer = LexerString(manager, text, Location(fileIndex, 1, 1));
          lexer.Keywords = env(fileIndex).Keywords;
          mutable chain = [];
          mutable dotted = false;
          mutable token : Token = lexer.GetToken();
          while (!(token is Token.EndOfFile))
          {
            match (token)
            {
              | Token.Identifier(id) =>
                chain = if (dotted) chain + [id] else [id];
                dotted = false;
                when (id == name) found ::= (chain, token.Location)
              | Token.Operator(".") when !chain.IsEmpty => dotted = true
              | _ => chain = []; dotted = false
            }
            token = lexer.GetToken();
          }
        }
        catch { | e => when (Environment.GetEnvironmentVariable("NEMERLE_CHECK_DEBUG") != null) Console.Error.WriteLine("lex " + path + ": " + e.ToString()) }
        finally { ManagerClass.Instance = previous }
      }
      found.Rev()
    }
    // the type meant at the editor's place, when it gives one
    def target =
      if (RenameAtPath == null) null
      else match (named(RenameAtPath).Find(x => x[1].Line == RenameAtLine && x[1].Column <= RenameAtColumn && RenameAtColumn <= x[1].Column + name.Length))
      {
        | Some((chain, loc)) => meaning(chain, loc)
        | None => null
      };
    if (target != null && declared.Contains(target))
    {
      // what facts show is something else of that name (a local, a member)
      def others = SCG.HashSet.[string]();
      foreach (f in facts)
        when (f["name"] != null && f.Field("name").GetValue.[string]() == name && f.Field("kind").GetValue.[string]() != "constructor" && f["nameLine"] != null)
          _ = others.Add(f.Field("path").GetValue.[string]() + ":" + f.Field("nameLine").GetValue.[int]().ToString() + ":" + f.Field("nameColumn").GetValue.[int]().ToString());
      def spans = JsonArray();
      foreach (path in files)
        foreach ((chain, at) in named(path))
          when (!others.Contains(path + ":" + at.Line.ToString() + ":" + at.Column.ToString()) && meaning(chain, at) == target)
          {
            def s = JsonObject();
            s["path"] = JsonValue.Create(path); s["line"] = JsonValue.Create(at.Line);
            s["column"] = JsonValue.Create(at.Column); s["endColumn"] = JsonValue.Create(at.Column + name.Length);
            spans.Add(s);
          }
      result["typeRename"] = spans;
    }
    else if (declared.Count == 0) ()   // not a type of the workspace: nothing to say
    else if (declared.Count > 1)
      refuse("`" + name + "' names " + declared.Count.ToString() + " types in the workspace (" + string.Join(", ", declared.ToArray()) + "); rename them by hand")
    else
    {
      // a type of a referenced library with that short name: its uses could not be told apart by name
      mutable clash = null;
      def walk(node : NamespaceTree.Node, depth : int) : void
      {
        when (clash == null && depth < 12 && node.Children != null)
          foreach (child in node.Children.Values)
          {
            match (child.Value)
            {
              | NamespaceTree.TypeInfoCache.Cached(ti) when ti.Name == name && !(ti is TypeBuilder) && !declared.Contains(ti.FullName) => clash = ti.FullName
              | NamespaceTree.TypeInfoCache.NotLoaded(e) when e.SystemType.Name == name => clash = e.SystemType.FullName
              | _ => ()
            }
            walk(child, depth + 1)
          }
      }
      try { walk(manager.NameTree.NamespaceTree, 0) } catch { | _ => () }
      if (clash != null) refuse("`" + name + "' is also the name of " + clash + " in a referenced library; rename it by hand")
      else
      {
        // what facts show is something else of that name (a local, a member)
        def others = SCG.HashSet.[string]();
        foreach (f in facts)
          when (f["name"] != null && f.Field("name").GetValue.[string]() == name && f.Field("kind").GetValue.[string]() != "constructor" && f["nameLine"] != null)
            _ = others.Add(f.Field("path").GetValue.[string]() + ":" + f.Field("nameLine").GetValue.[int]().ToString() + ":" + f.Field("nameColumn").GetValue.[int]().ToString());
        def spans = JsonArray();
        def previous = ManagerClass.Instance;
        ManagerClass.Instance = manager;
        try
          foreach (path in files)
          {
            def text = Text(path, overlay);
            when (text != null && text.Contains(name))
              try
              {
                def fileIndex = Location.GetFileIndex(path);
                def lexer = LexerString(manager, text, Location(fileIndex, 1, 1));
                lexer.Keywords = if (manager.FileModuleRegistry.IsModule(fileIndex)) manager.FileModuleRegistry.Environment(fileIndex).Keywords else manager.CoreEnv.Keywords;
                mutable token : Token = lexer.GetToken();
                while (!(token is Token.EndOfFile))
                {
                  match (token)
                  {
                    | Token.Identifier(id) when id == name =>
                      def at = token.Location;
                      unless (others.Contains(path + ":" + at.Line.ToString() + ":" + at.Column.ToString()))
                      {
                        def s = JsonObject();
                        s["path"] = JsonValue.Create(path); s["line"] = JsonValue.Create(at.Line);
                        s["column"] = JsonValue.Create(at.Column); s["endColumn"] = JsonValue.Create(at.Column + name.Length);
                        spans.Add(s);
                      }
                    | _ => ()
                  }
                  token = lexer.GetToken();
                }
              }
              catch { | e => when (Environment.GetEnvironmentVariable("NEMERLE_CHECK_DEBUG") != null) Console.Error.WriteLine("lex " + path + ": " + e.ToString()) }
          }
        finally { ManagerClass.Instance = previous; }
        result["typeRename"] = spans;
      }
    }
  }
}

/// A compiler manager that answers code completion. The marker (an identifier the checker writes at the cursor) is
/// typed like any name; when the typer reaches it, `Complete` lists what fits there from the typer's own view: the
/// members of the object's type after a dot (or the types, namespaces and static members of a type or namespace
/// path), else the locals in scope, the current type's members, and the types and namespaces opened there.
public sealed class CompletionManager : ManagerClass
{
  public static Marker : string = "__nemerle_complete__";
  /// What was found: [{label, kind (LSP CompletionItemKind), detail}].
  public Items : JsonArray = JsonArray();
  prefix : string;
  mutable done : bool;
  /// Signature help: what the name at the marker (the whole of it, `prefix') can call, each with its parameters.
  signature : bool;
  public Signatures : JsonArray = JsonArray();

  public this(options : CompilationOptions, prefix : string, signature : bool = false)
  {
    base(options);
    this.prefix = prefix;
    this.signature = signature;
    _isIntelliSenseMode = true;
    _isCompletionInProgress = true;
  }

  public class Found : Exception { }

  protected override CompletePattern(_ : PExpr, _ : TypeVar, _ : Typer.PatternTyper, _ : GlobalEnv) : void { }
  protected override IsExtensionMethod(_ : IMethod, _ : TypeVar) : bool { false }

  Keywords : array[string] = array["def", "mutable", "if", "else", "when", "unless", "match", "foreach", "for", "while", "do",
    "async", "await", "yield",
    "using", "fun", "true", "false", "null", "this", "base", "try", "catch", "finally", "throw", "is", "as", "in", "with",
    "public", "private", "protected", "internal", "static", "class", "struct", "variant", "interface", "module", "mask",
    "export", "extend", "macro", "syntax", "grammar", "space", "scope", "dial", "lock", "typeof", "array", "list", "option", "void"];

  protected override Complete(expression : PExpr, _ : TypeVar, typer : Typer, env : GlobalEnv) : TExpr
  {
    def marked(n : Name) { !done && n.Id.EndsWith(Marker, StringComparison.Ordinal) }
    match (expression)
    {
      | PExpr.Member(obj, Splicable.Name(n)) when marked(n) && signature => done = true; CalledMember(obj, typer, env); throw Found()
      | PExpr.Ref(n) when marked(n) && signature => done = true; CalledName(typer, env); throw Found()
      | PExpr.Member(obj, Splicable.Name(n)) when marked(n) => done = true; AfterDot(obj, n, typer, env); throw Found()
      | PExpr.Ref(n) when marked(n) => done = true; Names(n, typer, env); throw Found()
      | _ => null
    }
  }

  // ---- signature help ----

  /// One callable: its label (`Name(a : int, b : string) : bool'), with its parameters'.
  AddSignature(name : string, parameters : list[string * string], returned : string) : void
  {
    def shown = parameters.Map(p => if (p[0] == null || p[0] == "") p[1] else p[0] + " : " + p[1]);
    def label = name + "(" + string.Join(", ", shown) + ")" + (if (returned == null) "" else " : " + returned);
    unless (Signatures.Any(s => s.Field("label").GetValue.[string]() == label))
    {
      def item = JsonObject(); item["label"] = JsonValue.Create(label);
      def ps = JsonArray(); foreach (p in shown) { def x = JsonObject(); x["label"] = JsonValue.Create(p); ps.Add(x) }
      item["parameters"] = ps;
      Signatures.Add(item);
    }
  }

  /// A method's (or constructor's) parameters and result.
  Method(name : string, m : IMethod) : void
  {
    def header = try { m.GetHeader() } catch { | _ => null };
    def parameters = if (header != null) header.Parameters.Map(p => (p.Name, p.Type.ToString())) else [];
    def returned = if (m.MemberKind == MemberKinds.Constructor) null else try { m.ReturnType.ToString() } catch { | _ => null };
    AddSignature(name, parameters, returned)
  }

  /// What a type's members of the name can call (its constructors for a nested type of the name).
  Callable(ti : TypeInfo, instance : bool) : void
  {
    foreach (m in (try { ti.LookupMember(prefix) } catch { | _ => [] }))
      match (m)
      {
        | method is IMethod when instance != method.IsStatic || !instance => Method(prefix, method)
        | nested is TypeInfo => Constructors(nested)
        | _ => ()
      }
  }

  Constructors(ti : TypeInfo) : void
  {
    foreach (c is IMethod in (try { ti.GetConstructors(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance) } catch { | _ => [] }))
      Method(ti.Name, c)
  }

  CalledMember(obj : PExpr, typer : Typer, env : GlobalEnv) : void
  {
    // a type's (or a namespace's) path: its static members of the name, or a type of the name in it
    match (match (Path(obj)) { | null => None() | path => try { env.LookupType(path) } catch { | _ => None() } })
    {
      | Some(ti) => Callable(ti, false)
      | None =>
        match (match (Path(obj)) { | null => None() | path => try { env.LookupType(path + [prefix]) } catch { | _ => None() } })
        {
          | Some(ti) => Constructors(ti)
          | None =>
            try
            {
              match (typer.TypeExpr(obj).Type.Hint)
              {
                | Some(FixedType.Class(ti, _)) => Callable(ti, true)
                | _ => ()
              }
            }
            catch { | _ is Found => throw Found() | _ => () }
        }
    }
  }

  CalledName(typer : Typer, env : GlobalEnv) : void
  {
    // a local function (its parameters' names), or a local holding a function value (its type's)
    try
      foreach ((_, v) in typer.CurrentLocalContext.GetLocals())
        when (v.Name == prefix)
          match (v.ValKind)
          {
            | LocalValue.Kind.Function(header, _) => AddSignature(prefix, header.Parameters.Map(p => (p.Name, p.Type.ToString())), header.ReturnType.ToString())
            | _ =>
              match (v.Type.Hint)
              {
                | Some(FixedType.Fun(from, to)) =>
                  def parameters = match (from.Hint) { | Some(FixedType.Tuple(args)) => args.Map(a => (null, a.ToString())) | Some(FixedType.Void) => [] | _ => [(null, from.ToString())] };
                  AddSignature(prefix, parameters, to.ToString())
                | _ => ()
              }
          }
    catch { | _ => () }
    // the current type's functions of the name (a file's), then a type of the name (its constructors)
    def current = typer.CurrentTypeBuilder;
    when (current != null) { Callable(current, true); Callable(current, false) }
    match (try { env.LookupType([prefix]) } catch { | _ => None() })
    {
      | Some(ti) => Constructors(ti)
      | None => ()
    }
  }

  seen : SCG.HashSet[string] = SCG.HashSet();

  Add(label : string, kind : int, detail : string) : void
  {
    when (!label.Contains(Marker) && !label.StartsWith("_N_", StringComparison.Ordinal) && Completion.MatchName(label, prefix) && seen.Add(label + "/" + kind.ToString()))
    {
      def item = JsonObject();
      item["label"] = JsonValue.Create(label); item["kind"] = JsonValue.Create(kind);
      when (detail != null) item["detail"] = JsonValue.Create(detail);
      Items.Add(item);
    }
  }

  static Hidden(name : string) : bool
  {
    name.StartsWith("get_", StringComparison.Ordinal) || name.StartsWith("set_", StringComparison.Ordinal)
    || name.StartsWith("add_", StringComparison.Ordinal) || name.StartsWith("remove_", StringComparison.Ordinal)
    || name.StartsWith("op_", StringComparison.Ordinal) || name.StartsWith(".", StringComparison.Ordinal) || name.StartsWith("_N_", StringComparison.Ordinal)
  }

  Members(ti : TypeInfo, instance : bool, all : bool) : void
  {
    def flags = System.Reflection.BindingFlags.Public
              | (if (all) System.Reflection.BindingFlags.NonPublic else System.Reflection.BindingFlags.Default)
              | (if (instance) System.Reflection.BindingFlags.Instance else System.Reflection.BindingFlags.Static | System.Reflection.BindingFlags.FlattenHierarchy);
    foreach (m in (try { ti.GetMembers(flags) } catch { | _ => [] }))
      // System.Object's statics (ReferenceEquals, Equals) come with every type's: they are noise there
      unless (Hidden(m.Name) || !instance && m.DeclaringType != null && m.DeclaringType.FullName == "System.Object")
      {
        def kind = match (m.MemberKind)
        {
          | MemberKinds.Method => 2 | MemberKinds.Field => 5 | MemberKinds.Property => 10 | MemberKinds.Event => 23
          | MemberKinds.NestedType => 7 | _ => 1
        };
        Add(m.Name, kind, try { m.GetMemType().ToString() } catch { | _ => null })
      }
  }

  Nodes(elems : SCG.List[Elem]) : void
  {
    foreach (e in elems)
      match (e)
      {
        | Elem.Node(name, node) =>
          def kind = match (node.Value) { | NamespaceTree.TypeInfoCache.Cached(_) | NamespaceTree.TypeInfoCache.NotLoaded(_) => 7 | _ => 9 };
          Add(name, kind, node.GetDisplayName())
        | Elem.Member(m) => Add(m.Name, 2, null)
        | Elem.Simple(name, info, _) => Add(name, 7, info)
        | Elem.Local(v) => Add(v.Name, 6, v.Type.ToString())
        | _ => ()
      }
  }

  static Path(e : PExpr) : list[string]
  {
    match (e)
    {
      | PExpr.Ref(n) => [n.Id]
      | PExpr.Member(o, Splicable.Name(n)) => match (Path(o)) { | null => null | p => p + [n.Id] }
      | _ => null
    }
  }

  AfterDot(obj : PExpr, name : Name, typer : Typer, env : GlobalEnv) : void
  {
    def current = typer.CurrentTypeBuilder;
    // a type or namespace path: its types, namespaces and static members
    def path = Path(obj);
    mutable asType = false;
    when (path != null)
    {
      match (try { env.LookupType(path) } catch { | _ => None() })
      {
        | Some(ti) => asType = true; Members(ti, false, ti.Equals(current))
        | None => ()
      }
      def elems = SCG.List();
      try { Completion.AddTypesAndNamespaces(elems, env.NameTree.NamespaceTree :: env.OpenNamespaces, obj, Name(prefix), true, true) } catch { | _ => () }
      Nodes(elems);
    }
    // a value: its type's members
    unless (asType)
      try
      {
        def typed = typer.TypeExpr(obj);
        match (typed.Type.Hint)
        {
          | Some(FixedType.Class(ti, _)) => Members(ti, true, ti.Equals(current))
          | Some(FixedType.Array) => Members(InternalType.Array_tc, true, false)
          | _ => ()
        }
      }
      catch { | _ is Found => throw Found() | _ => () }
  }

  Names(_ : Name, typer : Typer, env : GlobalEnv) : void
  {
    // the locals in scope
    try { foreach ((_, v) in typer.CurrentLocalContext.GetLocals()) Add(v.Name, 6, v.Type.ToString()) } catch { | _ => () }
    // the current type's members (a file's functions and top-level state)
    def current = typer.CurrentTypeBuilder;
    when (current != null) { Members(current, true, true); Members(current, false, true) }
    // the types, namespaces and members the environment opens (`using`)
    def elems = SCG.List();
    try { Completion.AddTypesAndNamespaces(elems, env.NameTree.NamespaceTree :: env.OpenNamespaces, null, Name(prefix), true, false) } catch { | _ => () }
    Nodes(elems);
    foreach (k in Keywords) Add(k, 14, null);
  }
}
