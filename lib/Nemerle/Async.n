// The runtime of `async' functions (see doc/book/src/12-dotnet.md). BSD-3-Clause, as all of lib/.
using System;
using System.Collections.Generic;
using System.Runtime.CompilerServices;
using System.Threading.Tasks;

/// Runs the body of an `async' function, as the C# compiler's code does: the body is an iterator (the state machine
/// `yield' makes), driven by the runtime's AsyncTaskMethodBuilder. An `await' whose awaiter has not completed hands
/// the awaiter to AwaitUnsafe (or AwaitSafe), by reference and with its own type, and yields; the builder resumes the
/// body when it completes (on the awaiter's context, as the awaiter decides). The body ends by setting Result. A body
/// that never waits completes its task at once, and allocates no other task.
public sealed class AsyncDriver[T] : IAsyncStateMachine
{
  mutable builder : AsyncTaskMethodBuilder[T];
  mutable steps : IEnumerator[object];

  /// The value the body ends with.
  public mutable Result : T;

  /// Starts the body (synchronously, up to its first `await' that has to wait) and returns its Task.
  public Run(body : IEnumerable[object]) : Task[T]
  {
    builder = AsyncTaskMethodBuilder.[T].Create();
    steps = body.GetEnumerator();
    mutable machine = this;
    builder.Start(ref machine);
    builder.Task
  }

  /// Starts the body of an async function that returns no Task (an event handler's): an exception it ends with
  /// is thrown on the thread pool, where it ends the process unless handled, as in C#.
  public RunAndForget(body : IEnumerable[object]) : void
  {
    AsyncVoid.Forget(Run(body))
  }

  /// Runs the body to its next wait, or to its end.
#if !NETSTANDARD2_0
  [System.Diagnostics.StackTraceHidden]   // (the runtime's plumbing, as C#'s builders: a stack trace shows the async functions)
#endif
  public MoveNext() : void
  {
    try
    {
      unless (steps.MoveNext())
      {
        steps.Dispose();
        builder.SetResult(Result)
      }
    }
    catch { | e => steps.Dispose(); builder.SetException(e) }   // (an OperationCanceledException cancels the task)
  }

  /// The body waits for `awaiter': the builder resumes it when it completes.
  public AwaitUnsafe[A](awaiter : ref A) : void where A : ICriticalNotifyCompletion
  {
    mutable machine = this;
    builder.AwaitUnsafeOnCompleted(ref awaiter, ref machine)
  }

  /// As AwaitUnsafe, for an awaiter that is only an INotifyCompletion.
  public AwaitSafe[A](awaiter : ref A) : void where A : INotifyCompletion
  {
    mutable machine = this;
    builder.AwaitOnCompleted(ref awaiter, ref machine)
  }

  public SetStateMachine(machine : IAsyncStateMachine) : void { builder.SetStateMachine(machine) }
}

/// What the body of an async function calls where its state machine is a struct (as C#'s: the compiler makes it,
/// see Typer3): these calls become calls on the struct itself, which has the builder. They are never run as they are.
public module Machine
{
  /// Never true: `when (Machine.Never) yield null' makes a body that never waits an iterator all the same.
  public Never : bool = false;

  /// The body waits for `awaiter' (the struct hands it, and itself, to its builder): what its `yield' yields, so the
  /// struct has its next state when the builder copies it.
  public AwaitUnsafe[A](_awaiter : ref A) : object where A : ICriticalNotifyCompletion { throw InvalidOperationException("Machine.AwaitUnsafe runs in a state machine only") }

  /// As AwaitUnsafe, for an awaiter that is only an INotifyCompletion.
  public AwaitSafe[A](_awaiter : ref A) : object where A : INotifyCompletion { throw InvalidOperationException("Machine.AwaitSafe runs in a state machine only") }

  /// The value the body ends with: its task's result.
  public Return[T](_value : T) : void { throw InvalidOperationException("Machine.Return runs in a state machine only") }

  /// An async stream's `yield x': the item is the stream's Current, and MoveNextAsync completes with true.
  public Produce[T](_item : T) : object { throw InvalidOperationException("Machine.Produce runs in a state machine only") }

  /// Whether an async stream is being disposed of before its end (DisposeAsync resumed it after a `yield'): it then
  /// leaves through its `finally' blocks, as C#'s does.
  public Disposing() : bool { throw InvalidOperationException("Machine.Disposing runs in a state machine only") }

  /// An async stream's [EnumeratorCancellation] parameter: `origin' (what the stream was made with) combined with the
  /// token it is enumerated with.
  public Token(_origin : System.Threading.CancellationToken) : System.Threading.CancellationToken { throw InvalidOperationException("Machine.Token runs in a state machine only") }
}

/// What an async stream disposed of before its end throws where it resumes: it runs the stream's `finally' blocks (no
/// `catch' sees it), and its state machine ends the enumeration when it gets it.
public sealed class StreamDisposed : Exception
{
  public this() { base("the async stream is disposed of") }
}

/// An async lambda run where a `void' delegate is wanted (an event handler, as C#'s `async void'): nothing waits for its
/// task, so what it ends with is thrown on the thread pool, where it ends the process unless handled.
public module AsyncVoid
{
  public Forget(task : Task) : void
  {
    _ = task.ContinueWith(fun (t : Task) : void
      {
        when (t.IsFaulted)
        {
          def error = System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture((t.Exception :> System.AggregateException).InnerException);
          System.Threading.ThreadPool.QueueUserWorkItem(_ => error.Throw())
        }
      }, TaskContinuationOptions.ExecuteSynchronously)
  }
}

#if !NETSTANDARD2_0   // (.NET Standard 2.0 has no ValueTask builders)
/// As AsyncDriver, for an async function that returns ValueTask[T]: one that never waits completes with its value and
/// allocates nothing (AsyncValueTaskMethodBuilder).
public sealed class AsyncValueDriver[T] : IAsyncStateMachine
{
  mutable builder : AsyncValueTaskMethodBuilder[T];
  mutable steps : IEnumerator[object];
  public mutable Result : T;

  public Run(body : IEnumerable[object]) : ValueTask[T]
  {
    builder = AsyncValueTaskMethodBuilder.[T].Create();
    steps = body.GetEnumerator();
    mutable machine = this;
    builder.Start(ref machine);
    builder.Task
  }

#if !NETSTANDARD2_0
  [System.Diagnostics.StackTraceHidden]   // (the runtime's plumbing, as C#'s builders: a stack trace shows the async functions)
#endif
  public MoveNext() : void
  {
    try
    {
      unless (steps.MoveNext())
      {
        steps.Dispose();
        builder.SetResult(Result)
      }
    }
    catch { | e => steps.Dispose(); builder.SetException(e) }
  }

  public AwaitUnsafe[A](awaiter : ref A) : void where A : ICriticalNotifyCompletion
  {
    mutable machine = this;
    builder.AwaitUnsafeOnCompleted(ref awaiter, ref machine)
  }

  public AwaitSafe[A](awaiter : ref A) : void where A : INotifyCompletion
  {
    mutable machine = this;
    builder.AwaitOnCompleted(ref awaiter, ref machine)
  }

  public SetStateMachine(machine : IAsyncStateMachine) : void { builder.SetStateMachine(machine) }
}

/// As AsyncValueDriver, for an async function that returns ValueTask.
public sealed class AsyncValueVoidDriver : IAsyncStateMachine
{
  mutable builder : AsyncValueTaskMethodBuilder;
  mutable steps : IEnumerator[object];
  /// (unused: the body has no value)
  public mutable Result : object;

  public Run(body : IEnumerable[object]) : ValueTask
  {
    builder = AsyncValueTaskMethodBuilder.Create();
    steps = body.GetEnumerator();
    mutable machine = this;
    builder.Start(ref machine);
    builder.Task
  }

#if !NETSTANDARD2_0
  [System.Diagnostics.StackTraceHidden]   // (the runtime's plumbing, as C#'s builders: a stack trace shows the async functions)
#endif
  public MoveNext() : void
  {
    try
    {
      unless (steps.MoveNext())
      {
        steps.Dispose();
        builder.SetResult()
      }
    }
    catch { | e => steps.Dispose(); builder.SetException(e) }
  }

  public AwaitUnsafe[A](awaiter : ref A) : void where A : ICriticalNotifyCompletion
  {
    mutable machine = this;
    builder.AwaitUnsafeOnCompleted(ref awaiter, ref machine)
  }

  public AwaitSafe[A](awaiter : ref A) : void where A : INotifyCompletion
  {
    mutable machine = this;
    builder.AwaitOnCompleted(ref awaiter, ref machine)
  }

  public SetStateMachine(machine : IAsyncStateMachine) : void { builder.SetStateMachine(machine) }
}

#endif
