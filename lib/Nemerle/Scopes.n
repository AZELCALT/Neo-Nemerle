// The storage behind `scope` declarations (see doc/book/src/10-grammars.md). BSD-3-Clause, as all of lib/.
using System;
using System.Collections.Generic;

/// A scope's storage: a dedicated global area that a program and its spaces read and write. Scopes are shared by the
/// whole process, so a host application and the plugin scripts it runs see the same values. `scope.A.registery`
/// appends a slot; any value fits, and the compiler checks the types where the slots are used.
public sealed class Scope
{
  /// The process's scopes, by name: kept with the process (an AppDomain slot) in types of the core library only, so
  /// every copy of Nemerle.dll in the process (a plugin loaded with its own) finds the same storage.
  static stores : Dictionary[string, Dictionary[string, object]] = Stores();
  slots : Dictionary[string, object];
  this(slots : Dictionary[string, object]) { this.slots = slots }

  static Stores() : Dictionary[string, Dictionary[string, object]]
  {
    def domain = AppDomain.CurrentDomain;
    lock (domain)
      match (domain.GetData("Nemerle.Scopes"))
      {
        | shared is Dictionary[string, Dictionary[string, object]] => shared
        | _ =>
          def shared = Dictionary();
          domain.SetData("Nemerle.Scopes", shared);
          shared
      }
  }

  /// Creates scope `name` (`file.A`): what `scope A;` runs, where it is written, in the file that declares it. The
  /// process keeps it from then on (the table above holds it, so it lives as long as the process); a declaration that
  /// runs again (the same file loaded once more) finds it and keeps its values.
  public static Declare(name : string) : Scope
  {
    lock (stores)
    {
      mutable slots;
      unless (stores.TryGetValue(name, out slots)) { slots = Dictionary(); stores[name] = slots; }
      Scope(slots)
    }
  }

  /// The storage of scope `name`, for a use of it (`scope.A.x`, in any file): access to the one the declaring file
  /// created, never a new one. Before that (the declaring file has not run in this process) the use fails, saying so.
  public static Access(name : string) : Scope
  {
    lock (stores)
    {
      mutable slots;
      if (stores.TryGetValue(name, out slots)) Scope(slots)
      else
      {
        def dot = name.LastIndexOf('.');
        def file = if (dot > 0) name.Substring(0, dot) else name;
        def short = name.Substring(dot + 1);
        throw InvalidOperationException($"scope $name is not set up in this process: `scope $short;' in $file creates it, and "
          $"$file has not run here (a plugin reaches its host's scope only inside the host); for state of its own, declare a scope")
      }
    }
  }

  /// The storage of scope `name`, made if missing: what binaries compiled before Declare and Access use.
  public static Of(name : string) : Scope { Declare(name) }

  /// The initial value of a slot of type `type`: its default.
  public static Default(type : Type) : object { if (type != null && type.IsValueType) Activator.CreateInstance(type) else null }

  /// Appends slot `name`; a slot that is already there keeps its value.
  public Register(name : string, initial : object) : void
  {
    lock (slots) unless (slots.ContainsKey(name)) slots[name] = initial;
  }

  /// Appends slot `name` of type `type` (what `scope.A.registery(name, type(...))` makes): a write checks the value
  /// against it, as a read does.
  public Register(name : string, initial : object, type : Type) : void
  {
    lock (slots)
    {
      unless (slots.ContainsKey(name)) slots[name] = initial;
      unless (type == null || slots.ContainsKey(TypeKey(name))) slots[TypeKey(name)] = type
    }
  }

  // (the slot's type, kept in the storage itself, in types of the core library: every copy of Nemerle.dll sees it)
  static TypeKey(name : string) : string { "\0type:" + name }

  /// The value of slot `name`, or `fallback` while no code has registered or written it (the storage is global
  /// memory: a reader does not depend on the order in which the binaries of the process set it up).
  public Get(name : string, fallback : object) : object
  {
    lock (slots)
    {
      mutable value;
      if (slots.TryGetValue(name, out value)) value else fallback
    }
  }

  public Get(name : string) : object { Get(name, null) }

  /// Slot `name` as a `T`: its default while nothing is there, and a Content (from code that knew no type for the
  /// slot) checked for that type.
  public Read[T](name : string) : T
  {
    match (Get(name, null))
    {
      | null => Default(typeof(T)) :> T
      | content is Content => content.As.[T]()
      | value when Content.Foreign(value) => Content.Of(value).As.[T]()
      | value when value is T => value :> T
      | value => throw InvalidCastException(Identity.Explain(value.GetType(), typeof(T)))
    }
  }

  /// Writes slot `name` (a slot that is not there yet is added). A slot of a type takes a value of that type only: one
  /// type, the same object for every reader (a copy of the type compiled apart from it is another type).
  public Set(name : string, value : object) : void
  {
    lock (slots)
    {
      mutable type;
      when (value != null && !(value is Content) && !Content.Foreign(value) && slots.TryGetValue(TypeKey(name), out type))
        match (type)
        {
          | t is Type when !t.IsInstanceOfType(value) => throw InvalidCastException(Identity.Explain(value.GetType(), t))
          | _ => ()
        }
      slots[name] = value
    }
  }
}

/// The types a value held in a Content can be: a file's top-level value whose type changes is kept in one, and its
/// field says which types its content is, as a function's result of several types says (for C# and other languages,
/// which see a Content).
[AttributeUsage(AttributeTargets.Field | AttributeTargets.Property | AttributeTargets.ReturnValue)]
public sealed class ContentTypesAttribute : Attribute
{
  public Types : array[Type];
  public this(params types : array[Type]) { Types = types }
}

/// What a slot of no fixed type holds: the content and the type it currently is. Reading it asks for a type, which
/// is checked, so a wrong guess is reported as such instead of failing as a bad cast somewhere else. A dial member
/// with several forms is held the same way: `Call` runs the form whose parameters fit the arguments.
public sealed class Content
{
  public Value : object;
  /// The type the content currently is (null when there is none).
  public Type : Type;
  public this(value : object) { Value = value; Type = if (value == null) null else value.GetType(); }

  /// `value` as a content (a content stays itself).
  public static Of(value : object) : Content
  {
    match (value)
    {
      | content is Content => content
      // the Content of another copy of Nemerle.dll (a plugin's own): its value, in this copy's Content
      | other when Foreign(other) => Content((other.GetType().GetField("Value") :> System.Reflection.FieldInfo).GetValue(other))
      | _ => Content(value)
    }
  }

  /// A Content of another copy of Nemerle.dll in the process: the same type by name, not by identity.
  internal static Foreign(value : object) : bool
  {
    value != null && !(value is Content) && value.GetType().FullName == typeof(Content).FullName
  }

  public Is[T]() : bool { typeof(T).IsInstanceOfType(Value) }

  public As[T]() : T
  {
    if (typeof(T).IsInstanceOfType(Value) || Value == null && !typeof(T).IsValueType) Value :> T
    else if (Value == null) throw InvalidCastException("the slot holds nothing, not " + typeof(T).ToString())
    else throw InvalidCastException(Identity.Explain(Value.GetType(), typeof(T)))
  }

  /// The content as a `T` for code that uses it: checked as `As` does, except that a use taking any object (or a
  /// Content) gets the container itself, so the value keeps its type instead of becoming a bare object.
  public Read[T]() : T
  {
    if (typeof(T) == typeof(object) || typeof(T) == typeof(Content)) (this : object) :> T else As.[T]()
  }

  /// Calls the content: a function value, or the form of a dial member whose parameters fit `arguments`.
  public Call(params arguments : array[object]) : Content
  {
    def fits(form : Delegate) : bool
    {
      def parameters = (form.GetType().GetMethod("Invoke") :> System.Reflection.MethodInfo).GetParameters();
      mutable ok = parameters.Length == arguments.Length;
      for (mutable i = 0; ok && i < parameters.Length; i++)
        ok = if (arguments[i] == null) !parameters[i].ParameterType.IsValueType else parameters[i].ParameterType.IsInstanceOfType(arguments[i]);
      ok
    }
    def forms = match (Value) { | many is array[Delegate] => many | one is Delegate => array[one] | _ => array(0) };
    mutable chosen : Delegate = null;
    foreach (form in forms) when (chosen == null && fits(form)) chosen = form;
    when (chosen == null)
      throw InvalidOperationException("no form of the slot takes " + arguments.Length.ToString() + " argument(s) of these types");
    Content.Of(chosen.DynamicInvoke(arguments))
  }

  public override ToString() : string { if (Value == null) "" else Value.ToString() }
}

/// Why a value is not of a slot's type. To .NET a type is a copy of an assembly and a name, so a type compiled
/// twice is two types, and an object is of one of them. A compilation that continues from the binary declaring the
/// scope makes no copy of the types its slots reach (ManagerClass.ShareContinuedTypes): one type, one object. A copy
/// compiled apart from it is another type: the records in both binaries' continuation sections (.nemir) tell whether
/// it is the same code, compiled apart, or another type.
internal module Identity
{
  sealed class Record
  {
    public Base : string;
    public Fields : List[string * string] = List();
    public mutable Code : string = "";
    public this(b : string) { Base = b }
  }

  // (the records of each binary, read once)
  records : System.Runtime.CompilerServices.ConditionalWeakTable[System.Reflection.Assembly, Dictionary[string, Record]] =
    System.Runtime.CompilerServices.ConditionalWeakTable();

  Name(type : Type) : string { type.FullName ?? type.Name }

  Of(type : Type) : Record
  {
    if (type == null || type.IsArray || type.Assembly.IsDynamic) null
    else
    {
      mutable table;
      lock (records)
        unless (records.TryGetValue(type.Assembly, out table))
        {
          table = try { Read(Section(type.Assembly)) } catch { | _ is Exception => Dictionary() };
          records.Add(type.Assembly, table)
        }
      mutable record;
      if (table.TryGetValue(Name(type), out record)) record else null
    }
  }

  /// What a read or a write says when the value is of another type than the slot's.
  public Explain(source : Type, target : Type) : string
  {
    def describe(t : Type) { Name(t) + " (" + t.Assembly.GetName().Name + ")" }
    def rs = Of(source); def rt = Of(target);
    def head = "the slot is " + describe(target) + ", and the value is " + describe(source);
    if (rs != null && rt != null && rs.Code != "" && rs.Code == rt.Code)
      head + ": the same code, compiled apart, so another .NET type; compile it against the binary that declares the "
           + "scope (-r), which makes it that binary's type"
    else if (Name(source) == Name(target) && rs != null && rt != null)
    {
      mutable differs = "its members";
      for (mutable i = 0; i < Math.Min(rs.Fields.Count, rt.Fields.Count); i++)
        when (differs == "its members" && !rs.Fields[i].Equals(rt.Fields[i]))
          differs = "field " + rs.Fields[i][0] + " : " + rs.Fields[i][1] + " (the slot's: " + rt.Fields[i][0] + " : " + rt.Fields[i][1] + ")";
      when (differs == "its members" && rs.Fields.Count != rt.Fields.Count) differs = "its fields";
      head + ", another type of the same name: " + differs + " differ"
    }
    else if (Name(source) == Name(target))
      head + ": a type of the same name compiled apart, so another .NET type; compile it against the binary that "
           + "declares the scope (-r), which makes it that binary's type"
    else head
  }

  /// The continuation section of a binary: the one its loader kept (an image loaded from memory, a script), else the
  /// one in its file.
  Section(assembly : System.Reflection.Assembly) : array[byte]
  {
    mutable section = null;
    match (AppDomain.CurrentDomain.GetData("Nemerle.Sections"))
    {
      | kept is System.Runtime.CompilerServices.ConditionalWeakTable[System.Reflection.Assembly, array[byte]] => _ = kept.TryGetValue(assembly, out section)
      | _ => ()
    }
    if (section != null || String.IsNullOrEmpty(assembly.Location)) section
    else
    {
      def image = System.IO.File.ReadAllBytes(assembly.Location);
      def pe = BitConverter.ToInt32(image, 0x3C);
      when (pe > 0 && pe + 24 <= image.Length && BitConverter.ToUInt32(image, pe) == 0x4550u)
      {
        def count = BitConverter.ToUInt16(image, pe + 6) :> int;
        def table = pe + 24 + BitConverter.ToUInt16(image, pe + 20);
        for (mutable i = 0; i < count && table + i * 40 + 40 <= image.Length; i++)
        {
          def at = table + i * 40;
          when (System.Text.Encoding.ASCII.GetString(image, at, 8).TrimEnd(array['\0']) == ".nemir")
          {
            def size = BitConverter.ToInt32(image, at + 8);
            def raw = BitConverter.ToInt32(image, at + 20);
            when (size > 0 && raw > 0 && raw + size <= image.Length)
            {
              section = array(size);
              Array.Copy(image, raw, section, 0, size)
            }
          }
        }
      }
      section
    }
  }

  /// The type records of a continuation section (its format: Nemerle.Compiler's ContinuationStore).
  Read(data : array[byte]) : Dictionary[string, Record]
  {
    def result = Dictionary();
    mutable pos = 0;
    def next() : int { def b = data[pos] :> int; pos++; b }
    def number() : int
    {
      def b = next();
      if ((b & 0x80) == 0) b
      else if ((b & 0xC0) == 0x80) ((b & 0x3F) << 8) | next()
      else { def b1 = next(); def b2 = next(); def b3 = next(); ((b & 0x1F) << 24) | (b1 << 16) | (b2 << 8) | b3 }
    }
    def text() : string { def n = number(); def s = System.Text.Encoding.UTF8.GetString(data, pos, n); pos += n; s }
    when (data != null && data.Length > 8 && data[0] == 0x4E && data[1] == 0x45 && data[2] == 0x4D && data[3] == 0x43)
    {
      pos = 4;
      when (number() == 1)
      {
        _ = text();
        def strings = array(number());
        for (mutable i = 0; i < strings.Length; i++) strings[i] = text();
        repeat (number())
        {
          def kind = next();
          def length = number();
          def end = pos + length;
          when (kind == 6)
            repeat (number())
            {
              def name = strings[number()];
              def record = Record(strings[number()]);
              repeat (number()) { def field = strings[number()]; record.Fields.Add((field, strings[number()])) }
              record.Code = strings[number()];
              result[name] = record
            }
          pos = end
        }
      }
    }
    result
  }
}
