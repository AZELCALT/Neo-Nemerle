// Pascal (ISO 7185, with Turbo Pascal's units) as a grammar library: in a program that references pascal.dll, a
// `space Pascal { ... }` holds a Pascal program (`program P; ... end.`) or a unit (`unit U; interface ... end.`, in the
// file of its name), translated when the file is compiled: its declarations are members of its file's module, its
// statements the file's top-level code, and units find each other as files do. The grammar parses; the front end
// (pascalfront.n, pascalfront.dll beside this library) compiles. README.md says what is in.

using System;
using System.IO;
using SCG = System.Collections.Generic;

// ---- what the translated programs use ----

/// A value Pascal copies when it is assigned or passed (an array, a record).
public interface IPascalValue { Clone() : object; }

/// A record: a class of its fields, copied as Pascal copies a record.
public abstract class PascalRecord : IPascalValue
{
  public abstract Copy() : PascalRecord;
  public Clone() : object { Copy() }
}

/// `array [low..high] of T': indexed from its own low bound, and checked as Pascal checks it.
public class PascalArray[T] : IPascalValue
{
  mutable low : int;
  mutable items : array[T];
  /// (for a file of it: an empty one, its bounds and elements set as they are read)
  public this() { items = array(0) }
  public this(low : int, high : int, element : void -> T)
  {
    this.low = low;
    items = array(high - low + 1);
    for (mutable i = 0; i < items.Length; i++) items[i] = element()
  }
  public Low : int { get { low } set { low = value } }
  public High : int { get { low + items.Length - 1 } }
  /// Its elements (what a file of it keeps, with Low)
  public Items : array[T] { get { items } set { items = value } }
  public Item[index : int] : T
  {
    get { items[Check(index)] }
    set { items[Check(index)] = value }
  }
  Check(index : int) : int
  {
    when (index < low || index > High)
      throw IndexOutOfRangeException("index " + index.ToString() + " is out of the array's range " + low.ToString() + ".." + High.ToString());
    index - low
  }
  public Clone() : object
  {
    def copy = PascalArray(low, High, () => default(T));
    for (mutable i = 0; i < items.Length; i++) copy.items[i] = Pascal.Value(items[i]);
    copy
  }
  /// A packed array of char as the string it holds
  public AsString() : string
  {
    def b = System.Text.StringBuilder();
    foreach (x in items) _ = b.Append((x : object) :> char);
    b.ToString()
  }
  /// A string as a packed array of char from `low' (a string literal assigned to one)
  public static FromString(low : int, text : string) : PascalArray[char]
  {
    def a = PascalArray(low, low + text.Length - 1, () => ' ');
    for (mutable i = 0; i < text.Length; i++) a.items[i] = text[i];
    a
  }
}

/// A pointer: `p^' is its Value; `new(p)' makes one, `nil' is null.
public class PascalPointer[T]
{
  public mutable Value : T;
  public this(value : T) { Value = value }
}

/// `set of T': its members' ordinal values (0 to 255, as Pascal implementations give), immutable.
public sealed class PascalSet
{
  mutable bits : array[ulong];
  this(bits : array[ulong]) { this.bits = bits }
  /// (for a file of it: an empty one, its members set as they are read)
  public this() { bits = array(4) }
  /// Its members (what a file of it keeps)
  public Members : array[int]
  {
    get { def m = SCG.List(); for (mutable v = 0; v <= 255; v++) when (Contains(v)) m.Add(v); m.ToArray() }
    set { def b = array(4) : array[ulong]; foreach (v in value) b[v / 64] = b[v / 64] | masks[v % 64]; bits = b }
  }
  // (each bit of a word, as a mask)
  static masks : array[ulong] = Masks();
  static Masks() : array[ulong] { def m = array(64) : array[ulong]; m[0] = 1UL; for (mutable i = 1; i < 64; i++) m[i] = m[i - 1] * 2UL; m }
  public static Empty : PascalSet = PascalSet(array(4));
  /// The set of the ranges given, as low and high pairs (`[1, 3..5]' is 1, 1, 3, 5)
  public static Of(params bounds : array[int]) : PascalSet
  {
    def b = array(4) : array[ulong];
    for (mutable i = 0; i + 1 < bounds.Length; i += 2)
      for (mutable v = bounds[i]; v <= bounds[i + 1]; v++)
      {
        when (v < 0 || v > 255) throw ArgumentOutOfRangeException("set element", v, "a set's element is 0 to 255");
        b[v / 64] = b[v / 64] | masks[v % 64]
      }
    PascalSet(b)
  }
  public Contains(v : int) : bool { v >= 0 && v <= 255 && (bits[v / 64] & masks[v % 64]) != 0UL }
  Combine(other : PascalSet, f : ulong * ulong -> ulong) : PascalSet
  {
    def b = array(4) : array[ulong];
    for (mutable i = 0; i < 4; i++) b[i] = f(bits[i], other.bits[i]);
    PascalSet(b)
  }
  public Union(other : PascalSet) : PascalSet { Combine(other, (a, b) => a | b) }
  public Difference(other : PascalSet) : PascalSet { Combine(other, (a, b) => a & ~b) }
  public Intersection(other : PascalSet) : PascalSet { Combine(other, (a, b) => a & b) }
  public SetEquals(other : PascalSet) : bool { mutable same = true; for (mutable i = 0; i < 4; i++) when (bits[i] != other.bits[i]) same = false; same }
  public IsSubsetOf(other : PascalSet) : bool { mutable sub = true; for (mutable i = 0; i < 4; i++) when ((bits[i] & ~other.bits[i]) != 0UL) sub = false; sub }
}

/// A goto out of a routine, to a label of a routine around it: thrown, and caught by the statements of that label.
public class PascalGoto : Exception
{
  public Target : int;
  public this(target : int) { base("goto out of its routine"); Target = target }
}

/// The translated programs' helpers.
public module Pascal
{
  /// An assigned or passed value: a copy of an array or a record
  public Value[T](x : T) : T { match (x : object) { | v is IPascalValue => v.Clone() :> T | _ => x } }
  /// A subrange's value, checked
  public Check(v : int, low : int, high : int) : int
  {
    when (v < low || v > high) throw ArgumentOutOfRangeException("value", v, "out of the subrange " + low.ToString() + ".." + high.ToString());
    v
  }
  /// Pascal's `mod': never negative; the divisor is positive
  public Mod(a : int, b : int) : int
  {
    when (b <= 0) throw DivideByZeroException("mod by a divisor that is not positive");
    ((a % b) + b) % b
  }
  /// A Turbo string with its character at `index' (from 1) changed
  public SetChar(s : string, index : int, c : char) : string
  {
    when (index < 1 || index > s.Length) throw IndexOutOfRangeException("index " + index.ToString() + " is out of the string");
    s.Substring(0, index - 1) + c.ToString() + s.Substring(index)
  }
  /// Turbo's `copy(s, index, count)'
  /// Turbo's delete(s, index, count) and insert(source, s, index): the string they leave
  public Delete(s : string, index : int, count : int) : string
  {
    if (index < 1 || index > s.Length || count <= 0) s else s.Remove(index - 1, Math.Min(count, s.Length - index + 1))
  }
  public Insert(source : string, s : string, index : int) : string
  {
    s.Insert(Math.Max(0, Math.Min(s.Length, index - 1)), source)
  }
  /// Turbo's val(s, v, code): the number, and the place of the first character that is not one (0: none)
  public ValInt(s : string, code : out int) : int
  {
    mutable v; if (int.TryParse(s.Trim(), Globalization.NumberStyles.Integer, Globalization.CultureInfo.InvariantCulture, out v)) { code = 0; v } else { code = BadAt(s); 0 }
  }
  public ValReal(s : string, code : out int) : double
  {
    mutable v; if (double.TryParse(s.Trim(), Globalization.NumberStyles.Float, Globalization.CultureInfo.InvariantCulture, out v)) { code = 0; v } else { code = BadAt(s); 0.0 }
  }
  BadAt(s : string) : int
  {
    mutable i = 0;
    while (i < s.Length && (char.IsDigit(s[i]) || s[i] == '.' || s[i] == '-' || s[i] == '+' || s[i] == 'e' || s[i] == 'E' || s[i] == ' ')) i++;
    if (i < s.Length) i + 1 else Math.Max(1, s.Length)
  }
  /// Turbo's random: below n, or a real in [0, 1); randomize seeds it from the clock
  mutable randomness : System.Random = System.Random(0);
  public Randomize() : void { randomness = System.Random() }
  public Random(n : int) : int { if (n <= 0) 0 else randomness.Next(n) }
  public RandomReal() : double { randomness.NextDouble() }
  /// A value of Turbo's `string[n]': its first n characters
  public Short(s : string, n : int) : string { if (s.Length > n) s.Substring(0, n) else s }
  public Copy(s : string, index : int, count : int) : string
  {
    if (index > s.Length || count <= 0) "" else s.Substring(Math.Max(0, index - 1), Math.Min(count, s.Length - Math.Max(0, index - 1)))
  }
  public Pack[T](a : PascalArray[T], from : int, z : PascalArray[T]) : void
  { for (mutable j = z.Low; j <= z.High; j++) z[j] = a[from + j - z.Low] }
  public Unpack[T](z : PascalArray[T], a : PascalArray[T], from : int) : void
  { for (mutable j = z.Low; j <= z.High; j++) a[from + j - z.Low] = z[j] }
}

/// A text file (`text', `input', `output'): reading and writing as Pascal's are, on a file or on the console.
public class PascalText
{
  public static Input : PascalText = PascalText(Console.In, null);
  public static Output : PascalText = PascalText(null, Console.Out);
  mutable path : string;
  mutable reader : TextReader;
  mutable writer : TextWriter;
  mutable ahead : int = -2; // (the next character, read ahead; -2 when not yet)
  mutable put : char = ' ';
  console : bool;
  public this(name : string) { path = name }
  this(r : TextReader, w : TextWriter) { reader = r; writer = w; console = true }
  public Assign(name : string) : void { path = name }
  public Reset() : void { Close(); reader = File.OpenText(path); ahead = -2 }
  public Rewrite() : void { Close(); writer = StreamWriter(path) }
  public Close() : void
  {
    unless (console)
    {
      when (reader != null) { reader.Dispose(); reader = null }
      when (writer != null) { writer.Dispose(); writer = null }
    }
  }
  In() : TextReader { when (reader == null) throw InvalidOperationException("the file is not open for reading (reset it)"); reader }
  Out() : TextWriter { when (writer == null) throw InvalidOperationException("the file is not open for writing (rewrite it)"); writer }
  Peek() : int
  {
    when (ahead == -2)
    {
      ahead = In().Read();
      // (a line ends with "\n" or "\r\n": one end of line)
      when (ahead == '\r') { when (In().Peek() == '\n') _ = In().Read(); ahead = '\n' }
    }
    ahead
  }
  public Eof : bool { get { Peek() < 0 } }
  public Eoln : bool { get { def c = Peek(); c == '\n' || c < 0 } }
  /// The buffer variable `f^': the next character (a space at the end of a line); what `put' writes
  public Buffer : char
  {
    get { def c = Peek(); if (c < 0 || c == '\n') ' ' else (c :> char) }
    set { put = value }
  }
  public Get() : void { when (Peek() < 0) throw EndOfStreamException("read past the end of the file"); ahead = -2 }
  public Put() : void { Out().Write(put) }
  public Page() : void { Out().Write('\f') }
  /// (Turbo's append: writing on at the file's end)
  public Append() : void { Close(); writer = File.AppendText(path) }
  /// A text that writes into a string (Turbo's str): what it wrote
  public static Memory() : PascalText { PascalText(null, StringWriter()) }
  public Written : string { get { writer.ToString() } }
  public ReadChar() : char { def c = Buffer; Get(); c }
  SkipBlanks() : void { while (!Eof && (Peek() == '\n' || char.IsWhiteSpace(Peek() :> char))) Get() }
  Number(real : bool) : string
  {
    SkipBlanks();
    def b = System.Text.StringBuilder();
    def take() { _ = b.Append(Peek() :> char); Get() }
    when (!Eof && (Peek() == '+' || Peek() == '-')) take();
    while (!Eof && char.IsDigit(Peek() :> char)) take();
    when (real)
    {
      when (!Eof && Peek() == '.') { take(); while (!Eof && char.IsDigit(Peek() :> char)) take() }
      when (!Eof && (Peek() == 'e' || Peek() == 'E'))
      {
        take(); when (!Eof && (Peek() == '+' || Peek() == '-')) take();
        while (!Eof && char.IsDigit(Peek() :> char)) take()
      }
    }
    when (b.Length == 0 || b.ToString() == "+" || b.ToString() == "-") throw FormatException("read: no number here");
    b.ToString()
  }
  public ReadInt() : int { int.Parse(Number(false), Globalization.CultureInfo.InvariantCulture) }
  public ReadReal() : double { double.Parse(Number(true), Globalization.CultureInfo.InvariantCulture) }
  /// (Turbo's string read: the rest of the line)
  public ReadString() : string { def b = System.Text.StringBuilder(); while (!Eoln) _ = b.Append(ReadChar()); b.ToString() }
  public ReadLine() : void { while (!Eoln) Get(); unless (Eof) Get() }
  Field(text : string, width : int) : void { Out().Write(if (width > text.Length) text.PadLeft(width) else text) }
  public WriteInt(v : int, width : int) : void { Field(v.ToString(Globalization.CultureInfo.InvariantCulture), width) }
  public WriteChar(v : char, width : int) : void { Field(v.ToString(), width) }
  public WriteString(v : string, width : int) : void { Field(v, width) }
  public WriteBool(v : bool, width : int) : void { Field(if (v) "TRUE" else "FALSE", width) }
  public WriteValue(v : object, width : int) : void { Field(if (v == null) "" else v.ToString(), width) }
  /// A real: `x:w:d' fixed with d decimals; `x' or `x:w' in floating-point form (as many digits as the width gives)
  public WriteReal(v : double, width : int, decimals : int) : void
  {
    def culture = Globalization.CultureInfo.InvariantCulture;
    if (decimals >= 0) Field(v.ToString("F" + decimals.ToString(), culture), width)
    else
    {
      def digits = if (width <= 0) 10 else Math.Max(1, width - 7);
      def text = v.ToString("0." + string('0', digits) + "E+000", culture);
      Field(if (v >= 0) " " + text else text, width)
    }
  }
  public WriteLine() : void { Out().WriteLine() }
}

/// `file of T': its elements, kept in the file a line each (as JSON).
public class PascalFile[T]
{
  mutable path : string;
  items : SCG.List[T] = SCG.List();
  mutable position : int;
  mutable writing : bool;
  public mutable Buffer : T;
  static options : System.Text.Json.JsonSerializerOptions = Options();
  static Options() : System.Text.Json.JsonSerializerOptions { def o = System.Text.Json.JsonSerializerOptions(); o.IncludeFields = true; o }
  public this(name : string) { path = name }
  public Assign(name : string) : void { path = name }
  public Reset() : void
  {
    Close(); items.Clear(); writing = false; position = 0;
    when (File.Exists(path))
      foreach (line when line.Length > 0 in File.ReadAllLines(path))
        items.Add(System.Text.Json.JsonSerializer.Deserialize.[T](line, options));
    Buffer = if (items.Count > 0) items[0] else default(T)
  }
  public Rewrite() : void { Close(); items.Clear(); writing = true; position = 0 }
  public Eof : bool { get { writing || position >= items.Count } }
  public Get() : void
  {
    when (writing || position >= items.Count) throw EndOfStreamException("read past the end of the file");
    position++;
    Buffer = if (position < items.Count) items[position] else default(T)
  }
  public Put() : void { unless (writing) throw InvalidOperationException("the file is not open for writing (rewrite it)"); items.Add(Buffer) }
  public Page() : void { }
  public Close() : void
  {
    when (writing && path != null && path.Length > 0)
    {
      def lines = SCG.List();
      foreach (x in items) lines.Add(System.Text.Json.JsonSerializer.Serialize(x, options));
      File.WriteAllLines(path, lines);
      writing = false
    }
  }
}

/// What a Pascal space imports (its `uses'), so that a program's units are found as files are.
public class PascalImports : Nemerle.Compiler.NitraDialectServices.ISpaceImports
{
  public Imports(grammar : string, body : string) : array[string]
  {
    if (!String.Equals(grammar, "Pascal", StringComparison.OrdinalIgnoreCase)) array[]
    else
    {
      // (comments and strings out, then each `uses a, b;')
      def text = System.Text.RegularExpressions.Regex.Replace(body, @"\{[^}]*\}|\(\*.*?\*\)|'([^']|'')*'", " ", System.Text.RegularExpressions.RegexOptions.Singleline);
      def names = SCG.List();
      foreach (m is System.Text.RegularExpressions.Match in System.Text.RegularExpressions.Regex.Matches(text, @"\buses\b([^;]*);", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
        foreach (n in m.Groups[1].Value.Split(','))
          when (n.Trim().Length > 0) names.Add(n.Trim());
      names.ToArray()
    }
  }
}

// ---- the grammar ----

grammar Pascal
{
  using Nemerle.Compiler.Parsetree;
  syntax module Program
  {
    using Nitra.Core;

    // Pascal is case-insensitive: each keyword in any case (`begin', `BEGIN', `Begin'), not the start of a longer name
    regex KAndText = ['a', 'A'] ['n', 'N'] ['d', 'D'];
    regex KArrayText = ['a', 'A'] ['r', 'R'] ['r', 'R'] ['a', 'A'] ['y', 'Y'];
    regex KBeginText = ['b', 'B'] ['e', 'E'] ['g', 'G'] ['i', 'I'] ['n', 'N'];
    regex KCaseText = ['c', 'C'] ['a', 'A'] ['s', 'S'] ['e', 'E'];
    regex KConstText = ['c', 'C'] ['o', 'O'] ['n', 'N'] ['s', 'S'] ['t', 'T'];
    regex KDivText = ['d', 'D'] ['i', 'I'] ['v', 'V'];
    regex KDoText = ['d', 'D'] ['o', 'O'];
    regex KDowntoText = ['d', 'D'] ['o', 'O'] ['w', 'W'] ['n', 'N'] ['t', 'T'] ['o', 'O'];
    regex KElseText = ['e', 'E'] ['l', 'L'] ['s', 'S'] ['e', 'E'];
    regex KEndText = ['e', 'E'] ['n', 'N'] ['d', 'D'];
    regex KFileText = ['f', 'F'] ['i', 'I'] ['l', 'L'] ['e', 'E'];
    regex KForText = ['f', 'F'] ['o', 'O'] ['r', 'R'];
    regex KFunctionText = ['f', 'F'] ['u', 'U'] ['n', 'N'] ['c', 'C'] ['t', 'T'] ['i', 'I'] ['o', 'O'] ['n', 'N'];
    regex KGotoText = ['g', 'G'] ['o', 'O'] ['t', 'T'] ['o', 'O'];
    regex KIfText = ['i', 'I'] ['f', 'F'];
    regex KImplementationText = ['i', 'I'] ['m', 'M'] ['p', 'P'] ['l', 'L'] ['e', 'E'] ['m', 'M'] ['e', 'E'] ['n', 'N'] ['t', 'T'] ['a', 'A'] ['t', 'T'] ['i', 'I'] ['o', 'O'] ['n', 'N'];
    regex KInText = ['i', 'I'] ['n', 'N'];
    regex KInterfaceText = ['i', 'I'] ['n', 'N'] ['t', 'T'] ['e', 'E'] ['r', 'R'] ['f', 'F'] ['a', 'A'] ['c', 'C'] ['e', 'E'];
    regex KLabelText = ['l', 'L'] ['a', 'A'] ['b', 'B'] ['e', 'E'] ['l', 'L'];
    regex KModText = ['m', 'M'] ['o', 'O'] ['d', 'D'];
    regex KNilText = ['n', 'N'] ['i', 'I'] ['l', 'L'];
    regex KNotText = ['n', 'N'] ['o', 'O'] ['t', 'T'];
    regex KOfText = ['o', 'O'] ['f', 'F'];
    regex KOrText = ['o', 'O'] ['r', 'R'];
    regex KPackedText = ['p', 'P'] ['a', 'A'] ['c', 'C'] ['k', 'K'] ['e', 'E'] ['d', 'D'];
    regex KProcedureText = ['p', 'P'] ['r', 'R'] ['o', 'O'] ['c', 'C'] ['e', 'E'] ['d', 'D'] ['u', 'U'] ['r', 'R'] ['e', 'E'];
    regex KProgramText = ['p', 'P'] ['r', 'R'] ['o', 'O'] ['g', 'G'] ['r', 'R'] ['a', 'A'] ['m', 'M'];
    regex KRecordText = ['r', 'R'] ['e', 'E'] ['c', 'C'] ['o', 'O'] ['r', 'R'] ['d', 'D'];
    regex KRepeatText = ['r', 'R'] ['e', 'E'] ['p', 'P'] ['e', 'E'] ['a', 'A'] ['t', 'T'];
    regex KSetText = ['s', 'S'] ['e', 'E'] ['t', 'T'];
    regex KThenText = ['t', 'T'] ['h', 'H'] ['e', 'E'] ['n', 'N'];
    regex KToText = ['t', 'T'] ['o', 'O'];
    regex KTypeText = ['t', 'T'] ['y', 'Y'] ['p', 'P'] ['e', 'E'];
    regex KUnitText = ['u', 'U'] ['n', 'N'] ['i', 'I'] ['t', 'T'];
    regex KUntilText = ['u', 'U'] ['n', 'N'] ['t', 'T'] ['i', 'I'] ['l', 'L'];
    regex KUsesText = ['u', 'U'] ['s', 'S'] ['e', 'E'] ['s', 'S'];
    regex KVarText = ['v', 'V'] ['a', 'A'] ['r', 'R'];
    regex KWhileText = ['w', 'W'] ['h', 'H'] ['i', 'I'] ['l', 'L'] ['e', 'E'];
    regex KWithText = ['w', 'W'] ['i', 'I'] ['t', 'T'] ['h', 'H'];
    // (Turbo's)
    regex KXorText = ['x', 'X'] ['o', 'O'] ['r', 'R'];
    regex KShlText = ['s', 'S'] ['h', 'H'] ['l', 'L'];
    regex KShrText = ['s', 'S'] ['h', 'H'] ['r', 'R'];
    // (directives, not reserved: a name elsewhere)
    regex KForwardText = ['f', 'F'] ['o', 'O'] ['r', 'R'] ['w', 'W'] ['a', 'A'] ['r', 'R'] ['d', 'D'];
    regex KOtherwiseText = ['o', 'O'] ['t', 'T'] ['h', 'H'] ['e', 'E'] ['r', 'R'] ['w', 'W'] ['i', 'I'] ['s', 'S'] ['e', 'E'];
    token KAnd = KAndText !IdentifierPartCharacters;
    token KArray = KArrayText !IdentifierPartCharacters;
    token KBegin = KBeginText !IdentifierPartCharacters;
    token KCase = KCaseText !IdentifierPartCharacters;
    token KConst = KConstText !IdentifierPartCharacters;
    token KDiv = KDivText !IdentifierPartCharacters;
    token KDo = KDoText !IdentifierPartCharacters;
    token KDownto = KDowntoText !IdentifierPartCharacters;
    token KElse = KElseText !IdentifierPartCharacters;
    token KEnd = KEndText !IdentifierPartCharacters;
    token KFile = KFileText !IdentifierPartCharacters;
    token KFor = KForText !IdentifierPartCharacters;
    token KFunction = KFunctionText !IdentifierPartCharacters;
    token KGoto = KGotoText !IdentifierPartCharacters;
    token KIf = KIfText !IdentifierPartCharacters;
    token KImplementation = KImplementationText !IdentifierPartCharacters;
    token KIn = KInText !IdentifierPartCharacters;
    token KInterface = KInterfaceText !IdentifierPartCharacters;
    token KLabel = KLabelText !IdentifierPartCharacters;
    token KMod = KModText !IdentifierPartCharacters;
    token KNil = KNilText !IdentifierPartCharacters;
    token KNot = KNotText !IdentifierPartCharacters;
    token KOf = KOfText !IdentifierPartCharacters;
    token KOr = KOrText !IdentifierPartCharacters;
    token KPacked = KPackedText !IdentifierPartCharacters;
    token KProcedure = KProcedureText !IdentifierPartCharacters;
    token KProgram = KProgramText !IdentifierPartCharacters;
    token KRecord = KRecordText !IdentifierPartCharacters;
    token KRepeat = KRepeatText !IdentifierPartCharacters;
    token KSet = KSetText !IdentifierPartCharacters;
    token KThen = KThenText !IdentifierPartCharacters;
    token KTo = KToText !IdentifierPartCharacters;
    token KType = KTypeText !IdentifierPartCharacters;
    token KUnit = KUnitText !IdentifierPartCharacters;
    token KUntil = KUntilText !IdentifierPartCharacters;
    token KUses = KUsesText !IdentifierPartCharacters;
    token KVar = KVarText !IdentifierPartCharacters;
    token KWhile = KWhileText !IdentifierPartCharacters;
    token KWith = KWithText !IdentifierPartCharacters;
    token KXor = KXorText !IdentifierPartCharacters;
    token KShl = KShlText !IdentifierPartCharacters;
    token KShr = KShrText !IdentifierPartCharacters;
    token KForward = KForwardText !IdentifierPartCharacters;
    token KOtherwise = KOtherwiseText !IdentifierPartCharacters;
    regex Reserved = KAndText | KArrayText | KBeginText | KCaseText | KConstText | KDivText | KDoText | KDowntoText | KElseText
                   | KEndText | KFileText | KForText | KFunctionText | KGotoText | KIfText | KImplementationText | KInText
                   | KInterfaceText | KLabelText | KModText | KNilText | KNotText | KOfText | KOrText | KPackedText
                   | KProcedureText | KProgramText | KRecordText | KRepeatText | KSetText | KThenText | KToText | KTypeText
                   | KUnitText | KUntilText | KUsesText | KVarText | KWhileText | KWithText | KXorText | KShlText | KShrText;
    // a name, never a reserved word (the word's end is checked in a token: a syntax rule would skip the spaces after it
    // first, and take `nil end' for a name)
    token ReservedWord = Reserved !IdentifierPartCharacters;
    syntax Ident = !ReservedWord Body=IdentifierBody;

    // Pascal's comments, `(* ... *)' and `{ ... }'
    extend token IgnoreToken
    {
      | ParenComment = "(*" Body=(!"*)" Any)* "*)";
      | BraceComment = "{" Body=(!"}" Any)* "}";
    }

    regex Digits = ['0'..'9']+;
    regex HexDigits = "$" ['0'..'9', 'a'..'f', 'A'..'F']+;
    regex RealLiteral = Digits "." Digits (('e' | 'E') ('+' | '-')? Digits)? | Digits ('e' | 'E') ('+' | '-')? Digits;
    // (one token, so the spaces inside are the string's; Turbo's `#65' is a character by its code, and quoted parts and
    // codes side by side are one string: 'line'#13#10)
    regex StringLiteral = ("'" ("''" | (Any - '\''))* "'" | "#" Digits)+;

    [StartRule] syntax Start = Unit=CompilationUnit
    {
      map PExpr = pascalfront.Front.Compile(Unit.Ast() :> pascalfront.CompUnit);
    }

    syntax CompilationUnit
    {
      Ast() : object;
      | Program = KProgram Name=Ident Files=ProgramFiles? ";" Uses=UsesClause? Block=Block "."
        {
          override Ast = pascalfront.CompUnit.Program(pascalfront.N.At(Location), GetText(Name.Body),
                                                      if (Uses.HasValue) Uses.Value.List() :> list[string * Nemerle.Compiler.AST.Location] else [],
                                                      Block.Ast() :> pascalfront.Block);
        }
      | Unit = KUnit Name=Ident ";" KInterface IUses=UsesClause? IDecls=InterfaceDeclaration* KImplementation MUses=UsesClause?
               MDecls=Declaration* Init=UnitInit? KEnd "."
        {
          override Ast = {
            mutable idecls = []; foreach (d in IDecls) idecls = idecls + (d.Ast() :> list[pascalfront.Decl]);
            mutable mdecls = []; foreach (d in MDecls) mdecls = mdecls + (d.Ast() :> list[pascalfront.Decl]);
            pascalfront.CompUnit.Unit(pascalfront.N.At(Location), GetText(Name.Body),
                                      if (IUses.HasValue) IUses.Value.List() :> list[string * Nemerle.Compiler.AST.Location] else [], idecls,
                                      if (MUses.HasValue) MUses.Value.List() :> list[string * Nemerle.Compiler.AST.Location] else [], mdecls,
                                      if (Init.HasValue) Init.Value.Body.Ast() :> list[pascalfront.Stmt] else null)
          };
        }
    }
    syntax ProgramFiles = "(" Names=(Ident; ",")* ")";
    syntax UsesClause = KUses Names=(Ident; ",")+ ";"
    {
      List() : object = { mutable xs = []; foreach (n in Names.Item1) xs ::= (GetText(n.Body), pascalfront.N.At(n.Location)); xs.Rev() };
    }
    syntax UnitInit = KBegin Body=Statements;

    syntax Block = Declarations=Declaration* KBegin Body=Statements KEnd
    {
      Ast() : object = {
        mutable decls = []; foreach (d in Declarations) decls = decls + (d.Ast() :> list[pascalfront.Decl]);
        pascalfront.Block(decls, Body.Ast() :> list[pascalfront.Stmt])
      };
    }

    // (each gives the declarations of its section)
    syntax Declaration
    {
      Ast() : object;
      | Labels = KLabel Names=(Digits; ",")+ ";"
        {
          override Ast = { mutable xs = []; foreach (n in Names.Item1) xs ::= GetText(n); [pascalfront.Decl.Labels(pascalfront.N.At(Location), xs.Rev()) : pascalfront.Decl] };
        }
      | Constants = KConst Items=ConstantDeclaration+
        {
          override Ast = { mutable xs = []; foreach (c in Items) xs ::= (c.Ast() :> pascalfront.Decl); xs.Rev() };
        }
      | Types = KType Items=TypeDeclaration+
        {
          override Ast = { mutable xs = []; foreach (c in Items) xs ::= (c.Ast() :> pascalfront.Decl); xs.Rev() };
        }
      | Variables = KVar Items=VariableDeclaration+
        {
          override Ast = { mutable xs = []; foreach (c in Items) xs ::= (c.Ast() :> pascalfront.Decl); xs.Rev() };
        }
      | Routine = Header=RoutineHeader ";" Body=RoutineBody ";"
        {
          override Ast = {
            def body = Body.Ast();
            [pascalfront.Decl.Routine(pascalfront.N.At(Location), Header.Ast() :> pascalfront.Header,
                                      if (body == null) null else body :> pascalfront.Block, body == null) : pascalfront.Decl]
          };
        }
    }
    // a unit's interface: its constants, types, variables, and its routines' headings
    syntax InterfaceDeclaration
    {
      Ast() : object;
      | Constants = KConst Items=ConstantDeclaration+
        {
          override Ast = { mutable xs = []; foreach (c in Items) xs ::= (c.Ast() :> pascalfront.Decl); xs.Rev() };
        }
      | Types = KType Items=TypeDeclaration+
        {
          override Ast = { mutable xs = []; foreach (c in Items) xs ::= (c.Ast() :> pascalfront.Decl); xs.Rev() };
        }
      | Variables = KVar Items=VariableDeclaration+
        {
          override Ast = { mutable xs = []; foreach (c in Items) xs ::= (c.Ast() :> pascalfront.Decl); xs.Rev() };
        }
      | Heading = Header=RoutineHeader ";"
        {
          override Ast = [pascalfront.Decl.Routine(pascalfront.N.At(Location), Header.Ast() :> pascalfront.Header, null, false) : pascalfront.Decl];
        }
    }
    syntax RoutineBody
    {
      Ast() : object;
      | Forward = KForward { override Ast = null; }
      | Body = Block=Block { override Ast = Block.Ast(); }
    }

    syntax ConstantDeclaration
    {
      Ast() : object;
      | Plain = Name=Ident "=" Value=Expr ";"
        {
          override Ast = pascalfront.Decl.Const(pascalfront.N.At(Location), GetText(Name.Body), Value.Ast() :> pascalfront.Expr);
        }
      // Turbo's typed constant: a variable with its first value, kept from one call to the next
      | Typed = Name=Ident ":" Type=TypeSpec "=" Value=ConstValue ";"
        {
          override Ast = pascalfront.Decl.TypedConst(pascalfront.N.At(Location), GetText(Name.Body), Type.Ast() :> pascalfront.TypeSpec, Value.Ast() :> pascalfront.Expr);
        }
    }
    // a typed constant's value: an expression, an array's `(1, 2, 3)', a record's `(x: 1; y: 2)'
    syntax ConstValue
    {
      Ast() : object;
      | Plain = Value=Expr { override Ast = Value.Ast(); }
      | Items = "(" First=ConstValue "," Rest=(ConstValue; ",")+ ")"
        {
          override Ast = { mutable xs = [First.Ast() :> pascalfront.Expr]; foreach (v in Rest.Item1) xs ::= (v.Ast() :> pascalfront.Expr); pascalfront.Expr.Items(pascalfront.N.At(Location), xs.Rev()) };
        }
      | Fields = "(" Items=(ConstField; ";"; ?)+ ")"
        {
          override Ast = { mutable xs = []; foreach (f in Items.Item1) xs ::= (f.Ast() :> string * pascalfront.Expr); pascalfront.Expr.Fields(pascalfront.N.At(Location), xs.Rev()) };
        }
    }
    syntax ConstField = Name=Ident ":" Value=ConstValue
    {
      Ast() : object = (GetText(Name.Body), Value.Ast() :> pascalfront.Expr);
    }
    syntax TypeDeclaration = Name=Ident "=" Type=TypeSpec ";"
    {
      Ast() : object = pascalfront.Decl.TypeDecl(pascalfront.N.At(Location), GetText(Name.Body), Type.Ast() :> pascalfront.TypeSpec);
    }
    syntax VariableDeclaration = Names=(Ident; ",")+ ":" Type=TypeSpec ";"
    {
      Ast() : object = {
        mutable xs = []; foreach (n in Names.Item1) xs ::= GetText(n.Body);
        pascalfront.Decl.VarDecl(pascalfront.N.At(Location), xs.Rev(), Type.Ast() :> pascalfront.TypeSpec)
      };
    }

    // `procedure P(...)', `function F(...) : T' (the parameters left out where it was declared before)
    syntax RoutineHeader = Kind=RoutineKind Name=Ident Parameters=ParameterList? Result=(":" Ident)?
    {
      Ast() : object = {
        def result = if (Result.HasValue) pascalfront.TypeSpec.Named(pascalfront.N.At(Result.Value.Item2.Location), GetText(Result.Value.Item2.Body)) else null;
        pascalfront.Header(pascalfront.N.At(Location), Kind is RoutineKind.Function, GetText(Name.Body),
                           if (Parameters.HasValue) Parameters.Value.Ast() :> list[pascalfront.Param] else null, result)
      };
    }
    syntax RoutineKind { | Procedure = KProcedure | Function = KFunction }
    syntax ParameterList = "(" Groups=(ParameterGroup; ";")* ")"
    {
      Ast() : object = { mutable xs = []; foreach (g in Groups.Item1) xs ::= (g.Ast() :> pascalfront.Param); xs.Rev() };
    }
    syntax ParameterGroup
    {
      Ast() : object;
      | Value = Names=(Ident; ",")+ ":" Type=TypeSpec
        {
          override Ast = { mutable xs = []; foreach (n in Names.Item1) xs ::= GetText(n.Body); pascalfront.Param.Value(xs.Rev(), Type.Ast() :> pascalfront.TypeSpec) };
        }
      | ByRef = KVar Names=(Ident; ",")+ ":" Type=TypeSpec
        {
          override Ast = { mutable xs = []; foreach (n in Names.Item1) xs ::= GetText(n.Body); pascalfront.Param.ByRef(xs.Rev(), Type.Ast() :> pascalfront.TypeSpec) };
        }
      // a procedural parameter: `procedure p(x : real)', `function f(x : real) : real'
      | Routine = Header=RoutineHeader { override Ast = pascalfront.Param.Routine(Header.Ast() :> pascalfront.Header); }
    }

    syntax TypeSpec
    {
      Ast() : object;
      | Named = Name=Ident { override Ast = pascalfront.TypeSpec.Named(pascalfront.N.At(Location), GetText(Name.Body)); }
      | Sized = Name=Ident "[" Size=Expr "]" { override Ast = pascalfront.TypeSpec.Str(pascalfront.N.At(Location), GetText(Name.Body), Size.Ast() :> pascalfront.Expr); }
      | Enum = "(" Names=(Ident; ",")+ ")"
        {
          override Ast = { mutable xs = []; foreach (n in Names.Item1) xs ::= GetText(n.Body); pascalfront.TypeSpec.Enum(pascalfront.N.At(Location), xs.Rev()) };
        }
      | Range = Low=Expr ".." High=Expr
        {
          override Ast = pascalfront.TypeSpec.Range(pascalfront.N.At(Location), Low.Ast() :> pascalfront.Expr, High.Ast() :> pascalfront.Expr);
        }
      | Array = Packed=KPacked? KArray "[" Indexes=(TypeSpec; ",")+ "]" KOf Element=TypeSpec
        {
          override Ast = {
            mutable xs = []; foreach (i in Indexes.Item1) xs ::= (i.Ast() :> pascalfront.TypeSpec);
            pascalfront.TypeSpec.Array(pascalfront.N.At(Location), xs.Rev(), Element.Ast() :> pascalfront.TypeSpec)
          };
        }
      | Record = Packed=KPacked? KRecord Fields=FieldList KEnd
        {
          override Ast = pascalfront.TypeSpec.Record(pascalfront.N.At(Location), Fields.Ast() :> pascalfront.FieldList);
        }
      | SetOf = Packed=KPacked? KSet KOf Element=TypeSpec
        {
          override Ast = pascalfront.TypeSpec.SetOf(pascalfront.N.At(Location), Element.Ast() :> pascalfront.TypeSpec);
        }
      | FileOf = Packed=KPacked? KFile KOf Element=TypeSpec
        {
          override Ast = pascalfront.TypeSpec.FileOf(pascalfront.N.At(Location), Element.Ast() :> pascalfront.TypeSpec);
        }
      | Pointer = "^" Target=Ident { override Ast = pascalfront.TypeSpec.Pointer(pascalfront.N.At(Location), GetText(Target.Body)); }
      // a conformant array parameter (ISO's level 1): `array [lo..hi : integer; ...] of T', its bounds named
      | Conformant = Packed=KPacked? KArray "[" Bounds=(ConformantBound; ";")+ "]" KOf Element=TypeSpec
        {
          override Ast = {
            mutable xs = []; foreach (b in Bounds.Item1) xs ::= (b.Ast() :> string * string * pascalfront.TypeSpec);
            pascalfront.TypeSpec.Conformant(pascalfront.N.At(Location), xs.Rev(), Element.Ast() :> pascalfront.TypeSpec)
          };
        }
    }
    syntax ConformantBound = Low=Ident ".." High=Ident ":" Index=Ident
    {
      Ast() : object = (GetText(Low.Body), GetText(High.Body), pascalfront.TypeSpec.Named(pascalfront.N.At(Index.Location), GetText(Index.Body)) : pascalfront.TypeSpec);
    }

    // a record's fields: `a, b : T; ...', then its variant part (`case tag : T of 1: (...); ...')
    syntax FieldList = Sections=(FieldSection; ";"; ?)* Variant=VariantPart? ";"?
    {
      Ast() : object = {
        mutable fixed = []; foreach (s in Sections.Item1) fixed ::= (s.Ast() :> list[string] * pascalfront.TypeSpec);
        if (Variant.HasValue)
        {
          def (tag, tagType, cases) = Variant.Value.Ast() :> string * pascalfront.TypeSpec * list[list[pascalfront.Expr] * pascalfront.FieldList];
          pascalfront.FieldList(fixed.Rev(), tag, tagType, cases)
        }
        else pascalfront.FieldList(fixed.Rev(), null, null, [])
      };
    }
    syntax FieldSection = Names=(Ident; ",")+ ":" Type=TypeSpec
    {
      Ast() : object = { mutable xs = []; foreach (n in Names.Item1) xs ::= GetText(n.Body); (xs.Rev(), Type.Ast() :> pascalfront.TypeSpec) };
    }
    syntax VariantPart = KCase Tag=VariantTag KOf Cases=(VariantCase; ";"; ?)+
    {
      Ast() : object = {
        mutable cs = []; foreach (c in Cases.Item1) cs ::= (c.Ast() :> list[pascalfront.Expr] * pascalfront.FieldList);
        def (name, type) = Tag.Ast() :> string * pascalfront.TypeSpec;
        (name, type, cs.Rev())
      };
    }
    syntax VariantTag
    {
      Ast() : object;
      | Named = Name=Ident ":" Type=Ident
        {
          override Ast = (GetText(Name.Body), pascalfront.TypeSpec.Named(pascalfront.N.At(Type.Location), GetText(Type.Body)) : pascalfront.TypeSpec);
        }
      | Anonymous = Type=Ident
        {
          override Ast = (null : string, pascalfront.TypeSpec.Named(pascalfront.N.At(Type.Location), GetText(Type.Body)) : pascalfront.TypeSpec);
        }
    }
    syntax VariantCase = Labels=(Expr; ",")+ ":" "(" Fields=FieldList ")"
    {
      Ast() : object = { mutable xs = []; foreach (l in Labels.Item1) xs ::= (l.Ast() :> pascalfront.Expr); (xs.Rev(), Fields.Ast() :> pascalfront.FieldList) };
    }

    // (`;' separates statements; one before `end' is Pascal's empty statement)
    syntax Statements = Items=(Statement; ";"; ?)*
    {
      Ast() : object = { mutable xs = []; foreach (s in Items.Item1) xs ::= (s.Ast() :> pascalfront.Stmt); xs.Rev() };
    }

    syntax Statement
    {
      Ast() : object;
      | Labeled = Label=Digits ":" Stmt=Statement
        {
          override Ast = pascalfront.Stmt.Labeled(pascalfront.N.At(Location), GetText(Label), Stmt.Ast() :> pascalfront.Stmt);
        }
      | Assign = Target=Designator ":=" Value=Expr
        {
          override Ast = pascalfront.Stmt.Assign(pascalfront.N.At(Location), Target.Ast() :> pascalfront.Desig, Value.Ast() :> pascalfront.Expr);
        }
      // a procedure call; write, writeln, read and readln are the predeclared ones (their arguments may say a width)
      // (Turbo: a unit's routine by the unit's name, `Counter.Add(1)')
      | Call = Unit=UnitPrefix? Name=Ident Args=WriteArguments?
        {
          override Ast = pascalfront.Stmt.Call(pascalfront.N.At(Location), (if (Unit.HasValue) GetText(Unit.Value.Name.Body) + "." else "") + GetText(Name.Body),
                                               if (Args.HasValue) Args.Value.Ast() :> list[pascalfront.WArg] else []);
        }
      | Compound = KBegin Body=Statements KEnd
        {
          override Ast = pascalfront.Stmt.Block(pascalfront.N.At(Location), Body.Ast() :> list[pascalfront.Stmt]);
        }
      | If = KIf Condition=Expr KThen Then=Statement Else=(KElse Statement)?
        {
          override Ast = pascalfront.Stmt.If(pascalfront.N.At(Location), Condition.Ast() :> pascalfront.Expr, Then.Ast() :> pascalfront.Stmt,
                                             if (Else.HasValue) Else.Value.Item2.Ast() :> pascalfront.Stmt else null);
        }
      | While = KWhile Condition=Expr KDo Body=Statement
        {
          override Ast = pascalfront.Stmt.While(pascalfront.N.At(Location), Condition.Ast() :> pascalfront.Expr, Body.Ast() :> pascalfront.Stmt);
        }
      | Repeat = KRepeat Body=Statements KUntil Condition=Expr
        {
          override Ast = pascalfront.Stmt.Repeat(pascalfront.N.At(Location), Body.Ast() :> list[pascalfront.Stmt], Condition.Ast() :> pascalfront.Expr);
        }
      | For = KFor Variable=Ident ":=" From=Expr Direction=ForDirection To=Expr KDo Body=Statement
        {
          override Ast = pascalfront.Stmt.For(pascalfront.N.At(Location), GetText(Variable.Body), From.Ast() :> pascalfront.Expr,
                                              To.Ast() :> pascalfront.Expr, Direction is ForDirection.Down, Body.Ast() :> pascalfront.Stmt);
        }
      | Case = KCase Selector=Expr KOf Arms=(CaseArm; ";"; ?)+ Else=CaseElse? KEnd
        {
          override Ast = {
            mutable arms = []; foreach (a in Arms.Item1) arms ::= (a.Ast() :> list[pascalfront.Expr * pascalfront.Expr] * pascalfront.Stmt);
            pascalfront.Stmt.Case(pascalfront.N.At(Location), Selector.Ast() :> pascalfront.Expr, arms.Rev(),
                                  if (Else.HasValue) Else.Value.Body.Ast() :> list[pascalfront.Stmt] else null)
          };
        }
      | With = KWith Records=(Designator; ",")+ KDo Body=Statement
        {
          override Ast = {
            mutable xs = []; foreach (r in Records.Item1) xs ::= (r.Ast() :> pascalfront.Desig);
            pascalfront.Stmt.With(pascalfront.N.At(Location), xs.Rev(), Body.Ast() :> pascalfront.Stmt)
          };
        }
      | Goto = KGoto Label=Digits { override Ast = pascalfront.Stmt.Goto(pascalfront.N.At(Location), GetText(Label)); }
    }
    syntax ForDirection { | Up = KTo | Down = KDownto }
    syntax CaseArm = Labels=(CaseLabel; ",")+ ":" Body=Statement
    {
      Ast() : object = { mutable xs = []; foreach (l in Labels.Item1) xs ::= (l.Ast() :> pascalfront.Expr * pascalfront.Expr); (xs.Rev(), Body.Ast() :> pascalfront.Stmt) };
    }
    // a label, or a range of them (Turbo Pascal's `1..5:')
    syntax CaseLabel = Low=Expr High=(".." Expr)?
    {
      Ast() : object = (Low.Ast() :> pascalfront.Expr, if (High.HasValue) High.Value.Item2.Ast() :> pascalfront.Expr else null);
    }
    syntax CaseElse = ";"? Keyword=CaseElseKeyword Body=Statements;
    syntax CaseElseKeyword { | Else = KElse | Otherwise = KOtherwise }

    syntax WriteArguments = "(" Items=(WriteArgument; ",")* ")"
    {
      Ast() : object = { mutable xs = []; foreach (a in Items.Item1) xs ::= (a.Ast() :> pascalfront.WArg); xs.Rev() };
    }
    // `e', `e:width', `e:width:decimals'
    syntax WriteArgument = Value=Expr Width=(":" Expr)? Decimals=(":" Expr)?
    {
      Ast() : object = pascalfront.WArg(Value.Ast() :> pascalfront.Expr,
                                        if (Width.HasValue) Width.Value.Item2.Ast() :> pascalfront.Expr else null,
                                        if (Decimals.HasValue) Decimals.Value.Item2.Ast() :> pascalfront.Expr else null);
    }

    // a variable, an element (`a[i, j]'), a field (`r.f'), a pointer's target or a file's buffer (`p^')
    syntax Designator = Name=Ident Selectors=Selector*
    {
      Ast() : object = {
        mutable xs = []; foreach (s in Selectors) xs ::= (s.Ast() :> pascalfront.Sel);
        pascalfront.Desig(pascalfront.N.At(Location), GetText(Name.Body), xs.Rev())
      };
    }
    syntax Selector
    {
      Ast() : object;
      | Index = "[" Items=(Expr; ",")+ "]"
        {
          override Ast = { mutable xs = []; foreach (e in Items.Item1) xs ::= (e.Ast() :> pascalfront.Expr); pascalfront.Sel.Index(xs.Rev()) };
        }
      | Field = "." Name=Ident { override Ast = pascalfront.Sel.Field(GetText(Name.Body)); }
      | Deref = "^" { override Ast = pascalfront.Sel.Deref(); }
    }

    syntax Expr
    {
      Ast() : object;
      precedence Relational:
      | Equal = Left=Expr "=" Right=Expr { override Ast = pascalfront.Expr.Bin(pascalfront.N.At(Location), "=", Left.Ast() :> pascalfront.Expr, Right.Ast() :> pascalfront.Expr); }
      | NotEqual = Left=Expr "<>" Right=Expr { override Ast = pascalfront.Expr.Bin(pascalfront.N.At(Location), "<>", Left.Ast() :> pascalfront.Expr, Right.Ast() :> pascalfront.Expr); }
      | Less = Left=Expr "<" Right=Expr { override Ast = pascalfront.Expr.Bin(pascalfront.N.At(Location), "<", Left.Ast() :> pascalfront.Expr, Right.Ast() :> pascalfront.Expr); }
      | LessEqual = Left=Expr "<=" Right=Expr { override Ast = pascalfront.Expr.Bin(pascalfront.N.At(Location), "<=", Left.Ast() :> pascalfront.Expr, Right.Ast() :> pascalfront.Expr); }
      | Greater = Left=Expr ">" Right=Expr { override Ast = pascalfront.Expr.Bin(pascalfront.N.At(Location), ">", Left.Ast() :> pascalfront.Expr, Right.Ast() :> pascalfront.Expr); }
      | GreaterEqual = Left=Expr ">=" Right=Expr { override Ast = pascalfront.Expr.Bin(pascalfront.N.At(Location), ">=", Left.Ast() :> pascalfront.Expr, Right.Ast() :> pascalfront.Expr); }
      | In = Left=Expr KIn Right=Expr { override Ast = pascalfront.Expr.Bin(pascalfront.N.At(Location), "in", Left.Ast() :> pascalfront.Expr, Right.Ast() :> pascalfront.Expr); }
      precedence Additive:
      | Add = Left=Expr "+" Right=Expr { override Ast = pascalfront.Expr.Bin(pascalfront.N.At(Location), "+", Left.Ast() :> pascalfront.Expr, Right.Ast() :> pascalfront.Expr); }
      | Sub = Left=Expr "-" Right=Expr { override Ast = pascalfront.Expr.Bin(pascalfront.N.At(Location), "-", Left.Ast() :> pascalfront.Expr, Right.Ast() :> pascalfront.Expr); }
      | Or = Left=Expr KOr Right=Expr { override Ast = pascalfront.Expr.Bin(pascalfront.N.At(Location), "or", Left.Ast() :> pascalfront.Expr, Right.Ast() :> pascalfront.Expr); }
      | Xor = Left=Expr KXor Right=Expr { override Ast = pascalfront.Expr.Bin(pascalfront.N.At(Location), "xor", Left.Ast() :> pascalfront.Expr, Right.Ast() :> pascalfront.Expr); }
      precedence Multiplicative:
      | Mul = Left=Expr "*" Right=Expr { override Ast = pascalfront.Expr.Bin(pascalfront.N.At(Location), "*", Left.Ast() :> pascalfront.Expr, Right.Ast() :> pascalfront.Expr); }
      | Divide = Left=Expr "/" Right=Expr { override Ast = pascalfront.Expr.Bin(pascalfront.N.At(Location), "/", Left.Ast() :> pascalfront.Expr, Right.Ast() :> pascalfront.Expr); }
      | Div = Left=Expr KDiv Right=Expr { override Ast = pascalfront.Expr.Bin(pascalfront.N.At(Location), "div", Left.Ast() :> pascalfront.Expr, Right.Ast() :> pascalfront.Expr); }
      | Mod = Left=Expr KMod Right=Expr { override Ast = pascalfront.Expr.Bin(pascalfront.N.At(Location), "mod", Left.Ast() :> pascalfront.Expr, Right.Ast() :> pascalfront.Expr); }
      | And = Left=Expr KAnd Right=Expr { override Ast = pascalfront.Expr.Bin(pascalfront.N.At(Location), "and", Left.Ast() :> pascalfront.Expr, Right.Ast() :> pascalfront.Expr); }
      | Shl = Left=Expr KShl Right=Expr { override Ast = pascalfront.Expr.Bin(pascalfront.N.At(Location), "shl", Left.Ast() :> pascalfront.Expr, Right.Ast() :> pascalfront.Expr); }
      | Shr = Left=Expr KShr Right=Expr { override Ast = pascalfront.Expr.Bin(pascalfront.N.At(Location), "shr", Left.Ast() :> pascalfront.Expr, Right.Ast() :> pascalfront.Expr); }
      precedence Unary:
      | Not = KNot Operand=Expr { override Ast = pascalfront.Expr.Un(pascalfront.N.At(Location), "not", Operand.Ast() :> pascalfront.Expr); }
      | Negate = "-" Operand=Expr { override Ast = pascalfront.Expr.Un(pascalfront.N.At(Location), "-", Operand.Ast() :> pascalfront.Expr); }
      | Plus = "+" Operand=Expr { override Ast = pascalfront.Expr.Un(pascalfront.N.At(Location), "+", Operand.Ast() :> pascalfront.Expr); }
      precedence 0:
      | Number = Value=Digits { override Ast = pascalfront.Expr.Num(pascalfront.N.At(Location), int.Parse(GetText(Value))); }
      | Hex = Value=HexDigits
        {
          override Ast = pascalfront.Expr.Num(pascalfront.N.At(Location), int.Parse(GetText(Value).Substring(1), System.Globalization.NumberStyles.HexNumber));
        }
      | RealNumber = Value=RealLiteral
        {
          override Ast = pascalfront.Expr.RealNum(pascalfront.N.At(Location), double.Parse(GetText(Value), System.Globalization.CultureInfo.InvariantCulture));
        }
      | Text = Value=StringLiteral
        {
          override Ast = pascalfront.Expr.Str(pascalfront.N.At(Location), pascalfront.N.Text(GetText(Value)));
        }
      | NilPointer = KNil { override Ast = pascalfront.Expr.Nil(pascalfront.N.At(Location)); }
      | SetOf = "[" Items=(SetElement; ",")* "]"
        {
          override Ast = { mutable xs = []; foreach (e in Items.Item1) xs ::= (e.Ast() :> pascalfront.Expr * pascalfront.Expr); pascalfront.Expr.SetOf(pascalfront.N.At(Location), xs.Rev()) };
        }
      | Call = Unit=UnitPrefix? Name=Ident "(" Args=(Expr; ",")* ")"
        {
          override Ast = { mutable xs = []; foreach (a in Args.Item1) xs ::= (a.Ast() :> pascalfront.Expr); pascalfront.Expr.Call(pascalfront.N.At(Location), (if (Unit.HasValue) GetText(Unit.Value.Name.Body) + "." else "") + GetText(Name.Body), xs.Rev()) };
        }
      | Variable = Target=Designator { override Ast = pascalfront.Expr.Var(pascalfront.N.At(Location), Target.Ast() :> pascalfront.Desig); }
      | Group = "(" Inner=Expr ")" { override Ast = Inner.Ast(); }
    }
    syntax UnitPrefix = Name=Ident ".";
    syntax SetElement = Low=Expr High=(".." Expr)?
    {
      Ast() : object = (Low.Ast() :> pascalfront.Expr, if (High.HasValue) High.Value.Item2.Ast() :> pascalfront.Expr else null);
    }
  }
}
