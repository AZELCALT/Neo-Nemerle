// goto: a loop written with a label, and a jump out of nested loops
space Pascal
{
  program Jumps;
  label 10, 20, 99;
  var
    i, j, n : integer;
  begin
    n := 0;
  10:
    n := n + 1;
    if n < 5 then goto 10;
    writeln('counted to ', n);
    for i := 1 to 9 do
      for j := 1 to 9 do
        if i * j = 42 then goto 20;
  20:
    writeln('found ', i, ' * ', j);
    goto 99;
    writeln('never');
  99:
    writeln('done')
  end.
}
