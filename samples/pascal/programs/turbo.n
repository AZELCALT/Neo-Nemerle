// Turbo Pascal's additions: exit, break and continue; typed constants (a routine's keeps its value between calls);
// integers of other sizes; bit operators; #codes in strings; string[n]; string routines; str and val; low, high and
// sizeof
space Pascal
{
  program Turbo;
  type
    Color = (red, green, blue);
    Point = record x, y : integer end;
  const
    greeting : string = 'hi';
    squares : array [1..3] of integer = (1, 4, 9);
    origin : Point = (x: 3; y: 4);
  var
    i, n, code : integer;
    b : byte;
    s : string;
    short : string[5];
    x : real;

  procedure Count;
  const
    calls : integer = 0;
  begin
    calls := calls + 1;
    write(calls)
  end;

  function FirstOver(limit : integer) : integer;
  var
    k : integer;
  begin
    FirstOver := -1;
    for k := 1 to 100 do
      if k * k > limit then
      begin
        FirstOver := k;
        exit
      end
  end;

  begin
    for i := 1 to 10 do
    begin
      if i = 3 then continue;
      if i = 6 then break;
      write(i)
    end;
    writeln;
    Count; Count; Count;
    writeln;
    writeln(FirstOver(50), ' ', greeting, ' ', squares[2] + squares[3], ' ', origin.x * origin.y);
    b := 200;
    writeln(b, ' ', 5 and 3, ' ', 5 or 3, ' ', 5 xor 3, ' ', 1 shl 4, ' ', 256 shr 2, ' ', not 0, ' ', true xor false);
    s := 'Hello World';
    delete(s, 1, 6);
    insert('Big ', s, 1);
    writeln(s, ' ', length('a'#13#10), ' ', #65'b'#67);
    str(3.14159:6:2, s);
    val('17', n, code);
    writeln('[', s, '] ', n + 1, ' ', code);
    val('1x', n, code);
    write(code, ' ');
    val('2.5', x, code);
    writeln(x:3:1, ' ', code);
    short := 'truncated';
    writeln(short, ' ', length(short));
    writeln(ord(high(Color)), ' ', high(byte), ' ', low(shortint), ' ', high(squares), ' ', sizeof(Point));
    exit;
    writeln('not reached')
  end.
}
