class X {
        static Main () :  void
        {
                mutable  a = Nemerle.ExtensionsMacros.DefaultValue (int) :int;

                call (out a);
                assert(a == 1);
        }

        static call ( a : out int) :  void
        {
    mutable cond = true;
                while (cond){
                        try {
                                a = 1;
                                cond = false;
                        }
                        catch { | _ =>  {
                        }
                        }
                };
        }
}

