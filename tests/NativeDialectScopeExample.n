// A space is a logical file inside this file. The program and the space share scope A: the program writes `answer`,
// the space's mapping reads it and writes `doubled` back, and the program reads that.
scope A;
grammar Demo
{
  using Nemerle.Compiler.NitraDialectServices;
  using Nemerle.Compiler.Parsetree;
  syntax module Query
  {
    using Nitra.Core;
    [StartRule] syntax Input = "answer"
    {
      map (context : NitraDialectContext) PExpr = {
        def shared = context.Scope("A");
        shared.Set("doubled", <[ $(shared.Get("answer").Value :> PExpr) * 2 ]>);
        <[ () ]>
      };
    }
  }
}

scope.A.registery("answer", type("integer"));
scope.A.registery("doubled", type("integer"));
scope.A.answer = 21;
space Demo [A] { answer }
def doubled = scope.A.doubled;
System.Console.WriteLine(doubled);
