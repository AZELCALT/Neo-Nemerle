// A space is a logical file inside this file. Scope A is storage the program and the space share: the program writes
// `answer`, the space's code reads it and writes `doubled`, and the program reads that.
scope A;
grammar Demo
{
  using Nemerle.Compiler.NitraDialectServices;
  using Nemerle.Compiler.Parsetree;
  syntax module Query
  {
    using Nitra.Core;
    [StartRule] syntax Input = "answer"
    {
      map (context : NitraDialectContext) PExpr = {
        def shared = context.Scope("A");
        shared.Write("doubled", <[ $(shared.Read("answer")) * 2 ]>)
      };
    }
  }
}

scope.A.registery("answer", type("int"));
scope.A.registery("doubled", type("int"));
scope.A.answer = 21;
space Demo [A] { answer }
def doubled = scope.A.doubled;
System.Console.WriteLine(doubled);
