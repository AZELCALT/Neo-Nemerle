// ---- AST/AstType.n (Nitra.Ast) ----
public interface AstTypeSymbol : TypeSymbol
{
}

public class AstTypeVarSymbol : BoundedTypeVarSymbol, AstTypeSymbol
{
  get_Declarations() : Seq[AstType] implements AstTypeSymbol.get_Declarations
