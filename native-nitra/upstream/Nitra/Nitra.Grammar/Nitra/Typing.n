    base(name, name.Value);
    _node = node;
  }

  public override Type : AstType           { get { _node.ReturnType } }
  public override Expr : SyntaxMappingExpr { get { assert2(false, "Expression not available"); SyntaxMappingExpr.Error(FirstLocation) } }
}

