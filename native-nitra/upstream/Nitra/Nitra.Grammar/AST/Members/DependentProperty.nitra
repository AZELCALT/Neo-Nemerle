using Nitra.Runtime;
using Nitra.Grammar;
using DotNet;
using Nitra.Ast;

using Nitra.Grammar.AstUtils;
using Nitra.Declarations;

namespace Nitra.Ast
{
  abstract declaration DependentProperty : BindableAst
  {
    symbol
    {
      SpanClass = NitraLang.DependentPropertySpanClass;
      Kind      = "dependent property";
    }

    Type.Scope = Scope;

    Type : QualifiedReference;
  }
}
