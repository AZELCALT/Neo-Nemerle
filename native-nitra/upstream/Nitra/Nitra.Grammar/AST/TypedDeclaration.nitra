using Nitra.Runtime;
using Nitra.Grammar;
using DotNet;
using Nitra.Ast;
using Nitra.Declarations;

namespace Nitra.Ast
{
  abstract declaration TypedDeclaration
  {
    symbol
    {
      Kind  = "typed declaration";
      Scope = Type.Scope;

    stage 1:
      in Type : TypeSymbol;
    }
  }
}
