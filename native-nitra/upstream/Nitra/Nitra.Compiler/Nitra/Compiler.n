          }
        ]>);
        ExternalSymbolType.DisableImplicitConstructor();
        _manualReadWrite = false;

      | Some(tb) =>
        ExternalSymbolType = tb;
        _manualReadWrite = true;
    }
  }

  public DefineMembers() : void
  {
    TargetSymbolType.DefineConditional(<[ decl:
      SymbolTypeId : string implements Nitra.Serialization.ISymbol.SymbolTypeId
      {
        get { $(TargetSymbolType.FullName : string) }
      }
    ]>);

    def symbolProperties = SymbolEmitterUtils.GetSymbolProperties(TargetSymbolType);
    def symbolType       = TargetSymbolType.GetMemType();

    unless (_manualReadWrite)
    {
      def serializeCode = SCG.List();
      serializeCode.Add(<[ IgnoreParams() ]>);

      def members = SCG.List();
      foreach (p when !p.IsExternal in symbolProperties)
      {
        def m = p.Property;
        members.Add(RecordMemberInfo(m, _serializationEmitter.EnqueueType(symbolType.TypeOfMember(m).Fix())));
      }

      _serializationEmitter.Formatter.WriteRecordMembers(serializeCode, members, () => <[ this ]>, (expr, _) => expr);

      TargetSymbolType.DefineConditional(<[ decl:
        Serialize(writer : System.IO.BinaryWriter, metadataWriter : Nitra.Serialization.IMetadataWriter) : void implements Nitra.Serialization.IExportableSymbol.Serialize
        {
          ..$serializeCode
        }
      ]>);
    }

    foreach (prop in symbolProperties)
      DefineSymbolProperty(prop);

    ExternalSymbolType.Define(<[ decl:
      public override Description : string { get { $(SymbolEmitterUtils.MakeDescriptionText(ExternalSymbolType.Name) : string) } }
    ]>);

    ExternalSymbolType.DefineConditional(<[ decl:
      public static CreateSymbols(metadataReader : Nitra.Serialization.IMetadataReader, reader : System.IO.BinaryReader) : void
      {
        def location   = metadataReader.SymbolLocation;
        def assemblyId = metadataReader.AssemblyId;
        def loop()
        {
          def symbolId = reader.ReadInt32();
          when (symbolId > 0)
          {
            def nodeId   = reader.ReadInt32();
            if (nodeId == 0)
            {
              def name     = reader.ReadString();
              def symbol   = $(ExternalSymbolType.GetMemType() : typed)(location, name, assemblyId);
              metadataReader.Register(symbolId, symbol);
            }
            else
            {
              def node     = metadataReader.GetNode(nodeId);
              def symbol   = $(ExternalSymbolType.GetMemType() : typed)(location, node.PartName, assemblyId);
              node.SetSymbol(symbol, location);
              metadataReader.Register(symbolId, symbol);
            }
            loop();
          }
        }
        loop();
      }
    ]>);

    unless (_manualReadWrite)
    {
      def deserializeCode = SCG.List();
      deserializeCode.Add(<[ IgnoreParams() ]>);

      def members = SCG.List();
      foreach (p when !p.IsExternal in symbolProperties)
      {
        def m = p.OverriddenProperty;
        members.Add(RecordMemberInfo(m, _serializationEmitter.EnqueueType(symbolType.TypeOfMember(m).Fix())));
      }

      _serializationEmitter.Formatter.ReadRecordMembers(deserializeCode, members, (expr, info) => <[ this.$(info.OriginalName : usesite) = $expr ]>);

      def readExternal = symbolProperties.MapFiltered(_.IsExternal,
        p => <[ this.$(p.Property.Name : usesite) = reader.ReadPropertyValue(project, this, $(p.Property.Name : string)) ]>);

      ExternalSymbolType.DefineConditional(<[ decl:
        Deserialize(reader : System.IO.BinaryReader, metadataReader : Nitra.Serialization.IMetadataReader) : void implements Nitra.Serialization.IImportableSymbol.Deserialize
        {
          ..$deserializeCode;
        }
      ]>);
      ExternalSymbolType.DefineConditional(<[ decl:
        ReadExternalProperties(project : Nitra.ProjectSystem.Project, reader : Nitra.Serialization.IExternalSymbolPropertyReader) : void implements Nitra.Serialization.IImportableSymbol.ReadExternalProperties
        {
          IgnoreParams();
          ..$readExternal;
        }
      ]>);
    }

    foreach (ctor when !ctor.IsStatic in TargetSymbolType.GetConstructors())
      match (ctor.GetParameters())
      {
        | [p1, p2] when p1.Type.Equals(Environment.LocationTypeVar) && p2.Type.Equals(Environment.StringTypeVar) =>
          ExternalSymbolType.Define(<[ decl:
            public this(definition : Nitra.Runtime.Location, name : string, assemblyId : byte)
            {
              base(definition, name);
              AssemblyId = assemblyId;
            }
          ]>);
          break;

        | [p1] when p1.Type.Equals(Environment.StringTypeVar) =>
          ExternalSymbolType.Define(<[ decl:
            public this(definition : Nitra.Runtime.Location, name : string, assemblyId : byte)
            {
              base(name);
              AssemblyId = assemblyId;
              _definition = definition;
            }
          ]>);
          ExternalSymbolType.Define(<[ decl: private          _definition   : Nitra.Runtime.Location                                 ]>);
          ExternalSymbolType.Define(<[ decl: public  override Locations     : list[Nitra.Runtime.Location] { get { [_definition] } } ]>);
          ExternalSymbolType.Define(<[ decl: public  override FirstLocation : Nitra.Runtime.Location       { get {  _definition  } } ]>);
          break;

        | _ => ()
      }
  }

  public Emit() : void
  {
    ExternalSymbolType.Compile();
  }

  private DefineSymbolProperty(property : SymbolProperty) : void
  {
    property.OverriddenProperty = ExternalSymbolType.DefineAndReturn(<[ decl:
      public override $(property.Property.Name : usesite) : $(property.Property.GetMemType() : typed)
      {
        get;
        private set;
      }
    ]>) :> IProperty;
  }
}

// ---- Generation/Symbols/SymbolEmitterUtils.n (Nitra.Compiler) ----
internal sealed class SymbolProperty
{
  public this(property : IProperty)
  {
    Property = property;
  }

  public Property           : IProperty { get; }
  public OverriddenProperty : IProperty { get; set; }
  public IsExternal         : bool      { [Memoize] get { Property.IsCustomAttributeDefined("Nitra.Serialization.ExternalPropertyAttribute") } }
}

internal module SymbolEmitterUtils
{
  private _systemProperties : HashSet[string] = HashSet(["Description", "Locations", "FirstLocation"]);

  public GetSymbolProperties(targetSymbolType : TypeBuilder) : list[SymbolProperty]
  {
    def isSymbolProperty(p)
    {
      // TODO: add attribute check
      !_systemProperties.Contains(p.Name) && p.GetGetter()?.IsAbstract
    }
    targetSymbolType
      .GetProperties(BindingFlags.Instance | BindingFlags.Public)
      .MapFiltered(isSymbolProperty, SymbolProperty(_));
  }

  public MakeDescriptionText(text : string) : string
  {
    def length =
    {
      def symbolText = "Symbol";
      if (text.EndsWith(symbolText))
        text.Length - symbolText.Length
      else
        text.Length;
    }
    def buffer = System.Text.StringBuilder();
    mutable needWordbreak = false;
    for (mutable i = 0; i < length; ++i)
    {
      def c = text[i];
      if (char.IsUpper(c))
      {
        when (needWordbreak)
        {
          _ = buffer.Append(' ');
          needWordbreak = false;
        }
      }
      else
        needWordbreak = true;
      _ = buffer.Append(char.ToLowerInvariant(c));
    }
    buffer.ToString()
  }
}

// ---- Generation/SyntaxModule/SyntaxModuleEmitter.n (Nitra.Compiler) ----
internal class SyntaxModuleEmitter
{
  public Environment   : EmitterEnvironment { get; }
  public Env           : GlobalEnv          { get; }
  public SyntaxModule  : SyntaxModuleSymbol { get; }

  public GrammarTB               : TypeBuilder { get; }
  public GrammarImplTB           : TypeBuilder { get; }
  private GrammarDescriptorImplTB : TypeBuilder;

  private SyntaxModuleParseTreeTb        : TypeBuilder; //TODO : переместить в более подходящее место

  private _ruleParserEmitters                  : List[RuleParserEmitter] = List();
  private _ruleDescriptorEmitters              : List[IRuleDescriptorEmitter] = List();
  private _allParseTreeEmitters                : List[IParseTreeEmitter] = List();
  private _simpleParseTreeEmitters             : List[IParseTreeEmitter] = List();
  private _extensionParseTreeEmitters          : List[IParseTreeEmitter] = List();
  private _parseTreeEmitterDefineTypeFunctions : Hashtable[IRuleDeclarationSite, ClassMember.TypeDeclaration -> TypeBuilder] = Hashtable();

  public this(environment : EmitterEnvironment, syntaxModule : SyntaxModuleSymbol)
  {
    Environment       = environment;
    SyntaxModule      = syntaxModule;
    Env               = Environment.NamespaceOfSymbol(syntaxModule);
    _externalGrammars = HashSet(syntaxModule.ExternalImports);

    GrammarTB               = Env.Define(<[ decl: public partial module $(syntaxModule.Name : usesite) { } ]>);
    GrammarImplTB           = GrammarTB.DefineNestedType(<[decl: public module $(AssemblyConstants.GrammarImplName : usesite) { } ]>);
    GrammarDescriptorImplTB = GrammarTB.DefineNestedType(<[decl:
      private sealed class $("_N_GrammarDescriptor_#" : usesite) : Nitra.Runtime.GrammarDescriptor
      {
        public this() {}
        public override Name        : string { get { $(syntaxModule.Name                 : string) } }
        public override FullName    : string { get { $(syntaxModule.Node.FullName        : string) } }
        public override Namespace   : string { get { $(syntaxModule.Node.Parent.FullName : string) } }
      }
    ]>);
    GrammarTB.DefineConditional(<[ decl: private static _staticDescriptor : Nitra.Runtime.GrammarDescriptor = $(GrammarDescriptorImplTB.GetMemType() : typed)() ]>);
    GrammarTB.DefineConditional(<[ decl: public static StaticDescriptor : Nitra.Runtime.GrammarDescriptor { get { _staticDescriptor } } ]>);

    SyntaxModuleParseTreeTb = Env.Define(<[ decl: public partial module $(syntaxModule.Name + "ParseTree" : usesite) {} ]>);

    RecognitionEmitter.Define(SyntaxModule, GrammarTB);
    def allRuleSymbols = SyntaxModule.GetAllRuleSymbols();

    foreach (ruleSymbol in allRuleSymbols)
    {
      | ExtensibleRuleSymbol       => ()
      | ExtensionRuleSymbol  as rs => _ruleParserEmitters.Add(ExtensionRuleParserEmitter(this, rs))
      | SimpleRuleSymbol     as rs => _ruleParserEmitters.Add(SimpleRuleParserEmitter(this, rs))
      | RegularRuleSymbol    as rs => _ruleParserEmitters.Add(RegularRuleParserEmitter(this, rs))
      | _                          => assert(false);
    }

    // TODO: Нужно собрать литералы.
    def code = List();
    foreach (e is RegularRuleParserEmitter in _ruleParserEmitters)
      code.Add(<[  _ = results.Add($(GrammarImplTB.GetMemType() : typed).$(e.MethodName : global)(pos, text)); ]>);

    GrammarDescriptorImplTB.Define(<[ decl:
      public override ParseAllGrammarTokens(pos : int, text : string, results : HashSet[int]) : void
      {
        IgnoreParams();
        ..$code;
      }
    ]>);

    mutable extensibleRuleSymbols = [];
    mutable simpleRuleSymbols     = [];
    mutable regularRuleSymbols    = [];
    mutable postfixRuleSymbols    = [];
    mutable prefixRuleSymbols     = [];
    foreach (ruleSymbol in allRuleSymbols)
    {
      | ExtensibleRuleSymbol                         as ruleSymbol => extensibleRuleSymbols ::= ruleSymbol
      | SimpleRuleSymbol                             as ruleSymbol => simpleRuleSymbols     ::= ruleSymbol
      | RegularRuleSymbol                            as ruleSymbol => regularRuleSymbols    ::= ruleSymbol
      | ExtensionRuleSymbol(ExtensionType = Postfix) as ruleSymbol => postfixRuleSymbols    ::= ruleSymbol
      | ExtensionRuleSymbol(ExtensionType = Prefix)  as ruleSymbol => prefixRuleSymbols     ::= ruleSymbol
      | _ => ()
    }
    unless (extensibleRuleSymbols.IsEmpty) _ruleDescriptorEmitters.Add(ExtensibleRuleDescriptorEmitter(this, extensibleRuleSymbols));
    unless (simpleRuleSymbols.IsEmpty)     _ruleDescriptorEmitters.Add(SimpleRuleDescriptorEmitter(this, simpleRuleSymbols));
    unless (regularRuleSymbols.IsEmpty)    _ruleDescriptorEmitters.Add(RegularRuleDescriptorEmitter(this, regularRuleSymbols));
    unless (prefixRuleSymbols.IsEmpty)     _ruleDescriptorEmitters.Add(PrefixRuleDescriptorEmitter(this, prefixRuleSymbols));
    unless (postfixRuleSymbols.IsEmpty)    _ruleDescriptorEmitters.Add(PostfixRuleDescriptorEmitter(this, postfixRuleSymbols));

    DefineBindingPowerRelations(syntaxModule);
    DefineAllPrecedences(syntaxModule);

    when (SyntaxModuleParseTreeTb != null)
    {
      foreach (ruleSymbol when ruleSymbol.Type is RuleType.Ref in SyntaxModule.Node.GetDescendants.[SyntaxRuleSymbol]())
      {
        match (ruleSymbol)
        {
          | SimpleRuleSymbol as s =>
            def emitter = SimpleRuleParseTreeEmitter(Environment, s);
            _simpleParseTreeEmitters.Add(emitter);
            _allParseTreeEmitters.Add(emitter);

          | ExtensibleRuleSymbol as s =>
            def emitter = ExtensibleRuleParseTreeEmitter(Environment, s);
            _simpleParseTreeEmitters.Add(emitter);
            _allParseTreeEmitters.Add(emitter);

          | ExtensionRuleSymbol as s =>
            def emitter = ExtensionRuleParseTreeEmitter(Environment, s);
            _extensionParseTreeEmitters.Add(emitter);
            _allParseTreeEmitters.Add(emitter);

          | _ => ()
        }
      }

      foreach (extendSyntaxSymbol in SyntaxModule.Node.GetDescendants.[ExtendSyntaxSymbol]())
      {
        def emitter = ExtendSyntaxParseTreeEmitter(extendSyntaxSymbol);
        _simpleParseTreeEmitters.Add(emitter);
        _allParseTreeEmitters.Add(emitter);
      }

      _parseTreeEmitterDefineTypeFunctions[SyntaxModule] = SyntaxModuleParseTreeTb.DefineNestedType;
      foreach (emitter when emitter.Symbol is IRuleDeclarationSite in _allParseTreeEmitters)
      {
        _parseTreeEmitterDefineTypeFunctions[emitter.Symbol :> IRuleDeclarationSite] =
          fun (decl)
          {
            DefineParseTreeTypes(emitter);
            emitter.DefineNestedType(decl)
          };
      }
    }
  }

  private GetPrecedenceSymbolOwnerReference(symbol : IPrecedenceSymbolOwner) : PExpr
  {
    match (symbol)
    {
      | extendSymbol is ExtendSyntaxSymbol =>
        if (extendSymbol.Extend is Some(symbol))
          symbol.GetRuleDescriptorRef();
        else
          PExpr.Error("ICE: Unresolved symbol in DefineBindingPowerRelations.");

      | extensibleRuleSymbol is ExtensibleRuleSymbol =>
        extensibleRuleSymbol.GetRuleDescriptorRef();

      | _ =>
          PExpr.Error("ICE: Unknown symbol in DefineBindingPowerRelations.");
    }
  }

  private DefineBindingPowerRelations(syntaxModule : SyntaxModuleSymbol) : void
  {
    def convert(symbol : IPrecedenceSymbolOwner, relations : List[string * string]) : PExpr
    {
      def symbol = GetPrecedenceSymbolOwnerReference(symbol);
      def relations = relations.Map((lo, hi) => <[($lo, $hi)]>);
      (<[ ($symbol, array[..$relations]) ]>);
    }
    def relations = syntaxModule.PrecedenceRelations.Grouping(r => (r.Symbol, (r.Low, r.Hi))).KeyValuePairs.Map(convert);
    GrammarDescriptorImplTB.DefineConditional(<[ decl: public override BindingPowerRelations : array[ExtensibleRuleDescriptor * array[string * string]] { get { array[..$relations] } } ]> );
  }

  private DefineAllPrecedences(syntaxModule : SyntaxModuleSymbol) : void
  {
    def convert(symbol : IPrecedenceSymbolOwner, allPrecedences : List[string]) : PExpr
    {
      def symbol = GetPrecedenceSymbolOwnerReference(symbol);
      def allPrecedences = allPrecedences.Map((name) => <[$name]>);
      (<[ ($symbol, array[..$allPrecedences]) ]>);
    }
    def relations = syntaxModule.AllPrecedences.Grouping(p => (p.Symbol, p.Name)).KeyValuePairs.Map(convert);
    GrammarDescriptorImplTB.DefineConditional(<[ decl: public override AllPrecedences : array[ExtensibleRuleDescriptor * array[string]] { get { array[..$relations] } } ]> );
  }

  public DefineSimpleParseTreeTypes() : void
  {
    foreach (emitter in _simpleParseTreeEmitters)
      DefineParseTreeTypes(emitter);
  }

  public DefineExtensionParseTreeTypes() : void
  {
    foreach (emitter in _extensionParseTreeEmitters)
      DefineParseTreeTypes(emitter);
  }

  public DefineParseTreeMembers() : void
  {
    foreach (emitter in _allParseTreeEmitters)
      emitter.DefineMembers();
  }

  private _externalGrammars : HashSet[SyntaxModuleSymbol];

  public CallRule(callSymbol : RuleSymbol) : void
  {
    when (callSymbol.DeclaringModule : object != SyntaxModule)
      _ = _externalGrammars.Add(callSymbol.DeclaringModule);
  }

  public DefineParserTypes() : void
  {
    foreach (emitter in _ruleParserEmitters)
      emitter.DefineParser();

    foreach (emitter in _ruleDescriptorEmitters)
      emitter.DefineDescriptor();
  }

  public DefineParserMethods() : void
  {
    foreach (emitter in _ruleParserEmitters)
      emitter.DefineParserMethods();

    when (SyntaxModule.Language is SymbolRef.Some(language))
      GrammarDescriptorImplTB.Define(<[ decl:
        public override Language : Nitra.Runtime.Language
        {
          get { $(Environment.GetLanguageType(language) : typed).Instance }
        }
      ]>);

    GrammarDescriptorImplTB.DefineConditional(<[decl:
      public override Rules : array[Nitra.Runtime.RuleDescriptor]
      {
        get { array[..$(_ruleDescriptorEmitters.SelectMany(_.RuleSymbols).Select(_.GetRuleDescriptorRef())) ] }
      }
    ]>);

    GrammarDescriptorImplTB.DefineConditional(<[decl:
      public override Dependencies : array[Nitra.Runtime.GrammarDescriptor]
      {
        get { array[..$(_externalGrammars.Map(_.GetGrammarDescriptorRef()))] }
      }
    ]>);
  }

  public Emit() : void
  {
    foreach (emitter in _ruleParserEmitters)
      emitter.Emit();
    foreach (emitter in _ruleDescriptorEmitters)
      emitter.Emit();
    foreach (emitter in _allParseTreeEmitters)
      emitter.Emit();
    when (SyntaxModuleParseTreeTb != null)
      SyntaxModuleParseTreeTb.Compile();
    GrammarDescriptorImplTB.Compile();
    GrammarImplTB.Compile();
    GrammarTB.Compile();
  }

  private DefineParseTreeTypes(emitter : IParseTreeEmitter) : void
  {
    unless (emitter.IsTypesDefined)
      emitter.DefineTypes(_parseTreeEmitterDefineTypeFunctions[emitter.SymbolDeclarationSite]);
  }
}

// ---- Integration/NativeSourceHost.n (Nitra.Compiler) ----
internal sealed class SelectedRegistry
{
  sealed class Provider : ISourceSnapshotProvider
  {
    source : SourceSnapshot;
    public this(text : string, location : Nemerle.Compiler.AST.Location)
    {
      def prefix=string('\n',Math.Max(0,location.Line-1))+string(' ',Math.Max(0,location.Column-1));
      source=SourceSnapshot(prefix+text,location.File).WithTextSubstring(prefix.Length,text.Length);
    }
    public GetSource() : SourceSnapshot { source }
  }
  public Documents : SCG.List[NitraDocument] = SCG.List();
  factories : SCG.Dictionary[string,Func[ISourceSnapshotProvider,NitraStructure,Func[string,ISourceSnapshotProvider,NitraStructure,object],object]] = SCG.Dictionary();
  trees : SCG.Dictionary[ISourceSnapshotProvider,SCG.Dictionary[string,object]] = SCG.Dictionary();
  public Add(assembly : Assembly) : void
  {
    foreach(type in assembly.GetTypes())
    {
      def graph=type.GetMethod("GetRecognitionGrammar",BindingFlags.Public%|BindingFlags.Static%|BindingFlags.DeclaredOnly);
      when(graph!=null && graph.ReturnType==typeof(NitraDocument))
        Documents.Add(graph.Invoke(null,null) :> NitraDocument);
      def identity=type.GetMethod("GetRecognitionRuleName",BindingFlags.Public%|BindingFlags.Static%|BindingFlags.DeclaredOnly);
      when(identity!=null)
      {
        def name=identity.Invoke(null,null) :> string;
        def method=type.GetMethod("CreateSelected",BindingFlags.Public%|BindingFlags.Static%|BindingFlags.DeclaredOnly);
        def factory=method.CreateDelegate(typeof(Func[ISourceSnapshotProvider,NitraStructure,Func[string,ISourceSnapshotProvider,NitraStructure,object],object])) :> Func[ISourceSnapshotProvider,NitraStructure,Func[string,ISourceSnapshotProvider,NitraStructure,object],object];
        factories.Add(name,factory);
      }
    }
  }
  public Create(name : string, provider : ISourceSnapshotProvider, selected : NitraStructure) : object
  {
    mutable node=selected;
    mutable key=name;
    unless(factories.ContainsKey(key))
    {
      mutable found=false;
      while(!found)
      {
        if(node.Kind=="variant" && factories.ContainsKey(node.Label)) { key=node.Label; found=true; }
        else if(node.Children.Count==1) node=node.Children[0];
        else throw ArgumentException("no native selected factory for "+name);
      }
    }
    def sequence=Nitra.Runtime.SelectedFields.Unwrap(node,"seq");
    def identity=key+":"+sequence.Id.ToString();
    unless(trees.ContainsKey(provider)) trees.Add(provider,SCG.Dictionary());
    def cache=trees[provider];
    if(cache.ContainsKey(identity)) cache[identity]
    else { def tree=factories[key].Invoke(provider,sequence,Func(Create)); cache.Add(identity,tree); tree }
  }
  public Output(name : string, selected : NitraStructure, location : Nemerle.Compiler.AST.Location, context : NitraDialectContext) : PExpr
  {
    def source=Provider(selected.Source,location);
    def tree=Create(name,source,selected);
    def maps=SCG.List.[MethodInfo]();
    foreach(method in tree.GetType().GetMethods(BindingFlags.Public%|BindingFlags.Instance))
      when(method.Name=="GetAst" && method.ReturnType==typeof(PExpr) && (method.GetParameters().Length==0 || method.GetParameters().Length==1 && method.GetParameters()[0].ParameterType==typeof(NitraDialectContext))) maps.Add(method);
    when(maps.Exists(m => m.GetParameters().Length==1)) _=maps.RemoveAll(m => m.GetParameters().Length==0);
    unless(maps.Count==1) throw ArgumentException("space root requires exactly one native PExpr mapping (parameterless or NitraDialectContext); found "+maps.Count.ToString()+" for "+name);
    maps[0].Invoke(tree,if(maps[0].GetParameters().Length==0) null else array[context : object]) :> PExpr
  }
}

public sealed class NativeSourceHost : INitraNativeSourceHost
{
  static InputKey : string = "Nitra.Compiler.NativeSourceHost.RecognizedDefinitions";
  mutable registry : SelectedRegistry;
  /// The grammar assembly Nitra's compiler generated for the initialized definitions (descriptors for ParseSession).
  public GrammarAssembly : Assembly { get; private set; }
  public Initialize(manager : ManagerClass, definitions : SCG.IEnumerable[NitraDocument]) : void
  {
    def inputs=SCG.List(definitions);
    def previous=ManagerClass.Instance;
    def name="NativeGrammar_"+Guid.NewGuid().ToString("N");
    // Nitra writes its .nitrametadata files next to the output; keep them out of the caller's directory.
    def scratch=Path.Combine(Path.GetTempPath(),name);
    try
    {
      def directory=Path.GetDirectoryName(typeof(NativeSourceHost).Assembly.Location);
      def options=CompilationOptions();
      options.CompileToMemory=true; options.TargetIsLibrary=true; options.TargetIsSet=true;
      options.ProgressBar=false; options.ColorMessages=false; options.IgnoreConfusion=true;
      options.TargetReferenceDirectory=manager.Options.TargetReferenceDirectory;
      _=Directory.CreateDirectory(scratch);
      options.OutputFileName=Path.Combine(scratch,name+".dll");
      options.DisableExternalParsers=true;
      // The stub is the file module NativeGrammar_<guid> under the host's directory; it only carries the macro call.
      options.SourceRoot=directory;
      def refs=SCG.HashSet.[string](StringComparer.OrdinalIgnoreCase);
      def shared=SCG.HashSet.[Assembly]();
      foreach(reference in manager.ReferencedAssemblies)
      {
        _=shared.Add(reference.Assembly);
        when(reference.IsUserReference && !String.IsNullOrEmpty(reference.Assembly.Location)) _=refs.Add(reference.Assembly.Location);
      }
      foreach(name in array["Nemerle.Compiler.dll","Integrated.Nitra.Runtime.dll","Integrated.DotNetLang.dll","Integrated.Nitra.Grammar.dll","Integrated.Nitra.Compiler.dll"])
      {
        _=refs.Add(Path.Combine(directory,name));
        _=shared.Add(Assembly.LoadFrom(Path.Combine(directory,name)));
      }
      options.SharedAssemblies=SCG.List(shared).ToArray();
      options.ReferencedLibraries=refs.NToList();
      options.MacrosToLoad=[typeof(NativeSourceHost).Assembly.Location];
      options.Sources=[StringSource(Nemerle.Compiler.AST.Location.GetFileIndex(Path.Combine(directory,name+".n")),"[assembly: NitraMacros.InvokeNitraCompiler]") : ISource];
      def compiler=ManagerClass(options); def messages=StringWriter(); compiler.InitOutput(messages);
      mutable errors=0; compiler.ErrorOccured += (_,_) => ++errors;
      // InitCompiler clears UserData; populate only after that reset.
      compiler.CompilationStart += current => current.UserData.Add(InputKey,inputs);
      try { compiler.Run(); }
      catch { | exception => when(errors==0) throw exception; }
      when(errors>0 || compiler.GeneratedAssembly==null) throw ArgumentException("native grammar compilation failed:\n"+messages.ToString());
      GrammarAssembly=compiler.GeneratedAssembly;
      registry=SelectedRegistry(); AddBuiltins(registry); registry.Add(compiler.GeneratedAssembly);
    }
    finally
    {
      ManagerClass.Instance=previous;
      try { when(Directory.Exists(scratch)) Directory.Delete(scratch,true) } catch { | _ => () }
    }
  }
  static AddBuiltins(registry : SelectedRegistry) : void
  {
    registry.Add(typeof(Nitra.Runtime.ParseTree).Assembly);
    registry.Add(typeof(NitraSyntaxParseTree.Start).Assembly);
    // DotNetLang contributes regex and syntax rules imported by NitraSyntax.
    registry.Add(Assembly.Load("Integrated.DotNetLang"));
  }
  // Called by the existing native assembly macro, before its semantic passes.
  public static Populate(manager : ManagerClass) : void
  {
    match(manager.UserData[InputKey])
    {
      | inputs is SCG.List[NitraDocument] =>
        def registry=SelectedRegistry(); AddBuiltins(registry);
        def grammar=NitraSyntax.Prepare(registry.Documents,array["NitraSyntax"]);
        def project=CompilingNitraProject.Instance(manager);
        def sources=SCG.Dictionary.[string,SCG.List[string]](StringComparer.Ordinal);
        foreach(document in inputs)
        {
          def chars=document.Source.ToCharArray();
          foreach(inactive in document.InactiveConstructs)
            for(mutable i=inactive.Start;i<inactive.End;++i) unless(chars[i]=='\n' || chars[i]=='\r') chars[i]=' ';
          unless(sources.ContainsKey(document.File)) sources.Add(document.File,SCG.List());
          sources[document.File].Add(string(chars));
        }
        foreach(source in sources)
        {
          def text=String.Join("\n",source.Value.ToArray());
          def selected=NitraSyntax.Structure(grammar,"NitraSyntax.Start",text,null);
          unless(selected.Success) throw ArgumentException(String.Join("\n",selected.Diagnostics.ToArray()));
          _=project.AddRecognizedFile(Nemerle.Compiler.AST.Location.GetFileIndex(source.Key),text,
            Func(provider => registry.Create("NitraSyntax.Start",provider,selected.Root) :> NitraSyntaxParseTree.Start));
        }
      | _ =>
        when(Path.GetFileName(manager.Options.OutputFileName).StartsWith("NativeGrammar_",StringComparison.Ordinal))
          throw InvalidOperationException("native source inputs were not retained by the grammar compilation");
    }
  }
  public Prepare(modules : SCG.IEnumerable[string]) : NitraPreparedGrammar
  { NitraSyntax.Prepare(registry.Documents,modules) }
  public Modules(owner : string) : array[string]
  {
    def names=SCG.List.[string]();
    foreach(document in registry.Documents) foreach(syntaxModule in document.Modules)
      when(syntaxModule.Name.StartsWith(owner+".",StringComparison.Ordinal)) names.Add(syntaxModule.Name);
    names.ToArray()
  }
  public Expand(rule : string, selected : NitraStructure, _ : Typer, location : Nemerle.Compiler.AST.Location, context : NitraDialectContext) : PExpr
  {
    try { registry.Output(rule,selected,location,context) }
    catch
    {
      | exception =>
        mutable error=exception;
        while(error is TargetInvocationException && error.InnerException!=null) error=error.InnerException;
        Message.Error(location,error.Message); PExpr.Error(location)
    }
  }
}

// ---- Integration/RecognitionEmitter.n (Nitra.Compiler) ----
// Emit the recognition graph from the SAME normalized rules as native fields.
// No field-name inference and no second parser are involved at the handoff.
internal module RecognitionEmitter
{
  Expr(kind : string, text : string, children : list[PExpr]) : PExpr
  {
    def adds=children.Map(c => <[ e.Children.Add($c) ]>);
    def textExpr=if(text==null) <[ null ]> else <[ $(text : string) ]>;
    <[ def e=Nemerle.Compiler.NitraSyntaxModel.NitraExpression($(kind : string),$textExpr); ..$adds; e ]>
  }
  Repeat(kind : string, min : int, max : option[int], children : list[PExpr], trailing : bool) : PExpr
  {
    def e=Expr(kind,if(trailing) "trailing" else null,children);
    def upper=match(max) { | Some(n) => n | None => -1 };
    <[ def e = $e; e.Min = $(min : int); e.Max = $(upper : int); e ]>
  }
  Regular(rule : RegularRule) : PExpr
  {
    match(rule)
    {
      | Choice(rules) => Expr("alt",null,rules.Map(Regular))
      | Sequence(rules) => Expr("seq",null,rules.Map(Regular))
      | Call(SymbolRef.Some(symbol)) => Expr("call",symbol.Node.FullName,[])
      | Call => throw InvalidOperationException("unresolved native regular call")
      | Repeat(min,max,body) => Repeat("repeat",min,max,[Regular(body)],false)
      | RepeatWithSeparator(min,max,body,separator) => Repeat("separated",min,max,[Regular(body),Regular(separator)],false)
      | Subtract(left,right) => Expr("subtract",null,[Regular(left),Regular(right)])
      | Chars(sets) =>
        Expr("seq",null,sets.Map(set => Expr("class",null,set.Ranges.Map(range => Expr("range",string(array[range.from,range.to]),[])))))
    }
  }
  Syntax(rule : Rule, prefix : Rule.Call = null) : PExpr
  {
    match(rule)
    {
      | Sequence(rules) => Expr("seq",null,rules.Map(r => Syntax(r,prefix)))
      | Call(SymbolRef.Some(symbol),bp) =>
        unless(symbol is RuleDefSymbol) return Expr("empty",null,[]);
        def e=Expr("call",symbol.Node.FullName,[]);
        if(bp.IsZero) <[ def e = $e; e.Binding="0"; e.NativePrefix = $(Object.ReferenceEquals(rule,prefix) : bool); e ]> else
        {
          def name=match(bp.Symbol) { | Zero => "0" | Name(SymbolRef.Some(s)) => s.Node.FullName | _ => throw InvalidOperationException("unresolved native binding power") };
          <[ def e = $e; e.Binding = $(name : string); e.Strong = $(bp.IsStrong : bool); e.NativePrefix = $(Object.ReferenceEquals(rule,prefix) : bool); e ]>
        }
      | Call => throw InvalidOperationException("unresolved native call")
      | String(text) => Expr("literal",text,[])
      // Captures retain even literal-only repetitions as selected fields.
      // The regular-language fast path may otherwise retain only their span.
      | Repeat(min,max,body) => Repeat("repeat",min,max,[Expr("capture","item",[Syntax(body,prefix)])],false)
      | RepeatWithSeparator(min,max,body,separator,trailing) => Repeat("separated",min,max,[Expr("capture","item",[Syntax(body,prefix)]),Expr("capture","separator",[Syntax(separator,prefix)])],trailing)
      | Not(body) => Expr("not",null,[Syntax(body,prefix)])
      | And(body) => Expr("and",null,[Syntax(body,prefix)])
    }
  }
  public Define(syntaxModule : SyntaxModuleSymbol, tb : TypeBuilder) : void
  {
    def statements=SCG.List.[PExpr]();
    foreach(imported in syntaxModule.ExternalImports)
      statements.Add(<[ m.Imports.Add($(imported.Node.FullName : string),$(imported.Node.FullName : string)) ]>);
    foreach(symbol in syntaxModule.GetAllRuleSymbols())
    {
      def name=symbol.Name; def scope=symbol.Node.Parent.FullName;
      def kind=if(symbol is RegularRuleSymbol) "regex" else if(symbol.Type is RuleType.Void) "void" else "syntax";
      def body=match(symbol)
      {
        | RegularRuleSymbol as r => Regular(r.Rule)
        | ExtensibleRuleSymbol => null
        | ExtensionRuleSymbol(ExtensionType=ExtensionRuleSymbol.ExtensionRuleType.Postfix(prefix,_)) as r => Syntax(r.Rule,prefix)
        | SyntaxRuleSymbol as r => Syntax(r.Rule)
        | _ => null
      };
      def variants=SCG.List.[PExpr]();
      def precedence=match(symbol)
      {
        | ExtensionRuleSymbol(ExtensionType=ExtensionRuleSymbol.ExtensionRuleType.Postfix(BindingPower=bp)) =>
          match(bp.Symbol) { | Name(SymbolRef.Some(s)) => s.Node.FullName | _ => "0" }
        | _ => "0"
      };
      when(body!=null)
        variants.Add(<[ def a=Nemerle.Compiler.NitraSyntaxModel.NitraAlternative(); a.Scope = $(symbol.Node.FullName : string); a.Expression = $body; a.ExplicitSpaces=true; a.Precedence = $(precedence : string); a.NativePostfix = $(symbol is ExtensionRuleSymbol(ExtensionType=ExtensionRuleSymbol.ExtensionRuleType.Postfix) : bool); a.NativeStrong = $(symbol is ExtensionRuleSymbol(ExtensionType=ExtensionRuleSymbol.ExtensionRuleType.Postfix(BindingPower=BindingPowerInfo(IsStrong=true))) : bool); r.Alternatives.Add(a) ]>);
      def baseName=match(symbol) { | ExtensionRuleSymbol(BaseRule=SymbolRef.Some(s)) => s.Node.FullName | _ => null };
      def baseExpr=if(baseName==null) <[ null ]> else <[ $(baseName : string) ]>;
      def orders=SCG.List.[PExpr]();
      foreach(p in syntaxModule.AllPrecedences)
        orders.Add(<[ r.Orders.Add($("0<"+p.Symbol.Node.FullName+"."+p.Name : string)) ]>);
      foreach(p in syntaxModule.PrecedenceRelations)
        orders.Add(<[ r.Orders.Add($(p.Symbol.Node.FullName+"."+p.Low+"<"+p.Symbol.Node.FullName+"."+p.Hi : string)) ]>);
      statements.Add(<[
        def r=Nemerle.Compiler.NitraSyntaxModel.NitraRule(); r.Name = $(name : string); r.Scope = $(scope : string);
        r.Kind = $(kind : string); r.Base = $baseExpr; r.Module=m;
        r.Declaration=Nemerle.Compiler.NitraSyntaxModel.NitraDeclaration(); r.ExplicitSpaces=true; r.NativeBindings=true;
        r.StartRule = $(symbol.Options.IsStart : bool); ..$variants; ..$orders; m.Rules.Add(r);
      ]>);
    }
    tb.DefineConditional(<[ decl:
      public static GetRecognitionGrammar() : Nemerle.Compiler.NitraSyntaxModel.NitraDocument
      {
        def d=Nemerle.Compiler.NitraSyntaxModel.NitraDocument(); def m=Nemerle.Compiler.NitraSyntaxModel.NitraModule();
        m.Name = $(syntaxModule.Node.FullName : string); m.ExplicitSpaces=true;
        ..$statements; d.Modules.Add(m); d
      }
    ]>);
  }
}

// ---- Integration/RecognizedNemerleFile.n (Nitra.Compiler) ----
// Semantic input supplied by the shared recognizer. This file deliberately
// has no ParseSession and cannot re-enter Nitra's incremental parser.
public sealed class RecognizedNemerleFile : NemerleFile
{
  source : SourceSnapshot;
  tree : NitraSyntaxParseTree.Start;
  mutable ast : IAst;
  mutable astReady : bool;

  [Obsolete("no longer experimental; use the overload without the flag")]
  public this(project : Project, index : int, text : string,
              createTree : Func[ISourceSnapshotProvider,NitraSyntaxParseTree.Start],
              _experimental : bool)
  { this(project, index, text, createTree) }
  public this(project : Project, index : int, text : string,
              createTree : Func[ISourceSnapshotProvider,NitraSyntaxParseTree.Start])
  {
    base(project, index);
    when(text == null) throw ArgumentNullException("text");
    when(createTree == null) throw ArgumentNullException("createTree");
    source = SourceSnapshot(text, this);
    tree = createTree.Invoke(this);
    when(tree == null) throw ArgumentException("selected tree factory returned null");
    unless(Object.ReferenceEquals(tree.File, this))
      throw ArgumentException("selected tree must retain its semantic source file");
  }

  public override GetSource() : SourceSnapshot { source }
  public override Length : int { get { source.Text.Length } }
  public override GetParseTree() : ParseTree { tree }
  public override ParseResult : IParseResult
  { get { throw InvalidOperationException("selected semantic input has no parser result"); } }
  public override ReParse() : void
  { throw InvalidOperationException("selected semantic input must be replaced by the shared recognizer"); }
  public override UpdateParseTree() : void { }
  public override HasAst : bool { get { astReady } }
  public override Ast : IAst
  { get { unless(astReady) UpdateAst(); ast } }
  public override UpdateAst() : void
  {
    _astMessages.Clear(); _typingMessages.Clear();
    ast = Nitra.Declarations.AstContext.GetAstUntyped(tree, _astMessages);
    astReady = true;
  }
  public override ResetAst() : void
  { ast = null; astReady = false; _astMessages.Clear(); _typingMessages.Clear(); }
  public override ResetParseTree() : void { ResetAst(); }
  public override ResetCache() : void { ResetAst(); _parseMessages.Clear(); }
  public override DeepResetProperties() : void
  {
    _typingMessages.Clear();
    when(astReady && ast != null) IAstExtensions.DeepResetProperties(ast);
  }
}

// ---- NemerleCompilerMessages.n (Nitra.Compiler) ----
internal sealed class NemerleCompilerMessages : ICompilerMessages
{
  public ErrorCount : int { get; private set; }

  public ReportMessage(messageType : CompilerMessageType, loc : Location, msg : string, num : int) : void
  {
    match (messageType)
    {
      | FatalError =>
        ErrorCount++;
        Nemerle.Compiler.MessageMacros.FatalError(loc.NLocation(), msg)

      | Error =>
        ErrorCount++;
        Message.Error(loc.NLocation(), msg)

      | Warning =>
        if (num > 0)
          Message.Warning(num, loc.NLocation(), msg)
        else
          Message.Warning(loc.NLocation(), msg)

      | Hint => Message.Hint(loc.NLocation(), msg)
    }
  }

  public ReportRootMessage(messageType : CompilerMessageType, loc : Location, msg : string, num : int) : IRootCompilerMessages
  {
    ReportMessage(messageType, loc, msg, num);
    FakeRootCompilerMessages(this)
  }

  public Remove(_predicate : Func[Guid, Location, bool]) : void
  {
  }

  public SetFutureMessagesKind(_kind : Guid) : void
  {
  }
}

// ---- Util.n (Nitra) ----
internal module Util
{
  public DefineConditional(this tb : Nemerle.Compiler.type_builder.TypeBuilder, classMember : ClassMember) : void
  {
    DefineConditional(tb, null, classMember)
  }

  public DefineConditional(this tb : Nemerle.Compiler.type_builder.TypeBuilder, conditionName : string, classMember : ClassMember) : void
  {
    if (conditionName == null || tb.Manager.Options.IsConstantDefined(conditionName))
      _ = tb.DefineWithSource(classMember)
    else
      tb.Define(classMember)
  }

  public MakeVariableName(this sequence : SequenceCompileInfo, prefix : string) : string
  {
    def suffix = match (sequence)
    {
      | SequenceCompileInfo.Root(Symbol = symbol) => symbol.Name
      | _                                  => sequence.SrcRule.FieldName
    };
    prefix + sequence.Level + "_" + suffix + "_" + Nemerle.Compiler.manager_class.ManagerClass.Instance.GetNewId()
  }

  public MakeVariableName(this subrule : SubruleCompileInfo, prefix : string) : string
  {
    prefix + subrule.SequenceLevel + "_" + subrule.SrcRule.FieldName + "_" + Nemerle.Compiler.manager_class.ManagerClass.Instance.GetNewId()
  }

  public MakeLanguageName(language : LanguageSymbol) : string
  {
    language.Name
  }

  public MakeSpanClassName(spanClass : SpanClassSymbol) : string
  {
    spanClass.Name + "SpanClass"
  }

  public MakeStyleName(style : StyleSymbol) : string
  {
    style.Name + "Style"
  }

  public CreateConstant(tb : TypeBuilder, name : string, value : int) : string
  {
    assert2(tb != null);
    def decl   = <[ decl: private static $(name : global) = $(value) ]>;
    _ = tb.Define(decl);
    name
  }
}

public mask Integration
{
  // ---- Integration/NitraParser.n (Nitra.Compiler.Integration) ----
  [Record]
  public sealed class NitraParser : IParser
  {
    manager : ManagerClass;

    private static _compilerInvokeTag : object = object();

    public Parse(source : ISource) : Nemerle.Compiler.Parser.ParseResult
    {
      unless (manager.UserData.Contains(_compilerInvokeTag))
      {
        manager.UserData.Add(_compilerInvokeTag, _compilerInvokeTag);

        def fakeLoc = Location(source.FileIndex, 1, 1);
        def attr    = Nemerle.Compiler.UtilMacros.locate(fakeLoc, <[ NitraMacros.InvokeNitraCompiler ]>);
        manager.Hierarchy.AddAssemblyAttribute(manager.CoreEnv, attr);
      }

      def project = CompilingNitraProject.Instance(manager);
      _ = project.CreateNemerleFile(source);
      Nemerle.Compiler.Parser.ParseResult([])
    }
  }
}

public mask PatternMatching
{
  // ---- Generation/PatternMatching/Access.n (Nitra.Compiler.PatternMatching) ----
  [Record, StructuralEquality]
  internal variant Access
  {
    | Obj
    | Sel
      {
        Ctor   : ParseTreeCtor;
        Index  : int;
        Access : Access;
      }
 
    public static AppendAccess(this buffer : StringBuilder, access : Access) : StringBuilder
    {
      match (access)
      {
        | Obj                 => buffer.Append('.')
        | Sel(_, index, next) => buffer.AppendAccess(next).Append('#').Append(index)
      }
    }
 
    public override ToString() : string
    {
      StringBuilder().AppendAccess(this).ToString()
    }
  }

  // ---- Generation/PatternMatching/Decision.n (Nitra.Compiler.PatternMatching) ----
  internal variant Decision[T]
  {
    | Failure
    | Success { Value : T }
    | IfEq
      {
        Access : Access;
        Con    : ParseTreeCtor;
        True   : Decision[T];
        False  : Decision[T];
      }
    | Variable
      {
        Name         : Identifier;
        Access       : Access;
        Continuation : Decision[T];
      }
 
    public static AppendDecision(this buffer : StringBuilder, tab : int, decision : Decision[T]) : StringBuilder
    {
      match (decision)
      {
        | Failure        => buffer.Append(' ', tab).Append("FAIL")
        | Success(value) => buffer.Append(' ', tab).Append("return ").Append(value)
        | IfEq(access, con, t, f) =>
          buffer.Append(' ', tab).Append("If ").AppendAccess(access).Append(" is ").AppendCtor(con).AppendLine()
            .AppendDecision(tab + 2, t).AppendLine()
            .Append(' ', tab).Append("Else").AppendLine()
            .AppendDecision(tab + 2, f)

        | Variable(name, access, continuation) =>
          buffer.Append(' ', tab).Append("var ").Append(name.Value).Append(" = ").AppendAccess(access).AppendLine()
            .AppendDecision(tab, continuation)
      }
    }
 
    public override ToString() : string
    {
      StringBuilder().AppendDecision(0, this).ToString()
    }
  }

  // ---- Generation/PatternMatching/MatchCompiler.n (Nitra.Compiler.PatternMatching) ----
  internal module MatchCompiler
  {
    private type Context = list[ParseTreeCtor * list[Termd]];

    private Augment(ctx : Context, dsc : Termd) : Context
    {
      match (ctx)
      {
        | [] => []
        | (con, args) :: rest => (con, dsc :: args) :: rest
      }
    }

    private Norm(ctx : Context) : Context
    {
      | [] => []
      | (con, args) :: rest => Augment(rest, Termd.Pos(con, args.Rev()))
    }

    private AddNeg(nonset : Termd, con : ParseTreeCtor) : Termd.Neg
    {
      match (nonset)
      {
        | Neg(cons) as neg when cons.Contains(con) => neg
        | Neg(cons) =>
          assert(cons.Length + 1 < Math.Max(int.MaxValue, con.Span));
          Termd.Neg(con :: cons);
 
        | Pos => assert(false)
      }
    }

    private BuildDsc(ctx : Context, dsc : Termd, work : list[list[ParseTreePattern] * list[Access] * list[Termd]]) : Termd
    {
      match (ctx, work)
      {
        | ([], []) => dsc
        | ((con, args) :: rest, (_, _, dargs) :: work) =>
          BuildDsc(rest, Termd.Pos(con, NList.RevAppend(args, dsc :: dargs)), work)

        | _ => assert(false)
      }
    }

    private Fail[T](dsc : Termd, rules : list[ParseTreePattern * T]) : Decision[T]
    {
      match (rules)
      {
        | []                       => Decision.Failure()
        | (pat1, rhs1) :: rulerest => Match(pat1, Access.Obj(), dsc, [], [], rhs1, rulerest)
      }
    }

    private Succeed[T](ctx : Context, works : list[list[ParseTreePattern] * list[Access] * list[Termd]], rhs : T, rules : list[ParseTreePattern * T]) : Decision[T]
    {
      match (works)
      {
        | []                                                  => Decision.Success(rhs)
        | ([], [], []) :: workr                               => Succeed(Norm(ctx), workr, rhs, rules)
        | (pat1 :: patr, obj1 :: objr, dsc1 :: dscr) :: workr => Match(pat1, obj1, dsc1, ctx, (patr, objr, dscr) :: workr, rhs, rules)
        | _ => assert3(false)
      }
    }

    private enum MatchResult
    {
      | Yes
      | No
      | MayBe
    }

    private StaticMatch(pcon : ParseTreeCtor, term : Termd) : MatchResult
    {
      match (term)
      {
        | Neg(nonset) when nonset.Contains(pcon)          => MatchResult.No
        | Neg(nonset) when pcon.Span == nonset.Length + 1 => MatchResult.Yes
        | Pos(scon, _)                                    => if (pcon == scon) MatchResult.Yes else MatchResult.No
        | _ => MatchResult.MayBe
      }
    }

    private Match[T](pat : ParseTreePattern, obj : Access, dsc : Termd, ctx : Context, work : list[list[ParseTreePattern] * list[Access] * list[Termd]], rhs : T, rules : list[ParseTreePattern * T]) : Decision[T]
    {
      match (pat)
      {
        | Var(name) =>
          def continuation = Succeed(Augment(ctx, dsc), work, rhs, rules);
          if (pat.IsWildcard)
            continuation
          else
            Decision.Variable(name, obj, continuation)

        | Ctor(pcon, pargs) =>
          def result = StaticMatch(pcon, dsc);
          if (result == MatchResult.No)
            Fail(BuildDsc(ctx, dsc, work), rules)
          else
          {
            mutable oargs = [];
            for (mutable i = pcon.Arity - 1; i >= 0; --i)
              oargs ::= Access.Sel(pcon, i, obj);

            def dargs =
              match (dsc)
              {
                | Neg => Termd.MakeAnyList(pcon.Arity)
                | Pos(_, dargs) => dargs
              };

            def success = Succeed((pcon, []) :: ctx, (pargs, oargs, dargs) :: work, rhs, rules);

            if (result == MatchResult.Yes)
              success
            else
              Decision.IfEq(obj, pcon, success, Fail(BuildDsc(ctx, AddNeg(dsc, pcon), work), rules))
          }
      }
    }

    public Compile[T](allmrules : list[ParseTreePattern * T]) : Decision[T]
    {
      Fail(Termd.Any, allmrules)
    }
  }

  // ---- Generation/PatternMatching/Termd.n (Nitra.Compiler.PatternMatching) ----
  internal variant Termd
  {
    | Pos { Con : ParseTreeCtor; Args : list[Termd] }
    | Neg { Cons : list[ParseTreeCtor] }
 
    public static Any : Neg = Neg([]);
 
    [Memoize]
    public static MakeAnyList(length : int) : list[Termd]
    {
      if (length > 0)
        Any :: MakeAnyList(length - 1)
      else if (length == 0)
        []
      else
        assert(false)
    }
 
    public static AppendTermd(this buffer : StringBuilder, termd : Termd) : StringBuilder
    {
      match (termd)
      {
        | Pos(con, args) => buffer.Append(con.Name).Append('(').AppendList(args, AppendTermd, ", ").Append(')')
        | Neg([])        => buffer.Append('*')
        | Neg(nonset)    => buffer.Append('!').Append('{').AppendList(nonset, ParseTreeCtor.AppendCtor, ", ").Append('}')
      }
    }
 
    public override ToString() : string
    {
      StringBuilder().AppendTermd(this).ToString()
    }
  }
}

public mask Serialization
{
  // ---- Generation/Serialization/BinarySerializationFormatter.n (Nitra.Serialization) ----
  public class BinarySerializationFormatter : SerializationFormatter
  {
    public this()
    {
      WriteParameters = [SerializationParameter("writer", <[ System.IO.BinaryWriter ]>)];
      ReadParameters  = [SerializationParameter("reader", <[ System.IO.BinaryReader ]>)];
    }

    public override WriteParameters : list[SerializationParameter] { get; }
    public override ReadParameters  : list[SerializationParameter] { get; }

    public override EmitFatalError(message : PExpr) : PExpr
    {
      <[ throw System.Exception($message) ]>
    }

    public override WriteTag(tag : TypeTag) : PExpr
    {
      <[ $("writer" : global).Write($(tag :> byte : byte)) ]>
    }

    public override ReadTag() : PExpr
    {
      <[ $("reader" : global).ReadByte() :> Nitra.Serialization.TypeTag ]>
    }

    public override WritePrimitive(tag : TypeTag, obj : PExpr) : PExpr
    {
      if (tag == TypeTag.Char)
        WritePrimitive(TypeTag.UInt16, <[ $obj :> ushort ]>)
      else
        <[ $("writer" : global).Write($obj : System.$(tag.ToString() : usesite)); ]>
    }

    public override ReadPrimitive(tag : TypeTag) : PExpr
    {
      if (tag == TypeTag.Char)
        <[ $(ReadPrimitive(TypeTag.UInt16)) :> char ]>
      else
        <[ $("reader" : global).$("Read" + tag.ToString() : usesite)() ]>
    }
  }

  // ---- Generation/Serialization/CollectionTypeSerializationBuilder.n (Nitra.Serialization) ----
  [Record]
  public sealed class CollectionTypeSerializationBuilder : ComplexTypeSerializationBuilder
  {
    public override Tag : TypeTag { get { TypeTag.Collection } }

    private _collectionType : DefaultTypeSerializationFactory.CollectionType;
    private _itemType       : Nemerle.Compiler.type_var.TypeVar;

    [RecordIgnore] private mutable _itemSerializationBuilder : TypeSerializationBuilder;

    protected override CollectTypeData() : void
    {
      assert(_itemSerializationBuilder : object == null);

      _itemSerializationBuilder = Compiler.EnqueueType(_itemType.Fix());
    }

    protected override GenerateWriteBody(body : SCG.List[PExpr]) : void
    {
      assert(_itemSerializationBuilder : object != null);

      def count =
        match (_collectionType)
        {
          | ImmutableArray
          | Array
          | NemerleList => <[ obj.Length ]>
          | IEnumerable => <[ System.Linq.Enumerable.Count(obj) ]>
          | _           => <[ obj.Count ]>
        };

      body.Add(Formatter.WriteInt32(count));
      body.Add(<[ foreach (item in obj)
                    $(_itemSerializationBuilder.Write(<[ item ]>)); ]>);
    }

    protected override GenerateReadBody(body : SCG.List[PExpr]) : void
    {
      assert(_itemSerializationBuilder : object != null);

      def readItem = _itemSerializationBuilder.Read(<[ "item" ]>, _itemSerializationBuilder.TagExpr);
      body.Add(<[ def count  = $(Formatter.ReadInt32()); ]>);
      match (_collectionType)
      {
        | IImmutableList
        | ImmutableArray =>
          body.Add(<[ def buffer = System.Collections.Immutable.ImmutableArray.CreateBuilder(count); ]>);
          body.Add(<[ repeat (count)
                        buffer.Add($readItem); ]>);
          body.Add(<[ buffer.MoveToImmutable() ]>);

        | NemerleList         with result = <[ Nemerle.Collections.NList.FromArray(buffer) ]>
        | IReadOnlyCollection with result = <[ System.Collections.ObjectModel.ReadOnlyCollection(buffer) ]>
        | IReadOnlyList       with result = <[ System.Collections.ObjectModel.ReadOnlyCollection(buffer) ]>
        | _                   with result = <[ buffer ]> =>
          body.Add(<[ def buffer = array(count); ]>);
          body.Add(<[ for(mutable i = 0; i < buffer.Length; ++i)
                        buffer[i] = $readItem; ]>);
          body.Add(result);
      }
    }
  }

  // ---- Generation/Serialization/ComplexTypeSerializationBuilder.n (Nitra.Serialization) ----
  public abstract class ComplexTypeSerializationBuilder : TypeSerializationBuilder
  {
    public this(compiler : SerializationCompiler, type : FixedType)
    {
      base(compiler, type);

      def id = compiler.Manager.GetNewId().ToString();
      _writeMethodName = "_N_" + type + "_Write_" + id;
      _readMethodName  = "_N_" + type + "_Read__" + id;
    }

    private _writeMethodName : string;
    private _readMethodName  : string;

    private HelperTb : TypeBuilder
    {
      mutable _helperTb : TypeBuilder;
      get
      {
        when (_helperTb : object == null)
          _helperTb = Compiler.InitHelperTb();
        _helperTb;
      }
    }

    private HelperTypeVar : FixedType
    {
      mutable _helperTypeVar : FixedType;
      get
      {
        when (_helperTypeVar : object == null)
          _helperTypeVar = HelperTb.GetMemType();
        _helperTypeVar
      }
    }

    public sealed override Write(obj : PExpr) : PExpr
    {
      def args = obj :: Compiler.MakeWriteArguments();
      <[ $(HelperTypeVar : typed).$(_writeMethodName : global)(..$args) ]>
    }

    public sealed override Read(memberName : PExpr, typeTag : PExpr) : PExpr
    {
      def args = memberName :: typeTag :: Compiler.MakeReadArguments();
      <[ $(HelperTypeVar : typed).$(_readMethodName : global)(..$args) ]>
    }

    protected sealed override EmitImpl() : void
    {
      Nemerle.Compiler.UtilMacros.locate(Type.Location,
      {
        try
          CollectTypeData();
        catch
        {
          | Recovery => throw;
          | ex       => Nemerle.Compiler.MessageMacros.FatalError($"Failed to build serialization code for type '$Type' with exception $ex")
        }

        def writeParms = <[ parameter: obj : $(Type : typed) ]> :: Compiler.MakeWriteParameters();
        def writeBody = SCG.List();
        GenerateWriteBody(writeBody);

        HelperTb.Define(<[ decl:
          public $(_writeMethodName : usesite)(..$writeParms) : void
          {
            IgnoreParams();
            unchecked { ..$writeBody }
          }
        ]>);

        def readParms =
             <[ parameter: memberName : System.String               ]>
          :: <[ parameter: typeTag    : Nitra.Serialization.TypeTag ]>
          :: Compiler.MakeReadParameters();

        def readBody = SCG.List();
        readBody.Add(Formatter.TestTypeTag(<[ memberName ]>, <[ typeTag ]>, Tag));
        GenerateReadBody(readBody);

        HelperTb.Define(<[ decl:
          public $(_readMethodName : usesite)(..$readParms) : $(Type : typed)
          {
            IgnoreParams();
            unchecked { ..$readBody }
          }
        ]>);
      });
    }

    protected abstract CollectTypeData() : void;
    protected abstract GenerateWriteBody(body : SCG.List[PExpr]) : void;
    protected abstract GenerateReadBody(body : SCG.List[PExpr]) : void;
  }

  // ---- Generation/Serialization/DefaultTypeSerializationFactory.n (Nitra.Serialization) ----
  public class DefaultTypeSerializationFactory : TypeSerializationFactory
  {
    public enum CollectionType
    {
      | Array
      | NemerleList
      | IList
      | ICollection
      | IEnumerable
      | ImmutableArray
      | IImmutableList
      | IReadOnlyCollection
      | IReadOnlyList
    }

    public override CreateBuilder(compiler : SerializationCompiler, type : FixedType) : TypeSerializationBuilder
    {
      def typeCatalog = compiler.Manager.InternalType;
      match (type)
      {
        | Tuple(itemTypes)   => TupleTypeSerializationBuilder(compiler, type, itemTypes)
        | Array(itemType, 1)                                                           => CreateCollectionBuilder(compiler, CollectionType.Array,               type, itemType)
        | Class(ti, [itemType]) when ti.Equals(typeCatalog.Nemerle_list_tc)            => CreateCollectionBuilder(compiler, CollectionType.NemerleList,         type, itemType)
        | Class(ti, [itemType]) when ti.Equals(typeCatalog.Generic_IList_tc)           => CreateCollectionBuilder(compiler, CollectionType.IList,               type, itemType)
        | Class(ti, [itemType]) when ti.Equals(typeCatalog.Generic_ICollection_tc)     => CreateCollectionBuilder(compiler, CollectionType.ICollection,         type, itemType)
        | Class(ti, [itemType]) when ti.Equals(typeCatalog.Generic_IEnumerable_tc)     => CreateCollectionBuilder(compiler, CollectionType.IEnumerable,         type, itemType)
        | Class(ti, [itemType]) when EqualsOption(ti, compiler.ImmutableArrayOpt)      => CreateCollectionBuilder(compiler, CollectionType.ImmutableArray,      type, itemType)
        | Class(ti, [itemType]) when EqualsOption(ti, compiler.IImmutableListOpt)      => CreateCollectionBuilder(compiler, CollectionType.IImmutableList,      type, itemType)
        | Class(ti, [itemType]) when EqualsOption(ti, compiler.IReadOnlyCollectionOpt) => CreateCollectionBuilder(compiler, CollectionType.IReadOnlyCollection, type, itemType)
        | Class(ti, [itemType]) when EqualsOption(ti, compiler.IReadOnlyListOpt)       => CreateCollectionBuilder(compiler, CollectionType.IReadOnlyList,       type, itemType)
        | Class(ti, _) =>
          def parseDeclaration(currentTypeInfo : Nemerle.Compiler.type_info.TypeInfo) : TypeSerializationBuilder
          {
            match (currentTypeInfo?.GetTydecl())
            {
              | Alias(type)      => parseDeclaration(type.TypeInfo)
              | Enum             => EnumTypeSerializationBuilder(compiler, type, currentTypeInfo.UnderlyingType)
              | Variant(options) => VariantTypeSerializationBuilder(compiler, type, options)
              | VariantOption    => VariantOptionTypeSerializationBuilder(compiler, type)
              | _                => RecordTypeSerializationBuilder(compiler, type)
            }
          }
          if (ti.IsPrimitive || ti.Equals(typeCatalog.String_tc))
            PrimitiveTypeSerializationBuilder(compiler, type, ti)
          else
            parseDeclaration(ti)

        | _ => Nemerle.Compiler.MessageMacros.FatalError(type.Location, $"Type '$type' is not suppported in serialization compiler.")
      }
    }

    protected virtual CreateCollectionBuilder(compiler : SerializationCompiler, collectionType : CollectionType, type : FixedType, itemType : Nemerle.Compiler.type_var.TypeVar) : TypeSerializationBuilder
    {
      CollectionTypeSerializationBuilder(compiler, type, collectionType, itemType)
    }

    private static EqualsOption(ti : Nemerle.Compiler.type_info.TypeInfo, opt : option[Nemerle.Compiler.type_info.TypeInfo]) : bool
    {
      if (opt is Some(x))
        ti.Equals(x)
      else
        false
    }
  }

  // ---- Generation/Serialization/EnumTypeSerializationBuilder.n (Nitra.Serialization) ----
  public sealed class EnumTypeSerializationBuilder : PrimitiveTypeSerializationBuilder
  {
    public UnderlyingType : Nemerle.Compiler.type_var.TypeVar { get; }

    public this(compiler : SerializationCompiler, type : FixedType, underlyingTypeInfo : Nemerle.Compiler.type_info.TypeInfo)
    {
      base(compiler, type, underlyingTypeInfo);
      UnderlyingType = underlyingTypeInfo.GetMemType();
    }

    public override Write(obj : PExpr) : PExpr
    {
      base.Write(<[ $obj :> $(UnderlyingType : typed) ]>)
    }

    public override Read(memberName : PExpr, typeTag : PExpr) : PExpr
    {
      <[ $(base.Read(memberName, typeTag)) :> $(Type : typed) ]>
    }
  }

  // ---- Generation/Serialization/NitraTypeSerializationFactory.n (Nitra.Serialization) ----
  public class NitraTypeSerializationFactory : DefaultTypeSerializationFactory
  {
    private mutable _iExportableSymbolType  : FixedType;
    private mutable _symbolType             : FixedType;
    private mutable _locationType           : FixedType;
    private mutable _serializableType       : FixedType;

    public override CreateBuilder(compiler : SerializationCompiler, type : FixedType) : TypeSerializationBuilder
    {
      InitKnownTypes(compiler);
      match (type)
      {
        | Class when type.TryRequire(_iExportableSymbolType) => IExportableSymbolTypeSerializationBuilder(compiler, type)
        | Class when type.TryRequire(_symbolType)            => SymbolTypeSerializationBuilder(compiler, type)
        | Class when type.Equals(_locationType)              => LocationTypeSerializationBuilder(compiler, type)
        | Class when type.TryRequire(_serializableType)      => ISerializableTypeSerializationBuilder(compiler, type)
        | _ => base.CreateBuilder(compiler, type)
      }
    }

    protected override CreateCollectionBuilder(compiler : SerializationCompiler, collectionType : CollectionType, type : FixedType, itemType : Nemerle.Compiler.type_var.TypeVar) : TypeSerializationBuilder
    {
      if (itemType.TryRequire(_serializableType))
        ISerializableCollectionTypeSerializationBuilder(compiler, type, collectionType, itemType)
      else
        base.CreateCollectionBuilder(compiler, collectionType, type, itemType)
    }

    private InitKnownTypes(compiler : SerializationCompiler) : void
    {
      when (_iExportableSymbolType : object == null)
      {
        def env = compiler.Manager.CoreEnv;
        _iExportableSymbolType = env.BindFixedType(<[ Nitra.Serialization.IExportableSymbol ]>);
        _symbolType            = env.BindFixedType(<[ Nitra.Runtime.Typing.Symbol ]>);
        _locationType          = env.BindFixedType(<[ Nitra.Runtime.Location ]>);
        _serializableType      = env.BindFixedType(<[ Nitra.Serialization2.ISerializable ]>);
      }
    }
  }

  [Record]
  public class IExportableSymbolTypeSerializationBuilder : TypeSerializationBuilder
  {
    public override Tag : TypeTag { get { TypeTag.Object } }

    public override Write(obj : PExpr) : PExpr
    {
      <[ metadataWriter.WriteSymbolRef($obj, writer); ]>
    }

    public override Read(memberName : PExpr, typeTag : PExpr) : PExpr
    {
      <[
        $(Formatter.TestTypeTag(memberName, typeTag, Tag));
        metadataReader.ReadSymbolRef(reader) :> $(Type : typed);
      ]>
    }
  }

