// ---- Integration/SelectedFields.n (Nitra) ----
// These operations consume settled evidence. They never read or parse text.
public module SelectedFields
{
  public Unwrap(node : NitraStructure, kind : string) : NitraStructure
  {
    mutable n=node;
    while(n.Kind!=kind && n.Children.Count==1) n=n.Children[0];
    unless(n.Kind==kind) throw ArgumentException("selected native field expected "+kind+", got "+n.Kind);
    n
  }
  public Field(node : NitraStructure, index : int) : NitraStructure
  {
    def sequence=Unwrap(node,"seq");
    when(index<0 || index>=sequence.Children.Count) throw ArgumentException("selected native field index out of range");
    sequence.Children[index]
  }
  public List[T](provider : Nitra.Runtime.ISourceSnapshotProvider, node : NitraStructure,
                 convert : Func[NitraStructure,T], separated : bool, separators : bool) : ListParseTree[T] where T : IParseTree
  {
    def n=Unwrap(node,if(separated) "separated" else "repeat");
    def values=SCG.List.[T]();
    for(mutable i=0;i<n.Children.Count;++i)
      when(!separated || i%2==(if(separators) 1 else 0)) values.Add(convert.Invoke(n.Children[i]));
    ConcreteListParseTree(Nitra.Runtime.Location(provider,NSpan(n.Start,n.End)),values.ToArray())
  }
  public Optional[T](provider : Nitra.Runtime.ISourceSnapshotProvider, node : NitraStructure,
                     convert : Func[NitraStructure,T]) : OptionParseTree[T] where T : IParseTree
  {
    def n=Unwrap(node,"repeat"); def location=Nitra.Runtime.Location(provider,NSpan(n.Start,n.End));
    match(n.Children.Count)
    {
      | 0 => OptionParseTree.None(location)
      | 1 => OptionParseTree.Some(location,convert.Invoke(n.Children[0]))
      | _ => throw ArgumentException("selected native optional field has multiple values")
    }
  }
}

