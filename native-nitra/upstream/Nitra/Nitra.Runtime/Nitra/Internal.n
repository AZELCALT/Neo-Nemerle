// ---- ParseTree/RecoveryModeListWithSeparatorReader.n (Nitra.Internal) ----
internal sealed class RecoveryModeListWithSeparatorParseTreeReader[TItemLoader, TItem, TSeparatorLoader, TSeparator] :
  RecoveryModeBaseListParseTreeReader[
    /* TContext    */ RecoveryModeParseTreeReaderContext[TItemLoader, TItem] * RecoveryModeParseTreeReaderContext[TSeparatorLoader, TSeparator],
    /* TListBuffer */ SCG.List[TItem] * SCG.List[TSeparator],
    /* TParseTree  */ SequenceParseTree[ListParseTree[TItem], ListParseTree[TSeparator]]]
  where TItemLoader      : IParseTree
  where TItem            : TItemLoader
  where TSeparatorLoader : IParseTree
  where TSeparator       : TSeparatorLoader
{
  public static Instance : this;

  static this() { Instance = RecoveryModeListWithSeparatorParseTreeReader() }

  protected override MakeAmbiguousParseTree(ambiguities : array[SequenceParseTree[ListParseTree[TItem], ListParseTree[TSeparator]]], context : RecoveryModeParseTreeReaderContext[TItemLoader, TItem] * RecoveryModeParseTreeReaderContext[TSeparatorLoader, TSeparator]) : SequenceParseTree[ListParseTree[TItem], ListParseTree[TSeparator]]
  {
    _ = context;
    AmbiguousSequenceParseTree(ambiguities)
  }

  protected override MakeEmptyParseTree(parseResult : ParseResult, pos : int, context : RecoveryModeParseTreeReaderContext[TItemLoader, TItem] * RecoveryModeParseTreeReaderContext[TSeparatorLoader, TSeparator]) : SequenceParseTree[ListParseTree[TItem], ListParseTree[TSeparator]]
  {
    _ = context;
    def loc = Location(parseResult, pos);
    ConcreteSequenceParseTree(loc, EmptyListParseTree(loc), EmptyListParseTree(loc))
  }

  protected override CreateListBuffer() : SCG.List[TItem] * SCG.List[TSeparator]
  {
    (SCG.List(), SCG.List())
  }

  protected override ReadListItem(isItem : bool, parseResult : ParseResult, parsingSequence : ParsingSequence, startPos : int, endPos : int, listBuffer : SCG.List[TItem] * SCG.List[TSeparator], context : RecoveryModeParseTreeReaderContext[TItemLoader, TItem] * RecoveryModeParseTreeReaderContext[TSeparatorLoader, TSeparator]) : void
  {
    if (isItem)
      RecoveryModeSequenceParseTreeReader.Instance.Read(parseResult, parsingSequence, startPos, endPos, RecoveryModeSequenceParseTreeReaderContext(context[0].ItemLoader, context[0].ItemSequenceId))
        |> context[0].ItemConverter.Cast
        |> listBuffer[0].Add;
    else
      RecoveryModeSequenceParseTreeReader.Instance.Read(parseResult, parsingSequence, startPos, endPos, RecoveryModeSequenceParseTreeReaderContext(context[1].ItemLoader, context[1].ItemSequenceId))
        |> context[1].ItemConverter.Cast
        |> listBuffer[1].Add;
  }

  protected override CreateListParseTree(parseResult : ParseResult, startPos : int, endPos : int, listBuffer : SCG.List[TItem] * SCG.List[TSeparator]) : SequenceParseTree[ListParseTree[TItem], ListParseTree[TSeparator]]
  {
    def loc = Location(parseResult, startPos, endPos);
    ConcreteSequenceParseTree(loc, ConcreteListParseTree(loc, listBuffer[0]), ConcreteListParseTree(loc, listBuffer[1]))
  }
}

// ---- ParseTree/RecoveryModeOptionParseTreeReader.n (Nitra.Internal) ----
internal sealed class RecoveryModeOptionParseTreeReader[TLoader, TItem] : RecoveryModeParseTreeReader[RecoveryModeParseTreeReaderContext[TLoader, TItem], OptionParseTree[TItem]]
  where TLoader : IParseTree
  where TItem   : TLoader
{
  public static Instance : this;

  static this() { Instance = RecoveryModeOptionParseTreeReader() }

  protected override MakeEmptyParseTree(parseResult : Nitra.Runtime.ParseResult, pos : int, context : RecoveryModeParseTreeReaderContext[TLoader, TItem]) : OptionParseTree[TItem]
  {
    _ = context;
    OptionParseTree.None(Location(parseResult, pos))
  }

  protected override MakeAmbiguousParseTree(ambiguities : array[Nitra.Runtime.OptionParseTree[TItem]], context : RecoveryModeParseTreeReaderContext[TLoader, TItem]) : Nitra.Runtime.OptionParseTree[TItem]
  {
    _ = context;
    AmbiguousOptionParseTree(ambiguities)
  }

  protected override ReadParseTree(parseResult : Nitra.Runtime.ParseResult, startPos : int, endPos : int, recoveredSubruleIndex : int, context : RecoveryModeParseTreeReaderContext[TLoader, TItem]) : OptionParseTree[TItem]
  {
    def item = context.ItemLoader.ReadSequence(context.ItemSequenceId, recoveredSubruleIndex) |> context.ItemConverter.Cast;
    OptionParseTree.Some(Location(parseResult, startPos, endPos), item)
  }

  protected override ReadParseTreeInStandardMode(parseResult : ParseResult, startPos : int, endPos : int, context : RecoveryModeParseTreeReaderContext[TLoader, TItem]) : OptionParseTree[TItem]
  {
    mutable pos = startPos;
    def item = context.ItemLoader.ReadSequence(context.ItemSequenceId, ref pos) |> context.ItemConverter.Cast;
    assert(pos == endPos);
    OptionParseTree.Some(Location(parseResult, startPos, endPos), item)
  }
}

// ---- ParseTree/RecoveryModeParseTreeReader.n (Nitra.Internal) ----
internal abstract class RecoveryModeParseTreeReader[TContext, TParseTree]
{
  public Read(parseResult : ParseResult, parsingSequence : ParsingSequence, startPos : int, endPos : int, context : TContext) : TParseTree
  {
    if (startPos == endPos)
      MakeEmptyParseTree(parseResult, startPos, context)
    else
      match (parseResult.TryGetRecoveredSequence(startPos, endPos, parsingSequence))
      {
        | null                               => ReadParseTreeInStandardMode(parseResult, startPos, endPos, context)
        | Unambiguous(recoveredSubruleIndex) => ReadParseTree(parseResult, startPos, endPos, recoveredSubruleIndex, context)
        | Ambiguous(indexes) =>
          def ambiguities = array(indexes.Length);
          foreach (recoveredSubruleIndex in indexes with i)
            ambiguities[i] = ReadParseTree(parseResult, startPos, endPos, recoveredSubruleIndex, context);
          MakeAmbiguousParseTree(ambiguities, context)
      }
  }

  protected abstract MakeEmptyParseTree(parseResult : ParseResult, pos : int, context : TContext) : TParseTree;
  protected abstract MakeAmbiguousParseTree(ambiguities : array[TParseTree], context : TContext) : TParseTree;
  protected abstract ReadParseTreeInStandardMode(parseResult : ParseResult, startPos : int, endPos : int, context : TContext) : TParseTree;
  protected abstract ReadParseTree(parseResult : ParseResult, startPos : int, endPos : int, recoveredSubruleIndex : int, context : TContext) : TParseTree;
}

// ---- ParseTree/RecoveryModeParseTreeReaderContext.n (Nitra.Internal) ----
[Record]
internal struct RecoveryModeParseTreeReaderContext[TLoader, TItem]
  where TLoader : IParseTree
  where TItem : TLoader
{
  public ItemLoader     : ISequenceParseTreeLoader[TLoader];
  public ItemSequenceId : int;
  public ItemConverter  : ParseTreeCastHelper[TLoader, TItem];
}

// ---- ParseTree/RecoveryModeSequenceParseTreeReader.n (Nitra.Internal) ----
[Record]
internal struct RecoveryModeSequenceParseTreeReaderContext[TLoader]
  where TLoader : IParseTree
{
  public Loader     : ISequenceParseTreeLoader[TLoader];
  public SequenceId : int;
}

internal sealed class RecoveryModeSequenceParseTreeReader[TLoader] : RecoveryModeParseTreeReader[RecoveryModeSequenceParseTreeReaderContext[TLoader], TLoader]
  where TLoader : IParseTree
{
  public static Instance : this;

  static this() { Instance = RecoveryModeSequenceParseTreeReader() }

  protected override MakeEmptyParseTree(parseResult : ParseResult, pos : int, context : RecoveryModeSequenceParseTreeReaderContext[TLoader]) : TLoader
  {
    _ = parseResult;
    context.Loader.ReadEmptySequence(context.SequenceId, pos)
  }

  protected override MakeAmbiguousParseTree(ambiguities : array[TLoader], context : RecoveryModeSequenceParseTreeReaderContext[TLoader]) : TLoader
  {
    context.Loader.CreateAmbiguousSequence(context.SequenceId, ambiguities)
  }

  protected override ReadParseTree(parseResult : ParseResult, startPos : int, endPos : int, recoveredSubruleIndex : int, context : RecoveryModeSequenceParseTreeReaderContext[TLoader]) : TLoader
  {
    _ = parseResult; _ = startPos; _ = endPos;
    context.Loader.ReadSequence(context.SequenceId, recoveredSubruleIndex);
  }

  protected override ReadParseTreeInStandardMode(parseResult : ParseResult, startPos : int, endPos : int, context : RecoveryModeSequenceParseTreeReaderContext[TLoader]) : TLoader
  {
    _ = parseResult;
    mutable pos = startPos;
    def result = context.Loader.ReadSequence(context.SequenceId, ref pos);
    assert(pos == endPos);
    result
  }
}

