/* Macros used only inside the compiler.  */

using Nemerle;
using Nemerle.Compiler.type_builder;
using Nemerle.Imperative;
using System.Diagnostics;

// ---- compiler.n (Nemerle.Compiler.SolverMacros) ----
macro ReportError (messenger, msg)
{
  <[
    if ($messenger.NeedMessage)
    {
      //System.Diagnostics.Debug.Assert(false);
      $messenger.Error ($msg)
    }
    else
      $messenger.MarkError ()
  ]>
}

macro ReportLocatedError (loc, messenger, msg)
{
  <[
    if ($messenger.NeedMessage)
    {
      //System.Diagnostics.Debug.Assert(false);
      Nemerle.Compiler.UtilMacros.locate($loc, $messenger.Error($msg))
    }
    else
      $messenger.MarkError ()
  ]>
}

macro ReportFatal (messenger, msg)
{
  <[
    if ($messenger.NeedMessage) {
      $messenger.Error ($msg);
      when (IsTopLevel)
        throw Nemerle.Compiler.Utility.Recovery ();
    } else
      $messenger.MarkError ();

    Nemerle.Compiler.Typedtree.TExpr.Error ()
  ]>
}

macro SaveError (messenger, msg)
{
  <[
    if ($messenger.NeedMessage)
      $messenger.SaveError ($msg);
    else
      $messenger.MarkError ();
  ]>
}

[MacroUsage (MacroPhase.BeforeInheritance, MacroTargets.Method)]
macro PossiblyLooping (_ : TypeBuilder, m : ParsedMethod, solver)
{
  def newBody = Nemerle.Compiler.UtilMacros.locate(m.Body.Location, <[
    if ($solver.CanEnterPossiblyLooping ())
    {
      try
      {
        $(m.Body)
      }
      finally { $solver.LeavePossiblyLooping() }
    }
    else false
  ]>);
  
  m.Body = newBody;
}
