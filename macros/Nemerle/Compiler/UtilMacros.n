/* Macros used only inside the compiler.  */

using Nemerle;
using Nemerle.Imperative;
using System.Diagnostics;

// ---- compiler.n (Nemerle.Compiler.Util) ----
macro @locate(location, body)
  syntax("locate", "(", location, ")", body)
{
  <[
    def loc = $location;
    def hasLocation = loc.FileIndex != 0;
    
    when (hasLocation)
      Nemerle.Compiler.Utility.LocationStack.Push(loc);

    try { $body } 
    finally
    {
      when (hasLocation)
        Nemerle.Compiler.Utility.LocationStack.RemoveTop();
    }
  ]>
}

macro ice (msg = <[ "(see backtrace)" ]>)
{
  <[
    unless (Nemerle.Compiler.Utility.Message.SeenError)
    {
      def msg = $msg.ToString();
      System.Diagnostics.Debug.Assert(true, "ICE! (Internal Compiler Error)", msg);
      Nemerle.Compiler.Utility.Message.Debug ($"Internal compiler error '$msg', please report a bug to bugs.nemerle.org. "
                     "You can try modifying program near this location.");
    }
    assert(false, $msg);
  ]>
}

macro cassert (cond, message = <[ "" ]>)
{
  <[ unless ($cond) {
       unless (Nemerle.Compiler.Utility.Message.SeenError)
         Nemerle.Compiler.Utility.Message.Debug ("Internal compiler error, please report a bug to bugs.nemerle.org. "
                        "You can try modifying program near this location.");
       throw AssertionException ($(cond.Location.File : string), 
                                 $(cond.Location.Line : int),
                                 $cond.ToString (), $message)
     }
  ]>
}
