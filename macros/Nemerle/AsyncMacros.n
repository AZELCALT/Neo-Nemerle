// `async' functions and `await' (see doc/book/src/12-dotnet.md). The parser marks a function written `async F() : Task[T]'
// with AsyncFunction and reads `await e' in its body as `__await(e)'. AsyncFunction moves the body into an iterator
// (the state machine `yield' already makes) and F runs it with Nemerle.Async.AsyncDriver; `__await' expands, as the
// iterator is typed, to a wait that yields the awaiter when it has not completed.
using Nemerle;
using Nemerle.Compiler.ClassMembers;
using Nemerle.Compiler.macros;
using Nemerle.Compiler.type_builder;
using Nemerle.Compiler.Utility;
using Nemerle.Compiler.Parsetree;
using Nemerle.Compiler.AST;

/// A body whose value `finish' takes: its statements stay statements (each with its own sequence point, where a
/// breakpoint stops), and only its last expression is finished.
Ending(body : PExpr, finish : PExpr -> PExpr) : PExpr
{
  match (body)
  {
    | PExpr.Sequence(items) when !items.IsEmpty => PExpr.Sequence(body.Location, items.FirstN(items.Length - 1) + [Ending(items.Last, finish)])
    | _ => finish(body)
  }
}

/// Whether `e' is an `await' (as the parser writes it).
IsAwait(e : PExpr) : bool
{
  | PExpr.Call(PExpr.Member(_, name), [_]) => name.ToString() == "__await"
  | _ => false
}

/// Whether an `await' is in `e'.
HasAwait(e : PExpr) : bool
{
  mutable found = false;
  _ = Macros.TraverseExpr(None(), e, false, (_, after, node) => { when (!after && IsAwait(node)) found = true; node });
  found
}

/// Whether evaluating `e' early or late is the same: it is not moved ahead of an `await'.
IsPlain(e : PExpr) : bool
{
  | PExpr.Literal | PExpr.Ref | PExpr.Lambda | PExpr.Wildcard | PExpr.ParmByRef | PExpr.ParmOut | PExpr.This | PExpr.Base => true
  | PExpr.Member(obj, _) => IsPlain(obj)
  | PExpr.MacroCall(name, _, _) => name.Id == "=>"   // a lambda
  | PExpr.TypeEnforcement(e, _) => IsPlain(e)
  | _ => false
}

/// Moves each `await' within an expression, and what is evaluated before it there, into a `def' ahead of the
/// expression, in the order they are evaluated: `f(a(), await b)' is `{ def x = a(); def y = await b; f(x, y) }'. An
/// `await' then stands where its state machine can wait (a statement, a `def' value, a branch), and its value
/// stays one value, evaluated once. A loop's condition is not moved out of its loop.
Spill(body : PExpr, stream : PExpr = null) : PExpr
{
  // `await foreach' and `await using' are waits on MoveNextAsync and DisposeAsync, made here (before the rest)
  def body = Macros.TraverseExpr(None(), body, false, (_, after, node) =>
    {
      match (node)
      {
        | PExpr.Call(PExpr.Member(_, name), [construct]) when after && name.ToString() == "__await_each" => AwaitEach(construct)
        | _ => node
      }
    });
  // an async lambda in the body is its own async code (lowered where it is typed): set aside meanwhile
  def nested = System.Collections.Generic.Dictionary();
  def body = Macros.TraverseExpr(None(), body, false, (_, after, node) =>
    {
      match (node)
      {
        | PExpr.Call(PExpr.Member(_, name), [_]) when after && name.ToString() == "__async_lambda" =>
          def key = Macros.NewSymbol("async_lambda");
          nested[key.Id] = node;
          <[ $(key : name) ]>
        | _ => node
      }
    });
  // `yield x' produces an item of an async stream (one that returns IAsyncEnumerable[T]); any other async function
  // returns one Task
  def body = Macros.TraverseExpr(None(), body, false, (_, after, node) =>
    {
      match (node)
      {
        | PExpr.MacroCall(name, ns, [SyntaxElement.Expression(item)]) when after && name.Id == "yield" =>
          if (stream == null)
          {
            Message.Error(node.Location, "`yield' in an async function that returns a task: an async function yields when it returns IAsyncEnumerable[T]");
            node
          }
          else PExpr.MacroCall(node.Location, name, ns, [SyntaxElement.Expression(<[ ($stream).Produce($item) ]>)])
        | _ => node
      }
    });
  def restore(e : PExpr) : PExpr
  {
    if (nested.Count == 0) e   // (nothing set aside: the tree as it is, with the places the last pass gave it)
    else
      Macros.TraverseExpr(None(), e, false, (_, after, node) =>
        {
          match (node)
          {
            | PExpr.Ref(name) when after && nested.ContainsKey(name.Id) => restore(nested[name.Id])
            | PExpr.Call(_, [awaited]) when after && IsAwait(node) && awaited.Location.IsSourceAvailable => node.Location = awaited.Location; node
            | _ => node
          }
        })
  }
  def part(e : PExpr, defs : System.Collections.Generic.List[PExpr]) : PExpr
  {
    match (e)
    {
      | PExpr.Sequence(items) when items.Length > 1 =>   // a value made ahead already: its defs come first
        foreach (d in items.FirstN(items.Length - 1)) defs.Add(d);
        part(items.Last, defs)
      | _ when IsPlain(e) => e
      | _ =>
        def name = Macros.NewSymbol("await_part");
        defs.Add(<[ def $(name : name) = $e ]>);
        <[ $(name : name) ]>
    }
  }
  // the parts up to the last one with an `await' are evaluated ahead, in order
  def parts(items : list[PExpr], defs : System.Collections.Generic.List[PExpr]) : list[PExpr]
  {
    mutable last = -1;
    mutable i = 0;
    foreach (item in items) { when (HasAwait(item)) last = i; i++ }
    mutable result = [];
    i = 0;
    foreach (item in items) { result ::= if (i <= last) part(item, defs) else item; i++ }
    result.Rev()
  }
  def ahead(defs : System.Collections.Generic.List[PExpr], e : PExpr) : PExpr
  {
    if (defs.Count == 0) e else PExpr.Sequence(e.Location, Nemerle.Collections.NList.FromArray(defs.ToArray()) + [e])
  }
  // the places of the nodes being visited (the traversal rebuilds the tree, and a rebuilt `await' keeps its own: its
  // statement is a step of its own in the debugger, which a generated place would not be)
  def places = System.Collections.Generic.Stack();
  def visit(_ : bool, after : bool, e : PExpr) : PExpr
  {
    if (!after) places.Push(e.Location)
    else
    {
      def place = places.Pop();
      // (it is generated, as the async macros made it: marked as having its source, it is a step all the same)
      when (IsAwait(e) && place.FileIndex > 0 && place.Line > 0) e.Location = place.AsFakeSorceAvailable();
    }
    if (!after || IsAwait(e) || !HasAwait(e)) e
    else
      Nemerle.Compiler.UtilMacros.locate(e.Location,
        match (e)
        {
          // the right side of && and || is evaluated only when the left says so
          | PExpr.Call(PExpr.Ref(op), [left, right]) when op.Id == "&&" && HasAwait(right) => Spill(<[ if ($left) $right else false ]>)
          | PExpr.Call(PExpr.Ref(op), [left, right]) when op.Id == "||" && HasAwait(right) => Spill(<[ if ($left) true else $right ]>)
          | PExpr.Call(f, args) =>
            def defs = System.Collections.Generic.List();
            def f = match (f)
              {
                | PExpr.Member(obj, name) when HasAwait(obj) || args.Exists(HasAwait) && !IsPlain(obj) =>
                  PExpr.Member(f.Location, part(obj, defs), name)
                | _ when HasAwait(f) => part(f, defs)
                | _ => f
              };
            def args = parts(args, defs);
            ahead(defs, PExpr.Call(e.Location, f, args))
          | PExpr.Indexer(obj, args) =>
            def defs = System.Collections.Generic.List();
            def obj = part(obj, defs);
            def args = parts(args, defs);
            ahead(defs, PExpr.Indexer(e.Location, obj, args))
          | PExpr.Member(obj, name) when HasAwait(obj) =>
            def defs = System.Collections.Generic.List();
            def obj = part(obj, defs);
            ahead(defs, PExpr.Member(e.Location, obj, name))
          | PExpr.Tuple(args) =>
            def defs = System.Collections.Generic.List();
            def args = parts(args, defs);
            ahead(defs, PExpr.Tuple.Create(e.Location, args))
          | PExpr.ListLiteral(args) =>
            def defs = System.Collections.Generic.List();
            def args = parts(args, defs);
            ahead(defs, PExpr.ListLiteral(e.Location, args))
          // (a name may be a field, the file's state: its value is not where the state machine can wait)
          | PExpr.Assign(target, value) when HasAwait(value) =>
            def defs = System.Collections.Generic.List();
            def value = part(value, defs);
            ahead(defs, PExpr.Assign(e.Location, target, value))
          | PExpr.TypeEnforcement(value, ty) when HasAwait(value) =>
            def defs = System.Collections.Generic.List(); def value = part(value, defs); ahead(defs, PExpr.TypeEnforcement(e.Location, value, ty))
          | PExpr.TypeConversion(value, ty) when HasAwait(value) =>
            def defs = System.Collections.Generic.List(); def value = part(value, defs); ahead(defs, PExpr.TypeConversion(e.Location, value, ty))
          | PExpr.Is(value, ty) when HasAwait(value) =>
            def defs = System.Collections.Generic.List(); def value = part(value, defs); ahead(defs, PExpr.Is(e.Location, value, ty))
          | PExpr.Throw(value) when value != null && HasAwait(value) =>
            def defs = System.Collections.Generic.List(); def value = part(value, defs); ahead(defs, PExpr.Throw(e.Location, value))
          | PExpr.Match(value, cases, _) when HasAwait(value) =>
            def defs = System.Collections.Generic.List(); def value = part(value, defs); ahead(defs, PExpr.Match(e.Location, value, cases))
          // the condition of `if', `when' and `unless' is evaluated once, first
          | PExpr.MacroCall(name, ns, SyntaxElement.Expression(condition) :: rest)
            when (name.Id == "if" || name.Id == "when" || name.Id == "unless") && HasAwait(condition) =>
            def defs = System.Collections.Generic.List();
            def condition = part(condition, defs);
            ahead(defs, PExpr.MacroCall(e.Location, name, ns, SyntaxElement.Expression(condition) :: rest))
          // a handler that waits runs after its `try': the `try' only records which case caught the exception
          | PExpr.Try(guarded, cases) when cases.Exists(HandlerAwaits)
                                            && !cases.Exists(_ is TryCase.Ellipsis) =>
            def caught = Macros.NewSymbol("caught");
            def which = Macros.NewSymbol("which");
            def result = Macros.NewSymbol("try_value");
            mutable i = 0;
            mutable later = [];
            // (a case without a variable gets one, for a `throw;' in its handler)
            def named(exn : Splicable) { | Splicable.Name(n) when n.Id == "_" => Splicable.Name(Macros.NewSymbol("exn")) | _ => exn }
            def recorded = cases.Map(fun (c)
              {
                i++;
                def record(exn : Splicable) { <[ $(caught : name) = $(Rethrown(exn, caught)); $(which : name) = $(i : int); Nemerle.AsyncMacros.__default_value() ]> }
                def bind(exn : Splicable, ty : PExpr, handler : PExpr)
                {
                  def value = if (ty is PExpr.Wildcard) <[ $(caught : name) ]> else <[ ($(caught : name) : object) :> $ty ]>;
                  def handler = AfterCatch(handler, caught);
                  later ::= <[ case: | $(i : int) => $(match (exn) { | Splicable.Name(n) => <[ def $(n : name) = $value; $handler ]> | _ => handler }) ]>
                }
                match (c)
                {
                  | TryCase.Catch(exn, ty, handler) => def exn = named(exn); bind(exn, ty, handler); TryCase.Catch(c.Location, exn, ty, record(exn))
                  | TryCase.Filter(exn, ty, filter, handler) => def exn = named(exn); bind(exn, ty, handler); TryCase.Filter(c.Location, exn, ty, filter, record(exn))
                  | other => other
                }
              });
            def dispatch = later.Rev() + [<[ case: | _ => $(result : name) ]>];
            <[
              mutable $(caught : name) : System.Exception = null;
              mutable $(which : name) = 0;
              def $(result : name) = $(PExpr.Try(e.Location, guarded, recorded));
              match ($(which : name)) { ..$dispatch }
            ]>
          // a `finally' that waits runs after its `try', then what the `try' threw goes on
          | PExpr.TryFinally(guarded, handler) when HasAwait(handler) =>
            def caught = Macros.NewSymbol("caught");
            def result = Macros.NewSymbol("try_value");
            <[
              mutable $(caught : name) : System.Exception = null;
              def $(result : name) = try { $guarded } catch { | exn => $(caught : name) = exn; Nemerle.AsyncMacros.__default_value() };
              $handler;
              when ($(caught : name) != null) System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture($(caught : name)).Throw();
              $(result : name)
            ]>
          // a lock is its thread's: the code after an `await' may run on another thread, which cannot release it
          | PExpr.MacroCall(name, _, _) when name.Id == "lock" =>
            Message.Error(e.Location, "`await' in a `lock': the rest of the body may run on another thread, which cannot release the lock; "
                                      "use System.Threading.SemaphoreSlim and `await semaphore.WaitAsync()' instead");
            e
          | _ => e
        })
  }
  // an `await' in a lambda or local function does not make it wait (it is not async)
  mutable depth = 0;
  def body = Macros.TraverseExpr(None(), body, false, (_, after, node) =>
    {
      match (node)
      {
        | PExpr.Lambda | PExpr.DefFunctions => depth += if (after) -1 else 1; node
        | PExpr.Call(PExpr.Ref(arrow), [_, _]) when arrow.Id == "=>" => depth += if (after) -1 else 1; node
        | PExpr.Call(_, [awaited]) when after && depth > 0 && IsAwait(node) =>
          Message.Error(node.Location, "`await' in a lambda or local function: only an async function waits, and a lambda cannot be one yet; "
                                       "move the code into an async function and call it");
          <[ ($awaited).GetAwaiter().GetResult() ]>
        | _ => node
      }
    });
  restore(Macros.TraverseExpr(None(), body, false, visit))
}

/// Whether a catch case's handler has an `await'.
HandlerAwaits(c : TryCase) : bool
{
  | TryCase.Catch(_, _, handler) | TryCase.Filter(_, _, _, handler) => HasAwait(handler)
  | _ => false
}

/// The exception a catch case records: its variable.
Rethrown(exn : Splicable, _caught : Name) : PExpr
{
  match (exn) { | Splicable.Name(n) => <[ $(n : name) ]> | _ => <[ null ]> }
}

/// A catch handler moved after its `try': `throw;' (rethrow) there throws the caught exception again, as it was.
AfterCatch(handler : PExpr, caught : Name) : PExpr
{
  Macros.TraverseExpr(None(), handler, false, (_, after, node) =>
    {
      match (node)
      {
        // (it gives any type, as `throw' does)
        | PExpr.Throw(null) when after =>
          <[ System.Runtime.ExceptionServices.ExceptionDispatchInfo.Capture($(caught : name)).Throw();
             $(Nemerle.Compiler.UtilMacros.locate(node.Location.AsGenerated(), <[ Nemerle.AsyncMacros.__default_value() ]>)) ]>
        | _ => node
      }
    })
}

/// A value of any type (its default): what a `try' gives when a catch case that waits took over.
macro __default_value()
{
  <[ $(Nemerle.Compiler.Typedtree.TExpr.DefaultValue(Macros.ImplicitCTX().FreshTypeVar()) : typed) ]>
}

[MacroUsage(MacroPhase.BeforeTypedMembers, MacroTargets.Method)]
macro AsyncFunction(tb : TypeBuilder, m : ParsedMethod)
{
  def loc = m.Location;
  // what F returns, and what its body ends with (the driver's T)
  def taskName(ty : PExpr) : string
  {
    match (ty)
    {
      | PExpr.Ref(n) => n.Id
      | PExpr.Member(_, n) => n.ToString()
      | _ => null
    }
  }
  def returned = m.header.ReturnType;
  // an async stream: what it yields
  def item = match (returned) { | PExpr.Indexer(s, [t]) when taskName(s) == "IAsyncEnumerable" => t | _ => null };
  def (result, finish) : PExpr * (PExpr -> PExpr) =
    match (returned)
    {
      | _ when item != null => (null, run => run)
      | PExpr.Indexer(task, [t]) when taskName(task) == "Task" => (t, run => run)
      | PExpr.Indexer(task, [t]) when taskName(task) == "ValueTask" => (t, run => <[ System.Threading.Tasks.ValueTask.[$t]($run) ]>)
      | _ when taskName(returned) == "Task" => (null, run => run)
      | _ when taskName(returned) == "ValueTask" => (null, run => <[ System.Threading.Tasks.ValueTask($run) ]>)
      | PExpr.Void => (null, null)
      | _ =>
        Message.Error(returned.Location, "an async function returns Task, Task[T], ValueTask, ValueTask[T] or void: its caller waits for that");
        (null, run => run)
    };
  def t = if (result == null) <[ object ]> else result;
  foreach (p in m.header.Parameters)
    when (p.Type is PExpr.ParmByRef || p.Type is PExpr.ParmOut)
      Message.Error(p.Location, "an async function takes no ref or out parameter: it returns before its body ends");
  def iterator = Macros.NewSymbol("async_" + m.Name);
  // (F starts the state machine: the debug information and stack traces name F for it)
  Macros.Manager().UserData["Nemerle.AsyncMacros.kickoff:" + iterator.Id] = m;
  Macros.Manager().UserData["Nemerle.AsyncMacros.kickoff-name:" + iterator.Id] = (m.Name, m.header.Parameters.Length);
  if (item != null)
  {
    // an async stream: F returns an AsyncStream, each enumeration of which runs the iterator
    def stream = Macros.NewSymbol("stream");
    Macros.Manager().UserData["Nemerle.AsyncMacros.driver:" + iterator.Id] = stream;   // (what its `await's wait with)
    def body = Spill(m.Body, <[ $(stream : name) ]>);
    def parameters = <[ parameter: $(stream : name) : Nemerle.Async.AsyncStream[$item] ]>
                     :: m.header.Parameters.Map(p => <[ parameter: $(p.PName : name) : $(p.Type) ]>);
    def arguments = <[ $(stream : name) ]> :: m.header.Parameters.Map(p => <[ $(p.PName : name) ]>);
    def body = <[ $(Nemerle.Compiler.UtilMacros.locate(body.Location.AsGenerated(), <[ when ($(stream : name) == null) yield null ]>)); $body; () ]>;
    def ienumerable = <[ System.Collections.Generic.IEnumerable[object] ]>;
    def method = if (m.Attributes %&& NemerleModifiers.Static)
                   <[ decl: private static $(iterator : name) (..$parameters) : $ienumerable { $body } ]>
                 else
                   <[ decl: private $(iterator : name) (..$parameters) : $ienumerable { $body } ]>;
    (method :> ClassMember.Function).header.TypeParameters = m.header.TypeParameters;
    tb.Define(method);
    m.Body = Nemerle.Compiler.UtilMacros.locate(loc,
      <[ Nemerle.Async.AsyncStream.[$item](fun ($(stream : name) : Nemerle.Async.AsyncStream[$item]) { $(iterator : name) (..$arguments) }) ]>);
  }
  else {
  m.Body = Spill(m.Body);
  // as C#'s: the state machine is a struct, which the builder boxes only when the body first has to wait (Typer3 makes
  // it). Not for code with lambdas or local functions in it, which would share its locals with them (nor async void).
  def lambdas(e : PExpr) : bool
  {
    mutable found = false;
    _ = Macros.TraverseExpr(None(), e, false, (_, after, node) =>
      {
        match (node)
        {
          | PExpr.Lambda | PExpr.DefFunctions when !after => found = true
          | PExpr.Call(PExpr.Ref(arrow), [_, _]) when !after && arrow.Id == "=>" => found = true
          | PExpr.Call(PExpr.Member(_, name), [_]) when !after && name.ToString() == "__async_lambda" => found = true
          | _ => ()
        }
        node
      });
    found
  }
  def returnsTask = match (returned)
    {
      | PExpr.Indexer(task, [_]) => taskName(task) == "Task" || taskName(task) == "ValueTask"
      | _ => taskName(returned) == "Task" || taskName(returned) == "ValueTask"
    };
  def structMode = finish != null && returnsTask && !lambdas(m.Body) && m.Name != "_N_top_level";
  if (structMode)
  {
    def iterator = Macros.NewSymbol("asyncs_" + m.Name);   // _N_asyncs_F_<n>: its state machine is a struct
    def manager = Macros.Manager();
    manager.UserData["Nemerle.AsyncMacros.struct:" + iterator.Id] = true;
    manager.UserData["Nemerle.AsyncMacros.kickoff:" + iterator.Id] = m;
    manager.UserData["Nemerle.AsyncMacros.kickoff-name:" + iterator.Id] = (m.Name, m.header.Parameters.Length);
    def parameters = m.header.Parameters.Map(p => <[ parameter: $(p.PName : name) : $(p.Type) ]>);
    def arguments = m.header.Parameters.Map(p => <[ $(p.PName : name) ]>);
    def first = Nemerle.Compiler.UtilMacros.locate(m.Body.Location.AsGenerated(), <[ when (Nemerle.Async.Machine.Never) yield null ]>);
    def body = if (result == null)
                 <[ $first; $(m.Body); () ]>
               else
                 <[ $first;
                    $(Ending(m.Body, last => Nemerle.Compiler.UtilMacros.locate(last.Location,
                        <[ def value = $last; $(Nemerle.Compiler.UtilMacros.locate(m.Body.Location.AsGenerated(), <[ Nemerle.Async.Machine.Return(value) ]>)) ]>))) ]>;
    def method = if (m.Attributes %&& NemerleModifiers.Static)
                   <[ decl: private static $(iterator : name) (..$parameters) : $returned { $body } ]>
                 else
                   <[ decl: private $(iterator : name) (..$parameters) : $returned { $body } ]>;
    (method :> ClassMember.Function).header.TypeParameters = m.header.TypeParameters;
    tb.Define(method);
    m.Body = Nemerle.Compiler.UtilMacros.locate(loc, <[ $(iterator : name) (..$arguments) ]>);
  }
  else {
  // an async file's top-level code: its bindings' values are typed apart, where it assigns them
  when (m.Name == "_N_top_level")
  {
    def bindings = Macros.Manager().ModuleBindings;
    def prefix = tb.FullName + ".";
    foreach (key when key.StartsWith(prefix, System.StringComparison.Ordinal) in Nemerle.Collections.NList.FromArray(System.Linq.Enumerable.ToArray(bindings.Keys)))
      bindings[key] = Spill(bindings[key]);
  }   // _N_async_F_<n>
  def driver = Macros.NewSymbol("driver");
  Macros.Manager().UserData["Nemerle.AsyncMacros.driver:" + iterator.Id] = driver;   // (what its `await's wait with)
  // the runtime's builder that runs it: a ValueTask's does not allocate a task when the body does not wait
  def (driverType, newDriver, finish) : PExpr * PExpr * (PExpr -> PExpr) = match (returned)
    {
      | PExpr.Indexer(task, [_]) when taskName(task) == "ValueTask" =>
        (<[ Nemerle.Async.AsyncValueDriver[$t] ]>, <[ Nemerle.Async.AsyncValueDriver.[$t]() ]>, run => run)
      | _ when taskName(returned) == "ValueTask" =>
        (<[ Nemerle.Async.AsyncValueVoidDriver ]>, <[ Nemerle.Async.AsyncValueVoidDriver() ]>, run => run)
      | _ => (<[ Nemerle.Async.AsyncDriver[$t] ]>, <[ Nemerle.Async.AsyncDriver.[$t]() ]>, finish)
    };
  def parameters = <[ parameter: $(driver : name) : $driverType ]>
                   :: m.header.Parameters.Map(p => <[ parameter: $(p.PName : name) : $(p.Type) ]>);
  def arguments = <[ $(driver : name) ]> :: m.header.Parameters.Map(p => <[ $(p.PName : name) ]>);
  // the body, as an iterator: it is one even when it never waits (the driver then completes it at once)
  def first = Nemerle.Compiler.UtilMacros.locate(m.Body.Location.AsGenerated(), <[ when ($(driver : name) == null) yield null ]>);
  def body = if (result == null)
               <[ $first; $(m.Body); () ]>
             else
               <[ $first;
                  $(Ending(m.Body, last => Nemerle.Compiler.UtilMacros.locate(last.Location,
                      <[ def value = $last; $(Nemerle.Compiler.UtilMacros.locate(m.Body.Location.AsGenerated(), <[ $(driver : name).Result = value ]>)) ]>))) ]>;
  def ienumerable = <[ System.Collections.Generic.IEnumerable[object] ]>;
  def method = if (m.Attributes %&& NemerleModifiers.Static)
                 <[ decl: private static $(iterator : name) (..$parameters) : $ienumerable { $body } ]>
               else
                 <[ decl: private $(iterator : name) (..$parameters) : $ienumerable { $body } ]>;
  (method :> ClassMember.Function).header.TypeParameters = m.header.TypeParameters;
  tb.Define(method);
  def start = <[ $(iterator : name) (..$arguments) ]>;
  m.Body = Nemerle.Compiler.UtilMacros.locate(loc,
    if (finish == null)
      <[ def $(driver : name) = Nemerle.Async.AsyncDriver.[object](); $(driver : name).RunAndForget($start) ]>
    else
      <[ def $(driver : name) = $newDriver; $(finish(<[ $(driver : name).Run($start) ]>)) ]>);
  }
  }
}

/// `await e': waits for e (anything with GetAwaiter(), as a Task) and is what it ends with.
macro __await(e)
{
  def typer = Macros.ImplicitCTX();
  def manager = typer.Manager;
  def method = typer.CurrentMethodBuilder.Name;
  // what the state machine around waits with: its driver (or stream), the nearest async lambda's or the function's
  def driver = match ((typer.CurrentFunction :: typer.CurrentFunction.GetParents()).Find(h => h.Name.StartsWith("_N_async_local_")))
    {
      | Some(h) when manager.UserData.Contains("Nemerle.AsyncMacros.driver:" + h.Name) => manager.UserData["Nemerle.AsyncMacros.driver:" + h.Name] :> Name
      | _ when manager.UserData.Contains("Nemerle.AsyncMacros.driver:" + method) => manager.UserData["Nemerle.AsyncMacros.driver:" + method] :> Name
      | _ => null
    };
  // (an async function whose state machine is a struct: its awaits are the Machine calls Typer3 makes the struct's)
  def structMode = driver == null && manager.UserData.Contains("Nemerle.AsyncMacros.struct:" + method);
  if (method == "_N_state_types" || method == "_N_state_flow")
    // a copy of top-level code that only gives the file's state its types (never run)
    <[ ($e).GetAwaiter().GetResult() ]>
  else if (driver == null && !structMode)
  {
    Message.Error(e.Location, "`await' waits in an async function only");
    <[ ($e).GetAwaiter().GetResult() ]>
  }
  else
  {
    // the awaiter goes to the driver by reference, with its own type (not boxed), as C#'s builders take it; one that
    // is only an INotifyCompletion is waited for with the ExecutionContext flowed by itself
    def awaiter = typer.TypeExpr(<[ ($e).GetAwaiter() ]>);
    def critical = match (manager.LookupTypeInfo("System.Runtime.CompilerServices.ICriticalNotifyCompletion", 0))
      {
        | null => false
        | info => awaiter.Type.TryRequire(Nemerle.Compiler.fixed_type.FixedType.Class(info, []))
      };
    // (a struct machine's builder copies it: the wait is what `yield' yields, after the state is set)
    def wait = if (structMode && critical) <[ yield Nemerle.Async.Machine.AwaitUnsafe(ref awaiter) ]>
               else if (structMode) <[ yield Nemerle.Async.Machine.AwaitSafe(ref awaiter) ]>
               else if (critical) <[ $(driver : name).AwaitUnsafe(ref awaiter); yield null ]>
               else <[ $(driver : name).AwaitSafe(ref awaiter); yield null ]>;
    // (at the `await's place: its line is a step of its own, where the debugger stops)
    Nemerle.Compiler.UtilMacros.locate(e.Location.AsGenerated(), <[
      mutable awaiter = $(awaiter : typed);
      unless (awaiter.IsCompleted) { $wait }
      awaiter.GetResult()
    ]>)
  }
}

/// The kind of task an async local function's declared return type asks for: what its driver's Task becomes.
Finished(returned : PExpr) : PExpr -> PExpr
{
  def last(ty : PExpr) { | PExpr.Ref(n) => n.Id | PExpr.Member(_, n) => n.ToString() | _ => null }
  match (returned)
  {
    | PExpr.Indexer(task, [t]) when last(task) == "ValueTask" => run => <[ System.Threading.Tasks.ValueTask.[$t]($run) ]>
    | _ when last(returned) == "ValueTask" => run => <[ System.Threading.Tasks.ValueTask($run) ]>
    | _ => run => run
  }
}

/// `async fun (...) {...}', `async (x) => ...', `async def f(...) {...}': the body becomes a local iterator (its state
/// machine) run by an AsyncDriver; the lambda returns its Task (a Task[T] when the body has a value).
macro __async_lambda(e)
{
  def typer = Macros.ImplicitCTX();
  def lower(body : PExpr, finish : PExpr -> PExpr, forgotten : bool) : PExpr
  {
    def driver = Macros.NewSymbol("driver");
    def iterator = Macros.NewSymbol("async_local");   // _N_async_local_<n>: typed as an iterator
    Macros.Manager().UserData["Nemerle.AsyncMacros.driver:" + iterator.Id] = driver;
    def body = Spill(body);
    def start = if (forgotten) <[ $(driver : name).RunAndForget($(iterator : name)()) ]>
                else <[ Nemerle.AsyncMacros.__async_task($(driver : name), $(iterator : name)()) ]>;
    Nemerle.Compiler.UtilMacros.locate(body.Location, <[
      def $(driver : name) = Nemerle.Async.AsyncDriver();
      def $(iterator : name)() : System.Collections.Generic.IEnumerable[object]
      {
        $(Nemerle.Compiler.UtilMacros.locate(body.Location.AsGenerated(), <[ when ($(driver : name) == null) yield null ]>));
        $(Ending(body, last => Nemerle.Compiler.UtilMacros.locate(last.Location, <[ Nemerle.AsyncMacros.__async_result($(driver : name), $last) ]>)))
      }
      $(finish(start))
    ]>)
  }
  def lambda(forgotten : bool) : PExpr
  {
    match (e)
    {
      | PExpr.Lambda(decl) => PExpr.Lambda(e.Location, Function_decl(decl.Location, decl.header, lower(decl.body, run => run, forgotten)))
      | PExpr.Call(PExpr.Ref(arrow) as f, [parameters, body]) when arrow.Id == "=>" => PExpr.Call(e.Location, f, [parameters, lower(body, run => run, forgotten)])
      | _ => null
    }
  }
  match (e)
  {
    | PExpr.DefFunctions(functions) =>
      foreach (f in functions) f.body = lower(f.body, Finished(f.header.ReturnType), f.header.ReturnType is PExpr.Void);
      e
    | _ when lambda(false) != null => lambda(false)
    | _ =>
      Message.Error(e.Location, "`async' makes a lambda (`async fun', `async (x) => ...') or a local function (`async def') async");
      e
  }
}

/// The end of an async lambda's body: its value is the task's result, or, when it has none (void), the task is a Task.
macro __async_result(driver, body)
{
  def typer = Macros.ImplicitCTX();
  def typed = typer.TypeExpr(body);
  // a body that ends by throwing has no value: its task is a Task, as in C#
  def throws(t : Nemerle.Compiler.Typedtree.TExpr) : bool
  {
    | Nemerle.Compiler.Typedtree.TExpr.Throw => true
    | Nemerle.Compiler.Typedtree.TExpr.Sequence(_, last)
    | Nemerle.Compiler.Typedtree.TExpr.DefValIn(_, _, last)
    | Nemerle.Compiler.Typedtree.TExpr.DebugInfo(last, _) => throws(last)
    | _ => false
  }
  def isVoid = match (typed.Type.Hint) { | Some(t) => t.Equals(typer.Manager.InternalType.Void) | _ => false };
  if (isVoid || throws(typed))
  {
    match (driver) { | PExpr.Ref(name) => typer.Manager.UserData["Nemerle.AsyncMacros.void:" + name.Id] = true | _ => () }
    <[ $(typed : typed); _ = ($driver : Nemerle.Async.AsyncDriver[object]) ]>
  }
  else
    <[ def value = $(typed : typed); $driver.Result = value ]>
}

/// An async lambda's task: a Task[T] when its body has a value, else a Task (which a `void' delegate, an event
/// handler, takes as C#'s `async void': see Typer.NonLiteralCast).
macro __async_task(driver, start)
{
  def manager = Macros.ImplicitCTX().Manager;
  match (driver)
  {
    | PExpr.Ref(name) when manager.UserData.Contains("Nemerle.AsyncMacros.void:" + name.Id) => <[ ($driver.Run($start) : System.Threading.Tasks.Task) ]>
    | _ => <[ $driver.Run($start) ]>
  }
}

/// `await foreach (x in stream) body' (an IAsyncEnumerable's enumerator, disposed at the end) and `await using (x = e)
/// body' (an IAsyncDisposable, disposed at the end), as waits on MoveNextAsync and DisposeAsync.
AwaitEach(construct : PExpr) : PExpr
{
  def parts = match (construct) { | PExpr.MacroCall(_, _, parms) => parms.Map(fun (p) { | SyntaxElement.Expression(e) => e | _ => null }) | _ => [] };
  def binding(e : PExpr) { e is PExpr.Assign || e is PExpr.Define || e is PExpr.DefMutable }
  Nemerle.Compiler.UtilMacros.locate(construct.Location,
    match (construct)
    {
      | PExpr.MacroCall(name, _, _) when name.Id == "foreach" =>
        match (parts.Find(p => p is <[ $_ in $_ ]>), parts.Find(p => p != null && !(p is <[ $_ in $_ ]>)))
        {
          | (Some(<[ $item in $stream ]>), Some(body)) =>
            def enumerator = Macros.NewSymbol("enumerator");
            def more = Macros.NewSymbol("more");
            <[
              def $(enumerator : name) = ($stream).GetAsyncEnumerator();
              try
              {
                mutable $(more : name) = Nemerle.AsyncMacros.__await($(enumerator : name).MoveNextAsync());
                while ($(more : name))
                {
                  def $item = $(enumerator : name).Current;
                  $body;
                  $(more : name) = Nemerle.AsyncMacros.__await($(enumerator : name).MoveNextAsync())
                }
              }
              finally { Nemerle.AsyncMacros.__await($(enumerator : name).DisposeAsync()) }
            ]>
          | _ => Message.Error(construct.Location, "expected `await foreach (x in stream) body'"); construct
        }
      | PExpr.MacroCall(name, _, _) when name.Id == "using" =>
        def bindings = parts.Filter(p => p != null && binding(p));
        match (parts.Find(p => p != null && !binding(p)))
        {
          | Some(body) =>
            bindings.FoldRight(body, fun (b, inner)
              {
                def (target, value) = match (b) { | PExpr.Assign(t, v) | PExpr.Define(t, v) | PExpr.DefMutable(t, v) => (t, v) | _ => (null, null) };
                <[
                  def $target = $value;
                  try { $inner }
                  finally { when (($target : object) != null) Nemerle.AsyncMacros.__await($target.DisposeAsync()) }
                ]>
              })
          | _ => Message.Error(construct.Location, "expected `await using (x = value) body'"); construct
        }
      | _ =>
        Message.Error(construct.Location, "`await' before a `foreach' or a `using' only: `await foreach (x in stream)', `await using (x = value)'");
        construct
    })
}

/// `await foreach' or `await using' where no spill pass made it (a copy of top-level code typed for its state, or code
/// that is not async, where its `await's are reported).
macro __await_each(construct)
{
  AwaitEach(construct)
}
