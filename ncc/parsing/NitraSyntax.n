using System;
using SCG = System.Collections.Generic;
namespace Nemerle.Compiler
{
  /// Nitra syntax APIs: declaration inspection is kept separate from execution.
  public module NitraSyntax
  {
    private native : Lazy[NitraPreparedGrammar] = Lazy(fun() { NitraPreparation(NitraBootstrap.Documents(),array["NitraSyntax"]).Prepare() });
    [Obsolete("Nitra syntax is no longer experimental; use the overload without the flag")]
    public BaselineDefinitions(_experimental : bool) : array[NitraDocument] { BaselineDefinitions() }
    public BaselineDefinitions() : array[NitraDocument]
    {
      NitraBootstrap.Documents()
    }
    [Obsolete("Nitra syntax is no longer experimental; use the overload without the flag")]
    public Read(source : string, file : string, _experimental : bool) : NitraDocument { Read(source,file) }
    public Read(source : string, file : string) : NitraDocument
    {
      def d=ReadDefinitions(source,file);
      when(d.Success)
      {
        def check=native.Value.Recognize("NitraSyntax.Start",source); d.Surface=check;
        if(check.Complete && check.Accepted) d.SurfaceValidated=true;
        else if(check.Diagnostics.Count>0) foreach(message in check.Diagnostics) d.Diagnostics.Add(GrammarDiagnostic(d.File,check.Furthest,message));
        else d.Diagnostics.Add(GrammarDiagnostic(d.File,check.Furthest,"source does not match the pinned Nitra declaration grammar"));
      }
      d
    }
    /// Source hosting retains the suspended custom dialect without activating it.
    /// Read remains the strict native Nitra reader.
    [Obsolete("Nitra syntax is no longer experimental; use the overload without the flag")]
    public ReadSourceGrammar(source : string, file : string, _experimental : bool) : NitraDocument { ReadSourceGrammar(source,file) }
    public ReadSourceGrammar(source : string, file : string) : NitraDocument
    {
      when(source==null) throw ArgumentNullException("source");
      def inactive=SCG.List.[NitraInactiveConstruct]();
      try
      {
        def filtered=NitraInactiveSyntax.Filter(source,file,inactive);
        def d=Read(filtered,file); d.Source=source; d.InactiveConstructs.AddRange(inactive);
        def pending=SCG.Stack.[NitraDeclaration](); foreach(item in d.Declarations) pending.Push(item);
        while(pending.Count>0)
        {
          def item=pending.Pop(); item.Text=source.Substring(item.Start,item.End-item.Start);
          foreach(child in item.Children) pending.Push(child);
        }
        d
      }
      catch { | e is ArgumentException => Failed(source,file,e.Message) }
    }
    [Obsolete("Nitra syntax is no longer experimental; use the overload without the flag")]
    public Prepare(documents : SCG.IEnumerable[NitraDocument], modules : SCG.IEnumerable[string], _experimental : bool) : NitraPreparedGrammar { Prepare(documents,modules) }
    public Prepare(documents : SCG.IEnumerable[NitraDocument], modules : SCG.IEnumerable[string]) : NitraPreparedGrammar
    {
      NitraPreparation(documents,modules).Prepare()
    }
    [Obsolete("Nitra syntax is no longer experimental; use the overload without the flag")]
    public Structure(grammar : NitraPreparedGrammar, rule : string, source : string, resolver : Func[NitraStructuralChoice,int], _experimental : bool) : NitraStructureResult { Structure(grammar,rule,source,resolver) }
    public Structure(grammar : NitraPreparedGrammar, rule : string, source : string,
                     resolver : Func[NitraStructuralChoice,int]) : NitraStructureResult
    {
      when(grammar==null) throw ArgumentNullException("grammar");
      def gcPause0=if(NitraRecognizer.PhasesOn) GC.GetTotalPauseDuration().Ticks else 0L; def gcCount0=if(NitraRecognizer.PhasesOn) GC.CollectionCount(0) else 0;
      if(NitraFastParser.Verify && !NitraFastParser.Off) Verified(grammar,rule,source,resolver,true)
      else
      {
        def fast=Hybrid(grammar,rule,source,resolver);
        if(fast!=null)
        {
          when(NitraRecognizer.PhasesOn) NitraRecognizer.NoteGc(GC.GetTotalPauseDuration().Ticks-gcPause0,GC.CollectionCount(0)-gcCount0);
          fast
        }
        else Full(grammar,rule,source,resolver,gcPause0,gcCount0)
      }
    }
    private Full(grammar : NitraPreparedGrammar, rule : string, source : string, resolver : Func[NitraStructuralChoice,int], gcPause0 : long, gcCount0 : int) : NitraStructureResult
    {
      def recognized=grammar.Recognize(rule,source,true,false);
      def started=System.Diagnostics.Stopwatch.GetTimestamp();
      def allocStart=GC.GetAllocatedBytesForCurrentThread(); def findStart=NitraLongMap.Finds+NitraPairMap.Finds; def setStart=NitraPairMap.Sets+NitraLongMap.Adds;
      def builder=NitraStructureBuilder(recognized,resolver); def result=builder.Run();
      when(NitraRecognizer.PhasesOn)
      {
        NitraRecognizer.NoteCount("sel_alloc_kb",((GC.GetAllocatedBytesForCurrentThread()-allocStart)/1024L) :> int); NitraRecognizer.NoteCount("sel_hash_finds",((NitraLongMap.Finds+NitraPairMap.Finds-findStart) :> int)); NitraRecognizer.NoteCount("sel_hash_sets",((NitraPairMap.Sets+NitraLongMap.Adds-setStart) :> int));
        NitraRecognizer.NotePhase("select",System.Diagnostics.Stopwatch.GetTimestamp()-started);
        NitraRecognizer.NoteCount("later",builder.LaterCount); NitraRecognizer.NoteCount("ask",builder.AskCount); NitraRecognizer.NoteCount("build",builder.BuildCount);
        NitraRecognizer.NotePhase("feasible",builder.FeasibleTicks); for(mutable k=1;k<=5;++k) { NitraRecognizer.NotePhase("step"+k.ToString(),builder.StepTicks[k]); NitraRecognizer.NoteCount("steps"+k.ToString(),builder.StepCounts[k]); } NitraRecognizer.NoteCount("feasible_calls",builder.FeasibleCalls); NitraRecognizer.NoteCount("frames",builder.Frames); NitraRecognizer.NoteCount("endpoint_visits",builder.EndpointVisits); NitraRecognizer.NoteCount("endpoint_builds",builder.EndpointBuilds);
        NitraRecognizer.NoteGc(GC.GetTotalPauseDuration().Ticks-gcPause0,GC.CollectionCount(0)-gcCount0);
      }
      result
    }
    // NITRA_VERIFY: the full engine runs first with the caller's resolver (questions and answers recorded); the fast pass
    // then replays the answers, must ask the very same questions in the same order, and must build the same result.
    private Verified(grammar : NitraPreparedGrammar, rule : string, source : string, resolver : Func[NitraStructuralChoice,int], phases : bool) : NitraStructureResult
    {
      def asked=SCG.List.[string](); def answers=SCG.List.[int]();
      def describe(c : NitraStructuralChoice) : string
      {
        def b=System.Text.StringBuilder((c.Parent ?? "")+"@"+c.Start.ToString()+".."+c.End.ToString());
        foreach(o in c.Options) _=b.Append("|"+o.Operation.ToString()+":"+o.Kind+":"+(o.Label ?? "")+":"+o.Start.ToString()+".."+o.End.ToString());
        b.ToString()
      }
      def recording=if(resolver==null) null else Func.[NitraStructuralChoice,int](fun(c) { def a=resolver.Invoke(c); asked.Add(describe(c)); answers.Add(a); a });
      def full=if(phases) Full(grammar,rule,source,recording,0L,0) else NitraStructureBuilder(grammar.Recognize(rule,source,true,false),recording).Run();
      mutable next=0;
      def replay=if(resolver==null) null else Func.[NitraStructuralChoice,int](fun(c)
      {
        when(next>=asked.Count || asked[next]!=describe(c))
          throw InvalidOperationException("hybrid mismatch: resolver question "+next.ToString()+" "+describe(c)+" vs "+(if(next<asked.Count) asked[next] else "none"));
        def a=answers[next]; ++next; a
      });
      def fast=Hybrid(grammar,rule,source,replay);
      when(fast!=null)
      {
        NitraFastParser.Compare(fast,full);
        when(next!=asked.Count) throw InvalidOperationException("hybrid mismatch: resolver asked "+next.ToString()+" of "+asked.Count.ToString()+" questions");
      }
      full
    }
    // Fast first pass; null means the full engine decides (see NitraFast.n).
    private Hybrid(grammar : NitraPreparedGrammar, rule : string, source : string, resolver : Func[NitraStructuralChoice,int]) : NitraStructureResult
    {
      if(NitraFastParser.Off) null
      else
      {
        def started=if(NitraRecognizer.PhasesOn) System.Diagnostics.Stopwatch.GetTimestamp() else 0L; def alloc0=GC.GetAllocatedBytesForCurrentThread();
        def parser=NitraFastParser(grammar,source,resolver); def fast=parser.Run(rule);
        when(NitraRecognizer.PhasesOn)
        {
          NitraRecognizer.NotePhase("hybrid",System.Diagnostics.Stopwatch.GetTimestamp()-started);
          NitraRecognizer.NoteCount("hybrid_hit",if(fast!=null) 1 else 0); NitraRecognizer.NoteCount("hybrid_passes",parser.Passes); NitraRecognizer.NoteCount("hybrid_runs",parser.Runs); NitraRecognizer.NoteCount("hybrid_groups",parser.Groups); NitraRecognizer.NoteCount("hybrid_entries",parser.Entries); NitraRecognizer.NoteCount("hybrid_deps",parser.Deps); NitraRecognizer.NoteCount("hybrid_kb",((GC.GetAllocatedBytesForCurrentThread()-alloc0)/1024L) :> int);
        }
        fast
      }
    }
    internal StructureCompact(grammar : NitraPreparedGrammar, rule : string, source : string,
                              resolver : Func[NitraStructuralChoice,int]) : NitraStructureResult
    {
      if(NitraFastParser.Verify && !NitraFastParser.Off) Verified(grammar,rule,source,resolver,false)
      else
      {
        def fast=Hybrid(grammar,rule,source,resolver);
        if(fast!=null) fast else NitraStructureBuilder(grammar.Recognize(rule,source,true,false),resolver).Run()
      }
    }
    private Failed(source : string, file : string, message : string) : NitraDocument
    { def d=NitraDocument(); d.Source=source; d.File=file ?? "<grammar>"; d.Diagnostics.Add(GrammarDiagnostic(d.File,0,message)); d }
    [Obsolete("Nitra syntax is no longer experimental; use the overload without the flag")]
    public ReadDefinitions(source : string, file : string, _experimental : bool) : NitraDocument { ReadDefinitions(source,file) }
    public ReadDefinitions(source : string, file : string) : NitraDocument
    {
      when(source==null) throw ArgumentNullException("source");
      try { NitraDeclarationReader(source,file ?? "<grammar>").Read() }
      catch
      {
        | e is ArgumentException =>
          def d=NitraDocument(); d.Source=source; d.File=file ?? "<grammar>";
          d.Diagnostics.Add(GrammarDiagnostic(d.File,0,e.Message)); d
        | e is FormatException => Failed(source,file,e.Message)
        | e is OverflowException => Failed(source,file,e.Message)
      }
    }
  }
}
