using System;
using System.Collections.Generic;
using Nemerle.Collections;
using Nemerle.Compiler.Parsetree;
using Nemerle.Compiler.Typedtree;

namespace Nemerle.Compiler
{
  // Internal compiler data; public hosting contracts live outside the compiler.
  public sealed class ScriptCompilationData
  {
    public Prefix : string = "__script_" + Guid.NewGuid().ToString("N") + "_";
    public mutable LastInputToken : Token = null;
    public mutable IncompleteInput : bool = false;
    public mutable InvalidInput : bool = false;
    public PreludeSources : List[System.Tuple[string, string]] = List();
    public mutable Template : string;
    public mutable TypeName : string;
    public mutable FileName : string;
    public mutable CaptureResult : bool = true;
    public mutable ResultField : string = null;
    public mutable ResultTypeName : string = null;
    public OpenImportedNames : List[string] = List();
    public mutable ReceiverCount : int;
    public mutable DefaultImports : array[string];
    public TypedInitializers : Dictionary[string, TExpr] = Dictionary();
    public InferredInitializers : Dictionary[string, PExpr] = Dictionary();
    public PreviousTypeNames : Dictionary[string, string] = Dictionary();
    public PreviousNames : Dictionary[string, string] = Dictionary();
    public ImportedTypeNames : Dictionary[string, string] = Dictionary();
    public Members : Dictionary[string, string] = Dictionary();
    public Exports : Dictionary[string, string] = Dictionary();
    public RelocatedInitializers : HashSet[string] = HashSet();
    internal Names : Dictionary[string, string] = Dictionary();
    internal Owners : Dictionary[string, string] = Dictionary();
    internal FunctionScopes : Dictionary[string, string] = Dictionary();
    internal PrivateNames : HashSet[string] = HashSet();
    internal Masks : HashSet[TopDeclaration] = HashSet();
  }

  internal sealed class ScriptInitializerMacro : IMacro
  {
    public GetName() : string { "__script_binding_value" }
    public GetNamespace() : string { "Nemerle.Compiler" }
    public IsInherited : bool { get { false } }
    public IsTailRecursionTransparent : bool { get { false } }
    public Keywords : list[string] { get { [] } }
    public Usage : MacroUsageAttribute { get { null } }
    public Location : Location { get { Location.Default } }
    public SyntaxExtension() : GrammarElement * (list[SyntaxElement] -> list[SyntaxElement]) { (null, null) }
    public CallTransform(args : list[PExpr]) : list[SyntaxElement] { args.Map(e => SyntaxElement.Expression(e) : SyntaxElement) }
    public Run(ctx : Typer, args : list[SyntaxElement]) : PExpr
    {
      match (args)
      {
        | [SyntaxElement.Expression(PExpr.Literal(Literal.String(name)))] =>
          def data = ctx.Manager.Options.Script;
          foreach (field is FieldBuilder in ctx.CurrentType.LookupMember(name)) field.InferScriptType(ctx);
          <[ $(data.TypedInitializers[name] : typed) ]>;
        | _ => MessageMacros.FatalError("Invalid internal script initializer"); null
      }
    }
  }

  internal sealed class ScriptResultMacro : IMacro
  {
    public GetName() : string { "__capture_script_result" }
    public GetNamespace() : string { "Nemerle.Compiler" }
    public IsInherited : bool { get { false } }
    public IsTailRecursionTransparent : bool { get { false } }
    public Keywords : list[string] { get { [] } }
    public Usage : MacroUsageAttribute { get { null } }
    public Location : Location { get { Location.Default } }
    public SyntaxExtension() : GrammarElement * (list[SyntaxElement] -> list[SyntaxElement]) { (null, null) }
    public CallTransform(args : list[PExpr]) : list[SyntaxElement] { args.Map(e => SyntaxElement.Expression(e) : SyntaxElement) }
    public Run(ctx : Typer, args : list[SyntaxElement]) : PExpr
    {
      match (args)
      {
        | [SyntaxElement.Expression(body)] =>
          def resultName = ctx.Manager.Options.Script.Prefix + "result";
          def typed = ctx.TypeExpr(body);
          def ty = typed.Type.Fix();
          if (!ctx.Manager.Options.Script.CaptureResult)
            <[ $(typed : typed); this.$(resultName : usesite) = array[true : object, null : object, typeof(void) : object] ]>
          else if (ty is FixedType.Void)
            <[ $(typed : typed); this.$(resultName : usesite) = array[true : object, null : object, typeof(void) : object] ]>
          else if (ctx.Manager.Options.Script.ResultField != null)
          {
            def field = ctx.Manager.Options.Script.ResultField;
            <[ def value = $(typed : typed); this.$(field : usesite) = value; this.$(resultName : usesite) = array[false : object, (value : object), typeof($(ty : typed)) : object] ]>
          }
          else
            <[ def value = $(typed : typed); this.$(resultName : usesite) = array[false : object, (value : object), typeof($(ty : typed)) : object] ]>;
        | _ => MessageMacros.FatalError("Invalid internal script result capture"); null
      }
    }
  }
}
