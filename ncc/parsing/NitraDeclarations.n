using System;
using System.Text;
using SCG = System.Collections.Generic;
using Nemerle;
using Nemerle.Imperative;
namespace Nemerle.Compiler
{
  internal sealed class NitraDeclarationReader
  {
    doc : NitraDocument;
    r : NitraLex;
    public this(text : string, file : string)
    { doc=NitraDocument(); doc.Source=text; doc.File=file; r=NitraLex(text,file); }
    public Read() : NitraDocument
    {
      try { Members(doc.Declarations,"",null,null); unless(r.Is("<eof>")) r.Fail("unexpected closing brace"); }
      catch { | e is ArgumentException => doc.Diagnostics.Add(GrammarDiagnostic(doc.File,r.Peek().Start,e.Message)); }
      doc
    }
    private Node(kind : string, name : string, scope : string, start : int) : NitraDeclaration
    { def d=NitraDeclaration(); d.Kind=kind; d.Name=name; d.Scope=scope; d.File=doc.File; d.Start=start; d }
    private Finish(d : NitraDeclaration) : void
    { d.End=r.PreviousEnd; d.Text=doc.Source.Substring(d.Start,d.End-d.Start); }
    private Attributes() : SCG.List[string]
    {
      def attrs=SCG.List.[string]();
      while(r.Is("["))
      {
        _=r.Take();
        while(!r.Eat("]"))
        {
          def name=r.Name(); attrs.Add(name);
          when(r.Is("(")) r.Group("(",")");
          unless(r.Is("]")) r.Need(",");
        }
      }
      attrs
    }
    private Flag(attrs : SCG.List[string], on : string, off : string, initial : bool) : bool
    { mutable value=initial; foreach(a in attrs) { when(a==on) value=true; when(a==off) value=false; } value }
    private Members(items : SCG.List[NitraDeclaration], scope : string, mod : NitraModule, owner : NitraRule) : void
    {
      mutable precedence="0";
      while(!r.Is("<eof>") && !r.Is("}"))
      {
        def start=r.Peek().Start; def attrs=Attributes();
        if(r.Eat("using"))
        {
          def first=r.Name(); def target=if(r.Eat("=")) r.Name() else first; r.Need(";");
          def d=Node("using",first,scope,start); Finish(d); items.Add(d);
          when(mod!=null) mod.Imports[first]=target;
        }
        else if(r.Eat("namespace") || r.Eat("grammar"))
        {
          def name=r.Name(); def d=Node("scope",name,scope,start); d.Attributes.AddRange(attrs); r.Need("{");
          Members(d.Children,if(scope=="") name else scope+"."+name,mod,owner); r.Need("}"); Finish(d); items.Add(d);
        }
        else if(r.Is("syntax") && r.Ahead(1)=="module")
        {
          _=r.Take(); _=r.Take(); def name=r.Name();
          def m=NitraModule(); m.Name=if(scope=="") name else scope+"."+name; m.ExplicitSpaces=Flag(attrs,"ExplicitSpaces","ImplicitSpaces",false);
          def d=Node("module",name,scope,start); d.Attributes.AddRange(attrs); m.Declaration=d;
          when(r.Eat(":")) _=r.Name(); r.Need("{"); Members(d.Children,m.Name,m,null); r.Need("}");
          Finish(d); items.Add(d); doc.Modules.Add(m);
        }
        else if(r.Eat("precedence") && owner!=null)
        {
          precedence=r.Take().Text; unless(owner.Precedences.Contains(precedence)) owner.Precedences.Add(precedence);
          when(r.Eat("order"))
          { mutable left=r.Name(); while(r.Eat("<")) { def right=r.Name(); owner.Orders.Add(left+"<"+right); left=right; } }
          r.Need(":"); def d=Node("precedence",precedence,scope,start); Finish(d); items.Add(d);
        }
        else if(r.Eat("|") && owner!=null)
        {
          def va=Attributes(); attrs.AddRange(va);
          def named=r.Identifier() && r.Ahead(1)=="=";
          def name=if(named) r.Name() else "@"+owner.Alternatives.Count.ToString(); when(named) r.Need("=");
          def d=Node("alternative",name,scope,start); d.Attributes.AddRange(attrs);
          def a=NitraAlternative(); a.Name=name; a.Precedence=precedence; a.Declaration=d;
          a.Scope=scope+"."+name; a.ExplicitSpaces=Flag(attrs,"ExplicitSpaces","ImplicitSpaces",owner.ExplicitSpaces);
          a.SuppressTrailingSpaces=Flag(attrs,"SuppressTrailingSpaces","AllowTrailingSpaces",owner.SuppressTrailingSpaces);
          a.Expression=Expression(false);
          when(r.Eat("right")) { r.Need("-"); r.Need("associative"); a.Right=true; }
          when(r.Is("{")) { _=r.Take(); Members(d.Children,a.Scope,mod,owner); r.Need("}"); }
          _=r.Eat(";"); Finish(d); items.Add(d); owner.Alternatives.Add(a);
        }
        else if((r.Is("syntax") || r.Is("token") || r.Is("void") || r.Is("regex") || r.Is("extend")) && mod!=null)
        {
          def extend=r.Eat("extend"); def kind=r.Take().Text;
          unless(kind=="syntax" || kind=="token" || kind=="regex" || kind=="void") r.Fail("invalid rule kind");
          mutable name=r.Name(); mutable target;
          when(extend) { target=name; if(r.Eat("=")) target=r.Name(); else name="@extension"+mod.Rules.Count.ToString(); }
          def rule=NitraRule(); rule.Name=name; rule.Scope=scope; rule.Kind=kind; rule.Module=mod; rule.Base=target;
          rule.ExplicitSpaces=Flag(attrs,"ExplicitSpaces","ImplicitSpaces",kind!="syntax" || (if(owner!=null) owner.ExplicitSpaces else mod.ExplicitSpaces));
          rule.SuppressTrailingSpaces=Flag(attrs,"SuppressTrailingSpaces","AllowTrailingSpaces",false); rule.StartRule=attrs.Contains("StartRule");
          def d=Node(if(extend) "extension" else kind,name,scope,start); d.Attributes.AddRange(attrs); rule.Declaration=d; mod.Rules.Add(rule);
          when(r.Eat("="))
          { def a=NitraAlternative(); a.Name=name; a.Expression=Expression(kind=="regex"); a.Scope=scope+"."+name; a.ExplicitSpaces=rule.ExplicitSpaces; a.SuppressTrailingSpaces=rule.SuppressTrailingSpaces; a.Declaration=d; rule.Alternatives.Add(a); }
          if(r.Eat(";")) ()
          else { r.Need("{"); Members(d.Children,scope+"."+name,mod,rule); r.Need("}"); }
          Finish(d); items.Add(d);
        }
        else if(r.Eat("marker") && mod!=null)
        {
          def name=r.Name(); r.Need(";"); def d=Node("marker",name,scope,start); Finish(d); items.Add(d);
          AddRule(mod,scope,name,"marker",NitraExpression("empty",null),d);
        }
        else if(r.Eat("alias") && mod!=null)
        {
          def name=r.Name(); r.Need("="); def expr=Expression(false); r.Need(";"); def d=Node("alias",name,scope,start); Finish(d); items.Add(d);
          AddRule(mod,scope,name,"alias",expr,d);
        }
        else if(r.Eat("literal") && mod!=null)
        {
          def name=r.Name(); r.Need("="); def expr=NitraExpression("alt",null);
          while(true) { def t=r.Take(); unless(t.Quoted) r.Fail("literal requires a string"); expr.Children.Add(NitraExpression("literal",Decode(t))); unless(r.Eat(",")) break; }
          r.Need(";"); def d=Node("literal",name,scope,start); Finish(d); items.Add(d); AddRule(mod,scope,name,"literal",expr,d);
        }
        else if(r.Eat("keyword") && mod!=null)
        {
          r.Need("regex"); def expr=Expression(true); r.Need("rule"); def follower=r.Name(); r.Need(";");
          mod.KeywordPatterns.Add(expr); mod.KeywordFollowers.Add(follower);
          def d=Node("keyword",follower,scope,start); Finish(d); items.Add(d);
        }
        else
        {
          def d=Node("retained",r.Peek().Text,scope,start); d.Attributes.AddRange(attrs);
          Retain(d); Finish(d); items.Add(d);
        }
      }
    }
    private AddRule(m : NitraModule, scope : string, name : string, kind : string, expr : NitraExpression, d : NitraDeclaration) : void
    {
      def rule=NitraRule(); rule.Name=name; rule.Scope=scope; rule.Module=m; rule.Kind=kind; rule.ExplicitSpaces=true; rule.Declaration=d;
      def a=NitraAlternative(); a.Name=name; a.Expression=expr; a.Scope=scope+"."+name; a.ExplicitSpaces=true; a.Declaration=d;
      rule.Alternatives.Add(a); m.Rules.Add(rule);
    }
    private Retain(d : NitraDeclaration) : void
    {
      while(!r.Is("<eof>") && !r.Is("}"))
      {
        if(r.Eat(";")) return;
        else if(r.Is("(")) r.Group("(",")");
        else if(r.Is("[")) r.Group("[","]");
        else if(r.Is("{"))
        {
          def start=r.Peek().Start; r.Group("{","}"); def body=Node("retained-body","",d.Scope,start); Finish(body); d.Children.Add(body); _=r.Eat(";"); return;
        }
        else _=r.Take();
      }
      when(r.Is("<eof>")) r.Fail("unterminated retained declaration");
    }
    private Stop() : bool
    {
      r.Is("<eof>") || r.Is(";") || r.Is("}") || r.Is(")") || r.Is("|") || r.Is("precedence") || r.Is("rule")
      || (r.Is("right") && r.Ahead(1)=="-") || (r.Is("{") && !(char.IsDigit(r.Ahead(1)[0]) || r.Ahead(1)==","))
    }
    private Expression(regex : bool) : NitraExpression
    {
      mutable e=Sequence(regex);
      when(regex && r.Is("|"))
      { def alt=NitraExpression("alt",null); alt.Children.Add(e); while(r.Eat("|")) alt.Children.Add(Sequence(regex)); e=alt; }
      e
    }
    private Sequence(regex : bool) : NitraExpression
    {
      def seq=NitraExpression("seq",null);
      while(!Stop()) seq.Children.Add(Subtract(regex));
      when(seq.Children.Count==0) r.Fail("expected rule expression"); seq
    }
    private Subtract(regex : bool) : NitraExpression
    {
      mutable e=Term(regex);
      while(regex && r.Eat("-")) { def sub=NitraExpression("subtract",null); sub.Children.Add(e); sub.Children.Add(Term(regex)); e=sub; }
      e
    }
    private Term(regex : bool) : NitraExpression
    {
      mutable e;
      if(r.Is("!") || r.Is("&"))
      { def op=r.Take().Text; e=NitraExpression(if(op=="!") "not" else "and",null); e.Children.Add(Term(regex)); return e; }
      else if(r.Eat("("))
      {
        e=Expression(regex);
        when(r.Eat(";"))
        {
          def separated=NitraExpression("separated",null); separated.Children.Add(e); separated.Children.Add(Expression(regex));
          when(r.Eat(";")) { r.Need("?"); separated.Text="trailing"; } e=separated;
        }
        r.Need(")");
      }
      else if(r.Eat("["))
      {
        e=NitraExpression("class",if(r.Eat("^")) "inverted" else "normal");
        while(!r.Eat("]"))
        {
          if(r.Peek().Quoted)
          {
            def lo=Decode(r.Take()); unless(lo.Length==1) r.Fail("character class requires characters"); mutable hi=lo;
            when(r.Eat("..")) { hi=Decode(r.Take()); unless(hi.Length==1) r.Fail("range end requires a character"); }
            when(hi[0]<lo[0]) r.Fail("reversed range"); e.Children.Add(NitraExpression("range",lo+hi));
          }
          else e.Children.Add(NitraExpression("category",r.Name()));
          unless(r.Is("]")) r.Need(",");
        }
      }
      else if(r.Peek().Quoted) e=NitraExpression("literal",Decode(r.Take()));
      else
      {
        def name=r.Name();
        if(r.Eat("=")) { e=NitraExpression("capture",name); e.Children.Add(Term(regex)); return e; }
        else e=NitraExpression("call",name);
        when(r.Eat("^")) { e.Strong=r.Eat("+"); e.Binding=r.Take().Text; }
      }
      if(r.Eat("?")) { def q=NitraExpression("repeat",null); q.Min=0; q.Max=1; q.Children.Add(e); e=q; }
      else if(r.Is("*") || r.Is("+") || (r.Is("{") && (char.IsDigit(r.Ahead(1)[0]) || r.Ahead(1)==",")))
      {
        def q=if(e.Kind=="separated") e else NitraExpression("repeat",null); unless(q==e) q.Children.Add(e);
        if(r.Eat("*")) { q.Min=0; }
        else if(r.Eat("+")) { q.Min=1; }
        else
        {
          r.Need("{"); q.Min=if(r.Is(",")) 0 else int.Parse(r.Take().Text);
          if(r.Eat(",")) { q.Max=if(r.Is("}")) -1 else int.Parse(r.Take().Text); } else q.Max=q.Min;
          r.Need("}"); when(q.Max>=0 && q.Max<q.Min) r.Fail("reversed repetition bounds");
        };
        e=q;
      }
      else ();
      when(r.Eat("as")) { def capture=NitraExpression("capture",r.Name()); capture.Children.Add(e); e=capture; }
      e
    }
    private Decode(t : GLexeme) : string
    {
      unless(t.Quoted) r.Fail("expected quoted literal");
      // GReader decodes the common escapes; complete the Nitra escape alphabet.
      def b=StringBuilder(); def raw=t.Text;
      for(mutable i=1;i<raw.Length-1;++i)
      {
        def c=raw[i];
        if(c!='\\') _=b.Append(c);
        else
        {
          ++i; match(raw[i])
          {
            | 'n' => _=b.Append('\n'); | 'r' => _=b.Append('\r'); | 't' => _=b.Append('\t');
            | '0' => _=b.Append('\0'); | 'a' => _=b.Append('\a'); | 'b' => _=b.Append('\b');
            | 'f' => _=b.Append('\f'); | 'v' => _=b.Append('\v');
            | 'u' => _=b.Append(Convert.ToChar(Convert.ToInt32(raw.Substring(i+1,4),16))); i+=4;
            | _ => _=b.Append(raw[i]);
          }
        }
      }
      b.ToString()
    }
  }
}
