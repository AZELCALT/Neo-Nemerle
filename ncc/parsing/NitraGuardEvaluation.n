// Pure source/grammar checks. Each job owns its memo and publishes it only after completion.
using System;
using System.Globalization;
using SCG = System.Collections.Generic;
using Nemerle;
using Nemerle.Imperative;
namespace Nemerle.Compiler
{
  internal struct NitraGuardOutcome
  {
    public mutable Passed : bool;
    public mutable Scratch : NitraGuardEvaluator;
    public mutable LexicalResults : SCG.Dictionary[long,SCG.HashSet[int]];
    public mutable FirstTables : SCG.Dictionary[char,array[bool]];
    public mutable Observations : int;
    public mutable Evaluations : int;
    public mutable DispatchBuilds : int;
    public mutable CacheHits : int;
  }
  internal static class NitraGuardChecks
  {
    public Probe(grammar : NitraPreparedGrammar, source : string, p : int, op : NitraOperation,
                 cached : SCG.HashSet[int], bits : array[bool], scratch : NitraGuardEvaluator) : NitraGuardOutcome
    {
      mutable answer=default(NitraGuardOutcome); answer.Scratch=scratch; def guard=op.FirstGuard;
      def known=op.Nullable || bits!=null || p>=source.Length;
      when(known && !(op.Nullable || p<source.Length && bits[op.Id])) return answer;
      when(known && guard==null) { answer.Passed=true; return answer; }
      when(known && cached!=null) { answer.Passed=cached.Count>0; answer.CacheHits=1; return answer; }
      if(guard!=null && guard.Kind=="literal" && (known || guard.Text.Length>0))
      {
        answer.Observations=1;
        answer.Passed=p+guard.Text.Length<=source.Length && string.CompareOrdinal(source,p,guard.Text,0,guard.Text.Length)==0;
        when(answer.Passed && cached==null)
        {
          def ends=SCG.HashSet.[int](); _=ends.Add(p+guard.Text.Length);
          answer.LexicalResults=SCG.Dictionary(); answer.LexicalResults[(guard.Id :> long)*4294967296L+(p :> long)]=ends;
        }
        answer
      }
      else
      {
        when(answer.Scratch==null) answer.Scratch=NitraGuardEvaluator(grammar,source);
        def evaluator=answer.Scratch; evaluator.Begin(); when(cached!=null && guard!=null) evaluator.Seed(guard,p,cached);
        answer.Passed=evaluator.Test(op,p); answer.LexicalResults=evaluator.LexicalResults; answer.FirstTables=evaluator.FirstTables;
        answer.Observations=evaluator.Observations; answer.Evaluations=evaluator.Evaluations; answer.DispatchBuilds=evaluator.DispatchBuilds;
        answer
      }
    }
  }
  internal sealed class NitraGuardEvaluator
  {
    private prepared : NitraPreparedGrammar;
    private source : string;
    public mutable LexicalResults : SCG.Dictionary[long,SCG.HashSet[int]] = SCG.Dictionary();
    private lexical : SCG.Dictionary[long,SCG.HashSet[int]] = SCG.Dictionary();
    private lexicalActive : SCG.HashSet[long] = SCG.HashSet();
    public mutable FirstTables : SCG.Dictionary[char,array[bool]] = SCG.Dictionary();
    private firstSets : SCG.Dictionary[char,array[bool]] = SCG.Dictionary();
    public mutable Observations : int;
    public mutable Evaluations : int;
    public mutable DispatchBuilds : int;
    public this(grammar : NitraPreparedGrammar, text : string)
    { prepared=grammar; source=text; }
    public Begin() : void
    { LexicalResults=SCG.Dictionary(); FirstTables=SCG.Dictionary(); Observations=0; Evaluations=0; DispatchBuilds=0; }
    public Seed(o : NitraOperation,p : int,ends : SCG.HashSet[int]) : void
    { def key=Key(o.Id,p); unless(lexical.ContainsKey(key)) lexical[key]=ends; LexicalResults[key]=ends; }
    private Key(id : int,p : int) : long { (id :> long)*4294967296L+(p :> long) }
    private Count() : void { ++Evaluations; when(Evaluations>5000000) throw ArgumentException("guard convergence limit exceeded (5000000)"); }
    public Test(o : NitraOperation,p : int) : bool
    { Possible(o,p) && (o.FirstGuard==null || Lexical(o.FirstGuard,p).Count>0) }
    private static categoryNames : array[string] = array["Lu","Ll","Lt","Lm","Lo","Mn","Mc","Me","Nd","Nl","No","Zs","Zl","Zp","Cc","Cf","Cs","Co","Pc","Pd","Ps","Pe","Pi","Pf","Po","Sm","Sc","Sk","So","Cn"];
    private Category(c : char,name : string) : bool
    { def category=(char.GetUnicodeCategory(c) :> int); categoryNames[category]==name || (name.Length==1 && categoryNames[category].StartsWith(name,StringComparison.Ordinal)) }
    public Lexical(o : NitraOperation, p : int) : SCG.HashSet[int]
    {
      def key=Key(o.Id,p); when(lexical.ContainsKey(key)) { LexicalResults[key]=lexical[key]; return lexical[key]; }
      unless(lexicalActive.Add(key)) throw ArgumentException("cyclic lexical recognition at "+p.ToString());
      Count(); def ends=SCG.HashSet.[int]();
      try
      {
        match(o.Kind)
        {
          | "empty" => _=ends.Add(p);
          | "literal" =>
            ++Observations;
            when(p+o.Text.Length<=source.Length && string.CompareOrdinal(source,p,o.Text,0,o.Text.Length)==0) _=ends.Add(p+o.Text.Length);
          | "class" =>
            ++Observations;
            when(p<source.Length)
            {
              mutable found=false;
              foreach(c in o.Children)
                if(c.Kind=="range") { when(c.Text[0]<=source[p] && source[p]<=c.Text[1]) found=true; }
                else when(Category(source[p],c.Text)) found=true;
              when(found!=(o.Text=="inverted")) _=ends.Add(p+1);
            }
          | "seq" =>
            mutable positions=SCG.HashSet.[int](); _=positions.Add(p);
            foreach(c in o.Children)
            { def next=SCG.HashSet.[int](); foreach(q in positions) when(Possible(c,q)) next.UnionWith(Lexical(c,q)); positions=next; }
            ends.UnionWith(positions);
          | "not" | "and" =>
            def child=if(Possible(o.Children[0],p)) Lexical(o.Children[0],p) else SCG.HashSet();
            when((child.Count==0)==(o.Kind=="not")) _=ends.Add(p);
          | "subtract" => ends.UnionWith(Lexical(o.Children[0],p)); ends.ExceptWith(Lexical(o.Children[1],p));
          | "repeat" | "separated" =>
            def pending=SCG.Queue.[int*int](); def visited=SCG.HashSet.[long](); pending.Enqueue((p,0));
            while(pending.Count>0)
            {
              Count(); def (q,count)=pending.Dequeue();
              when(visited.Add(Key(count,q)))
              {
                when(count>=o.Min) _=ends.Add(q);
                when(o.Kind=="separated" && o.Text=="trailing" && count>0 && count>=o.Min) ends.UnionWith(Lexical(o.Children[1],q));
                when(o.Max<0 || count<o.Max)
                {
                  def positions=SCG.HashSet.[int]();
                  if(o.Kind=="separated" && count>0) positions.UnionWith(Lexical(o.Children[1],q)); else _=positions.Add(q);
                  foreach(start in positions) when(Possible(o.Children[0],start)) foreach(last in Lexical(o.Children[0],start))
                  {
                    when(last==q && !o.AllEnds) throw ArgumentException("non-progressing repetition at "+q.ToString());
                    pending.Enqueue((last,if(o.Max<0 && count>=Math.Max(1,o.Min)) Math.Max(1,o.Min) else count+1));
                  }
                }
              }
            }
          | "deferred" => throw ArgumentException(o.Text);
          | _ => foreach(c in o.Children) when(Possible(c,p)) ends.UnionWith(Lexical(c,p));
        }
        when((o.Kind=="longest" || (o.Kind=="repeat" || o.Kind=="separated") && !o.AllEnds) && ends.Count>1)
        { mutable last=p; foreach(q in ends) when(q>last) last=q; ends.Clear(); _=ends.Add(last); }
        lexical.Add(key,ends); LexicalResults[key]=ends;
        
        ends
      }
      finally { _=lexicalActive.Remove(key); }
    }
    private First(ch : char) : array[bool]
    {
      ++DispatchBuilds;
        def bits : array[bool]=array(prepared.Operations.Count); def pending=SCG.Queue.[NitraOperation]();
        foreach(op in prepared.Operations) pending.Enqueue(op);
        while(pending.Count>0)
        {
          def op=pending.Dequeue(); unless(bits[op.Id])
          {
            mutable yes=false;
            match(op.Kind)
            {
              | "literal" => yes=op.Text.Length>0 && op.Text[0]==ch;
              | "class" =>
                foreach(c in op.Children)
                  if(c.Kind=="range") { when(c.Text[0]<=ch && ch<=c.Text[1]) yes=true; }
                  else when(Category(ch,c.Text)) yes=true;
                yes=yes!=(op.Text=="inverted");
              | "deferred" => yes=true;
              | "seq" =>
                mutable more=true; foreach(c in op.Children) when(more) { when(bits[c.Id]) yes=true; more=c.Nullable; }
              | "subtract" => yes=bits[op.Children[0].Id];
              | "repeat" | "separated" => yes=bits[op.Children[0].Id];
              | _ => foreach(c in op.Children) when(bits[c.Id]) yes=true;
            }
            when(yes) { bits[op.Id]=true; foreach(parent in op.Parents) pending.Enqueue(parent); }
          }
        }
      bits
    }
    public Possible(o : NitraOperation, p : int) : bool
    {
      when(!prepared.Ready || o.Nullable) return true;
      when(p>=source.Length) return false;
      def ch=source[p];
      unless(firstSets.ContainsKey(ch))
      {
        // Grammar dispatch is immutable and source-independent. Share bounded
        // ASCII tables across inputs; non-ASCII tables stay local to this run.
        mutable existing : array[bool]=null;
        when((ch :> int)<128) lock(prepared.FirstAscii) existing=prepared.FirstAscii[ch :> int];
        def bits=existing ?? First(ch); firstSets.Add(ch,bits); FirstTables[ch]=bits;
      }
      firstSets[ch][o.Id]
    }
  }
}
