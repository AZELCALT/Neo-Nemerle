// Structure selection over settled recognition evidence. Evidence is consumed, never
// recognized again: every question is a lookup of (operation, start) -> ends.
// Feasibility and construction run on explicit stacks, so nesting depth is bounded
// by memory, not by the CLR stack.
using System;
using SCG = System.Collections.Generic;
using Nemerle;
using Nemerle.Imperative;
namespace Nemerle.Compiler
{
  /// Open-addressing map from a pair of 64-bit keys to an int (>= 0). Set overwrites.
  internal sealed class NitraPairMap
  {
    public static mutable Finds : long;
    public static mutable Sets : long;
    public mutable Hits : long;
    private mutable first : array[long];
    private mutable second : array[long];
    private mutable values : array[int];
    private mutable mask : int;
    private mutable used : int;
    public this() { Reset(); }
    private Reset() : void
    {
      first=array(64); second=array(64); values=array(64); mask=63; used=0;
      for(mutable i=0;i<64;++i) values[i]= -1;
    }
    private static Mix(a : long, b : long) : long { (a*2654435761L+b) & 0x7FFFFFFFL }
    private static Slot(a : long, b : long) : int
    {
      def h=unchecked((a * -7046029254386353131L) ^ (b * -4658895280553007687L));
      (((h >> 29) ^ (h >> 40)) & 0x7FFFFFFFL) :> int
    }
    public Find(a : long, b : long) : int
    {
      ++Finds; ++Hits;
      mutable i=Slot(a,b) & mask; mutable answer= -2;
      while(answer== -2)
      {
        if(values[i]<0) answer= -1
        else if(first[i]==a && second[i]==b) answer=values[i]
        else i=(i+1) & mask;
      }
      answer
    }
    public Set(a : long, b : long, value : int) : void
    {
      ++Sets;
      when((used+1)*2>first.Length) Grow();
      mutable i=Slot(a,b) & mask; mutable placed=false;
      while(!placed)
      {
        if(values[i]<0) { first[i]=a; second[i]=b; values[i]=value; ++used; placed=true; }
        else if(first[i]==a && second[i]==b) { values[i]=value; placed=true; }
        else i=(i+1) & mask;
      }
    }
    public Clear() : void { Reset(); }
    private Grow() : void
    {
      def oldFirst=first; def oldSecond=second; def oldValues=values;
      first=array(oldFirst.Length*2); second=array(oldFirst.Length*2); values=array(oldFirst.Length*2); mask=first.Length-1;
      for(mutable i=0;i<values.Length;++i) values[i]= -1;
      for(mutable j=0;j<oldFirst.Length;++j) when(oldValues[j] >=0)
      {
        mutable i=Slot(oldFirst[j],oldSecond[j]) & mask;
        while(values[i] >=0) i=(i+1) & mask;
        first[i]=oldFirst[j]; second[i]=oldSecond[j]; values[i]=oldValues[j];
      }
    }
  }
  /// Derivation graph of one sequence over a fixed span: edges (stage, from, to) in stage
  /// order, and which of them lie on a path that reaches the end.
  internal sealed class NitraSeqPlan
  {
    public Stages : int;
    public Edges : array[int];
    public EdgeCount : int;
    public First : array[int];
    public Good : array[bool];
    public mutable Ok : bool;
    public this(stages : int, edges : array[int], count : int)
    {
      Stages=stages; Edges=edges; EdgeCount=count; Good=array(count); First=array(stages+2);
      for(mutable s=0;s<=stages+1;++s) First[s]=count;
      for(mutable k=count-1;k>=0;--k) First[edges[3*k]]=k;
      // A stage without edges keeps the sentinel; make ranges monotone from the back.
      for(mutable s=stages;s>=0;--s) when(First[s] >First[s+1]) First[s]=First[s+1];
    }
    // The only end reachable from position at stage; -1 none, -2 several.
    public Single(stage : int, position : int) : int
    {
      mutable found= -1;
      for(mutable k=First[stage];k<First[stage+1] && found != -2;++k)
        when(Good[k] && Edges[3*k+1]==position)
        {
          def to=Edges[3*k+2];
          if(found== -1) found=to else when(found!=to) found= -2;
        }
      found
    }
    public Options(stage : int, position : int) : SCG.List[int]
    {
      def found=SCG.List.[int]();
      for(mutable k=First[stage];k<First[stage+1];++k)
        when(Good[k] && Edges[3*k+1]==position && !found.Contains(Edges[3*k+2])) found.Add(Edges[3*k+2]);
      found.Sort(); found
    }
  }
  /// States of one repetition over a fixed span: (position, capped count).
  internal sealed class NitraRepPlan
  {
    public Index : NitraLongMap = NitraLongMap();
    public StateP : SCG.List[int] = SCG.List();
    public StateCount : SCG.List[int] = SCG.List();
    public Steps : SCG.List[SCG.List[int]] = SCG.List();
    public Finish : SCG.List[bool] = SCG.List();
    public Viable : SCG.List[bool] = SCG.List();
    public Parents : SCG.List[SCG.List[int]] = SCG.List();
    public mutable Ok : bool;
    public State(p : int, count : int) : int
    {
      def key=(p :> long)*4294967296L+(count :> long); mutable id=Index.Find(key);
      when(id<0)
      {
        id=StateP.Count; Index.Add(key,id); StateP.Add(p); StateCount.Add(count);
        Steps.Add(SCG.List()); Finish.Add(false); Viable.Add(false); Parents.Add(SCG.List());
      }
      id
    }
    public Find(p : int, count : int) : int { Index.Find((p :> long)*4294967296L+(count :> long)) }
  }
  internal sealed class NitraAskFrame
  {
    public mutable Kind : int;   // 1 choice, 2 pass-through, 3 greedy call, 4 sequence, 5 repetition
    public mutable Op : NitraOperation;
    public mutable P : int;
    public mutable E : int;
    public mutable Cell : int;
    public mutable Entry : int;
    public mutable Cc : int;
    public mutable I : int;
    public mutable J : int;
    public mutable K : int;
    public mutable Phase : int;
    public mutable Pending : bool;
    public mutable Failed : bool;
    public mutable Q : int;
    public mutable Last : int;
    public mutable X : int;
    public mutable Count : int;
    public mutable Cs : int;
    public mutable PP : int;
    public mutable SepFlag : bool;
    public mutable Cur : array[int];
    public mutable CurN : int;
    public mutable Next : array[int];
    public mutable NextN : int;
    public mutable NextSet : SCG.HashSet[int];
    public mutable EdgeBuf : array[int];
    public mutable EdgeN : int;
    public mutable Back : NitraEnds;
    public mutable RepPlan : NitraRepPlan;
    public mutable Choices : array[int];
    public mutable ChoiceN : int;
    public mutable Pairs : SCG.List[int];
    public mutable Sorted : array[int];
  }
  internal sealed class NitraBuildItem
  {
    public mutable Kind : int;   // 1 build, 2 finish, 3 sequence advance, 4 repetition advance
    public mutable Node : NitraStructure;
    public mutable Parent : NitraStructure;
    public mutable Op : NitraOperation;
    public mutable Start : int;
    public mutable End : int;
    public mutable P : int;
    public mutable I : int;
    public mutable SeqPlan : NitraSeqPlan;
    public mutable RepPlan : NitraRepPlan;
  }
  internal sealed class NitraStructureBuilder
  {
    evidence : NitraEvidence;
    resolver : Func[NitraStructuralChoice,int];
    result : NitraStructureResult = NitraStructureResult();
    // Cells: one per (operation, start) that selection touches. A cell carries the evidence
    // ends and the per-position answers; entries hang off a cell per end and carry
    // feasibility (0 false, 1 true, 2 being computed), the derivation plan and the node.
    // Cells by start position (head array plus chain) and entries by cell (chain); no hashing.
    private mutable cellHead : array[int];
    private mutable cNext : array[int] = array(256);
    private mutable cOp : array[NitraOperation] = array(256);
    private mutable cEntry : array[int] = array(256);
    private mutable eNext : array[int] = array(256);
    private mutable eEnd : array[int] = array(256);
    private mutable cells : int;
    private mutable cEnds : array[NitraEnds] = array(256);
    private mutable cSorted : array[array[int]] = array(256);
    private mutable cLongest : array[int] = array(256);
    private mutable cTarget : array[int] = array(256);
    private mutable cEpoch : array[int] = array(256);
    private mutable cRegion : array[int] = array(256);
    private verifyOn : bool = Environment.GetEnvironmentVariable("NITRA_VERIFY")=="1";
    private fastOff : bool = Environment.GetEnvironmentVariable("NITRA_NOFAST")=="1";
    private verifyInfo : SCG.Dictionary[int,string] = SCG.Dictionary();
    private mutable eExpect : array[int] = array(256);
    internal mutable FastAnswers : int;
    internal mutable Verified : int;
    internal mutable FastPlans : int;
    internal mutable DbgNoRegion : int;
    internal mutable DbgState : int;
    internal mutable DbgOp : int;
    internal mutable DbgCalls : int;
    private GoodTriples(plan : NitraSeqPlan) : string
    {
      def list=SCG.List.[string]();
      for(mutable k=0;k<plan.EdgeCount;++k) when(plan.Good[k]) list.Add(plan.Edges[3*k].ToString()+","+plan.Edges[3*k+1].ToString()+","+plan.Edges[3*k+2].ToString());
      list.Sort(StringComparer.Ordinal); string.Join(";",list)
    }
    private RepSignature(plan : NitraRepPlan) : string
    {
      def rows=SCG.List.[string]();
      for(mutable s=0;s<plan.StateP.Count;++s)
        rows.Add(plan.StateP[s].ToString()+"/"+plan.StateCount[s].ToString()+" f="+plan.Finish[s].ToString()+" v="+plan.Viable[s].ToString()+" steps="+string.Join(",",plan.Steps[s]));
      rows.Sort(StringComparer.Ordinal); plan.Ok.ToString()+"|"+string.Join(";",rows)
    }
    private ComparePlans(o : NitraOperation, fast : int, slow : int) : void
    {
      ++FastPlans;
      if(o.Code==3)
      {
        def a=seqPlans[fast]; def b=if(slow >=0) seqPlans[slow] else null;
        if(b==null) throw ArgumentException("plan mismatch (search built no plan) for "+o.Label)
        else when(a.Ok!=b.Ok || GoodTriples(a)!=GoodTriples(b))
          throw ArgumentException("plan mismatch for sequence "+(o.Label ?? "")+": recorded ["+GoodTriples(a)+"] ok="+a.Ok.ToString()+", search ["+GoodTriples(b)+"] ok="+b.Ok.ToString());
      }
      else if(o.Code==6 || o.Code==7)
      {
        def a=RepSignature(repPlans[fast]); def b=if(slow >=0) RepSignature(repPlans[slow]) else "none";
        when(a!=b) throw ArgumentException("plan mismatch for repetition "+(o.Label ?? "")+": recorded "+a+", search "+b);
      }
      else
      {
        def a=string.Join(",",choicePlans[fast]); def b=if(slow >=0) string.Join(",",choicePlans[slow]) else "none";
        when(a!=b) throw ArgumentException("plan mismatch for choice "+(o.Label ?? "")+": recorded "+a+", search "+b);
      }
    }
    private mutable epoch : int;
    private mutable entries : int;
    private mutable eState : array[int] = array(256);
    private mutable ePlan : array[int] = array(256);
    private mutable eNode : array[int] = array(256);
    private mutable eEpoch : array[int] = array(256);
    private backMap : NitraPairMap = NitraPairMap();
    private seqPlans : SCG.List[NitraSeqPlan] = SCG.List();
    private choicePlans : SCG.List[array[int]] = SCG.List();
    private repPlans : SCG.List[NitraRepPlan] = SCG.List();
    private backSets : SCG.List[NitraEnds] = SCG.List();
    private revCache : SCG.Dictionary[int,SCG.Dictionary[int,SCG.List[int]]] = SCG.Dictionary();
    private stepCache : SCG.Dictionary[long,SCG.List[int]] = SCG.Dictionary();
    private mutable frames : array[NitraAskFrame] = array(64);
    private mutable sp : int;
    private mutable ret : bool;
    private mutable cyclic : bool;
    // Constructed objects.
    private nodeActive : SCG.List[bool] = SCG.List();
    private mutable items : array[NitraBuildItem] = array(64);
    private mutable top : int;
    internal mutable LaterCount : int;
    internal mutable CyclicCuts : int;
    internal mutable AskCount : int;
    internal mutable BuildCount : int;
    internal mutable EndpointVisits : int;
    internal mutable EndpointBuilds : int;
    internal mutable FeasibleTicks : long;
    internal mutable FeasibleCalls : int;
    internal mutable Frames : int;

    public this(recognition : NitraRecognitionResult, resolver : Func[NitraStructuralChoice,int])
    { result.Recognition=recognition; evidence=recognition.Evidence; this.resolver=resolver; }

    private static Pair(o : NitraOperation, p : int) : long { (o.Id :> long)*4294967296L+(p :> long) }
    private Ev(o : NitraOperation, p : int) : NitraEnds { evidence.At(o,p) }
    private static IsLeaf(o : NitraOperation) : bool { o.Code>=0 && o.Code<=2 }
    // Does o span exactly (p, e) in the evidence? Leaves are answered by the scanner.
    private Cell(o : NitraOperation, p : int) : int
    {
      when(cellHead==null)
      {
        cellHead=array(evidence.Source.Length+2);
        for(mutable q=0;q<cellHead.Length;++q) cellHead[q]= -1;
      }
      mutable c=if(p >= 0 && p<cellHead.Length) cellHead[p] else -1;
      while(c >= 0 && cOp[c] != o) c=cNext[c];
      when(c<0)
      {
        c=cells; ++cells;
        when(c==cEnds.Length)
        {
          mutable a=cEnds; Array.Resize(ref a,c*2); cEnds=a;
          mutable b=cSorted; Array.Resize(ref b,c*2); cSorted=b;
          mutable d=cLongest; Array.Resize(ref d,c*2); cLongest=d;
          mutable f=cTarget; Array.Resize(ref f,c*2); cTarget=f;
          mutable g=cEpoch; Array.Resize(ref g,c*2); cEpoch=g;
          mutable h=cRegion; Array.Resize(ref h,c*2); cRegion=h;
          mutable i1=cNext; Array.Resize(ref i1,c*2); cNext=i1;
          mutable i2=cOp; Array.Resize(ref i2,c*2); cOp=i2;
          mutable i3=cEntry; Array.Resize(ref i3,c*2); cEntry=i3;
        }
        cOp[c]=o; cNext[c]=cellHead[p]; cellHead[p]=c; cEntry[c]= -1;
        cEnds[c]=if(IsLeaf(o)) null else Ev(o,p); cSorted[c]=null; cLongest[c]= -1; cTarget[c]= -1; cEpoch[c]=epoch;
        cRegion[c]=if(IsLeaf(o)) -1 else evidence.Recognizer.RegionOf(o,p);
      }
      c
    }
    private Entry(c : int, e : int) : int
    {
      mutable en=cEntry[c];
      while(en >= 0 && eEnd[en] != e) en=eNext[en];
      when(en<0)
      {
        en=entries; ++entries;
        when(en==eState.Length)
        {
          mutable a=eState; Array.Resize(ref a,en*2); eState=a;
          mutable b=ePlan; Array.Resize(ref b,en*2); ePlan=b;
          mutable d=eNode; Array.Resize(ref d,en*2); eNode=d;
          mutable g=eEpoch; Array.Resize(ref g,en*2); eEpoch=g;
          mutable h=eExpect; Array.Resize(ref h,en*2); eExpect=h;
          mutable i1=eNext; Array.Resize(ref i1,en*2); eNext=i1;
          mutable i2=eEnd; Array.Resize(ref i2,en*2); eEnd=i2;
        }
        eEnd[en]=e; eNext[en]=cEntry[c]; cEntry[c]=en; eState[en]= -1; ePlan[en]= -1; eNode[en]= -1; eEpoch[en]=epoch; eExpect[en]= -1;
      }
      Fresh(en);
      en
    }
    // Search results older than the last cut are path-dependent and are forgotten lazily.
    private Fresh(en : int) : void
    { when(eEpoch[en]!=epoch) { eEpoch[en]=epoch; eState[en]= -1; ePlan[en]= -1; } }
    private HasAt(o : NitraOperation, c : int, p : int, e : int) : bool
    { if(IsLeaf(o)) evidence.LeafEnd(o,p)==e else cEnds[c].Contains(e) }
    private BeginSearch() : void
    {
      // A negative answer produced by an active-cycle cut is path-dependent.
      // Do not publish it (or plans depending on it) to later searches.
      when(cyclic)
      {
        ++epoch; cyclic=false;
      }
    }
    private SortedEnds(o : NitraOperation, p : int) : array[int]
    {
      if(IsLeaf(o)) { def end=evidence.LeafEnd(o,p); if(end<0) array(0) else array[end] }
      else
      {
        def c=Cell(o,p);
        when(cSorted[c]==null)
        {
          def ends=cEnds[c]; def copy : array[int]=array(ends.Count);
          for(mutable i=0;i<ends.Count;++i) copy[i]=ends.Items[i];
          when(copy.Length>1) Array.Sort(copy);
          cSorted[c]=copy;
        }
        cSorted[c]
      }
    }
    private RepeatKey(o : NitraOperation, count : int) : int
    { if(o.Max<0) Math.Min(count,Math.Max(1,o.Min)) else count }
    // (item start, item end) pairs of one repetition step, in ascending order.
    private RawSteps(o : NitraOperation, p : int, separated : bool) : SCG.List[int]
    {
      def key=((o.Id :> long) << 33) + ((p :> long) << 1) + (if(separated) 1L else 0L);
      if(stepCache.ContainsKey(key)) stepCache[key]
      else
      {
        def pairs=SCG.List.[int]();
        def starts : array[int]=if(separated) SortedEnds(o.Children[1],p) else array[p];
        foreach(q in starts) foreach(last in SortedEnds(o.Children[0],q)) when(last>p) { pairs.Add(q); pairs.Add(last); }
        stepCache[key]=pairs; pairs
      }
    }

    // ---- positions that can still chain to an end (evidence only) ----
    private Rev(o : NitraOperation) : SCG.Dictionary[int,SCG.List[int]]
    {
      if(revCache.ContainsKey(o.Id)) revCache[o.Id]
      else
      {
        def index=SCG.Dictionary.[int,SCG.List[int]]();
        evidence.ForEachOperation(o,fun(p : int,ends : NitraEnds)
        {
          for(mutable k=0;k<ends.Count;++k)
          {
            def q=ends.Items[k];
            unless(index.ContainsKey(q)) index[q]=SCG.List();
            index[q].Add(p);
          }
        });
        ++EndpointBuilds; revCache[o.Id]=index; index
      }
    }
    private BackSet(o : NitraOperation, slot : int, end : int) : NitraEnds
    {
      def a=(o.Id :> long)*4294967296L+(slot :> long); def hit=backMap.Find(a,(end :> long));
      if(hit>=0) backSets[hit]
      else
      {
        def found=NitraEnds();
        if(slot==o.Children.Count) _=found.Add(end);
        else
        {
          def later=BackSet(o,slot+1,end); def leafChild=o.Children[slot];
          if(IsLeaf(leafChild))
          {
            for(mutable i=0;i<later.Count;++i)
            {
              def q=later.Items[i];
              def p=match(leafChild.Code) { | 0 => q | 1 => q-leafChild.Text.Length | _ => q-1 };
              when(p>=0 && evidence.LeafEnd(leafChild,p)==q) { ++EndpointVisits; _=found.Add(p); }
            }
          }
          else
          {
          def rev=Rev(o.Children[slot]);
          for(mutable i=0;i<later.Count;++i)
          {
            def q=later.Items[i];
            when(rev.ContainsKey(q)) foreach(p in rev[q]) { ++EndpointVisits; _=found.Add(p); }
          }
          }
          // Zero-width results are not stored anywhere: they hold at every position the next character cannot start.
          def child=o.Children[slot];
          when((child.Interface ?? child).Sure)
            for(mutable i=0;i<later.Count;++i) when(evidence.IsZero(child,later.Items[i])) _=found.Add(later.Items[i]);
        }
        backMap.Set(a,(end :> long),backSets.Count); backSets.Add(found); found
      }
    }

    // ---- feasibility machine ----
    private NewFrame(kind : int, o : NitraOperation, p : int, e : int, cell : int, entry : int) : NitraAskFrame
    {
      when(sp==frames.Length) { mutable a=frames; Array.Resize(ref a,sp*2); frames=a; }
      when(frames[sp]==null) frames[sp]=NitraAskFrame();
      def f=frames[sp]; ++sp; ++Frames;
      f.Kind=kind; f.Op=o; f.P=p; f.E=e; f.Cell=cell; f.Entry=entry; f.Cc= -1; f.I=0; f.J=0; f.K=0; f.Phase=0; f.Pending=false; f.Failed=false;
      f.Q=0; f.Last=0; f.X=0; f.Count=0; f.SepFlag=false; f.CurN=0; f.NextN=0; f.NextSet=null; f.EdgeN=0; f.ChoiceN=0; f.Back=null;
      f.RepPlan=null; f.Pairs=null; f.Sorted=null;
      f
    }
    private Finish(entry : int, value : bool) : int
    { CheckExpected(entry,value); eState[entry]=if(value) 1 else 0; if(value) 1 else 0 }
    private Done(f : NitraAskFrame, value : bool) : void
    { CheckExpected(f.Entry,value); eState[f.Entry]=if(value) 1 else 0; --sp; ret=value; }
    // 1 feasible, 0 not feasible, -1 a frame was pushed and will deliver ret.
    // Feasibility read from what recognition settled: 1 feasible, 0 not, -1 unknown (use the search).
    private FastFeasible(o0 : NitraOperation, cell0 : int, p : int, e : int) : int
    {
      def o=o0.Pass;
      if(o.GreedyCall)
      {
        if(o.Children.Count==0 || o.Children[0].Pass.GreedyCall) -1
        else
        {
          def inner=o.Children[0];
          if(IsLeaf(inner.Pass) || IsLeaf(inner))
          { def sorted=SortedEnds(inner,p); if(sorted.Length>0 && sorted[sorted.Length-1]==e) 1 else 0 }
          else
          {
            def r=evidence.Recognizer.RegionOf(inner,p);
            if(r<0)
            { def sorted=SortedEnds(inner,p); if(sorted.Length>0 && sorted[sorted.Length-1]==e) 1 else 0 }
            else if(evidence.Recognizer.FeasibleState(r)==1) { if(evidence.Recognizer.FeasibleMax(r)==e) 1 else 0 }
            else -1
          }
        }
      }
      else
      {
        def r=cRegion[cell0];
        if(r<0) 1
        else if(evidence.Recognizer.FeasibleState(r)==1) { if(evidence.Recognizer.FeasibleEnds(r).Contains(e)) 1 else 0 }
        else -1
      }
    }
    private CheckExpected(en : int, value : bool) : void
    {
      when(verifyOn && eExpect[en] >=0) ++Verified;
      when(verifyOn && eExpect[en] >=0 && (eExpect[en]==1)!=value)
        throw ArgumentException("feasibility mismatch (recorded "+eExpect[en].ToString()+", search "+(if(value) "1" else "0")+") for "+verifyInfo[en]);
    }
    // c0 is the cell of (o0, p) when the caller already has it, else -1.
    private Enter(o0 : NitraOperation, c0 : int, p : int, e : int) : int
    {
      ++AskCount;
      mutable cell0=c0;
      if(IsLeaf(o0)) { unless(evidence.LeafEnd(o0,p)==e) return 0; }
      else
      {
        when(cell0<0) cell0=Cell(o0,p);
        unless(cEnds[cell0].Contains(e)) return 0;
      }
      def o=o0.Pass;
      unless(evidence.NativeSelection && !IsLeaf(o)) return 1;
      mutable fast= -1;
      unless(fastOff) fast=FastFeasible(o0,cell0,p,e);
      when(fast >=0 && !verifyOn) { ++FastAnswers; return fast; }
      mutable cell=cell0;
      when(o!=o0)
      {
        if(cTarget[cell0] >=0) cell=cTarget[cell0]
        else { cell=Cell(o,p); cTarget[cell0]=cell; }
      }
      def en=Entry(cell,e); def known=eState[en];
      when(known==2) { cyclic=true; ++CyclicCuts; return 0; }
      when(known>=0) return known;
      eState[en]=2;
      when(verifyOn) { eExpect[en]=fast; verifyInfo[en]=o.Kind+" "+(o.Label ?? "")+" at "+p.ToString()+".."+e.ToString(); }
      Begin(o,p,e,cell,en)
    }
    private Begin(o : NitraOperation, p : int, e : int, cell : int, en : int) : int
    {
      when(o.Code<0) o.Classify();
      if(o.GreedyCall)
      {
        when(cEpoch[cell]!=epoch) { cEpoch[cell]=epoch; cLongest[cell]= -1; }
        def known=cLongest[cell];
        if(known>=0) Finish(en,known-1==e)
        else
        {
          def f=NewFrame(3,o,p,e,cell,en); f.Sorted=SortedEnds(o,p); f.I=f.Sorted.Length-1; -1
        }
      }
      else if(o.OpaqueValue || o.Fast && (o.Code==6 || o.Code==7)) Finish(en,true)
      else match(o.Code)
      {
        | 0 | 1 | 2 | 8 | 9 => Finish(en,true)
        | 10 => _=NewFrame(2,o,p,e,cell,en); -1
        | 3 =>
          if(o.Children.Count==0) Finish(en,p==e)
          else
          {
            def f=NewFrame(4,o,p,e,cell,en);
            when(f.Cur==null) { f.Cur=array(8); f.Next=array(8); f.EdgeBuf=array(24); }
            f.Cur[0]=p; f.CurN=1; f.Back=BackSet(o,1,e); -1
          }
        | 6 | 7 =>
          if(p==e) Finish(en,o.Min==0)
          else
          {
            def f=NewFrame(5,o,p,e,cell,en);
            f.RepPlan=NitraRepPlan(); _=f.RepPlan.State(p,0); -1
          }
        | _ =>
          if(o.Children.Count==0) Finish(en,false)
          else if(o.Children.Count==1) { _=NewFrame(2,o,p,e,cell,en); -1 }
          else { def f=NewFrame(1,o,p,e,cell,en); when(f.Choices==null) f.Choices=array(8); -1 }
      }
    }
    private Drain() : void { while(sp>0) Step(); }
    internal StepTicks : array[long] = array(8);
    internal ProcTicks : array[long] = array(8);
    internal ProcCounts : array[int] = array(8);
    internal StepCounts : array[int] = array(8);
    private Step() : void
    {
      def f=frames[sp-1];
      def started=if(NitraRecognizer.PhasesOn) System.Diagnostics.Stopwatch.GetTimestamp() else 0L;
      def kind=f.Kind;
      match(kind)
      {
        | 1 => StepChoice(f)
        | 2 => StepPass(f)
        | 3 => StepGreedy(f)
        | 4 => StepSeq(f)
        | _ => StepRep(f)
      }
      when(NitraRecognizer.PhasesOn) { StepTicks[kind]+=System.Diagnostics.Stopwatch.GetTimestamp()-started; ++StepCounts[kind]; }
    }
    private AddChoice(f : NitraAskFrame, i : int) : void
    {
      when(f.ChoiceN==f.Choices.Length) { mutable a=f.Choices; Array.Resize(ref a,f.ChoiceN*2); f.Choices=a; }
      f.Choices[f.ChoiceN]=i; ++f.ChoiceN;
    }
    private StepChoice(f : NitraAskFrame) : void
    {
      when(f.Pending) { f.Pending=false; when(ret) AddChoice(f,f.Q); }
      def o=f.Op; mutable waiting=false;
      while(!waiting && f.I<o.Children.Count)
      {
        def i=f.I; ++f.I; def c=o.Children[i];
        if(IsLeaf(c))
        {
          when(evidence.LeafEnd(c,f.P)==f.E) { if(Enter(c,-1,f.P,f.E)==1) AddChoice(f,i) else (); }
        }
        else
        {
          def cc=Cell(c,f.P);
          when(cEnds[cc].Contains(f.E))
          {
            def r=Enter(c,cc,f.P,f.E);
            if(r<0) { f.Pending=true; f.Q=i; waiting=true; }
            else when(r==1) AddChoice(f,i);
          }
        }
      }
      unless(waiting)
      {
        def chosen : array[int]=array(f.ChoiceN); Array.Copy(f.Choices,chosen,f.ChoiceN);
        ePlan[f.Entry]=choicePlans.Count; choicePlans.Add(chosen);
        Done(f,f.ChoiceN>0);
      }
    }
    private StepPass(f : NitraAskFrame) : void
    {
      if(f.Pending) { f.Pending=false; Done(f,ret); }
      else
      {
        def r=Enter(f.Op.Children[0],-1,f.P,f.E);
        if(r<0) f.Pending=true else Done(f,r==1);
      }
    }
    private StepGreedy(f : NitraAskFrame) : void
    {
      mutable chosen= -2;
      if(f.Pending)
      {
        f.Pending=false;
        if(ret) chosen=f.Sorted[f.I] else --f.I;
      }
      else ();
      mutable waiting=false;
      while(chosen== -2 && !waiting)
      {
        if(f.I<0) chosen= -1
        else
        {
          def r=Enter(f.Op.Children[0],-1,f.P,f.Sorted[f.I]);
          if(r<0) { f.Pending=true; waiting=true; }
          else if(r==1) chosen=f.Sorted[f.I]
          else --f.I;
        }
      }
      unless(waiting)
      {
        cLongest[f.Cell]=chosen+1;
        Done(f,chosen==f.E);
      }
    }
    private AddEdge(f : NitraAskFrame, stage : int, from : int, to : int) : void
    {
      when(3*f.EdgeN+3>f.EdgeBuf.Length) { mutable a=f.EdgeBuf; Array.Resize(ref a,f.EdgeBuf.Length*2); f.EdgeBuf=a; }
      f.EdgeBuf[3*f.EdgeN]=stage; f.EdgeBuf[3*f.EdgeN+1]=from; f.EdgeBuf[3*f.EdgeN+2]=to; ++f.EdgeN;
      // Next-stage position set (no duplicates).
      mutable present=false;
      if(f.NextSet!=null) present= !f.NextSet.Add(to)
      else for(mutable i=0;i<f.NextN;++i) when(f.Next[i]==to) present=true;
      unless(present)
      {
        when(f.NextN==f.Next.Length) { mutable a=f.Next; Array.Resize(ref a,f.NextN*2); f.Next=a; }
        f.Next[f.NextN]=to; ++f.NextN;
        when(f.NextSet==null && f.NextN>16)
        { f.NextSet=SCG.HashSet(); for(mutable i=0;i<f.NextN;++i) _=f.NextSet.Add(f.Next[i]); }
      }
    }
    private StepSeq(f : NitraAskFrame) : void
    {
      def o=f.Op; def n=o.Children.Count;
      when(f.Pending)
      {
        f.Pending=false;
        when(ret) AddEdge(f,f.I,f.X,f.Q);
      }
      mutable waiting=false; mutable finished=false;
      while(!waiting && !finished)
      {
        if(f.I>=n) finished=true
        else if(f.J>=f.CurN)
        {
          if(f.NextN==0) { f.Failed=true; finished=true; }
          else
          {
            def swap=f.Cur; f.Cur=f.Next; f.Next=swap; f.CurN=f.NextN; f.NextN=0; f.NextSet=null;
            ++f.I; f.J=0; f.K=0; f.Cc= -1;
            when(f.I<n) f.Back=BackSet(o,f.I+1,f.E);
          }
        }
        else
        {
          def x=f.Cur[f.J]; def child=o.Children[f.I];
          if(IsLeaf(child))
          {
            if(f.K>0) { ++f.J; f.K=0; f.Cc= -1; }
            else
            {
              f.K=1; def q=evidence.LeafEnd(child,x);
              when(q>=0 && q<=f.E && f.Back.Contains(q)) AddEdge(f,f.I,x,q);
            }
          }
          else
          {
            when(f.Cc<0) f.Cc=Cell(child,x);
            def cx=f.Cc; def ends=cEnds[cx];
            if(f.K>=ends.Count) { ++f.J; f.K=0; f.Cc= -1; }
            else
            {
              def q=ends.Items[f.K]; ++f.K;
              when(q<=f.E && f.Back.Contains(q))
              {
                def r=Enter(child,cx,x,q);
                if(r<0) { f.Pending=true; f.X=x; f.Q=q; waiting=true; }
                else when(r==1) AddEdge(f,f.I,x,q);
              }
            }
          }
        }
      }
      unless(waiting)
      {
        def edges : array[int]=array(3*f.EdgeN); Array.Copy(f.EdgeBuf,edges,3*f.EdgeN);
        def plan=NitraSeqPlan(n,edges,f.EdgeN);
        def reached=(!f.Failed) && f.CurN>0 && f.Cur[0]==f.E;
        for(mutable k=plan.EdgeCount-1;k>=0;--k)
        {
          def stage=edges[3*k]; def to=edges[3*k+2];
          if(stage==n-1) plan.Good[k]=reached && to==f.E
          else
          {
            mutable ok=false;
            for(mutable m=plan.First[stage+1];m<plan.First[stage+2] && !ok;++m) when(plan.Good[m] && edges[3*m+1]==to) ok=true;
            plan.Good[k]=ok;
          }
        }
        mutable root=false;
        for(mutable k=plan.First[0];k<plan.First[1] && !root;++k) when(plan.Good[k] && edges[3*k+1]==f.P) root=true;
        plan.Ok=root;
        ePlan[f.Entry]=seqPlans.Count; seqPlans.Add(plan);
        Done(f,plan.Ok);
      }
    }
    private Accept(f : NitraAskFrame, q : int, last : int) : void
    {
      def plan=f.RepPlan;
      plan.Steps[f.Cs].Add(q); plan.Steps[f.Cs].Add(last);
      when(plan.StateP.Count>=500000) throw ArgumentException("repetition interpretation limit exceeded");
      def child=plan.State(last,RepeatKey(f.Op,f.Count+1));
      plan.Parents[child].Add(f.Cs);
    }
    private StepRep(f : NitraAskFrame) : void
    {
      def o=f.Op; def plan=f.RepPlan; mutable waiting=false;
      def separated=o.Kind=="separated";
      def prepare() : void
      {
        if(o.Max>=0 && f.Count>=o.Max) f.Pairs=null
        else { f.SepFlag=separated && f.Count>0; f.Pairs=RawSteps(o,f.PP,f.SepFlag); }
        f.J=0; f.Phase=2;
      }
      def itemCheck(q : int, last : int) : void
      {
        def r=Enter(o.Children[0],-1,q,last);
        if(r<0) { f.Pending=true; f.Phase=5; f.Q=q; f.Last=last; waiting=true; }
        else { when(r==1) Accept(f,q,last); f.J+=2; f.Phase=2; }
      }
      while(!waiting && f.Phase!=9)
      {
        match(f.Phase)
        {
          | 0 =>
            if(f.I>=plan.StateP.Count) f.Phase=9
            else
            {
              f.Cs=f.I; ++f.I; f.PP=plan.StateP[f.Cs]; f.Count=plan.StateCount[f.Cs];
              if(f.Count>=o.Min && f.PP==f.E) { plan.Finish[f.Cs]=true; prepare(); }
              else if(f.Count>=o.Min && f.Count>0 && separated && o.Text=="trailing")
              {
                def r=Enter(o.Children[1],-1,f.PP,f.E);
                if(r<0) { f.Pending=true; f.Phase=1; waiting=true; }
                else { when(r==1) plan.Finish[f.Cs]=true; prepare(); }
              }
              else prepare();
            }
          | 1 =>
            f.Pending=false; when(ret) plan.Finish[f.Cs]=true; prepare();
          | 2 =>
            if(f.Pairs==null || f.J>=f.Pairs.Count) f.Phase=0
            else
            {
              def q=f.Pairs[f.J]; def last=f.Pairs[f.J+1];
              if(last>f.E) f.J+=2
              else if(f.SepFlag)
              {
                def r=Enter(o.Children[1],-1,f.PP,q);
                if(r<0) { f.Pending=true; f.Phase=3; f.Q=q; f.Last=last; waiting=true; }
                else if(r==1) itemCheck(q,last)
                else f.J+=2;
              }
              else itemCheck(q,last);
            }
          | 3 =>
            f.Pending=false;
            if(ret) itemCheck(f.Q,f.Last) else { f.J+=2; f.Phase=2; }
          | 5 =>
            f.Pending=false; when(ret) Accept(f,f.Q,f.Last); f.J+=2; f.Phase=2;
          | _ => f.Phase=9
        }
      }
      unless(waiting)
      {
        def ready=SCG.Queue.[int]();
        for(mutable s=0;s<plan.StateP.Count;++s) when(plan.Finish[s]) { plan.Viable[s]=true; ready.Enqueue(s); }
        while(ready.Count>0)
        {
          def s=ready.Dequeue();
          foreach(parent in plan.Parents[s]) unless(plan.Viable[parent]) { plan.Viable[parent]=true; ready.Enqueue(parent); }
        }
        plan.Ok=plan.Viable[0];
        ePlan[f.Entry]=repPlans.Count; repPlans.Add(plan);
        Done(f,plan.Ok);
      }
    }
    private Query(o : NitraOperation, p : int, e : int) : bool
    {
      def started=if(NitraRecognizer.PhasesOn) System.Diagnostics.Stopwatch.GetTimestamp() else 0L;
      BeginSearch();
      def r=Enter(o,-1,p,e);
      def answer=if(r<0) { Drain(); ret } else r==1;
      when(NitraRecognizer.PhasesOn) { FeasibleTicks+=System.Diagnostics.Stopwatch.GetTimestamp()-started; ++FeasibleCalls; }
      answer
    }
    // Plans are built even when feasibility is plain membership (no native selection).
    // Plans read straight from the recorded edges of the region (exact regions only).
    private planKeys : SCG.List[long] = SCG.List();
    private planEdges : SCG.List[int] = SCG.List();
    private SeqFromEdges(o : NitraOperation, r : int, p : int, e : int) : int
    {
      def rec=evidence.Recognizer; def n=o.Children.Count;
      planKeys.Clear(); planEdges.Clear();
      mutable id=rec.EdgeHead(r);
      while(id >=0)
      {
        when(rec.EdgeKind(id)==2 && rec.EdgeTo(id)<=e && rec.EdgeUsable(r,id))
        { planKeys.Add(((rec.EdgeA(id) :> long) << 32)+(planEdges.Count :> long)); planEdges.Add(rec.EdgeA(id)); planEdges.Add(rec.EdgeFrom(id)); planEdges.Add(rec.EdgeTo(id)); }
        id=rec.EdgeNext(id);
      }
      def m=planEdges.Count/3; def keys=planKeys.ToArray(); Array.Sort(keys);
      def edges : array[int]=array(3*m);
      for(mutable k=0;k<m;++k)
      {
        def src=(keys[k] & 0xFFFFFFFFL) :> int;
        edges[3*k]=planEdges[src]; edges[3*k+1]=planEdges[src+1]; edges[3*k+2]=planEdges[src+2];
      }
      def plan=NitraSeqPlan(n,edges,m);
      for(mutable k=m-1;k >=0;--k)
      {
        def stage=edges[3*k]; def to=edges[3*k+2];
        if(stage==n-1) plan.Good[k]=(to==e)
        else
        {
          mutable ok=false;
          for(mutable q=plan.First[stage+1];q<plan.First[stage+2] && !ok;++q) when(plan.Good[q] && edges[3*q+1]==to) ok=true;
          plan.Good[k]=ok;
        }
      }
      mutable root=false;
      for(mutable k=plan.First[0];k<plan.First[1] && !root;++k) when(plan.Good[k] && edges[3*k+1]==p) root=true;
      plan.Ok=root;
      seqPlans.Add(plan); seqPlans.Count-1
    }
    private ChoiceFromEdges(o : NitraOperation, r : int, e : int) : int
    {
      def rec=evidence.Recognizer; planEdges.Clear();
      mutable id=rec.EdgeHead(r);
      while(id >=0)
      {
        when(rec.EdgeKind(id)==1 && rec.EdgeTo(id)==e && rec.EdgeUsable(r,id)) planEdges.Add(rec.EdgeA(id));
        id=rec.EdgeNext(id);
      }
      def chosen=planEdges.ToArray(); Array.Sort(chosen);
      choicePlans.Add(chosen); choicePlans.Count-1
    }
    private RepFromEdges(o : NitraOperation, r : int, p : int, e : int) : int
    {
      def rec=evidence.Recognizer; def separated=o.Code==7;
      def items=SCG.Dictionary.[long,SCG.List[int]](); def seps=SCG.Dictionary.[long,SCG.List[int]]();
      mutable id=rec.EdgeHead(r);
      while(id >=0)
      {
        def kind=rec.EdgeKind(id);
        when((kind==4 || kind==5) && rec.EdgeTo(id)<=e && rec.EdgeUsable(r,id))
        {
          def key=((rec.EdgeA(id) :> long) << 32)+(rec.EdgeB(id) :> long);
          def table=if(kind==4) items else seps;
          unless(table.ContainsKey(key)) table[key]=SCG.List();
          when(kind==4) table[key].Add(rec.EdgeFrom(id));
          table[key].Add(rec.EdgeTo(id));
        }
        id=rec.EdgeNext(id);
      }
      def plan=NitraRepPlan(); _=plan.State(p,0);
      mutable s=0;
      while(s<plan.StateP.Count)
      {
        def pp=plan.StateP[s]; def c=plan.StateCount[s]; def key=((c :> long) << 32)+(pp :> long);
        when(c >=o.Min && pp==e) plan.Finish[s]=true;
        when(separated && o.Text=="trailing" && c >=o.Min && c>0 && seps.ContainsKey(key) && seps[key].Contains(e)) plan.Finish[s]=true;
        when(items.ContainsKey(key) && (o.Max<0 || c<o.Max))
        {
          def raw=items[key]; def pairs=SCG.List.[long]();
          for(mutable k=0;k<raw.Count;k+=2)
            when(raw[k+1] >pp && (!(separated && c>0) || seps.ContainsKey(key) && seps[key].Contains(raw[k])))
              pairs.Add(((raw[k] :> long) << 32)+(raw[k+1] :> long));
          pairs.Sort();
          foreach(pair in pairs)
          {
            def q=(pair >> 32) :> int; def last=(pair & 0xFFFFFFFFL) :> int;
            plan.Steps[s].Add(q); plan.Steps[s].Add(last);
            def child=plan.State(last,RepeatKey(o,c+1));
            plan.Parents[child].Add(s);
          }
        }
        ++s;
      }
      def ready=SCG.Queue.[int]();
      for(mutable v=0;v<plan.StateP.Count;++v) when(plan.Finish[v]) { plan.Viable[v]=true; ready.Enqueue(v); }
      while(ready.Count>0)
      {
        def v=ready.Dequeue();
        foreach(parent in plan.Parents[v]) unless(plan.Viable[parent]) { plan.Viable[parent]=true; ready.Enqueue(parent); }
      }
      plan.Ok=plan.Viable[0];
      repPlans.Add(plan); repPlans.Count-1
    }
    // Returns a plan index with feasibility stored on the entry, or -1 to use the search.
    private FastPlan(o : NitraOperation, p : int, e : int, cell : int, en : int) : int
    {
      def r=cRegion[cell];
      when(r<0) ++DbgNoRegion;
      when(r >=0 && evidence.Recognizer.FeasibleState(r)!=1) ++DbgState;
      when(r >=0 && evidence.Recognizer.RegionOp(r)!=o) ++DbgOp;
      ++DbgCalls;
      if(r<0 || evidence.Recognizer.FeasibleState(r)!=1 || evidence.Recognizer.RegionOp(r)!=o) -1
      else if(o.Code==3 && o.Children.Count>0)
      {
        def index=SeqFromEdges(o,r,p,e); eState[en]=if(seqPlans[index].Ok) 1 else 0; index
      }
      else if((o.Code==4 || o.Code==5) && o.Children.Count>1)
      {
        def index=ChoiceFromEdges(o,r,e); eState[en]=if(choicePlans[index].Length>0) 1 else 0; index
      }
      else if((o.Code==6 || o.Code==7) && !o.Fast)
      {
        def index=RepFromEdges(o,r,p,e); eState[en]=if(repPlans[index].Ok) 1 else 0; index
      }
      else -1
    }
    private StartPlan(o : NitraOperation, p : int, e : int, cell : int, en : int) : int
    {
      def started=if(NitraRecognizer.PhasesOn) System.Diagnostics.Stopwatch.GetTimestamp() else 0L;
      BeginSearch();
      Fresh(en);
      mutable index=ePlan[en];
      when(index<0)
      {
        mutable fast= -1;
        when(!fastOff && evidence.NativeSelection) fast=FastPlan(o,p,e,cell,en);
        if(fast >=0 && !verifyOn) { ePlan[en]=fast; ++FastPlans; }
        else
        {
          eState[en]=2;
          def r=Begin(o,p,e,cell,en);
          when(r<0) Drain();
          index=ePlan[en];
          when(fast >=0) ComparePlans(o,fast,index);
        }
        when(fast >=0 && !verifyOn) index=fast;
      }
      when(NitraRecognizer.PhasesOn) { FeasibleTicks+=System.Diagnostics.Stopwatch.GetTimestamp()-started; ++FeasibleCalls; }
      index
    }

    // ---- construction ----
    private Option(o : NitraOperation, start : int, end : int) : NitraStructuralOption
    { def n=NitraStructuralOption(); n.Operation=o.Id; n.Kind=o.Kind; n.Label=o.Label; n.Start=start; n.End=end; n }
    private Pick(o : NitraOperation, start : int, end : int, options : SCG.List[NitraStructuralOption]) : NitraStructuralOption
    {
      when(options.Count==0) throw ArgumentException("missing settled structural evidence for "+o.Kind+" "+o.Label+" at "+start.ToString());
      when(options.Count==1) return options[0];
      def choice=NitraStructuralChoice(); choice.Parent=o.Label; choice.Start=start; choice.End=end; choice.Options.AddRange(options);
      when(resolver==null) throw ArgumentException("unresolved structural ambiguity in "+o.Label+" at "+start.ToString());
      def selected=resolver.Invoke(choice);
      when(selected<0 || selected>=options.Count) throw ArgumentException("structural resolver did not select a valid option in "+o.Label);
      options[selected]
    }
    private NewItem(kind : int) : NitraBuildItem
    {
      when(top==items.Length) { mutable a=items; Array.Resize(ref a,top*2); items=a; }
      when(items[top]==null) items[top]=NitraBuildItem();
      def item=items[top]; ++top;
      item.Kind=kind; item.Node=null; item.Parent=null; item.Op=null; item.Start=0; item.End=0; item.P=0; item.I=0;
      item.SeqPlan=null; item.RepPlan=null;
      item
    }
    private PushBuild(o : NitraOperation, start : int, end : int, parent : NitraStructure) : void
    { def item=NewItem(1); item.Op=o; item.Start=start; item.End=end; item.Parent=parent; }
    private Receive(parent : NitraStructure, child : NitraStructure) : void
    { if(parent==null) result.Root=child else parent.Children.Add(child); }
    private Build(o : NitraOperation, start : int, end : int, parent : NitraStructure) : void
    {
      ++BuildCount;
      def cell=Cell(o,start); def en=Entry(cell,end); def known=eNode[en];
      when(known>=0)
      {
        when(nodeActive[known]) throw ArgumentException("cyclic structural interpretation in "+o.Label);
        Receive(parent,result.Nodes[known]); return;
      }
      unless(HasAt(o,cell,start,end)) throw ArgumentException("unobserved structural span in "+o.Label);
      when(result.Nodes.Count>=500000) throw ArgumentException("structural object limit exceeded (500000)");
      when(o.Code<0) o.Classify();
      def n=NitraStructure(); n.Id=result.Nodes.Count; n.Operation=o.Id; n.Kind=o.Kind; n.Label=o.Label;
      n.Start=start; n.End=end; n.Source=evidence.Source; result.Nodes.Add(n);
      eNode[en]=n.Id; nodeActive.Add(true);
      n.RuleKind=o.RuleKind;
      def finish=NewItem(2); finish.Node=n; finish.Parent=parent;
      if(o.OpaqueValue || o.Fast && (o.Code==6 || o.Code==7)) ()
      else match(o.Code)
      {
        | 0 | 1 | 2 | 8 | 9 => ()
        | 10 => PushBuild(o.Children[0],start,end,n)
        | 3 =>
          when(o.Children.Count>0)
          {
            def index=StartPlan(o,start,end,cell,en);
            def plan=if(index>=0) seqPlans[index] else null;
            SeqAdvance(n,o,0,start,end,plan);
          }
        | 6 | 7 =>
          // No advancing transition can fit an empty target. No search graph is
          // needed for a nullable repetition; a required item remains an error.
          if(start==end) { when(o.Min>0) _=Pick(o,start,end,SCG.List()); }
          else
          {
            def index=StartPlan(o,start,end,cell,en);
            def plan=if(index>=0) repPlans[index] else null;
            RepAdvance(n,o,start,0,end,plan);
          }
        | _ when(o.Children.Count==1) =>
          def child=o.Children[0];
          if(Query(child,start,end)) PushBuild(child,start,end,n);
          else _=Pick(o,start,end,SCG.List());
        | _ =>
          def index=StartPlan(o,start,end,cell,en);
          if(index>=0 && choicePlans[index].Length==1) PushBuild(o.Children[choicePlans[index][0]],start,end,n)
          else
          {
            def options=SCG.List.[NitraStructuralOption]();
            when(index>=0) foreach(i in choicePlans[index]) options.Add(Option(o.Children[i],start,end));
            def selected=Pick(o,start,end,options);
            foreach(c in o.Children) when(c.Id==selected.Operation) PushBuild(c,start,end,n);
          }
      }
    }
    private SeqAdvance(n : NitraStructure, o : NitraOperation, i : int, p : int, end : int, plan : NitraSeqPlan) : void
    {
      when(i==o.Children.Count) return;
      def c=o.Children[i];
      mutable stop=if(plan!=null) plan.Single(i,p) else -1;
      when(stop== -1 || stop== -2)
      {
        def options=SCG.List.[NitraStructuralOption]();
        when(plan!=null) foreach(q in plan.Options(i,p)) options.Add(Option(c,p,q));
        stop=Pick(o,p,end,options).End;
      }
      def next=NewItem(3); next.Node=n; next.Op=o; next.I=i+1; next.P=stop; next.End=end; next.SeqPlan=plan;
      PushBuild(c,p,stop,n);
    }
    private RepAdvance(n : NitraStructure, o : NitraOperation, p : int, count : int, end : int, plan : NitraRepPlan) : void
    {
      def options=SCG.List.[NitraStructuralOption]();
      def state=if(plan==null) -1 else plan.Find(p,RepeatKey(o,count));
      when(state>=0)
      {
        when(plan.Finish[state]) options.Add(Option(o,p,end));
        def steps=plan.Steps[state];
        for(mutable k=0;k<steps.Count;k+=2)
        {
          def child=plan.Find(steps[k+1],RepeatKey(o,count+1));
          when(child>=0 && plan.Viable[child]) options.Add(Option(o.Children[0],steps[k],steps[k+1]));
        }
      }
      def selected=Pick(o,p,end,options);
      if(selected.Operation==o.Id)
      { when(p!=end) PushBuild(o.Children[1],p,end,n); }
      else
      {
        def next=NewItem(4); next.Node=n; next.Op=o; next.P=selected.End; next.I=count+1; next.End=end; next.RepPlan=plan;
        PushBuild(o.Children[0],selected.Start,selected.End,n);
        when(o.Kind=="separated" && count>0) PushBuild(o.Children[1],p,selected.Start,n);
      }
    }
    private Process(kind : int, node : NitraStructure, parent : NitraStructure, op : NitraOperation, start : int, end : int,
                     p : int, i : int, splan : NitraSeqPlan, rplan : NitraRepPlan) : void
    {
      match(kind)
      {
        | 1 => Build(op,start,end,parent)
        | 2 =>
          nodeActive[node.Id]=false;
          Receive(parent,node)
        | 3 => SeqAdvance(node,op,i,p,end,splan)
        | _ => RepAdvance(node,op,p,i,end,rplan)
      }
    }

    public Run() : NitraStructureResult
    {
      if(evidence==null)
      {
        result.Diagnostics.AddRange(result.Recognition.Diagnostics);
        when(result.Diagnostics.Count==0) result.Diagnostics.Add("source does not match "+result.Recognition.Rule+" at offset "+result.Recognition.Furthest.ToString());
      }
      else try
      {
        PushBuild(evidence.Root,0,evidence.Source.Length,null);
        while(top>0)
        {
          --top; ++LaterCount;
          def item=items[top];
          if(NitraRecognizer.PhasesOn)
          {
            def t0=System.Diagnostics.Stopwatch.GetTimestamp(); def kind=item.Kind;
            Process(item.Kind,item.Node,item.Parent,item.Op,item.Start,item.End,item.P,item.I,item.SeqPlan,item.RepPlan);
            ProcTicks[kind]+=System.Diagnostics.Stopwatch.GetTimestamp()-t0; ++ProcCounts[kind];
          }
          else Process(item.Kind,item.Node,item.Parent,item.Op,item.Start,item.End,item.P,item.I,item.SeqPlan,item.RepPlan);
        }
        when(NitraRecognizer.PhasesOn)
        {
          evidence.Recognizer.QueryReport();
          for(mutable k=0;k<8;++k) when(ProcCounts[k] > 0) { NitraRecognizer.NotePhase("pp"+k.ToString(),ProcTicks[k]); NitraRecognizer.NoteCount("pn"+k.ToString(),ProcCounts[k]); }
          
          NitraRecognizer.NoteCount("m_back",backMap.Hits :> int); NitraRecognizer.NoteCount("g_cyclic_cuts",CyclicCuts); NitraRecognizer.NoteCount("g_fast",FastAnswers); NitraRecognizer.NoteCount("g_verified",Verified); NitraRecognizer.NoteCount("g_fastplans",FastPlans); NitraRecognizer.NoteCount("d_calls",DbgCalls); NitraRecognizer.NoteCount("d_noregion",DbgNoRegion); NitraRecognizer.NoteCount("d_state",DbgState); NitraRecognizer.NoteCount("d_op",DbgOp);
        }
      }
      catch { | e is ArgumentException => result.Diagnostics.Add(e.Message); result.Root=null; }
      result
    }
  }
}
