// Retained logical lanes consume immutable evidence; they never receive source text.
using System;
using System.Threading;
using SCG = System.Collections.Generic;
using Nemerle;
using Nemerle.Imperative;
namespace Nemerle.Compiler
{
  internal sealed class NitraPoolMask
  {
    public mutable Id : int;
    public mutable Words : array[long];
    public mutable Count : int;
    public Contains(id : int) : bool { (Words[id/64] & (1L << (id%64)))!=0 }
  }
  internal sealed class NitraPoolMasks
  {
    private buckets : SCG.Dictionary[int,SCG.List[NitraPoolMask]] = SCG.Dictionary();
    private transitions : SCG.Dictionary[int*int*bool,NitraPoolMask] = SCG.Dictionary();
    private mutable next : int;
    private mutable parent : NitraPoolMasks;
    public this() {}
    public this(prepared : NitraPoolMasks) { parent=prepared; next=prepared.next; }
    private Find(hash : int,words : array[long]) : NitraPoolMask
    {
      when(buckets.ContainsKey(hash)) foreach(mask in buckets[hash])
      {
        mutable equal=mask.Words.Length==words.Length;
        for(mutable i=0;equal && i<words.Length;++i) equal=mask.Words[i]==words[i];
        when(equal) return mask;
      }
      if(parent!=null) parent.Find(hash,words) else null
    }
    private unions : SCG.Dictionary[int*int,NitraPoolMask] = SCG.Dictionary();
    public Union(left : NitraPoolMask,right : NitraPoolMask) : NitraPoolMask
    {
      def key=(left.Id,right.Id); when(unions.ContainsKey(key)) return unions[key];
      def words : array[long]=array(left.Words.Length);
      for(mutable i=0;i<words.Length;++i) words[i]=left.Words[i] | right.Words[i];
      def answer=Intern(words); when(unions.Count>=4096) unions.Clear(); unions[key]=answer; answer
    }
    public Intern(words : array[long]) : NitraPoolMask
    {
      mutable hash=17;
      foreach(word in words) hash=(hash<<5) ^ (hash>>27) ^ word.GetHashCode();
      def found=Find(hash,words); when(found!=null) return found;
      def value=NitraPoolMask(); value.Id=next; ++next; value.Words=words;
      foreach(word in words) { mutable bits=word; for(mutable i=0;i<64;++i) { when((bits & 1L)!=0) ++value.Count; bits=bits>>1; } }
      unless(buckets.ContainsKey(hash)) buckets[hash]=SCG.List(); buckets[hash].Add(value); value
    }
    public Select(left : NitraPoolMask,right : NitraPoolMask,remove : bool) : NitraPoolMask
    {
      def key=(left.Id,right.Id,remove); when(transitions.ContainsKey(key)) return transitions[key];
      def words : array[long]=array(left.Words.Length);
      for(mutable i=0;i<words.Length;++i) words[i]=left.Words[i] & (if(remove) ~right.Words[i] else right.Words[i]);
      def answer=Intern(words); when(transitions.Count>=4096) transitions.Clear(); transitions[key]=answer; answer
    }
  }
  internal struct NitraPoolEvidence
  {
    public mutable Session : long;
    public mutable Epoch : long;
    public mutable Context : int;
    public mutable Generation : int;
    public mutable Kind : int;
    public mutable Edge : int;
    public mutable Subject : int;
    public mutable SubjectVersion : int;
    public mutable EndpointCount : int;
    public mutable Position : int;
    public mutable Character : char;
    public mutable End : bool;
    public mutable First : array[bool];
  }
  internal struct NitraPoolEffect
  {
    public mutable Evidence : NitraPoolEvidence;
    public mutable Next : NitraLiteralFilter;
    public mutable Matches : SCG.List[int];
    public mutable General : array[bool];
    public mutable Continue : bool;
    public mutable Reject : bool;
  }
  internal static class NitraPoolPredicates
  {
    public Allows(operation : NitraOperation,evidence : NitraPoolEvidence) : bool
    { operation.Nullable || !evidence.End && evidence.First[operation.Id] }
  }
  internal sealed class NitraPoolLane
  {
    public mutable Context : NitraFamilyContext;
    public mutable Root : NitraPoolLane;
    public mutable From : int;
    public mutable Last : int;
    public mutable GeneralOnly : bool;
    public mutable Groups : SCG.List[NitraPoolLane];
    public mutable Node : NitraFamilyNode;
    public mutable Start : int;
    public mutable Position : int;
    public mutable Generation : int;
    public mutable Epoch : long;
    public mutable Applied : long;
    public mutable Prefix : NitraLiteralFilter;
    public mutable First : bool = true;
    public mutable Done : bool;
    public mutable Incoming : NitraPoolMask;
    public mutable Remaining : NitraPoolMask;
    public mutable Matched : NitraPoolMask;
    public mutable Effect : NitraPoolEffect;
    public mutable Ready : int;
    public mutable Leased : int;
    public mutable Failure : Exception;
    public mutable Evidence : NitraPoolEvidence;
    public mutable Deferred : SCG.Queue[NitraPoolEvidence];
    public Evaluate() : void
    {
      try
      {
        def e=Evidence; mutable answer=default(NitraPoolEffect); answer.Evidence=e;
        when(e.Kind!=0)
        { answer.Reject=e.Kind==2 && e.EndpointCount==0; Effect=answer; return; }
        when(First)
        {
          when(Last>From) answer.General=array(Last-From);
          for(mutable i=0;i<Last-From;++i)
          {
            def op=Node.Edges[Node.GeneralFilters[From+i]].Operation; def canonical=op.Interface ?? op;
            answer.General[i]=NitraPoolPredicates.Allows(canonical,e);
          }
        }
        when(GeneralOnly) { Effect=answer; return; }
        if(!e.End && Prefix.Edges.ContainsKey(e.Character))
        { answer.Next=Prefix.Edges[e.Character]; answer.Matches=answer.Next.Matches; answer.Continue=answer.Next.Edges.Count>0; }
        else { answer.Next=Prefix; answer.Continue=false; }
        Effect=answer;
      }
      catch { | error => Failure=error; }
      finally { Volatile.Write(ref Ready,1); }
    }
  }
}
