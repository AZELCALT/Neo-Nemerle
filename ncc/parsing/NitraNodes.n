// Session-owned segmented recognition storage. No node owns a collection object.
using System;
using System.Threading;
using System.Threading.Tasks;
using SCG = System.Collections.Generic;
using Nemerle;
using Nemerle.Imperative;
namespace Nemerle.Compiler
{
  internal sealed class NitraTable[T] : SCG.IEnumerable[T]
  {
    public Initial : int;
    public mutable First : array[T];
    public mutable Segments : array[array[T]];
    public mutable Count : int;
    public this() { this(64); }
    public this(initial : int) { Initial=initial; }
    public Add(value : T) : int
    {
      def id=Count; when(First==null) First=array(Initial);
      if(id<First.Length) First[id]=value;
      else
      {
        def offset=id-First.Length; when(Segments==null) Segments=array(4);
        when(offset/1024>=Segments.Length)
        { def expanded : array[array[T]]=array(Segments.Length*2); Array.Copy(Segments,expanded,Segments.Length); Segments=expanded; }
        when(offset%1024==0) Segments[offset/1024]=array(1024);
        Segments[offset/1024][offset%1024]=value;
      }
      ++Count; id
    }
    public Item[index : int] : T
    {
      get { if(index<First.Length) First[index] else Segments[(index-First.Length)/1024][(index-First.Length)%1024] }
      set { if(index<First.Length) First[index]=value; else Segments[(index-First.Length)/1024][(index-First.Length)%1024]=value; }
    }
    public GetEnumerator() : NitraTableEnumerator[T]
    { mutable e=default(NitraTableEnumerator[T]); e.Table=this; e.Index= -1; e }
    private Typed() : SCG.IEnumerator[T] implements SCG.IEnumerable[T].GetEnumerator { GetEnumerator() }
    private Untyped() : System.Collections.IEnumerator implements System.Collections.IEnumerable.GetEnumerator
    { GetEnumerator() }
  }
  internal struct NitraTableEnumerator[T] : SCG.IEnumerator[T]
  {
    public mutable Table : NitraTable[T];
    public mutable Index : int;
    public Current : T { get { Table[Index] } }
    private UntypedCurrent : object implements System.Collections.IEnumerator.Current { get { Current } }
    public MoveNext() : bool { ++Index; Index<Table.Count }
    public Reset() : void { Index= -1; }
    public Dispose() : void {}
  }
  internal struct NitraSetEnumerator[T] : SCG.IEnumerator[T]
  {
    public mutable Arena : NitraSetArena[T];
    public mutable Next : int;
    private mutable Value : T;
    public Current : T { get { Value } }
    private UntypedCurrent : object implements System.Collections.IEnumerator.Current { get { Current } }
    public MoveNext() : bool
    {
      while(Next>=0)
      { def entry=Arena.Entries[Next]; Next=entry.Next; when(entry.Active) { Value=entry.Value; return true; } }
      false
    }
    public Reset() : void { throw NotSupportedException(); }
    public Dispose() : void {}
  }
  internal struct NitraNodeEnumerator : SCG.IEnumerator[NitraSample]
  {
    public mutable Store : NitraNodeStore;
    public mutable Index : int;
    public Current : NitraSample { get { Store[Index] } }
    private UntypedCurrent : object implements System.Collections.IEnumerator.Current { get { Current } }
    public MoveNext() : bool { ++Index; Index<Store.Count }
    public Reset() : void { Index= -1; }
    public Dispose() : void {}
  }
  internal struct NitraSetHeader[T]
  {
    public mutable Head : int;
    public mutable Tail : int;
    public mutable Count : int;
    public mutable Index : SCG.Dictionary[T,int];
  }
  internal struct NitraSetEntry[T]
  {
    public mutable Value : T;
    public mutable Next : int;
    public mutable Active : bool;
    public mutable Previous : int;
  }
  internal sealed class NitraSetArena[T]
  {
    public Headers : NitraTable[NitraSetHeader[T]] = NitraTable(256);
    public Entries : NitraTable[NitraSetEntry[T]] = NitraTable(256);
    public At(id : int) : NitraNodeSet[T] { mutable s=default(NitraNodeSet[T]); s.Arena=this; s.Id=id; s }
    public New() : NitraNodeSet[T]
    { mutable h=default(NitraSetHeader[T]); h.Head= -1; h.Tail= -1; mutable s=default(NitraNodeSet[T]); s.Arena=this; s.Id=Headers.Add(h); s }
  }
  internal struct NitraNodeSet[T] : SCG.IEnumerable[T]
  {
    public mutable Arena : NitraSetArena[T];
    public mutable Id : int;
    public Count : int { get { Arena.Headers[Id].Count } }
    public Contains(value : T) : bool
    {
      def h=Arena.Headers[Id]; when(h.Index!=null) return h.Index.ContainsKey(value);
      mutable e=h.Head;
      while(e>=0) { def entry=Arena.Entries[e]; when(entry.Active && SCG.EqualityComparer.[T].Default.Equals(entry.Value,value)) return true; e=entry.Next; }
      false
    }
    public Add(value : T) : bool
    {
      when(Contains(value)) return false;
      mutable h=Arena.Headers[Id]; mutable entry=default(NitraSetEntry[T]); entry.Value=value; entry.Next= -1; entry.Previous=h.Tail; entry.Active=true;
      def id=Arena.Entries.Add(entry);
      if(h.Tail<0) h.Head=id;
      else { mutable last=Arena.Entries[h.Tail]; last.Next=id; Arena.Entries[h.Tail]=last; }
      h.Tail=id; ++h.Count;
      if(h.Index!=null) h.Index.Add(value,id);
      else when(h.Count>8)
      { h.Index=SCG.Dictionary(); mutable e=h.Head; while(e>=0) { def v=Arena.Entries[e]; when(v.Active) h.Index.Add(v.Value,e); e=v.Next; } }
      Arena.Headers[Id]=h; true
    }
    public Remove(value : T) : bool
    {
      mutable h=Arena.Headers[Id]; mutable e=h.Head;
      if(h.Index!=null) { unless(h.Index.ContainsKey(value)) return false; e=h.Index[value]; }
      else while(e>=0 && !SCG.EqualityComparer.[T].Default.Equals(Arena.Entries[e].Value,value)) e=Arena.Entries[e].Next;
      when(e<0) return false;
      mutable entry=Arena.Entries[e]; entry.Active=false; Arena.Entries[e]=entry;
      if(entry.Previous<0) h.Head=entry.Next;
      else { mutable before=Arena.Entries[entry.Previous]; before.Next=entry.Next; Arena.Entries[entry.Previous]=before; }
      if(entry.Next<0) h.Tail=entry.Previous;
      else { mutable after=Arena.Entries[entry.Next]; after.Previous=entry.Previous; Arena.Entries[entry.Next]=after; }
      --h.Count; when(h.Index!=null) _=h.Index.Remove(value); Arena.Headers[Id]=h; true
    }
    public Clear() : void
    { mutable h=Arena.Headers[Id]; h.Head= -1; h.Tail= -1; h.Count=0; h.Index=null; Arena.Headers[Id]=h; }
    public GetEnumerator() : NitraSetEnumerator[T]
    { mutable e=default(NitraSetEnumerator[T]); e.Arena=Arena; e.Next=Arena.Headers[Id].Head; e }
    private Typed() : SCG.IEnumerator[T] implements SCG.IEnumerable[T].GetEnumerator { GetEnumerator() }
    private Untyped() : System.Collections.IEnumerator implements System.Collections.IEnumerable.GetEnumerator
    { GetEnumerator() }
    public UnionWith(values : SCG.IEnumerable[T]) : void { foreach(value in values) _=Add(value); }
  }
  internal struct NitraNodeHeader
  {
    public mutable Operation : NitraOperation;
    public mutable Start : int;
    public mutable Started : bool;
    public mutable Closed : bool;
    public mutable Pending : int;
    public mutable Component : NitraDependencyComponent;
    public mutable Version : int;
    public mutable SubscriberHead : int;
    public mutable SubscriberTail : int;
    public mutable Ends : int;
    public mutable Candidates : int;
    public mutable Views : int;
    public mutable Dependencies : int;
    public mutable Outstanding : int;
    public mutable Parents : int;
    public mutable Cursors : int;
  }
  // A value handle; its mutable state lives in the segmented header table.
  internal struct NitraSample
  {
    public mutable Store : NitraNodeStore;
    public mutable Id : int;
    public IsNull : bool { get { Store==null } }
    public Operation : NitraOperation
    {
      get { if(Id<Store.Headers.Initial) Store.Headers.First[Id].Operation else Store.Headers.Segments[(Id-Store.Headers.Initial)/1024][(Id-Store.Headers.Initial)%1024].Operation }
      set { if(Id<Store.Headers.Initial) Store.Headers.First[Id].Operation=value; else Store.Headers.Segments[(Id-Store.Headers.Initial)/1024][(Id-Store.Headers.Initial)%1024].Operation=value; }
    }
    public Start : int
    {
      get { if(Id<Store.Headers.Initial) Store.Headers.First[Id].Start else Store.Headers.Segments[(Id-Store.Headers.Initial)/1024][(Id-Store.Headers.Initial)%1024].Start }
      set { if(Id<Store.Headers.Initial) Store.Headers.First[Id].Start=value; else Store.Headers.Segments[(Id-Store.Headers.Initial)/1024][(Id-Store.Headers.Initial)%1024].Start=value; }
    }
    public Started : bool
    {
      get { if(Id<Store.Headers.Initial) Store.Headers.First[Id].Started else Store.Headers.Segments[(Id-Store.Headers.Initial)/1024][(Id-Store.Headers.Initial)%1024].Started }
      set { if(Id<Store.Headers.Initial) Store.Headers.First[Id].Started=value; else Store.Headers.Segments[(Id-Store.Headers.Initial)/1024][(Id-Store.Headers.Initial)%1024].Started=value; }
    }
    public Closed : bool
    {
      get { if(Id<Store.Headers.Initial) Store.Headers.First[Id].Closed else Store.Headers.Segments[(Id-Store.Headers.Initial)/1024][(Id-Store.Headers.Initial)%1024].Closed }
      set { if(Id<Store.Headers.Initial) Store.Headers.First[Id].Closed=value; else Store.Headers.Segments[(Id-Store.Headers.Initial)/1024][(Id-Store.Headers.Initial)%1024].Closed=value; }
    }
    public Pending : int
    {
      get { if(Id<Store.Headers.Initial) Store.Headers.First[Id].Pending else Store.Headers.Segments[(Id-Store.Headers.Initial)/1024][(Id-Store.Headers.Initial)%1024].Pending }
      set { if(Id<Store.Headers.Initial) Store.Headers.First[Id].Pending=value; else Store.Headers.Segments[(Id-Store.Headers.Initial)/1024][(Id-Store.Headers.Initial)%1024].Pending=value; }
    }
    public Component : NitraDependencyComponent
    {
      get { if(Id<Store.Headers.Initial) Store.Headers.First[Id].Component else Store.Headers.Segments[(Id-Store.Headers.Initial)/1024][(Id-Store.Headers.Initial)%1024].Component }
      set { if(Id<Store.Headers.Initial) Store.Headers.First[Id].Component=value; else Store.Headers.Segments[(Id-Store.Headers.Initial)/1024][(Id-Store.Headers.Initial)%1024].Component=value; }
    }
    public Version : int
    {
      get { if(Id<Store.Headers.Initial) Store.Headers.First[Id].Version else Store.Headers.Segments[(Id-Store.Headers.Initial)/1024][(Id-Store.Headers.Initial)%1024].Version }
      set { if(Id<Store.Headers.Initial) Store.Headers.First[Id].Version=value; else Store.Headers.Segments[(Id-Store.Headers.Initial)/1024][(Id-Store.Headers.Initial)%1024].Version=value; }
    }
    public SubscriberHead : int
    {
      get { if(Id<Store.Headers.Initial) Store.Headers.First[Id].SubscriberHead else Store.Headers.Segments[(Id-Store.Headers.Initial)/1024][(Id-Store.Headers.Initial)%1024].SubscriberHead }
      set { if(Id<Store.Headers.Initial) Store.Headers.First[Id].SubscriberHead=value; else Store.Headers.Segments[(Id-Store.Headers.Initial)/1024][(Id-Store.Headers.Initial)%1024].SubscriberHead=value; }
    }
    public SubscriberTail : int
    {
      get { if(Id<Store.Headers.Initial) Store.Headers.First[Id].SubscriberTail else Store.Headers.Segments[(Id-Store.Headers.Initial)/1024][(Id-Store.Headers.Initial)%1024].SubscriberTail }
      set { if(Id<Store.Headers.Initial) Store.Headers.First[Id].SubscriberTail=value; else Store.Headers.Segments[(Id-Store.Headers.Initial)/1024][(Id-Store.Headers.Initial)%1024].SubscriberTail=value; }
    }
    public Ends : NitraNodeSet[int] { get { Store.Integers.At(Store.Headers[Id].Ends) } }
    public Candidates : NitraNodeSet[int] { get { Store.Integers.At(Store.Headers[Id].Candidates) } }
    public Views : NitraNodeSet[int] { get { Store.Integers.At(Store.Headers[Id].Views) } }
    public Dependencies : NitraNodeSet[int] { get { Store.Integers.At(Store.Headers[Id].Dependencies) } }
    public Outstanding : NitraNodeSet[int] { get { Store.Integers.At(Store.Headers[Id].Outstanding) } }
    public Parents : NitraNodeSet[int] { get { Store.Integers.At(Store.Headers[Id].Parents) } }
    public Cursors : NitraNodeSet[int*int*int] { get { Store.Cursors.At(Store.Headers[Id].Cursors) } }
  }
  internal sealed class NitraNodeStore : SCG.IEnumerable[NitraSample]
  {
    public Headers : NitraTable[NitraNodeHeader] = NitraTable();
    public Integers : NitraSetArena[int] = NitraSetArena();
    
    public Cursors : NitraSetArena[int*int*int] = NitraSetArena();
    public Count : int { get { Headers.Count } }
    public Item[id : int] : NitraSample
    { get { mutable s=default(NitraSample); s.Store=this; s.Id=id; s } }
    public Add(operation : NitraOperation, start : int) : NitraSample
    {
      mutable h=default(NitraNodeHeader); h.Operation=operation; h.Start=start; h.Version=1; h.SubscriberHead= -1; h.SubscriberTail= -1;
      h.Ends=Integers.New().Id;
      h.Candidates=Integers.New().Id;
      h.Views=Integers.New().Id;
      h.Dependencies=Integers.New().Id;
      h.Outstanding=Integers.New().Id;
      h.Parents=Integers.New().Id;
      h.Cursors=Cursors.New().Id;
      def id=Headers.Add(h); this[id]
    }
    public GetEnumerator() : NitraNodeEnumerator
    { mutable e=default(NitraNodeEnumerator); e.Store=this; e.Index= -1; e }
    private Typed() : SCG.IEnumerator[NitraSample] implements SCG.IEnumerable[NitraSample].GetEnumerator { GetEnumerator() }
    private Untyped() : System.Collections.IEnumerator implements System.Collections.IEnumerable.GetEnumerator
    { GetEnumerator() }
  }
  internal struct NitraNodeWork : IEquatable[NitraNodeWork]
  {
    // initialize, candidate, sequence, repeat, item, separator, family, close, and, subtract
    public mutable Kind : int;
    public mutable Owner : int;
    public mutable Position : int;
    public mutable End : int;
    public mutable Stage : int;
    public mutable Count : int;
    public mutable Context : int;
    public mutable Node : int;
    public mutable Edge : int;
    public mutable EvidenceEpoch : long;
    public Equals(other : NitraNodeWork) : bool { Kind==other.Kind && Owner==other.Owner && Position==other.Position && End==other.End && Stage==other.Stage && Count==other.Count && Context==other.Context && Node==other.Node && Edge==other.Edge && EvidenceEpoch==other.EvidenceEpoch }
    public override GetHashCode() : int { mutable h=17; h=(h<<5) ^ (h>>27) ^ Kind; h=(h<<5) ^ (h>>27) ^ Owner; h=(h<<5) ^ (h>>27) ^ Position; h=(h<<5) ^ (h>>27) ^ End; h=(h<<5) ^ (h>>27) ^ Stage; h=(h<<5) ^ (h>>27) ^ Count; h=(h<<5) ^ (h>>27) ^ Context; h=(h<<5) ^ (h>>27) ^ Node; h=(h<<5) ^ (h>>27) ^ Edge; h=(h<<5) ^ (h>>27) ^ EvidenceEpoch.GetHashCode(); h }
  }
  internal struct NitraConsumerLink
  {
    public mutable Child : int;
    public mutable Next : int;
    public mutable Delivered : int;
    public mutable Work : NitraNodeWork;
  }
  internal struct NitraTransitionInput
  {
    public mutable Work : NitraNodeWork;
    public mutable Operation : NitraOperation;
    public mutable Start : int;
    public mutable Version : int;
  }
  internal struct NitraTransitionEffect
  {
    public mutable Work : NitraNodeWork;
    public mutable Next : NitraNodeWork;
    public mutable Target : NitraOperation;
    public mutable Publish : bool;
    public mutable Continue : bool;
    public mutable Error : string;
  }
  internal sealed class NitraNodeWake
  {
    private Gate : object = object();
    public mutable Version : int;
    public Notify() : void { lock(Gate) { ++Version; Monitor.PulseAll(Gate); } }
    public Wait(version : int) : void { lock(Gate) while(Version==version) _=Monitor.Wait(Gate); }
    public Read() : int { lock(Gate) Version }
  }
  internal sealed class NitraTransitionBatch
  {
    public mutable Session : long;
    public mutable Epoch : long;
    public mutable Inputs : array[NitraTransitionInput];
    public mutable Effects : array[NitraTransitionEffect];
    public mutable Ready : array[int];
    public mutable Committed : array[bool];
    public mutable Pending : int;
    public mutable Remaining : int;
    public mutable Workers : int;
    public mutable Failure : Exception;
    public mutable Signal : TaskCompletionSource[bool];
    public mutable Wake : NitraNodeWake;
    public Run(first : int, last : int) : void
    {
      try
      {
        for(mutable i=first;i<last;++i) Effects[i]=NitraTransitions.Evaluate(Inputs[i]);
        for(mutable i=first;i<last;++i) Volatile.Write(ref Ready[i],1);
      }
      catch { | e => lock(this) when(Failure==null) Failure=e; }
      finally
      {
        Wake.Notify();
        when(Interlocked.Decrement(ref Remaining)==0)
        { if(Failure==null) Signal.SetResult(true); else Signal.SetException(Failure); Wake.Notify(); }
      }
    }
  }
  internal static class NitraTransitions
  {
    internal Digest(effect : NitraTransitionEffect) : int
    { effect.Work.End ^ effect.Next.Stage ^ (if(effect.Publish) 1 else 0) ^ (if(effect.Target==null) 0 else effect.Target.Id) }
    internal InlineDigest(inputs : array[NitraTransitionInput]) : int
    { mutable h=0; foreach(input in inputs) h=h ^ Digest(Evaluate(input)); h }
    internal EffectsDigest(effects : array[NitraTransitionEffect]) : int
    { mutable h=0; foreach(effect in effects) h=h ^ Digest(effect); h }
    internal Evaluate(input : NitraTransitionInput) : NitraTransitionEffect
    {
      mutable effect=default(NitraTransitionEffect); mutable work=input.Work; def o=input.Operation;
      mutable next=default(NitraNodeWork); next.Owner=work.Owner; next.Position=input.Start; next.End=input.Start;
      when(work.Kind==4)
      {
        when(work.End==work.Position && !o.AllEnds)
        { effect.Work=work; effect.Error="non-progressing repetition at "+work.Position.ToString(); return effect; }
        work.Count=if(o.Max<0 && work.Count>=Math.Max(1,o.Min)) Math.Max(1,o.Min) else work.Count+1;
        work.Kind=3;
      }
      when(work.Kind==8) { work.Kind=1; work.End=input.Start; }
      effect.Work=work;
      match(work.Kind)
      {
        | 2 =>
          effect.Publish=work.Stage==o.Children.Count; effect.Continue= !effect.Publish;
          when(effect.Continue) { effect.Target=o.Children[work.Stage]; next.Kind=2; next.Stage=work.Stage+1; }
        | 3 =>
          effect.Publish=work.Count>=o.Min; effect.Continue=o.Max<0 || work.Count<o.Max;
          when(effect.Continue)
          {
            next.Position=work.End; next.Count=work.Count;
            if(o.Kind=="separated" && work.Count>0) { next.Kind=5; effect.Target=o.Children[1]; }
            else { next.Kind=4; effect.Target=o.Children[0]; }
          }
        | 6 =>
          // The endpoint is established evidence. Resolve its prepared shared
          // continuation here; the coordinator only merges views and links.
          next=work;
          when(o.Family!=null) next.Node=o.Family.Nodes[work.Node].Edges[work.Edge].Target.Id;
          next.Position=work.End;
        | 5 =>
          effect.Publish=o.Text=="trailing" && work.Count>=o.Min; effect.Continue=true;
          next.Kind=4; next.Position=work.Position; next.Count=work.Count; effect.Target=o.Children[0];
        | _ => ();
      }
      effect.Next=next; effect
    }
  }

}
