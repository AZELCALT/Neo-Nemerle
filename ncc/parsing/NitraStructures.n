// Settled recognition evidence is consumed without recognizing source again.
using System;
using SCG = System.Collections.Generic;
using Nemerle.Imperative;
namespace Nemerle.Compiler
{
  internal sealed class NitraEvidence
  {
    public mutable Root : NitraOperation;
    public mutable Source : string;
    public mutable NativeSelection : bool;
    public Ends : SCG.Dictionary[int*int,SCG.HashSet[int]] = SCG.Dictionary();
    private empty : SCG.HashSet[int] = SCG.HashSet();
    public At(o : NitraOperation, start : int) : SCG.HashSet[int]
    { if(Ends.ContainsKey((o.Id,start))) Ends[(o.Id,start)] else empty }
  }
  internal sealed class NitraEndpointView
  {
    public Original : SCG.List[int] = SCG.List();
    public mutable Members : SCG.HashSet[int];
    private mutable ordered : SCG.List[int];
    private mutable ordinals : SCG.Dictionary[int,int];
    public Ordered : SCG.List[int]
    {
      get
      {
        when(Original.Count<=1) return Original;
        when(ordered==null) { ordered=SCG.List(Original); ordered.Sort(); }
        ordered
      }
    }
    public Rank(q : int) : int
    {
      when(ordinals==null)
      { ordinals=SCG.Dictionary(); for(mutable i=0;i<Original.Count;++i) ordinals[Original[i]]=i; }
      ordinals[q]
    }
  }
  internal sealed class NitraSuffixSearch
  {
    public mutable Cursor : int;
    public mutable Complete : bool;
    public mutable Ordered : SCG.List[int];
    public mutable Candidates : SCG.List[int];
    public Connections : SCG.List[int] = SCG.List();
  }
  internal sealed class NitraRepeatSearch
  {
    public mutable Complete : bool;
    public Steps : SCG.Dictionary[int*int,SCG.List[int*int]] = SCG.Dictionary();
    public Finishes : SCG.HashSet[int*int] = SCG.HashSet();
    public Viable : SCG.HashSet[int*int] = SCG.HashSet();
  }

  /// A selected structural object, not an executable foreign AST.
  public sealed class NitraStructure
  {
    public mutable Id : int;
    public mutable Operation : int;
    public mutable Kind : string;
    public mutable Label : string;
    public mutable RuleKind : string;
    public mutable Start : int;
    public mutable End : int;
    public mutable Source : string;
    public Children : SCG.List[NitraStructure] = SCG.List();
    public Text : string { get { Source.Substring(Start,End-Start) } }
    public Captures(name : string) : SCG.List[NitraStructure]
    {
      def found=SCG.List.[NitraStructure]();
      def pending=SCG.Stack.[NitraStructure]();
      for(mutable i=Children.Count-1;i>=0;--i) pending.Push(Children[i]);
      while(pending.Count>0)
      {
        def n=pending.Pop();
        if(n.Kind=="capture") { when(n.Label==name) found.Add(n); }
        else unless(n.Kind=="call" || n.Kind=="rule" || n.Kind=="longest" || n.Kind=="variant")
          for(mutable i=n.Children.Count-1;i>=0;--i) pending.Push(n.Children[i]);
      }
      found
    }
  }
  public sealed class NitraStructuralOption
  {
    public mutable Operation : int;
    public mutable Kind : string;
    public mutable Label : string;
    public mutable Start : int;
    public mutable End : int;
  }
  /// Resolver options describe constraints, not independently materialized ASTs.
  public sealed class NitraStructuralChoice
  {
    public mutable Parent : string;
    public mutable Start : int;
    public mutable End : int;
    public Options : SCG.List[NitraStructuralOption] = SCG.List();
  }
  public sealed class NitraStructureResult
  {
    public mutable Recognition : NitraRecognitionResult;
    public mutable Root : NitraStructure;
    public Nodes : SCG.List[NitraStructure] = SCG.List();
    public Diagnostics : SCG.List[string] = SCG.List();
    public Success : bool { get { Root!=null && Diagnostics.Count==0 } }
  }
  internal sealed class NitraStructureBuilder
  {
    evidence : NitraEvidence;
    resolver : Func[NitraStructuralChoice,int];
    result : NitraStructureResult = NitraStructureResult();
    memo : SCG.Dictionary[int*int*int,NitraStructure] = SCG.Dictionary();
    active : SCG.HashSet[int*int*int] = SCG.HashSet();
    feasible : SCG.Dictionary[int*int*int,bool] = SCG.Dictionary();
    checking : SCG.HashSet[int*int*int] = SCG.HashSet();
    private longest : SCG.Dictionary[int*int,int] = SCG.Dictionary();
    private endpoints : SCG.Dictionary[int*int,NitraEndpointView] = SCG.Dictionary();
    private sources : SCG.Dictionary[int,SCG.List[int*SCG.HashSet[int]]] = SCG.Dictionary();
    private reverse : SCG.Dictionary[int,SCG.Dictionary[int,SCG.HashSet[int]]] = SCG.Dictionary();
    private rawSuffixes : SCG.Dictionary[int*int*int,SCG.HashSet[int]] = SCG.Dictionary();
    private choices : SCG.Dictionary[int*int*int,NitraSuffixSearch] = SCG.Dictionary();
    private suffixes : SCG.Dictionary[int*int*int*int,NitraSuffixSearch] = SCG.Dictionary();
    private repetitions : SCG.Dictionary[int*int*int,NitraRepeatSearch] = SCG.Dictionary();
    private transitions : SCG.Dictionary[int*int*bool,SCG.List[int*int]] = SCG.Dictionary();
    private tasks : SCG.Stack[Action] = SCG.Stack();
    private mutable cyclic : bool;
    // Internal diagnostic fields: no public API or timing callbacks.
    internal mutable EndpointBuilds : int;
    internal mutable EndpointVisits : int;
    internal mutable SuffixReuses : int;
    internal mutable ConnectionReuses : int;
    internal mutable RepetitionReuses : int;
    internal mutable TransitionBuilds : int;
    public this(recognition : NitraRecognitionResult, resolver : Func[NitraStructuralChoice,int])
    { result.Recognition=recognition; evidence=recognition.Evidence; this.resolver=resolver; }
    private Key(o : NitraOperation, start : int, end : int) : int*int*int
    { (o.Id,start,end) }
    private Later(action : Action) : void { tasks.Push(action); }
    private Drain() : void
    {
      while(tasks.Count>0) tasks.Pop().Invoke();
    }
    private BeginSearch() : void
    {
      // A negative answer produced by an active-cycle cut is path-dependent.
      // Do not publish it (or connections depending on it) to later searches.
      when(cyclic)
      { feasible.Clear(); longest.Clear(); suffixes.Clear(); choices.Clear(); repetitions.Clear(); cyclic=false; }
    }
    private Endpoints(o : NitraOperation, p : int) : NitraEndpointView
    {
      def key=(o.Id,p);
      when(endpoints.ContainsKey(key)) return endpoints[key];
      def view=NitraEndpointView(); view.Members=evidence.At(o,p);
      view.Original.AddRange(view.Members);
      endpoints.Add(key,view); ++EndpointBuilds; view
    }
    private Reverse(o : NitraOperation) : SCG.Dictionary[int,SCG.HashSet[int]]
    {
      when(reverse.ContainsKey(o.Id)) return reverse[o.Id];
      when(sources.Count==0)
        foreach(pair in evidence.Ends)
        {
          def (id,p)=pair.Key;
          unless(sources.ContainsKey(id)) sources[id]=SCG.List();
          sources[id].Add((p,pair.Value));
        }
      def index=SCG.Dictionary.[int,SCG.HashSet[int]]();
      when(sources.ContainsKey(o.Id)) foreach((p,ends) in sources[o.Id]) foreach(q in ends)
      { unless(index.ContainsKey(q)) index[q]=SCG.HashSet(); _=index[q].Add(p); }
      reverse[o.Id]=index; index
    }
    // Backward joins find possible suffix starts directly from settled spans.
    // Each (sequence,slot,target) relation is built once, without semantic calls.
    private RawSuffix(o : NitraOperation, slot : int, end : int) : SCG.HashSet[int]
    {
      mutable i=slot;
      while(i<o.Children.Count && !rawSuffixes.ContainsKey((o.Id,i,end))) ++i;
      unless(rawSuffixes.ContainsKey((o.Id,i,end)))
      { def terminal=SCG.HashSet.[int](); _=terminal.Add(end); rawSuffixes[(o.Id,i,end)]=terminal; }
      while(i>slot)
      {
        --i; def positions=SCG.HashSet.[int](); def index=Reverse(o.Children[i]);
        foreach(q in rawSuffixes[(o.Id,i+1,end)]) when(index.ContainsKey(q))
          foreach(p in index[q]) _=positions.Add(p);
        rawSuffixes[(o.Id,i,end)]=positions;
      }
      rawSuffixes[(o.Id,slot,end)]
    }
    private Suffix(o : NitraOperation, slot : int, p : int, end : int) : NitraSuffixSearch
    {
      def key=(o.Id,slot,p,end);
      when(suffixes.ContainsKey(key)) { ++SuffixReuses; return suffixes[key]; }
      def state=NitraSuffixSearch(); state.Candidates=SCG.List();
      def view=Endpoints(o.Children[slot],p); def tail=RawSuffix(o,slot+1,end);
      // Enumerate the smaller side of the join, retaining historical feasibility
      // order. Construction sorts successful endpoints separately, once.
      if(tail.Count<view.Original.Count)
      {
        foreach(q in tail) { ++EndpointVisits; when(view.Members.Contains(q)) state.Candidates.Add(q); }
        when(state.Candidates.Count>1) state.Candidates.Sort(fun(a,b) { view.Rank(a).CompareTo(view.Rank(b)) });
      }
      else foreach(q in view.Original)
      { ++EndpointVisits; when(q<=end && tail.Contains(q)) state.Candidates.Add(q); }
      suffixes[key]=state; state
    }
    private AskSuffix(o : NitraOperation, slot : int, p : int, end : int, all : bool, receive : Action[bool]) : void
    {
      Later(fun()
      {
        when(slot==o.Children.Count) { receive.Invoke(p==end); return; }
        def state=Suffix(o,slot,p,end);
        when(state.Complete || !all && state.Connections.Count>0)
        { ++ConnectionReuses; receive.Invoke(state.Connections.Count>0); return; }
        def next() : void
        {
          if(state.Cursor==state.Candidates.Count)
          { state.Complete=true; receive.Invoke(state.Connections.Count>0); }
          else
          {
            def q=state.Candidates[state.Cursor]; ++state.Cursor;
            Ask(o.Children[slot],p,q,fun(ok)
            {
              if(!ok) Later(next);
              else AskSuffix(o,slot+1,q,end,false,fun(tail)
              {
                when(tail) state.Connections.Add(q);
                if(tail && !all) receive.Invoke(true); else Later(next);
              });
            });
          }
        }
        next();
      });
    }
    private RawSteps(o : NitraOperation, p : int, separated : bool) : SCG.List[int*int]
    {
      def key=(o.Id,p,separated);
      when(transitions.ContainsKey(key)) { ++RepetitionReuses; return transitions[key]; }
      def pairs=SCG.List.[int*int]();
      def starts=if(separated) Endpoints(o.Children[1],p).Ordered else SCG.List.[int]();
      unless(separated) starts.Add(p);
      foreach(q in starts) foreach(last in Endpoints(o.Children[0],q).Ordered)
        when(last>p) pairs.Add((q,last));
      transitions[key]=pairs; ++TransitionBuilds; pairs
    }
    private RepeatKey(o : NitraOperation, p : int, count : int) : int*int
    { (p,if(o.Max<0) Math.Min(count,Math.Max(1,o.Min)) else count) }
    private AskRepeat(o : NitraOperation, start : int, end : int, receive : Action[bool]) : void
    {
      def key=Key(o,start,end);
      when(repetitions.ContainsKey(key) && repetitions[key].Complete)
      { ++RepetitionReuses; receive.Invoke(repetitions[key].Viable.Contains((start,0))); return; }
      def plan=NitraRepeatSearch(); repetitions[key]=plan;
      def pending=SCG.Queue.[int*int](); pending.Enqueue((start,0));
      def parents=SCG.Dictionary.[int*int,SCG.List[int*int]]();
      def ready=SCG.Queue.[int*int]();
      def next() : void
      {
        when(pending.Count==0)
        {
          while(ready.Count>0)
          { def state=ready.Dequeue(); when(parents.ContainsKey(state)) foreach(parent in parents[state]) when(plan.Viable.Add(parent)) ready.Enqueue(parent); }
          plan.Complete=true; receive.Invoke(plan.Viable.Contains((start,0))); return;
        }
        def state=pending.Dequeue(); def (p,count)=state;
        when(plan.Steps.ContainsKey(state)) { Later(next); return; }
        when(plan.Steps.Count>=500000) throw ArgumentException("repetition interpretation limit exceeded");
        def good=SCG.List.[int*int](); plan.Steps[state]=good;
        def finish(ok : bool) : void
        { when(ok) { _=plan.Finishes.Add(state); when(plan.Viable.Add(state)) ready.Enqueue(state); } }
        def expand() : void
        {
          when(o.Max>=0 && count>=o.Max) { Later(next); return; }
          def separated=o.Kind=="separated" && count>0; def pairs=RawSteps(o,p,separated);
          def candidate(index : int) : void
          {
            when(index==pairs.Count) { Later(next); return; }
            def (q,last)=pairs[index];
            when(last>end) { Later(fun() { candidate(index+1); }); return; }
            def body(ok : bool) : void
            {
              if(!ok) Later(fun() { candidate(index+1); });
              else Ask(o.Children[0],q,last,fun(valid)
              {
                when(valid)
                {
                  good.Add((q,last)); def child=RepeatKey(o,last,count+1);
                  unless(parents.ContainsKey(child)) parents[child]=SCG.List();
                  parents[child].Add(state); pending.Enqueue(child);
                }
                Later(fun() { candidate(index+1); });
              });
            }
            if(separated) Ask(o.Children[1],p,q,body); else body(true);
          }
          candidate(0);
        }
        if(count>=o.Min && p==end) { finish(true); expand(); }
        else if(count>=o.Min && count>0 && o.Kind=="separated" && o.Text=="trailing")
          Ask(o.Children[1],p,end,fun(ok) { finish(ok); expand(); });
        else expand();
      }
      Later(next);
    }
    private AskChoices(o : NitraOperation, start : int, end : int, all : bool, receive : Action[bool]) : void
    {
      def key=Key(o,start,end);
      unless(choices.ContainsKey(key)) choices[key]=NitraSuffixSearch();
      def state=choices[key];
      when(state.Complete || !all && state.Connections.Count>0)
      { ++ConnectionReuses; receive.Invoke(state.Connections.Count>0); return; }
      def next() : void
      {
        if(state.Cursor==o.Children.Count)
        { state.Complete=true; receive.Invoke(state.Connections.Count>0); }
        else
        {
          def i=state.Cursor; ++state.Cursor;
          Ask(o.Children[i],start,end,fun(ok)
          {
            when(ok) state.Connections.Add(i);
            if(ok && !all) receive.Invoke(true); else Later(next);
          });
        }
      }
      Later(next);
    }
    private Ask(current : NitraOperation, first : int, last : int, receive : Action[bool]) : void
    {
      Later(fun()
      {
        unless(evidence.At(current,first).Contains(last)) { receive.Invoke(false); return; }
        unless(evidence.NativeSelection) { receive.Invoke(true); return; }
        def key=Key(current,first,last);
        when(feasible.ContainsKey(key)) { receive.Invoke(feasible[key]); return; }
        unless(checking.Add(key)) { cyclic=true; receive.Invoke(false); return; }
        def finish(value : bool) : void
        { feasible[key]=value; _=checking.Remove(key); Later(fun() { receive.Invoke(value); }); }
        if(current.GreedyCall)
        {
          def callKey=(current.Id,first);
          if(longest.ContainsKey(callKey)) finish(longest[callKey]==last);
          else
          {
            def ends=Endpoints(current,first).Ordered;
            def choose(index : int) : void
            {
              if(index<0) { longest[callKey]= -1; finish(false); }
              else Ask(current.Children[0],first,ends[index],fun(ok)
              {
                if(ok) { longest[callKey]=ends[index]; finish(ends[index]==last); }
                else Later(fun() { choose(index-1); });
              });
            }
            choose(ends.Count-1);
          }
        }
        else if(current.OpaqueValue || current.Fast && (current.Kind=="repeat" || current.Kind=="separated")) finish(true);
        else match(current.Kind)
        {
          | "literal" | "class" | "empty" | "not" | "and" => finish(true);
          | "subtract" => Ask(current.Children[0],first,last,finish);
          | "seq" => AskSuffix(current,0,first,last,false,finish);
          | "repeat" | "separated" => if(first==last) finish(current.Min==0); else AskRepeat(current,first,last,finish);
          | _ => if(current.Children.Count==1) Ask(current.Children[0],first,last,finish); else AskChoices(current,first,last,false,finish);
        }
      });
    }
    private Feasible(o : NitraOperation, start : int, end : int) : bool
    {
      BeginSearch();
      unless(evidence.At(o,start).Contains(end)) return false;
      unless(evidence.NativeSelection) return true;
      def key=Key(o,start,end); when(feasible.ContainsKey(key)) return feasible[key];
      mutable answer=false; Ask(o,start,end,fun(ok) { answer=ok; }); Drain(); answer
    }
    private Pick(o : NitraOperation, start : int, end : int, options : SCG.List[NitraStructuralOption]) : NitraStructuralOption
    {
      when(options.Count==0) throw ArgumentException("missing settled structural evidence for "+o.Kind+" "+o.Label+" at "+start.ToString());
      when(options.Count==1) return options[0];
      def choice=NitraStructuralChoice(); choice.Parent=o.Label; choice.Start=start; choice.End=end; choice.Options.AddRange(options);
      when(resolver==null) throw ArgumentException("unresolved structural ambiguity in "+o.Label+" at "+start.ToString());
      def selected=resolver.Invoke(choice);
      when(selected<0 || selected>=options.Count) throw ArgumentException("structural resolver did not select a valid option in "+o.Label);
      options[selected]
    }
    private Option(o : NitraOperation, start : int, end : int) : NitraStructuralOption
    { def n=NitraStructuralOption(); n.Operation=o.Id; n.Kind=o.Kind; n.Label=o.Label; n.Start=start; n.End=end; n }
    private work : SCG.Stack[Action] = SCG.Stack();
    private Schedule(o : NitraOperation, start : int, end : int, receive : Action[NitraStructure]) : void
    { work.Push(fun() { Build(o,start,end,receive); }); }
    private Build(o : NitraOperation, start : int, end : int, receive : Action[NitraStructure]) : void
    {
      def key=Key(o,start,end);
      when(active.Contains(key)) throw ArgumentException("cyclic structural interpretation in "+o.Label);
      when(memo.ContainsKey(key)) { receive.Invoke(memo[key]); return; }
      unless(evidence.At(o,start).Contains(end)) throw ArgumentException("unobserved structural span in "+o.Label);
      when(result.Nodes.Count>=500000) throw ArgumentException("structural object limit exceeded (500000)");
      def n=NitraStructure(); n.Id=result.Nodes.Count; n.Operation=o.Id; n.Kind=o.Kind; n.Label=o.Label;
      n.Start=start; n.End=end; n.Source=evidence.Source; result.Nodes.Add(n); memo.Add(key,n); _=active.Add(key);
      n.RuleKind=o.RuleKind;
      work.Push(fun() { _=active.Remove(key); receive.Invoke(n); });
      if(o.OpaqueValue || o.Fast && (o.Kind=="repeat" || o.Kind=="separated")) ()
      else match(o.Kind)
      {
        | "literal" | "class" | "empty" | "not" | "and" => ()
        | "subtract" => Schedule(o.Children[0],start,end,fun(child) { n.Children.Add(child); });
        | "seq" => Sequence(n,o,start,end);
        | "repeat" | "separated" => Repetition(n,o,start,end);
        | _ when(o.Children.Count==1) =>
          def child=o.Children[0];
          if(Feasible(child,start,end)) Schedule(child,start,end,fun(nested) { n.Children.Add(nested); });
          else _=Pick(o,start,end,SCG.List());
        | _ =>
          BeginSearch(); AskChoices(o,start,end,true,_ => ()); Drain();
          def options=SCG.List.[NitraStructuralOption]();
          foreach(i in choices[Key(o,start,end)].Connections) options.Add(Option(o.Children[i],start,end));
          def selected=Pick(o,start,end,options);
          foreach(c in o.Children) when(c.Id==selected.Operation) Schedule(c,start,end,fun(child) { n.Children.Add(child); });
      }
    }
    private Sequence(n : NitraStructure, o : NitraOperation, start : int, end : int) : void
    {
      def advance(i : int, p : int) : void
      {
        when(i==o.Children.Count) return;
        BeginSearch(); def state=Suffix(o,i,p,end);
        AskSuffix(o,i,p,end,true,_ => ()); Drain();
        when(state.Ordered==null) { state.Ordered=SCG.List(state.Connections); state.Ordered.Sort(); }
        def ends=state.Ordered;
        def options=SCG.List.[NitraStructuralOption](); def c=o.Children[i];
        foreach(q in ends) options.Add(Option(c,p,q));
        def selected=Pick(o,p,end,options);
        work.Push(fun() { advance(i+1,selected.End); });
        Schedule(c,p,selected.End,fun(child) { n.Children.Add(child); });
      }
      advance(0,start);
    }
    private Repetition(n : NitraStructure, o : NitraOperation, start : int, end : int) : void
    {
      // No advancing transition can fit an empty target. No search graph is
      // needed for a nullable repetition; a required item remains an error.
      when(start==end)
      { when(o.Min>0) _=Pick(o,start,end,SCG.List()); return; }
      BeginSearch(); AskRepeat(o,start,end,_ => ()); Drain();
      def plan=repetitions[Key(o,start,end)];
      def advance(p : int, count : int) : void
      {
        def state=RepeatKey(o,p,count); def options=SCG.List.[NitraStructuralOption]();
        when(plan.Finishes.Contains(state)) options.Add(Option(o,p,end));
        foreach((q,last) in plan.Steps[state]) when(plan.Viable.Contains(RepeatKey(o,last,count+1))) options.Add(Option(o.Children[0],q,last));
        def selected=Pick(o,p,end,options);
        when(selected.Operation==o.Id)
        { when(p!=end) Schedule(o.Children[1],p,end,fun(child) { n.Children.Add(child); }); return; }
        work.Push(fun() { advance(selected.End,count+1); });
        Schedule(o.Children[0],selected.Start,selected.End,fun(child) { n.Children.Add(child); });
        when(o.Kind=="separated" && count>0) Schedule(o.Children[1],p,selected.Start,fun(child) { n.Children.Add(child); });
      }
      advance(start,0);
    }

    public Run() : NitraStructureResult
    {
      if(evidence==null)
      {
        result.Diagnostics.AddRange(result.Recognition.Diagnostics);
        when(result.Diagnostics.Count==0) result.Diagnostics.Add("source does not match "+result.Recognition.Rule+" at offset "+result.Recognition.Furthest.ToString());
      }
      else try
      {
        Schedule(evidence.Root,0,evidence.Source.Length,fun(root) { result.Root=root; });
        while(work.Count>0) work.Pop().Invoke();
      }
      catch { | e is ArgumentException => result.Diagnostics.Add(e.Message); result.Root=null; }
      result
    }
  }
}
