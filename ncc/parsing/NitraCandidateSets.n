// Prepared shared structural families and timestamped relational filtering.
using System;
using System.Threading;
using System.Threading.Tasks;
using SCG = System.Collections.Generic;
using Nemerle;
using Nemerle.Imperative;
namespace Nemerle.Compiler
{
  internal sealed class NitraFamilyMark
  {
    public mutable Operation : NitraOperation;
    public mutable Begin : int;
  }
  internal sealed class NitraFamilyEdge
  {
    public mutable Operation : NitraOperation;
    public mutable Target : NitraFamilyNode;
    public Views : SCG.List[NitraOperation] = SCG.List();
    public Candidates : SCG.List[int] = SCG.List();
    public mutable Mask : NitraPoolMask;
  }
  internal sealed class NitraLiteralFilter
  {
    public mutable Id : int;
    public Edges : SCG.Dictionary[char,NitraLiteralFilter] = SCG.Dictionary();
    public Matches : SCG.List[int] = SCG.List();
  }
  internal sealed class NitraFamilyNode
  {
    public mutable Id : int;
    public mutable Parent : int = -1;
    public mutable Terminal : bool;
    public Edges : SCG.List[NitraFamilyEdge] = SCG.List();
    public Marks : SCG.List[NitraFamilyMark] = SCG.List();
    public LiteralFilter : NitraLiteralFilter = NitraLiteralFilter();
    public mutable LiteralWidth : int;
    public GeneralFilters : SCG.List[int] = SCG.List();
    public Guards : SCG.Dictionary[int,NitraOperation] = SCG.Dictionary();
    // Each member names its next structural requirement, not a candidate AST.
    public Members : SCG.List[int] = SCG.List();
    public Candidates : SCG.List[int] = SCG.List();
    public Terminals : SCG.List[int] = SCG.List();
    public mutable LiteralMask : NitraPoolMask;
    public mutable TerminalMask : NitraPoolMask;
  }
  internal sealed class NitraCandidateFamily
  {
    public Nodes : SCG.List[NitraFamilyNode] = SCG.List();
    public Dense : SCG.Dictionary[int,int] = SCG.Dictionary();
    public MaskStore : NitraPoolMasks = NitraPoolMasks();
    public mutable RootMask : NitraPoolMask;
    public mutable EmptyMask : NitraPoolMask;
    public Mask(ids : SCG.IEnumerable[int]) : NitraPoolMask
    {
      def words : array[long]=array((Dense.Count+63)/64);
      foreach(id in ids) { def index=Dense[id]; words[index/64]=words[index/64] | (1L << (index%64)); }
      MaskStore.Intern(words)
    }
    public this(root : NitraOperation)
    {
      _=Node(-1);
      if(root.Kind=="seq")
      { def last=Append(root,Nodes[0],true,SCG.HashSet()); last.Terminal=true; last.Terminals.Add(root.Id); }
      else foreach(child in root.Children)
      { def last=Append(child,Nodes[0],true,SCG.HashSet()); last.Terminal=true; last.Terminals.Add(child.Id); }
      foreach(n in Nodes)
      {
        mutable nextId=1;
        for(mutable i=0;i<n.Edges.Count;++i)
        {
          def op=n.Edges[i].Operation.Interface ?? n.Edges[i].Operation;
          def guard=op.FirstGuard ?? op;
          if(guard.Kind=="literal")
          {
            n.Guards[i]=guard; n.LiteralWidth=Math.Max(n.LiteralWidth,guard.Text.Length); mutable prefix=n.LiteralFilter;
            foreach(ch in guard.Text)
            {
              unless(prefix.Edges.ContainsKey(ch))
              { def child=NitraLiteralFilter(); child.Id=nextId; ++nextId; prefix.Edges[ch]=child; }
              prefix=prefix.Edges[ch];
            }
            prefix.Matches.Add(i);
          }
          else n.GeneralFilters.Add(i);
        }
      }
      // One membership slot per reachable terminal production. Equal structural
      // routes share work while separate marks retain production identities.
      for(mutable i=Nodes.Count-1;i>=0;--i)
      {
        def n=Nodes[i];
        for(mutable edge=0;edge<n.Edges.Count;++edge)
        {
          def target=n.Edges[edge].Target;
          foreach(candidate in target.Terminals) { n.Members.Add(edge); n.Candidates.Add(candidate); n.Edges[edge].Candidates.Add(candidate); }
          foreach(candidate in target.Candidates) { n.Members.Add(edge); n.Candidates.Add(candidate); n.Edges[edge].Candidates.Add(candidate); }
        }
      }
      foreach(n in Nodes) foreach(id in n.Terminals) unless(Dense.ContainsKey(id)) Dense[id]=Dense.Count;
      EmptyMask=Mask(SCG.List.[int]()); def all=SCG.List.[int](Dense.Keys); RootMask=Mask(all);
      foreach(n in Nodes)
      {
        n.TerminalMask=Mask(n.Terminals); def literals=SCG.List.[int]();
        for(mutable i=0;i<n.Edges.Count;++i)
        { n.Edges[i].Mask=Mask(n.Edges[i].Candidates); when(n.Guards.ContainsKey(i)) literals.AddRange(n.Edges[i].Candidates); }
        n.LiteralMask=Mask(literals);
      }
    }
    private Node(parent : int) : NitraFamilyNode
    { def n=NitraFamilyNode(); n.Id=Nodes.Count; n.Parent=parent; Nodes.Add(n); n }
    private Mark(original : NitraOperation, first : int, last : NitraFamilyNode) : void
    {
      mutable o=original; def seen=SCG.HashSet.[int]();
      while(seen.Add(o.Id))
      {
        mutable exists=false;
        foreach(m in last.Marks) when(m.Operation==o && m.Begin==first) exists=true;
        unless(exists) { def m=NitraFamilyMark(); m.Operation=o; m.Begin=first; last.Marks.Add(m); }
        if(o.Interface!=null && o!=o.Interface && o.Children.Count==1) o=o.Children[0];
        else if(o.Interface!=null && o!=o.Interface) o=o.Interface;
        else break;
      }
    }
    private Append(original : NitraOperation, first : NitraFamilyNode, outer : bool, active : SCG.HashSet[int]) : NitraFamilyNode
    {
      def o=original.Interface ?? original; mutable last=first;
      // Calls and genuinely shared prepared prefixes are region boundaries.
      // Do not unfold a shared prefix into each consumer's continuation history.
      // Unique local sequence requirements can still be flattened.
      if(o.Kind=="seq" && (outer || original.Kind!="call" && !(o.SharedPrefix && o.Parents.Count>1)) && active.Add(o.Id))
      {
        foreach(child in o.Children) last=Append(child,last,false,active);
        _=active.Remove(o.Id);
      }
      else
      {
        mutable found : NitraFamilyEdge=null;
        foreach(edge in first.Edges) when((edge.Operation.Interface ?? edge.Operation)==o) found=edge;
        when(found==null)
        { found=NitraFamilyEdge(); found.Operation=original; found.Target=Node(first.Id); first.Edges.Add(found); }
        unless(found.Views.Contains(original)) found.Views.Add(original);
        last=found.Target;
      }
      Mark(original,first.Id,last); last
    }
  }
  internal sealed class NitraFamilyContext
  {
    public mutable Id : int;
    public mutable Owner : NitraSample;
    public mutable Family : NitraCandidateFamily;
    public mutable Masks : NitraPoolMasks;
    public Incoming : SCG.Dictionary[int*int,SCG.HashSet[int]] = SCG.Dictionary();
    public Outgoing : SCG.Dictionary[int*int,SCG.List[int*int]] = SCG.Dictionary();
    public mutable Versions : SCG.Dictionary[int*int,long];
    public Visited : SCG.HashSet[int*int] = SCG.HashSet();
    public mutable Sets : SCG.Dictionary[int*int,NitraCandidateSet];
    public PoolSets : SCG.Dictionary[int*int,NitraPoolMask] = SCG.Dictionary();
    public PoolEdges : SCG.Dictionary[int*int*int,NitraPoolMask] = SCG.Dictionary();
    public PoolLanes : SCG.Dictionary[int*int,NitraPoolLane] = SCG.Dictionary();
    public mutable EdgeSets : SCG.Dictionary[int*int*int,NitraCandidateSet];
  }
  internal sealed class NitraCandidateSet
  {
    public mutable Id : int;
    public mutable Version : long;
    public Members : SCG.HashSet[int] = SCG.HashSet();
  }
  internal sealed class NitraGuardTask
  {
    public mutable Edges : array[int];
    public mutable Literal : bool;
    public mutable Evaluator : NitraGuardEvaluator;
    public mutable Cached : array[SCG.HashSet[int]];
    public mutable Passed : array[bool];
    public mutable Reused : array[bool];
    public mutable Checks : int;
    public mutable Characters : int;
    public mutable PoolThread : bool;
    public mutable CacheHits : int;
    public mutable Weight : int;
    public mutable LexicalResults : SCG.Dictionary[long,SCG.HashSet[int]];
    public mutable FirstTables : SCG.Dictionary[char,array[bool]];
    public mutable Observations : int;
    public mutable Evaluations : int;
    public mutable DispatchBuilds : int;
    public Evaluate(batch : NitraReductionBatch, evaluator : NitraGuardEvaluator) : void
    {
      Passed=array(Edges.Length);
      Evaluator=evaluator; Checks=0; Characters=0; CacheHits=0;
      LexicalResults=null; FirstTables=null; Observations=0; Evaluations=0; DispatchBuilds=0;
      if(Literal)
      {
        def matched=SCG.HashSet.[int]();
        mutable prefix=batch.Node.LiteralFilter; mutable p=batch.Position;
        foreach(i in prefix.Matches) _=matched.Add(i);
        mutable more=Reused==null;
        while(more && p<batch.Source.Length)
        {
          ++Characters;
          if(prefix.Edges.ContainsKey(batch.Source[p]))
          { prefix=prefix.Edges[batch.Source[p]]; ++p; foreach(i in prefix.Matches) _=matched.Add(i); }
          else more=false;
        }
        for(mutable i=0;i<Edges.Length;++i)
        {
          def edge=Edges[i]; Passed[i]=if(Reused==null) matched.Contains(edge) else Reused[i]; if(Reused==null) ++Checks; else ++CacheHits;
          when(Passed[i] && Cached[i]==null)
          {
            def guard=batch.Node.Guards[edge]; def key=(guard.Id :> long)*4294967296L+(batch.Position :> long);
            def ends=SCG.HashSet.[int](); _=ends.Add(batch.Position+guard.Text.Length);
            when(LexicalResults==null) LexicalResults=SCG.Dictionary(); LexicalResults[key]=ends;
          }
        }
      }
      else
      {
        mutable known=batch.FirstBits!=null || batch.Position>=batch.Source.Length;
        for(mutable i=0;i<Edges.Length;++i)
        { def op=batch.Node.Edges[Edges[i]].Operation.Interface ?? batch.Node.Edges[Edges[i]].Operation; when(op.FirstGuard!=null && Cached[i]==null) known=false; }
        if(known)
        {
          for(mutable i=0;i<Edges.Length;++i)
          {
            def op=batch.Node.Edges[Edges[i]].Operation.Interface ?? batch.Node.Edges[Edges[i]].Operation;
            Passed[i]=(op.Nullable || batch.Position<batch.Source.Length && batch.FirstBits[op.Id]) && (op.FirstGuard==null || Cached[i].Count>0);
            ++Checks; when(Cached[i]!=null) ++CacheHits;
          }
        }
        else
        {
          when(Evaluator==null) Evaluator=NitraGuardEvaluator(batch.Grammar,batch.Source);
          Evaluator.Begin();
          for(mutable i=0;i<Edges.Length;++i)
          {
            def op=batch.Node.Edges[Edges[i]].Operation.Interface ?? batch.Node.Edges[Edges[i]].Operation;
            when(Cached[i]!=null && op.FirstGuard!=null)
            { Evaluator.Seed(op.FirstGuard,batch.Position,Cached[i]); ++CacheHits; }
            Passed[i]=Evaluator.Test(op,batch.Position); ++Checks;
          }
          LexicalResults=Evaluator.LexicalResults; FirstTables=Evaluator.FirstTables;
          Observations=Evaluator.Observations; Evaluations=Evaluator.Evaluations; DispatchBuilds=Evaluator.DispatchBuilds;
        }
      }
    }
  }
  internal sealed class NitraReductionEntry
  {
    public mutable Key : int*int*string;
    public mutable Keep : array[bool];
    public mutable Previous : NitraReductionEntry;
    public mutable Next : NitraReductionEntry;
  }
  internal sealed class NitraReductionBatch
  {
    public mutable Session : long;
    public mutable Timestamp : long;
    public mutable Version : long;
    public mutable Context : NitraFamilyContext;
    public mutable Node : NitraFamilyNode;
    public mutable Position : int;
    public mutable Key : int*int*string;
    public mutable Keep : array[bool];
    public mutable Grammar : NitraPreparedGrammar;
    public mutable Source : string;
    public mutable FirstBits : array[bool];
    public mutable Set : NitraCandidateSet;
    public mutable Tasks : array[NitraGuardTask];
    public mutable Published : array[int];
    public mutable Applied : array[bool];
    public mutable PendingTasks : int;
    public mutable EdgeCounts : array[int];
    public RemainingCandidates : SCG.HashSet[int] = SCG.HashSet();
    public mutable Completion : Task;
    public mutable Signal : TaskCompletionSource[bool];
    public mutable Wake : NitraNodeWake;
    public mutable Remaining : int;
    public mutable Failure : Exception;
    public mutable Workers : int;
    public mutable Committed : bool;
    public Ready : bool { get { Completion==null || Completion.IsCompleted } }
    public Wait() : void { when(Completion!=null) Completion.GetAwaiter().GetResult(); }
  }
  internal struct NitraFilterJob
  {
    public mutable Batch : NitraReductionBatch;
    public mutable Transition : NitraTransitionBatch;
    public mutable Lanes : array[NitraPoolLane];
    public mutable LaneWake : NitraNodeWake;
    public mutable First : int;
    public mutable Last : int;
    public Run() : void
    {
      when(Lanes!=null)
      { for(mutable i=First;i<Last;++i) { Lanes[i].Evaluate(); when(LaneWake!=null) LaneWake.Notify(); } return; }
      when(Transition!=null) { Transition.Run(First,Last); return; }
      try
      {
        mutable evaluator : NitraGuardEvaluator=null;
        for(mutable j=First;j<Last;++j)
        {
          Batch.Tasks[j].PoolThread=Batch.Workers>1; Batch.Tasks[j].Evaluate(Batch,evaluator); evaluator=Batch.Tasks[j].Evaluator ?? evaluator;
          Volatile.Write(ref Batch.Published[j],1);
          when(Batch.Wake!=null) Batch.Wake.Notify();
        }
      }
      catch { | e => lock(Batch) when(Batch.Failure==null) Batch.Failure=e; }
      finally
      {
        when(Interlocked.Decrement(ref Batch.Remaining)==0 && Batch.Signal!=null)
          if(Batch.Failure==null) Batch.Signal.SetResult(true);
          else Batch.Signal.SetException(Batch.Failure);
        when(Batch.Wake!=null) Batch.Wake.Notify();
      }
    }
  }
  internal static class NitraFilterWorkers
  {
    internal static Limit : int = Math.Max(1,Environment.ProcessorCount-1);
    private static Slots : SemaphoreSlim = SemaphoreSlim(Limit,Limit);
    private static Work : SCG.Queue[NitraFilterJob] = SCG.Queue();
    private static Pump(_state : object) : void
    {
      try
      {
        mutable more=true;
        while(more)
        {
          mutable job=default(NitraFilterJob);
          lock(Work) { if(Work.Count==0) more=false; else job=Work.Dequeue(); }
          when(more) job.Run();
        }
      }
      finally
      {
        _=Slots.Release(); mutable remains=false; lock(Work) remains=Work.Count>0;
        when(remains) Kick(1);
      }
    }
    private static Kick(requested : int) : void
    {
      for(mutable i=0;i<requested;++i)
      {
        unless(Slots.Wait(0)) return;
        try
        {
          unless(ThreadPool.QueueUserWorkItem(WaitCallback(Pump)))
            throw InvalidOperationException("cannot schedule recognition filter worker");
        }
        catch { | e => _=Slots.Release(); throw e; }
      }
    }
    internal Partition(count : int, workers : int, index : int) : int*int
    {
      when(count<0 || workers<1 || index<0 || index>=workers) throw ArgumentException("invalid filter partition");
      (((index :> long)*count/workers) :> int,(((index+1 :> long)*count/workers) :> int))
    }
    internal WorkerCount(count : int, maximum : int, minimum : int) : int
    {
      if(count<=0) 0
      else if(count<Math.Max(1,minimum)) 1
      else Math.Min(count,Math.Min(Limit,Math.Max(1,maximum)))
    }
    internal StartNodes(batch : NitraTransitionBatch, maximum : int, minimum : int) : void
    {
      def count=batch.Inputs.Length; def workers=WorkerCount(count,maximum,minimum);
      batch.Workers=workers; batch.Pending=count; batch.Effects=array(count); batch.Ready=array(count); batch.Committed=array(count);
      if(workers<=1)
      { for(mutable i=0;i<count;++i) { batch.Effects[i]=NitraTransitions.Evaluate(batch.Inputs[i]); batch.Ready[i]=1; } }
      else
      {
        batch.Remaining=workers; batch.Signal=TaskCompletionSource.[bool](TaskCreationOptions.RunContinuationsAsynchronously);
        lock(Work)
        {
          for(mutable i=0;i<workers;++i)
          {
            def (first,last)=Partition(count,workers,i);
            mutable job=default(NitraFilterJob); job.Transition=batch; job.First=first; job.Last=last; Work.Enqueue(job);
          }
        }
        Kick(workers);
      }
    }
    internal StartLanes(lanes : array[NitraPoolLane], wake : NitraNodeWake, maximum : int, minimum : int) : int
    {
      mutable work=0; foreach(lane in lanes) work+=Math.Max(1,lane.Last-lane.From);
      def desired=Math.Max(1,(work+Math.Max(1,minimum)-1)/Math.Max(1,minimum));
      def workers=Math.Min(lanes.Length,Math.Min(Limit,Math.Min(Math.Max(1,maximum),desired)));
      if(workers<=1)
      { foreach(lane in lanes) lane.Evaluate(); }
      else
      {
        lock(Work)
        {
          mutable first=0; mutable remaining=work;
          for(mutable i=0;i<workers;++i)
          {
            def target=Math.Max(1,remaining/(workers-i)); mutable last=first; mutable assigned=0;
            while(last<lanes.Length-(workers-i-1) && (assigned<target || last==first))
            { assigned+=Math.Max(1,lanes[last].Last-lanes[last].From); ++last; }
            mutable job=default(NitraFilterJob); job.Lanes=lanes; job.LaneWake=wake; job.First=first; job.Last=last; Work.Enqueue(job);
            first=last; remaining-=assigned;
          }
        }
        Kick(workers);
      }
      workers
    }
    internal Start(batch : NitraReductionBatch, maximum : int, minimum : int) : void
    {
      def count=batch.Tasks.Length;
      def workers=Math.Min(count,WorkerCount(batch.Set.Members.Count,maximum,minimum));
      batch.Workers=workers; batch.Keep=array(batch.Node.Members.Count);
      batch.Published=array(count); batch.Applied=array(count); batch.PendingTasks=count;
      batch.RemainingCandidates.UnionWith(batch.Set.Members);
      batch.Remaining=Math.Max(1,workers);
      if(workers<=1)
      {
        mutable job=default(NitraFilterJob); job.Batch=batch; job.First=0; job.Last=count; job.Run();
        when(batch.Failure!=null) throw batch.Failure;
      }
      else
      {
        batch.Signal=TaskCompletionSource.[bool](TaskCreationOptions.RunContinuationsAsynchronously); batch.Completion=batch.Signal.Task;
        lock(Work)
        {
          mutable first=0; mutable weight=0; foreach(task in batch.Tasks) weight+=task.Weight;
          for(mutable i=0;i<workers;++i)
          {
            def target=Math.Max(1,weight/(workers-i)); mutable last=first; mutable assigned=0;
            while(last<count-(workers-i-1) && (assigned<target || last==first)) { assigned+=batch.Tasks[last].Weight; ++last; }
            mutable job=default(NitraFilterJob); job.Batch=batch; job.First=first; job.Last=last; Work.Enqueue(job);
            first=last; weight-=assigned;
          }
        }
        Kick(workers);
      }
    }
  }
}
