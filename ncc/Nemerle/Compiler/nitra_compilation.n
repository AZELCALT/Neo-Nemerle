// Compiler-local semantic services and direct output construction.

using System;
using SCG = System.Collections.Generic;
using Nemerle.Imperative;
using Nemerle.Compiler.Parsetree;
using Nemerle.Compiler.AST;
using Nemerle.Compiler.manager_class;
using Nemerle.Compiler.NitraRecognition;
using Nemerle.Compiler.NitraStructures;
using Nemerle.Compiler.nitra_syntax;
using Nemerle.Compiler.NitraTypes;
using Nemerle.Compiler.typer;

public sealed class NitraSemanticSymbol
{
  public mutable Name : string;
  public mutable Kind : string;
  public mutable Value : object;
  public mutable Output : PExpr;
  public Declarations : SCG.List[NitraStructure] = SCG.List();
}
/// Scope policy is programmable; table lookup is only one implementation.
public abstract class NitraSemanticScope
{
  public abstract Lookup(name : string) : SCG.List[NitraSemanticSymbol];
}
public sealed class NitraTableScope : NitraSemanticScope
{
  public mutable Parent : NitraSemanticScope;
  symbols : SCG.Dictionary[string,SCG.List[NitraSemanticSymbol]] = SCG.Dictionary();
  public Define(symbol : NitraSemanticSymbol) : void
  {
    when(symbol==null || symbol.Name==null) throw ArgumentException("a symbol must have a name");
    unless(symbols.ContainsKey(symbol.Name)) symbols.Add(symbol.Name,SCG.List());
    unless(symbols[symbol.Name].Contains(symbol)) symbols[symbol.Name].Add(symbol);
  }
  public override Lookup(name : string) : SCG.List[NitraSemanticSymbol]
  {
    if(symbols.ContainsKey(name)) SCG.List(symbols[name])
    else if(Parent!=null) Parent.Lookup(name)
    else SCG.List()
  }
}
/// Dependencies are explicit; callbacks run once, only when prerequisites exist.
public sealed class NitraSemanticProperty
{
  public mutable Name : string;
  public mutable Stage : int;
  public Dependencies : SCG.List[string] = SCG.List();
  public mutable Evaluate : Func[NitraCompilationContext,object];
}
public sealed class NitraCompilationContext
{
  public Typer : Typer;
  public Scope : NitraSemanticScope;
  public mutable Location : Location;
  public Mappings : SCG.Dictionary[string,Func[NitraCompilationContext,NitraStructure,PExpr]] = SCG.Dictionary();
  public Properties : SCG.List[NitraSemanticProperty] = SCG.List();
  public mutable Types : NitraTypeSolver;
  values : SCG.Dictionary[string,object] = SCG.Dictionary();
  output : SCG.Dictionary[int,PExpr] = SCG.Dictionary();
  emitting : SCG.HashSet[int] = SCG.HashSet();
  internal mutable Running : bool;
  internal mutable Root : NitraStructure;
  private mutable ready : bool;
  internal Owned : SCG.HashSet[NitraStructure] = SCG.HashSet();
  public this(typer : Typer, scope : NitraSemanticScope, location : Location)
  {
    when(typer==null) throw ArgumentNullException("typer");
    Typer=typer; Scope=scope ?? NitraTableScope(); Location=location;
  }
  public ProbeRoot : NitraStructure { get { Root } }
  public Get(name : string) : object
  {
    unless(values.ContainsKey(name)) throw ArgumentException("semantic property is not available: "+name);
    values[name]
  }
  public Resolve(name : string, scope : NitraSemanticScope,
                 select : Func[SCG.List[NitraSemanticSymbol],NitraSemanticSymbol]) : NitraSemanticSymbol
  {
    def candidates=(scope ?? Scope).Lookup(name);
    when(select!=null)
    {
      def chosen=select.Invoke(candidates);
      unless(chosen!=null && candidates.Contains(chosen)) throw ArgumentException("resolution did not select a visible symbol: "+name);
      return chosen;
    }
    unless(candidates.Count==1) throw ArgumentException((if(candidates.Count==0) "unknown symbol: " else "ambiguous symbol: ")+name);
    candidates[0]
  }
  internal Evaluate() : void
  {
    def pending=SCG.Dictionary.[string,NitraSemanticProperty]();
    foreach(p in Properties)
    {
      when(p.Name==null || p.Evaluate==null || p.Stage<0) throw ArgumentException("invalid semantic property");
      when(pending.ContainsKey(p.Name)) throw ArgumentException("duplicate semantic property: "+p.Name);
      pending.Add(p.Name,p);
    }
    foreach(p in Properties) foreach(d in p.Dependencies)
    {
      unless(pending.ContainsKey(d)) throw ArgumentException("unknown semantic dependency: "+d);
      when(pending[d].Stage>p.Stage) throw ArgumentException("semantic dependency belongs to a later stage: "+d);
    }
    while(pending.Count>0)
    {
      mutable stage=int.MaxValue; foreach(p in pending.Values) stage=Math.Min(stage,p.Stage);
      def runnable=SCG.List.[NitraSemanticProperty]();
      foreach(p in pending.Values) when(p.Stage==stage)
      {
        mutable satisfied=true; foreach(d in p.Dependencies) unless(values.ContainsKey(d)) satisfied=false;
        when(satisfied) runnable.Add(p);
      }
      when(runnable.Count==0) throw ArgumentException("cyclic semantic dependencies at stage "+stage.ToString());
      foreach(p in runnable) { values.Add(p.Name,p.Evaluate.Invoke(this)); _=pending.Remove(p.Name); }
    }
    ready=true;
  }
  public At(node : NitraStructure) : Location
  {
    mutable line=Location.Line; mutable column=Location.Column;
    for(mutable i=0;i<node.Start;++i) if(node.Source[i]=='\n') { ++line; column=1; } else ++column;
    Nemerle.Compiler.AST.Location(Location.FileIndex,line,column)
  }
  public Emit(node : NitraStructure) : PExpr
  {
    unless(Running && ready) throw InvalidOperationException("output construction requires settled structure and completed semantic evaluation");
    when(node==null) throw ArgumentNullException("node");
    unless(Owned.Contains(node)) throw ArgumentException("structural object belongs to another compilation");
    when(output.ContainsKey(node.Id)) return output[node.Id];
    unless(emitting.Add(node.Id)) throw ArgumentException("cyclic output construction in "+node.Label);
    try
    {
      def value=
        if(node.Kind=="variant" && node.Label!=null && Mappings.ContainsKey(node.Label)) Mappings[node.Label].Invoke(this,node)
        else Forward(node);
      when(value==null) throw ArgumentException("output mapping returned null for "+node.Label);
      output.Add(node.Id,value); value
    }
    finally { _=emitting.Remove(node.Id); }
  }
  private Forward(node : NitraStructure) : PExpr
  {
    if(node.Kind=="seq")
    {
      def significant=SCG.List.[NitraStructure]();
      foreach(c in node.Children) unless(c.RuleKind=="void" || c.RuleKind=="marker") significant.Add(c);
      when(significant.Count==1) return Emit(significant[0]);
    }
    else when(node.Children.Count==1) return Emit(node.Children[0]);
    throw ArgumentException("no direct Nemerle output mapping for "+node.Kind+" "+node.Label)
  }
}
public sealed class NitraCompilationResult
{
  public mutable Structure : NitraStructureResult;
  public mutable Expression : PExpr;
  public Diagnostics : SCG.List[string] = SCG.List();
  public Success : bool { get { Expression!=null && Diagnostics.Count==0 } }
}
public module NitraCompilation
{
  [Obsolete("no longer experimental; use the overload without the flag")]
  public Compile(grammar : NitraPreparedGrammar, rule : string, source : string,
                 context : NitraCompilationContext, resolver : Func[NitraStructuralChoice,int],
                 _experimental : bool) : NitraCompilationResult
  { Compile(grammar,rule,source,context,resolver) }
  public Compile(grammar : NitraPreparedGrammar, rule : string, source : string,
                 context : NitraCompilationContext, resolver : Func[NitraStructuralChoice,int]) : NitraCompilationResult
  {
    when(context==null) throw ArgumentNullException("context");
    when(context.Running || context.Root!=null) throw InvalidOperationException("semantic contexts belong to one compilation invocation");
    def result=NitraCompilationResult();
    def previous=ManagerClass.Instance;
    def errors=context.Typer.Manager.Message_ErrorCount;
    try
    {
      ManagerClass.Instance=context.Typer.Manager;
      result.Structure=NitraSyntax.StructureCompact(grammar,rule,source,resolver);
      unless(result.Structure.Success) { result.Diagnostics.AddRange(result.Structure.Diagnostics); return result; }
      context.Root=result.Structure.Root; context.Running=true;
      foreach(n in result.Structure.Nodes) _=context.Owned.Add(n);
      context.Evaluate(); result.Expression=context.Emit(context.Root);
      when(context.Typer.Manager.Message_ErrorCount>errors)
      { result.Expression=null; result.Diagnostics.Add("semantic evaluation or output construction reported compiler errors"); }
    }
    catch
    {
      | e is ArgumentException => result.Diagnostics.Add(e.Message);
      | e is FormatException => result.Diagnostics.Add(e.Message);
      | e is OverflowException => result.Diagnostics.Add(e.Message);
      | e is InvalidOperationException => result.Diagnostics.Add(e.Message);
    }
    finally { context.Running=false; ManagerClass.Instance=previous; }
    result
  }
}
