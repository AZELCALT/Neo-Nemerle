using System.IO;
using System;
using SCG = System.Collections.Generic;
using Nemerle.Collections;
using Nemerle.Compiler.Parsetree;
using Nemerle.Imperative;
using Nemerle.Compiler.AST;
using Nemerle.Compiler.MacroClassGen;
using Nemerle.Compiler.manager_class;
using Nemerle.Compiler.nitra_compilation;
using Nemerle.Compiler.NitraDialectServices;
using Nemerle.Compiler.nitra_inactive_syntax;
using Nemerle.Compiler.NitraRecognition;
using Nemerle.Compiler.NitraShared;
using Nemerle.Compiler.NitraSourceBoundaries;
using Nemerle.Compiler.NitraStructures;
using Nemerle.Compiler.nitra_syntax;
using Nemerle.Compiler.NitraSyntaxModel;
using Nemerle.Compiler.Source;
using Nemerle.Compiler.syntax_definition;
using Nemerle.Compiler.typer;
using Nemerle.Compiler.Utility;

/// Optional legacy callbacks; the default path uses native declared mappings.
public sealed class NitraSourceConfiguration
{
  mutable configureDialects : object;
  public ConfigureDialects : Action[NitraDialectRegistry]
  { get { configureDialects :> Action[NitraDialectRegistry] } set { configureDialects=value; } }
  public mutable Dialects : NitraDialectRegistry;
  public CreateContext : Func[Typer,string,NitraCompilationContext];
  public mutable ResolveStructure : Func[NitraStructuralChoice,int];
  public InactiveConstructs : SCG.List[NitraInactiveConstruct] = SCG.List();
  /// Optional: supplies the native semantic host for a set of grammar definitions (an editor caches hosts by grammar
  /// text this way). Null: the host is loaded and initialized for every compilation (NitraSourceSession.CreateNativeHost).
  public mutable ProvideHost : Func[ManagerClass,SCG.List[NitraDocument],INitraNativeSourceHost];
  /// Optional, for embedding hosts: an assignable Nemerle expression (such as a static field) that receives the value
  /// of each top-level space instead of discarding it. A program reads a space through scopes and dials; a host that
  /// tests a grammar's mapping reads the value here.
  public mutable SpaceValueTarget : string;
  public this() { CreateContext=null; }
  public this(createContext : Func[Typer,string,NitraCompilationContext])
  {
    when(createContext==null) throw ArgumentNullException("createContext"); CreateContext=createContext;
  }
  [Obsolete("grammar/space compilation is no longer experimental; use the constructor without the flag")]
  public this(_experimental : bool) { this() }
  [Obsolete("grammar/space compilation is no longer experimental; use the constructor without the flag")]
  public this(createContext : Func[Typer,string,NitraCompilationContext], _experimental : bool) { this(createContext) }
}
// The native semantic compiler (Integrated.Nitra.Compiler.dll next to Nemerle.Compiler.dll) implements this bridge.
// It is loaded only when a source contains a grammar or space block.
public interface INitraNativeSourceHost
{
  Initialize(manager : ManagerClass, definitions : SCG.IEnumerable[NitraDocument]) : void;
  Modules(owner : string) : array[string];
  Prepare(modules : SCG.IEnumerable[string]) : NitraPreparedGrammar;
  Expand(rule : string, selected : NitraStructure, typer : Typer, location : Location, context : NitraDialectContext) : PExpr;
}
/// A native host that keeps the bytes of the grammar image it compiled (for the continuation section).
public interface INitraGrammarImageHost
{
  Image : array[byte] { get; }
  /// Adds a grammar image stored in a continuation section; no compilation.
  AddImage(manager : ManagerClass, image : array[byte]) : void;
  /// Drops alternatives of a loaded grammar's rule, which a patch grammar replaces.
  RemoveAlternatives(owner : string, rule : string, names : array[string]) : void;
}
internal sealed class NitraSourceZone
{
  public mutable Id : int;
  public mutable File : int;
  public mutable Start : int;
  public mutable End : int;
  public mutable Body : int;
  public mutable Source : string;
  public Names : SCG.List[string] = SCG.List();
  public mutable Grammar : NitraPreparedGrammar;
  public mutable Rule : string;
  public mutable Owner : string;
  public mutable FileOwner : string;
  public mutable Alias : string;
  public mutable Space : NitraDialectSpace;
  /// A space of a continued binary: indexed for its dials and resolver, never placed in a source.
  public mutable Continued : bool;
  /// A continued space's stored path (its grammars are in Names).
  public mutable Path : string;
  public Scopes : SCG.List[string] = SCG.List();
  public mutable Dialect : string;
}
internal sealed class NitraSourceSession
{
  manager : ManagerClass;
  configuration : NitraSourceConfiguration;
  definitions : SCG.Dictionary[string,NitraDocument] = SCG.Dictionary();
  owners : SCG.Dictionary[string,int] = SCG.Dictionary();
  files : SCG.Dictionary[int,string] = SCG.Dictionary();
  zones : SCG.List[NitraSourceZone] = SCG.List();
  markSources : SCG.Dictionary[string,NitraDocument*int*int] = SCG.Dictionary();
  continuedNames : SCG.HashSet[string] = SCG.HashSet();
  patchedNames : SCG.HashSet[string] = SCG.HashSet();
  removals : SCG.List[string*string*array[string]] = SCG.List();
  /// Per redefined stored grammar, what changed against its stored marks.
  public ContinuationDiffs : SCG.Dictionary[string,Nemerle.Compiler.continuation.ContinuationDiff] = SCG.Dictionary();
  mutable nativeHost : INitraNativeSourceHost;
  // grammar name, file index, block start (keyword), block end
  internal GrammarBlocks : SCG.List[string * int * int * int] = SCG.List();
  // Editors index repeatedly with one manager: no expansion macros are registered then.
  internal mutable IndexOnly : bool;
  internal Zones : SCG.List[NitraSourceZone] { get { zones } }
  internal Definitions : SCG.Dictionary[string,NitraDocument] { get { definitions } }
  internal NativeHost : INitraNativeSourceHost { get { nativeHost } }
  internal Configuration : NitraSourceConfiguration { get { configuration } }
  internal Text(file : int) : string { if(files.ContainsKey(file)) files[file] else null }
  public this(manager : ManagerClass)
  { this.manager=manager; configuration=manager.Options.NitraSources; }
  private IsBlockHeader(text : string, file : string, start : int, keyword : string) : bool
  {
    try
    {
      def reader=GReader(text,file,start,text.Length); reader.Need(keyword);
      if(reader.Eat("("))
      { _=reader.Name(); while(reader.Eat(",")) _=reader.Name(); reader.Need(")"); }
      else unless(reader.Is("{") || reader.Is("[") || reader.Is("as")) _=reader.Name();
      when(reader.Eat("as")) _=reader.Name();
      when(reader.Eat("[")) { _=reader.Name(); while(reader.Eat(",")) _=reader.Name(); reader.Need("]"); }
      reader.Is("{")
    }
    catch { | _ is ArgumentException => false }
  }
  private Blank(chars : array[char], start : int, end : int) : void
  { for(mutable i=start;i<end;++i) unless(chars[i]=='\n' || chars[i]=='\r') chars[i]=' '; }
  private Insert(chars : array[char], start : int, end : int, tokens : array[string]) : void
  {
    mutable p=start;
    foreach(token in tokens)
    {
      mutable placed=false;
      while(p+token.Length<=end && !placed)
      {
        mutable fits=true; for(mutable i=0;i<token.Length;++i) when(chars[p+i]=='\n' || chars[p+i]=='\r') fits=false;
        if(fits) { token.CopyTo(0,chars,p,token.Length); p=p+token.Length; placed=true; } else ++p;
      }
      unless(placed) throw ArgumentException("space envelope is too short for internal expansion");
    }
  }
  public Index() : void
  {
    configuration.InactiveConstructs.Clear();
    configuration.Dialects=NitraDialectRegistry();
    foreach(source in manager.Options.Sources)
    {
      def text=source.GetText(); def chars=text.ToCharArray(); def file=Location.GetFileName(source.FileIndex);
      def r=GReader(text,file,0,text.Length); mutable depth=0; mutable previous="";
      while(!r.Is("<eof>"))
      {
        def t=r.Take();
        if(!t.Quoted && previous!="." && t.Text=="grammar" && depth==0 && !r.Is("("))
        {
          def name=r.Name();
          when(definitions.ContainsKey(name)) throw ArgumentException("duplicate source grammar: "+name);
          def block=r.Block();
          def nativeSource="namespace "+name+" {"+text.Substring(block.Start+1,block.End-block.Start-2)+"}";
          def document=if(configuration.CreateContext!=null) NitraSyntax.ReadSourceGrammar(nativeSource,file)
                       else
                       {
                         // Automatic hosting obtains modules and rules from
                         // native semantics. Do not recognize definitions once
                         // for inspection and again to construct their fields.
                         def d=NitraDocument(); d.Source=nativeSource; d.File=file;
                         _=NitraInactiveSyntax.Filter(nativeSource,file,d.InactiveConstructs); d
                       };
          unless(document.Success) throw ArgumentException(document.ToJson());
          foreach(c in document.InactiveConstructs)
          {
            def record=NitraInactiveConstruct(); record.Kind=c.Kind; record.File=file; record.Text=c.Text;
            record.Start=block.Start+1+c.Start-("namespace "+name+" {").Length;
            record.End=record.Start+c.End-c.Start; configuration.InactiveConstructs.Add(record);
          }
          // the continuation's mark trace needs every declaration's span, read textually (cheap) and
          // moved from the wrapped grammar text to positions in the source file
          when(manager.Options.ContinuationSection || !manager.ContinueFrom.IsEmpty)
            markSources[name]=(Nemerle.Compiler.NitraDeclarations.NitraDeclarationReader(nativeSource,file).Read(),block.Start+1-("namespace "+name+" {").Length,block.Start+1);
          definitions.Add(name,document); owners.Add(name,source.FileIndex); GrammarBlocks.Add((name,source.FileIndex,t.Start,block.End)); Blank(chars,t.Start,block.End);
        }
        else if(!t.Quoted && previous!="." &&
                (t.Text=="runtime" || t.Text=="compile" || t.Text=="grammar" && depth==0 && r.Is("(")) &&
                IsBlockHeader(text,file,t.Start,t.Text))
        {
          // Custom runtime/compiler blocks remain recognized placeholders.
          // Do not invoke their preserved handlers while Nitra is integrated.
          if(r.Eat("(")) { _=r.Name(); while(r.Eat(",")) _=r.Name(); r.Need(")"); }
          else unless(r.Is("{")) _=r.Name();
          def block=r.Block(); def c=NitraInactiveConstruct(); c.Kind=if(t.Text=="grammar") "grammar interaction" else t.Text; c.File=file;
          c.Start=t.Start; c.End=block.End; c.Text=text.Substring(t.Start,block.End-t.Start);
          configuration.InactiveConstructs.Add(c); Blank(chars,t.Start,block.End);
        }
        else if(!t.Quoted && previous!="." && t.Text=="space" && IsBlockHeader(text,file,t.Start,"space"))
        {
          // a space is a top-level declaration of the file: it talks to the program through scopes and dials, not as
          // a value inside a function, type or expression
          unless(depth==0 && (previous=="" || previous==";" || previous=="}" || previous=="]" || previous=="grammar"
                              || previous=="scope" || previous=="space" || previous=="runtime" || previous=="compile"))
          {
            r.Pos=t.Start; r.Reset();
            r.Fail(if(depth>0) "a space must be at the top level of the file, not inside a function or type; use scope bindings and dials to communicate with it"
                   else "a space is a top-level declaration, not an expression; read its results through scope bindings and dials");
          }
          def z=NitraSourceZone(); z.Id=zones.Count; z.File=source.FileIndex; z.Start=t.Start; z.Source=text;
          if(r.Eat("(")) { z.Names.Add(r.Name()); while(r.Eat(",")) z.Names.Add(r.Name()); r.Need(")"); }
          else unless(r.Is("{") || r.Is("[") || r.Is("as")) z.Names.Add(r.Name());
          when(r.Eat("as")) z.Alias=r.Name();
          when(r.Eat("[")) { z.Scopes.Add(r.Name()); while(r.Eat(",")) z.Scopes.Add(r.Name()); r.Need("]"); }
          z.FileOwner=FileOwner(source.FileIndex);
          def block=r.Block(); z.Body=block.Start+1; z.End=block.End-1; zones.Add(z);
          Blank(chars,t.Start,block.End); Insert(chars,t.Start,block.End,array["__g","(",z.Id.ToString(),")",";"]);
        }
        else if(!t.Quoted && previous!="." && t.Text=="scope" && depth==0 && !r.Is("."))
        {
          def name=r.Name(); _=configuration.Dialects.RegisterScope(name);
          def end=if(r.Eat(";")) r.Pos else { def block=r.Block(); when(block.End-block.Start>2 && !String.IsNullOrWhiteSpace(text.Substring(block.Start+1,block.End-block.Start-2))) r.Fail("scope declarations must be empty; use scope.name.registery to add bindings"); block.End };
          Blank(chars,t.Start,end);
        }
        else unless(t.Quoted) { when(t.Text=="{") ++depth; when(t.Text=="}") --depth; }
        previous=t.Text;
      }
      files.Add(source.FileIndex,string(chars));
    }
    // grammars stored in the continuation sections of the binaries this compilation continues from. A grammar the
    // sources define themselves wins; its stored image is not used (E3 will diff the marks instead).
    def continued=SCG.List.[array[byte]]();
    def storedSpaces=SCG.List.[string*SCG.List[Nemerle.Compiler.continuation.ContinuationSpace]]();
    when(configuration.CreateContext==null)
      foreach(path in manager.ContinueFrom)
      {
        mutable store=Nemerle.Compiler.continuation.ContinuationStore.FromImage(System.IO.File.ReadAllBytes(path));
        // shared scopes come first: they are plain bindings, valid whatever compiler wrote them
        when(store!=null) storedSpaces.Add((path,store.Spaces));
        when(store!=null)
          foreach(scope in store.Scopes)
          {
            def shared=configuration.Dialects.RegisterScope(scope.Name);
            foreach(binding when !shared.Contains(binding.Name) in scope.Bindings)
            {
              def bound=shared.Register(binding.Name,NitraDialectType(binding.Type),Location.Default);
              when(binding.Value!=null) bound.Value=Nemerle.Compiler.main_parser.MainParser.ParseExpr(manager.CoreEnv,binding.Value,Location.Default,false);
            }
          }
        // a grammar image is bound to the compiler and Nitra build that made it: another build's images are not used
        def version=typeof(ManagerClass).Assembly.GetName().Version.ToString();
        when(store!=null && store.GrammarImage!=null && store.CompilerVersion!=version)
        {
          when(Environment.GetEnvironmentVariable("NEMERLE_CONTINUATION_DIFF")=="1")
            Console.Error.WriteLine("continuation skipped "+path+": grammar image of compiler "+store.CompilerVersion+", this is "+version);
          store=null;
        }
        // a stored grammar the source redefines is diffed against the stored marks (the compile still falls back
        // to compiling the grammar in full)
        when(store!=null)
          foreach(stored when definitions.ContainsKey(stored.Name) && markSources.ContainsKey(stored.Name) in store.Grammars)
          {
            def (marks,delta,bodyStart)=markSources[stored.Name];
            def current=Nemerle.Compiler.continuation.ContinuationGrammar(); current.Name=stored.Name;
            current.Marks.AddRange(Nemerle.Compiler.continuation.ContinuationStore.Marks(marks,delta,bodyStart));
            def diff=Nemerle.Compiler.continuation.ContinuationStore.Diff(stored,current);
            ContinuationDiffs[stored.Name]=diff;
            def trace=Environment.GetEnvironmentVariable("NEMERLE_CONTINUATION_DIFF")=="1";
            when(trace) Console.Error.WriteLine("continuation diff "+stored.Name+": "+diff.ToString());
            // when only alternatives of extensible rules changed, compile a patch grammar of just those over the
            // stored image instead of the whole grammar
            if(diff.IsClean)
            {
              // nothing that matters changed: the stored image serves the grammar as it is
              _=definitions.Remove(stored.Name);
              when(trace) Console.Error.WriteLine("continuation reuse "+stored.Name+": unchanged, stored image used");
            }
            else match(PatchGrammar(stored,current,diff))
            {
              | Some((patch,drop)) when store.GrammarImage!=null =>
                def document=NitraDocument(); document.Source=patch; document.File=definitions[stored.Name].File;
                definitions[stored.Name]=document; _=patchedNames.Add(stored.Name); removals.AddRange(drop);
                when(trace) Console.Error.WriteLine("continuation patch "+stored.Name+": "+drop.Count.ToString()+" stale alternative(s) dropped, patch compiled alone");
              | _ => when(trace) Console.Error.WriteLine("continuation fallback "+stored.Name+": full grammar compile");
            }
          }
        when(store!=null && store.GrammarImage!=null && !store.Grammars.Exists(g => definitions.ContainsKey(g.Name) && !patchedNames.Contains(g.Name)))
        {
          continued.Add(store.GrammarImage);
          foreach(g when !patchedNames.Contains(g.Name) in store.Grammars)
          {
            def placeholder=NitraDocument(); placeholder.File=g.Owner; placeholder.Source="";
            continuedNames.Add(g.Name); definitions.Add(g.Name,placeholder);
          }
        }
      }
    // the continued binaries' spaces come with their scopes: each is indexed as a space of its file there (never
    // placed in this source), so dials reach it and its mapping can register its resolver again. A space whose
    // grammar is not available here (another compiler build's image) is left out.
    // a file this compilation compiles is that file itself, newer than the continued build: its old spaces are not
    // loaded (dial paths are unique, since the file is the namespace)
    def compiled=SCG.HashSet.[string](); foreach(source in manager.Options.Sources) _=compiled.Add(FileOwner(source.FileIndex));
    foreach((path,spaces) in storedSpaces)
      foreach(stored when !compiled.Contains(stored.File) && stored.Names.TrueForAll(n => definitions.ContainsKey(n)) in spaces)
      {
        def z=NitraSourceZone(); z.Id=zones.Count; z.Continued=true; z.File=Location.GetFileIndex(path);
        z.Source=stored.Body; z.Start=0; z.Body=0; z.End=stored.Body.Length; z.FileOwner=stored.File; z.Alias=stored.Alias;
        z.Names.AddRange(stored.Names); z.Path=stored.Path;
        z.Scopes.AddRange(stored.Scopes); zones.Add(z);
      }
    def sourceDefinitions=SCG.List.[NitraDocument]();
    foreach(pair when !continuedNames.Contains(pair.Key) in definitions) sourceDefinitions.Add(pair.Value);
    when(configuration.CreateContext==null && (definitions.Count>0 || zones.Count>0))
    {
      def inputs=sourceDefinitions;
      // continued images are loaded first, so that source grammars compile against (and may extend) those copies
      nativeHost=if(configuration.ProvideHost!=null) configuration.ProvideHost.Invoke(manager,inputs)
                 else if(continued.Count>0) CreateEmptyNativeHost()
                 else CreateNativeHost(manager,inputs);
      foreach(image in continued)
        match(nativeHost) { | host is INitraGrammarImageHost => host.AddImage(manager,image) | _ => throw ArgumentException("the native host cannot load continuation grammar images") }
      foreach((owner,rule,names) in removals)
        match(nativeHost) { | host is INitraGrammarImageHost => host.RemoveAlternatives(owner,rule,names) | _ => () }
      when(configuration.ProvideHost==null && continued.Count>0 && inputs.Count>0) nativeHost.Initialize(manager,inputs);
      // the compiled grammar image and the marks of every declaration go into the continuation section
      when(manager.Options.ContinuationSection && !IndexOnly && patchedNames.Count==0) // a patched compile does not store its grammar yet
        match(nativeHost)
        {
          | host is INitraGrammarImageHost when host.Image!=null =>
            manager.Continuation.GrammarImage=host.Image;
            foreach(pair when !continuedNames.Contains(pair.Key) in definitions)
            {
              def g=Nemerle.Compiler.continuation.ContinuationGrammar();
              g.Name=pair.Key; g.Owner=if(owners.ContainsKey(pair.Key) && files.ContainsKey(owners[pair.Key])) Location.GetFileName(owners[pair.Key]) else "";
              when(markSources.ContainsKey(pair.Key))
              {
                def (marks,delta,bodyStart)=markSources[pair.Key];
                g.Marks.AddRange(Nemerle.Compiler.continuation.ContinuationStore.Marks(marks,delta,bodyStart));
              }
              manager.Continuation.Grammars.Add(g);
            }
          | _ => ()
        }
    }
    foreach(z in zones)
    {
      def documents=SCG.List(NitraSyntax.BaselineDefinitions()); foreach(d in definitions.Values) documents.Add(d);
      // the modules of the selected grammars and the start rules among them
      def prepare(names : SCG.List[string]) : SCG.List[string]*NitraPreparedGrammar*SCG.List[string]
      {
        def modules=SCG.List.[string]();
        foreach(name in names)
        {
          unless(definitions.ContainsKey(name)) throw ArgumentException("unknown source grammar: "+name);
          if(nativeHost!=null) modules.AddRange(nativeHost.Modules(name));
          else foreach(m in definitions[name].Modules) modules.Add(m.Name);
        }
        def grammar=if(nativeHost!=null) nativeHost.Prepare(modules) else NitraSyntax.Prepare(documents,modules);
        def starts=SCG.List.[string]();
        foreach(rule in grammar.StartRules) foreach(mod in modules)
          when(rule.StartsWith(mod+".",StringComparison.Ordinal) && !starts.Contains(rule)) starts.Add(rule);
        (modules,grammar,starts)
      }
      mutable selected=SCG.List.[string]();
      if(z.Names.Count==0) foreach(pair in owners) when(pair.Value==z.File) selected.Add(pair.Key);
      else selected.AddRange(z.Names);
      mutable prepared=if(selected.Count==0) (SCG.List(),null,SCG.List()) else prepare(selected);
      // a plain space looks across grammars: when the file's own grammars give no single start rule, it uses every
      // grammar it can see (other files, continued binaries), so their rules combine in one space
      when(z.Names.Count==0)
      {
        def (_,_,starts)=prepared;
        unless(starts.Count==1)
        {
          def all=SCG.List(definitions.Keys);
          when(all.Count>selected.Count) { selected=all; prepared=prepare(all); }
        }
      }
      when(selected.Count==0) throw ArgumentException("space has no selected source grammars");
      def (modules,grammar,starts)=prepared;
      z.Grammar=grammar;
      z.Owner=String.Join(",",selected.ToArray()); z.Dialect=selected[0];
      // a space's path: the file's plain space is `file`, `space G` is `file.G`, the mixing `space (A, B)` is
      // `file.(A,B)` in any order; each exists once per file, and `as Name` adds `file.Name` (dial:.path::member)
      def owner=if(z.Path!=null) z.Path
                else if(z.Names.Count==0) z.FileOwner
                else if(z.Names.Count==1) z.FileOwner+"."+z.Names[0]
                else NitraDialectRegistry.Canonical(z.FileOwner+".("+String.Join(",",z.Names.ToArray())+")");
      z.Space=NitraDialectSpace(z.Dialect,owner,if(z.Continued) Location(z.File,1,1) else At(z.File,z.Start),z.Scopes.ToArray(),z.Id);
      z.Space.Names=selected.ToArray(); z.Space.File=z.FileOwner; z.Space.Alias=z.Alias; z.Space.Continued=z.Continued;
      z.Space.Body=z.Source.Substring(z.Body,z.End-z.Body);
      configuration.Dialects.AddSpace(z.Space);
      when(z.Alias!=null) configuration.Dialects.AddPath(z.FileOwner+"."+z.Alias,z.Space);
      _=modules;
      unless(starts.Count==1)
        throw ArgumentException(if(starts.Count==0) "source space requires exactly one selected StartRule"
                                else "source space requires exactly one selected StartRule; found "+String.Join(", ",starts.ToArray())+" (name one: space G { ... })");
      z.Rule=starts[0];
    }
    when(configuration.ConfigureDialects!=null) configuration.ConfigureDialects.Invoke(configuration.Dialects);
    foreach(source in manager.Options.Sources) files[source.FileIndex]=RewriteBoundaries(files[source.FileIndex],source.FileIndex);
    unless(IndexOnly)
    {
      manager.MacrosRegistry.RegisterMacro(NitraSpaceMacro(this));
      manager.MacrosRegistry.RegisterMacro(NitraBoundaryMacro(this));
    }
  }
  /// A patch grammar holding only the changed and added alternatives of a stored grammar, as
  /// `extend syntax` blocks over the stored modules, and the stale stored alternatives to drop. None when the change is
  /// anything else (a rule, a module, usings, a precedence group): then the grammar compiles in full.
  static PatchGrammar(stored : Nemerle.Compiler.continuation.ContinuationGrammar, current : Nemerle.Compiler.continuation.ContinuationGrammar,
                      diff : Nemerle.Compiler.continuation.ContinuationDiff) : option[string*SCG.List[string*string*array[string]]]
  {
    def marks(g : Nemerle.Compiler.continuation.ContinuationGrammar) { g.Marks }
    // the alternative a mark belongs to, with its rule and module, when the rule is extensible and has no precedence groups
    def place(g : Nemerle.Compiler.continuation.ContinuationGrammar, index : int) : option[int*int*int]
    {
      mutable i=index;
      while(i>=0 && marks(g)[i].Kind!="alternative") i=marks(g)[i].Parent;
      if(i<0) None()
      else
      {
        def rule=marks(g)[i].Parent;
        def moduleAt=if(rule<0) -1 else marks(g)[rule].Parent;
        def precedences=marks(g).Exists(m => m.Kind=="precedence" && m.Parent==rule);
        if(rule<0 || moduleAt<0 || marks(g)[rule].Kind!="syntax" || marks(g)[moduleAt].Kind!="module" || marks(g)[moduleAt].Parent>=0 || precedences) None()
        else Some((i,rule,moduleAt))
      }
    }
    if(diff.IsClean) None()
    else
    {
      mutable ok=true;
      def alternatives=SCG.List.[int*int*int]();   // in current: (alternative, rule, module)
      def drop=SCG.Dictionary.[string,SCG.List[string]]();
      def dropAt(g : Nemerle.Compiler.continuation.ContinuationGrammar, a : int, r : int, m : int) : void
      {
        def key=g.Name+"."+marks(g)[m].Name+"\n"+marks(g)[r].Name;
        unless(drop.ContainsKey(key)) drop[key]=SCG.List();
        unless(drop[key].Contains(marks(g)[a].Name)) drop[key].Add(marks(g)[a].Name);
      }
      def dirty=SCG.List(diff.Changed); dirty.AddRange(diff.Added);
      foreach(mark in dirty)
        match(place(current,current.Marks.IndexOf(mark)))
        {
          | Some((a,r,m)) => unless(alternatives.Exists((x,_,_) => x==a)) alternatives.Add((a,r,m));
          | None => ok=false
        }
      foreach(mark in diff.Removed)
        match(place(stored,stored.Marks.IndexOf(mark))) { | Some((a,r,m)) => dropAt(stored,a,r,m) | None => ok=false }
      // a changed alternative replaces the stored one of the same name
      foreach((a,r,m) in alternatives)
        when(stored.Marks.Exists(s => s.Kind=="alternative" && s.Name==current.Marks[a].Name)) dropAt(current,a,r,m);
      if(!ok || alternatives.Count==0 && drop.Count==0) None()
      else
      {
        def text(i : int) { current.Marks[i].Declaration.Text }
        def b=Text.StringBuilder("namespace "+current.Name+"\n{\n");
        foreach(i in [0 .. current.Marks.Count-1]) when(current.Marks[i].Parent<0 && current.Marks[i].Kind=="using") _=b.Append(text(i)).Append("\n");
        def modules=SCG.List.[int]();
        foreach((_,_,m) in alternatives) unless(modules.Contains(m)) modules.Add(m);
        foreach(m in modules)
        {
          def moduleName=current.Marks[m].Name;
          _=b.Append("syntax module "+moduleName+"__Patch\n{\n");
          foreach(i in [0 .. current.Marks.Count-1]) when(current.Marks[i].Parent==m && current.Marks[i].Kind=="using") _=b.Append(text(i)).Append("\n");
          _=b.Append("using "+current.Name+"."+moduleName+";\n");
          def rules=SCG.List.[int]();
          foreach((_,r,mm) in alternatives) when(mm==m && !rules.Contains(r)) rules.Add(r);
          foreach(r in rules)
          {
            _=b.Append("extend syntax "+current.Marks[r].Name+"\n{\n");
            foreach((a,rr,_) in alternatives) when(rr==r) _=b.Append(text(a)).Append("\n");
            _=b.Append("}\n");
          }
          _=b.Append("}\n");
        }
        _=b.Append("}\n");
        def result=SCG.List();
        foreach(pair in drop) { def parts=pair.Key.Split('\n'); result.Add((parts[0],parts[1],pair.Value.ToArray())); }
        Some((b.ToString(),result))
      }
    }
  }
  /// The native host without compiled definitions (only continuation images are added to it).
  static CreateEmptyNativeHost() : INitraNativeSourceHost
  {
    def directory=System.IO.Path.GetDirectoryName(typeof(ManagerClass).Assembly.Location);
    def assembly=System.Reflection.Assembly.LoadFrom(System.IO.Path.Combine(directory,"Integrated.Nitra.Compiler.dll"));
    Activator.CreateInstance(assembly.GetType("Nitra.Compiler+NativeSourceHost",true)) :> INitraNativeSourceHost
  }
  /// Loads the native semantic compiler next to Nemerle.Compiler.dll and compiles the grammar definitions with it.
  public static CreateNativeHost(manager : ManagerClass, definitions : SCG.List[NitraDocument]) : INitraNativeSourceHost
  {
    def directory=System.IO.Path.GetDirectoryName(typeof(ManagerClass).Assembly.Location);
    def hostPath=System.IO.Path.Combine(directory,"Integrated.Nitra.Compiler.dll");
    unless(System.IO.File.Exists(hostPath))
      throw ArgumentException("grammar and space blocks need the Nitra runtime (Integrated.Nitra.Compiler.dll and its Integrated.* dependencies) next to Nemerle.Compiler.dll in "+directory);
    def assembly=System.Reflection.Assembly.LoadFrom(hostPath);
    def type=assembly.GetType("Nitra.Compiler+NativeSourceHost",true); // nested in the file module Nitra.Compiler
    def host=Activator.CreateInstance(type) :> INitraNativeSourceHost;
    host.Initialize(manager,definitions); host
  }
  public Rewrite(source : ISource) : string
  { unless(files.ContainsKey(source.FileIndex)) throw ArgumentException("source was not indexed in native grammar compilation"); files[source.FileIndex] }
  public SpaceLocation(id : int) : Location
  { if(id>=0 && id<zones.Count) At(zones[id].File,zones[id].Start) else Location.Default }
  public Expand(typer : Typer, id : int) : PExpr
  {
    when(id<0 || id>=zones.Count) throw ArgumentException("invalid internal space identity");
    def z=zones[id];
    mutable line=1; mutable column=1;
    for(mutable i=0;i<z.Body;++i) if(z.Source[i]=='\n') { ++line; column=1; } else ++column;
    def location=Location(z.File,line,column);
    when(nativeHost!=null)
    {
      def selected=NitraSyntax.StructureCompact(z.Grammar,z.Rule,z.Source.Substring(z.Body,z.End-z.Body),configuration.ResolveStructure);
      unless(selected.Success)
      { foreach(message in selected.Diagnostics) Message.Error(location,message); return PExpr.Error(location); }
      def context=NitraDialectContext(configuration.Dialects,z.Space,typer,location);
      foreach(name in z.Scopes) _=context.Scope(name);
      def previous=NitraDialectContext.Active;
      // a space stands as a top-level statement: its own value is discarded
      try { NitraDialectContext.Active=context; return Statement(typer,nativeHost.Expand(z.Rule,selected.Root,typer,location,context),location); }
      finally { NitraDialectContext.Active=previous; }
    }
    def context=configuration.CreateContext.Invoke(typer,z.Owner);
    when(context==null || context.Typer : object != typer : object) throw ArgumentException("source context must use the current typer");
    context.Location=location;
    def compiled=NitraCompilation.Compile(z.Grammar,z.Rule,z.Source.Substring(z.Body,z.End-z.Body),context,configuration.ResolveStructure);
    unless(compiled.Success) { foreach(message in compiled.Diagnostics) Message.Error(context.Location,message); return PExpr.Error(context.Location); }
    Statement(typer,compiled.Expression,context.Location)
  }
  private Statement(typer : Typer, value : PExpr, location : Location) : PExpr
  {
    if(value is PExpr.Error || String.IsNullOrEmpty(configuration.SpaceValueTarget)) <[ _ = $value ]>
    else { def target=Nemerle.Compiler.main_parser.MainParser.ParseExpr(typer.Env,configuration.SpaceValueTarget,location,false); <[ $target = $value ]> }
  }

  // ---- merged from parsing/NitraSourceBoundaries.n ----
  boundaries : SCG.List[NitraBoundary] = SCG.List();
  preparing : SCG.HashSet[int] = SCG.HashSet();
  private At(file : int, offset : int) : Location
  {
    mutable text=""; foreach(source in manager.Options.Sources) when(source.FileIndex==file) text=source.GetText();
    mutable line=1; mutable column=1;
    for(mutable i=0;i<offset;++i) if(text[i]=='\n') { ++line; column=1; } else ++column;
    Location(file,line,column)
  }
  private FileOwner(file : int) : string
  {
    def path=Path.GetFullPath(Location.GetFileName(file));
    if(manager.Options.FileModules && manager.Options.FileNameNamespaces) Path.GetFileNameWithoutExtension(path)
    else if(manager.Options.FileModules)
    {
      def root=manager.FileModuleRegistry.Root;
      def prefix=root.TrimEnd(array[Path.DirectorySeparatorChar,Path.AltDirectorySeparatorChar])+Path.DirectorySeparatorChar;
      unless(path.StartsWith(prefix,StringComparison.Ordinal)) throw ArgumentException("dialect source is outside the source root: "+path);
      def relative=path.Substring(prefix.Length);
      Path.ChangeExtension(relative,null).Replace(Path.DirectorySeparatorChar,'.').Replace(Path.AltDirectorySeparatorChar,'.')
    }
    else Path.GetFileNameWithoutExtension(path)
  }
  private EndOfValue(text : string, file : string, start : int) : int
  {
    def r=GReader(text,file,start,text.Length); mutable depth=0;
    while(!r.Is("<eof>"))
    {
      def t=r.Peek();
      when(!t.Quoted && depth==0 && (t.Text==";" || t.Text=="," || t.Text=="}" || t.Text==")" || t.Text=="]")) return t.Start;
      _=r.Take(); unless(t.Quoted)
      { when(t.Text=="(" || t.Text=="[" || t.Text=="{") ++depth; when(t.Text==")" || t.Text=="]" || t.Text=="}") --depth; }
    }
    text.Length
  }
  private RewriteBoundaries(text : string, file : int) : string
  {
    def edits=SCG.List.[NitraBoundaryEdit](); def r=GReader(text,Location.GetFileName(file),0,text.Length);
    mutable previous="";
    while(!r.Is("<eof>"))
    {
      def t=r.Take();
      when(!t.Quoted && previous!="." && t.Text.Length>0 && (char.IsLetter(t.Text[0]) || t.Text[0]=='_'))
      {
        mutable boundary : NitraBoundary=null;
        if(t.Text=="scope" && r.Eat("."))
        {
          def scope=r.Take(); r.Need("."); def member=r.Take();
          boundary=NitraBoundary(); boundary.Owner=scope.Text; boundary.Member=member.Text;
          boundary.Kind=if(member.Text=="registery") "register" else "scope";
          when(r.Eat("=")) boundary.Kind="set";
        }
        else
        {
          // only `dial:.path::member` is a dial: dial:.file (the plain space), dial:.file.G, dial:.file.(A, B)
          def probe=GReader(text,r.File,t.Start,text.Length);
          when(t.Text=="dial" && { _=probe.Take(); probe.Eat(":") } && probe.Eat("."))
          {
            boundary=NitraBoundary(); boundary.Kind="dialect"; boundary.Dialect="dial";
            mutable owner=probe.Take().Text;
            while(probe.Eat("."))
              if(probe.Eat("("))
              {
                def names=SCG.List.[string](); names.Add(probe.Name()); while(probe.Eat(",")) names.Add(probe.Name()); probe.Need(")");
                owner=NitraDialectRegistry.Canonical(owner+".("+String.Join(",",names.ToArray())+")");
              }
              else owner=owner+"."+probe.Take().Text;
            boundary.Owner=owner; probe.Need(":"); probe.Need(":"); boundary.Member=probe.Take().Text;
            r.Pos=probe.Pos; r.Reset();
          }
        }
        when(boundary!=null)
        {
          boundary.Location=At(file,t.Start); def id=boundaries.Count; boundaries.Add(boundary);
          if(boundary.Kind=="set")
          {
            def end=EndOfValue(text,r.File,r.Pos);
            // the closing `)` is inserted after the value: the prefix keeps one character free for it, so later
            // positions (diagnostics, editor tokens) stay where they are in the source
            def prefix=NitraBoundaryEdit(t.Start,r.Pos,"__b("+id.ToString()+","); prefix.Reserve=1; edits.Add(prefix);
            edits.Add(NitraBoundaryEdit(end,end,")"));
          }
          else
          {
            boundary.IsCall=r.Eat("(");
            def end=if(boundary.IsCall) r.Pos else r.Peek().Start;
            def prefix=if(boundary.IsCall) "__b("+id.ToString()+(if(r.Is(")")) "" else ",") else "__b("+id.ToString()+")";
            edits.Add(NitraBoundaryEdit(t.Start,end,prefix));
          }
        }
      }
      previous=t.Text;
    }
    // Keep every original newline, including multiline qualified prefixes.
    edits.Sort((a,b) => b.Start.CompareTo(a.Start)); mutable result=text;
    foreach(edit in edits)
    {
      def original=text.Substring(edit.Start,edit.End-edit.Start);
      mutable replacement=edit.Text;
      foreach(c in original) when(c=='\n' || c=='\r') replacement=replacement+c.ToString();
      when(replacement.Length<original.Length-edit.Reserve) replacement=replacement+string(' ',original.Length-edit.Reserve-replacement.Length);
      result=result.Substring(0,edit.Start)+replacement+result.Substring(edit.End);
    }
    result
  }
  private Context(space : NitraDialectSpace, typer : Typer, location : Location) : NitraDialectContext
  {
    when(space.Resolver==null)
    {
      unless(preparing.Add(space.Zone)) throw ArgumentException("recursive dialect resolver initialization: dial:."+space.Owner);
      try { _=Expand(typer,space.Zone); } finally { _=preparing.Remove(space.Zone); }
    }
    NitraDialectContext(configuration.Dialects,space,typer,location)
  }
  private ResolveBoundary(boundary : NitraBoundary, typer : Typer, args : array[PExpr]) : NitraDialectResolution
  {
    def space=configuration.Dialects.Space(boundary.Owner);
    def context=Context(space,typer,boundary.Location); def previous=NitraDialectContext.Active;
    try { NitraDialectContext.Active=context; context.Resolve(boundary.Member,args,boundary.IsCall) }
    finally { NitraDialectContext.Active=previous; }
  }
  public BoundaryLocation(id : int) : Location
  { if(id>=0 && id<boundaries.Count) boundaries[id].Location else Location.Default }
  public Boundary(typer : Typer, id : int, args : list[PExpr]) : PExpr
  {
    when(id<0 || id>=boundaries.Count) throw ArgumentException("invalid internal boundary identity");
    def b=boundaries[id];
    if(b.Kind=="dialect")
    {
      def space=configuration.Dialects.Space(b.Owner); def context=Context(space,typer,b.Location);
      def previous=NitraDialectContext.Active;
      try
      {
        NitraDialectContext.Active=context;
        def request=NitraDialectRequest(context,b.Member,args.ToArray(),b.IsCall);
        def answer=context.Resolve(b.Member,request.Arguments,b.IsCall);
        when(answer.Lower==null) throw ArgumentException("dialect member has no lowering: "+b.Member);
        def output=answer.Lower.Invoke(request); when(output==null) throw ArgumentException("dialect lowering returned no expression: "+b.Member); output
      }
      finally { NitraDialectContext.Active=previous; }
    }
    else if(b.Kind=="register")
    {
      match(args)
      {
        | [PExpr.Literal(Literal.String(name)), PExpr.Call(PExpr.Ref(typeName), [PExpr.Literal(Literal.String(type))])] when(typeName.ToString()=="type") =>
          _=configuration.Dialects.RegisterScope(b.Owner).Register(name,NitraDialectType(type),b.Location); <[ () ]>
        | [PExpr.Literal(Literal.String(name)), PExpr.Call(PExpr.Ref(macroName), [PExpr.Literal(Literal.Integer(value,false,_))])] when(macroName.ToString()=="__b" && value<int.MaxValue :> ulong) =>
          def reference=boundaries[value :> int];
          unless(reference.Kind=="dialect" && !reference.IsCall) throw ArgumentException("scope registration requires a dialect member reference");
          def resolved=ResolveBoundary(reference,typer,array[]);
          _=configuration.Dialects.RegisterScope(b.Owner).Register(name,NitraDialectReference(reference.Dialect,reference.Owner,reference.Member,resolved),b.Location); <[ () ]>
        | _ => throw ArgumentException("expected scope.A.registery(\"name\", type(\"type\")) or a dialect member reference");
      }
    }
    else if(b.Kind=="set")
    {
      match(args)
      { | [value] => configuration.Dialects.Scope(b.Owner).Set(b.Member,value); <[ () ]>
        | _ => throw ArgumentException("scope assignment requires one value"); }
    }
    else
    {
      def binding=configuration.Dialects.Scope(b.Owner).Get(b.Member);
      match(binding.Value)
      {
        | reference is NitraDialectReference =>
          def call=NitraBoundary(); call.Kind="dialect"; call.Dialect=reference.Dialect; call.Owner=reference.Owner;
          call.Member=reference.Name; call.IsCall=b.IsCall; call.Location=b.Location;
          def slot=boundaries.Count; boundaries.Add(call); Boundary(typer,slot,args)
        | expression is PExpr => if(b.IsCall) PExpr.Call(expression,args) else expression
        | _ => throw ArgumentException("scope binding has no expression value: scope."+b.Owner+"."+b.Member);
      }
    }
  }
}
internal sealed class NitraSpaceMacro : IMacro
{
  session : NitraSourceSession;
  public this(session : NitraSourceSession) { this.session=session; }
  public GetName() : string { "__g" }
  public GetNamespace() : string { "Nemerle.Core" }
  public IsInherited : bool { get { false } }
  public IsTailRecursionTransparent : bool { get { false } }
  public Keywords : list[string] { get { [] } }
  public Usage : MacroUsageAttribute { get { null } }
  public Location : Location { get { Location.Default } }
  public SyntaxExtension() : GrammarElement * (list[SyntaxElement] -> list[SyntaxElement]) { (null,null) }
  public CallTransform(args : list[PExpr]) : list[SyntaxElement] { args.Map(e => SyntaxElement.Expression(e) : SyntaxElement) }
  public Run(ctx : Typer, args : list[SyntaxElement]) : PExpr
  {
    mutable location=Location.Default;
    try
    {
      match(args)
      {
        | [SyntaxElement.Expression(PExpr.Literal(Literal.Integer(value,false,_)))] when(value<=int.MaxValue :> ulong) =>
          location=session.SpaceLocation(value :> int); session.Expand(ctx,value :> int)
        | _ => throw ArgumentException("invalid internal native space invocation");
      }
    }
    catch
    {
      | exception =>
        mutable error=exception;
        while(error is System.Reflection.TargetInvocationException && error.InnerException!=null) error=error.InnerException;
        Message.Error(location,error.Message); PExpr.Error(location)
    }
  }
}
