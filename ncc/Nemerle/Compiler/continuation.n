// The continuation section. A binary carries, in its .nemir section, what a later late-bound compilation (a script
// compiled by the embedded compiler, or any compilation referencing it) needs to continue from it: the compiled Nitra
// grammar image with a mark trace of every grammar declaration, its macros, and the members those macros use.
// See doc/CONTINUATION.md.
using System;
using System.IO;
using System.Text;
using SCG = System.Collections.Generic;
using Nemerle;
using Nemerle.Imperative;
using Nemerle.Compiler.NitraSyntaxModel;

/// One declaration of a grammar (syntax module, rule or alternative) as its source showed it. Edits are matched to
/// declarations by (Kind, Scope, Name) and the hash of their text.
public sealed class ContinuationMark
{
  public mutable Kind : string = "";
  public mutable Name : string = "";
  public mutable Scope : string = "";
  public mutable Start : int;
  public mutable End : int;
  /// Hash of the declaration's whole text, whitespace runs outside literals collapsed.
  public mutable Hash : ulong;
  /// Hash of the declaration's own text (its children cut out), normalized the same way: a declaration whose own
  /// text did not change is clean even when a child changed.
  public mutable Own : ulong;
  /// Index of the enclosing declaration in the grammar's mark list, -1 at the top.
  public mutable Parent : int = -1;
  /// The source declaration (only for marks made from source in this compilation; not stored).
  public mutable Declaration : NitraDeclaration;
}

public sealed class ContinuationGrammar
{
  public mutable Name : string = "";
  /// Source file that declared the grammar.
  public mutable Owner : string = "";
  public Marks : SCG.List[ContinuationMark] = SCG.List();
}

/// A macro defined in the binary: its user-visible name, the CLR name of its macro class, and where it is defined.
public sealed class ContinuationMacro
{
  public mutable Name : string = "";
  public mutable TypeName : string = "";
  public mutable File : string = "";
  public mutable Start : int;
  public mutable End : int;
  public mutable Hash : ulong;
}

/// A module of the relevant set (it defines macros) and its members that CLR visibility hides from a referencing
/// compilation; a compilation that continues from the binary may use exactly these.
public sealed class ContinuationType
{
  /// CLR full name of the module class.
  public mutable TypeName : string = "";
  public Members : SCG.List[string] = SCG.List();
}

/// A shared scope (`scope A;` and its `scope.A.registery` bindings), stored next to the grammars so that a continuing
/// compilation or script starts with the same bindings.
public sealed class ContinuationScope
{
  public mutable Name : string = "";
  public Bindings : SCG.List[ContinuationBinding] = SCG.List();
}

/// A slot of a scope's storage layout: its name, its type token, and the Nemerle type it reads as. The value itself
/// lives in the storage when the program runs.
public sealed class ContinuationBinding
{
  public mutable Name : string = "";
  public mutable Type : string = "";
  public mutable Clr : string = "object";
}

/// A space stored with the scopes: enough to rebuild it in a continuing compilation, so a dial
/// (dial:.file::member) reaches it and its mapping can register the space's resolver again.
public sealed class ContinuationSpace
{
  /// The grammars the space uses (for a plain space, those it selected).
  public Names : SCG.List[string] = SCG.List();
  /// Where the space stands: `file`, `file.G` or `file.(A,B)` (dial:.path::member).
  public mutable Path : string = "";
  public mutable File : string = "";
  /// The `as` name, or null.
  public mutable Alias : string;
  public Scopes : SCG.List[string] = SCG.List();
  /// The space's body, as written.
  public mutable Body : string = "";
}

public sealed class ContinuationDiff
{
  public Changed : SCG.List[ContinuationMark] = SCG.List();
  public Added : SCG.List[ContinuationMark] = SCG.List();
  public Removed : SCG.List[ContinuationMark] = SCG.List();
  public mutable Unchanged : int;
  public IsClean : bool { get { Changed.Count == 0 && Added.Count == 0 && Removed.Count == 0 } }
  public override ToString() : string
  {
    def names(marks : SCG.List[ContinuationMark]) { string.Join(",", marks.ConvertAll(m => m.Kind + ":" + m.Name).ToArray()) }
    $"changed=[$(names(Changed))] added=[$(names(Added))] removed=[$(names(Removed))] unchanged=$Unchanged"
  }
}

public sealed class ContinuationStore
{
  static Magic : array[byte] = array[0x4E :> byte, 0x45 :> byte, 0x4D :> byte, 0x43 :> byte]; // "NEMC"
  public static FormatVersion : int = 1;
  static GrammarKind : byte = 1;
  static MacroKind : byte = 2;
  static TypeKind : byte = 3;
  static ScopeKind : byte = 4;

  public mutable CompilerVersion : string = "";
  /// The compiled grammar image (one assembly for all grammars of the binary), uncompressed; null when none.
  public mutable GrammarImage : array[byte];
  public Grammars : SCG.List[ContinuationGrammar] = SCG.List();
  public Macros : SCG.List[ContinuationMacro] = SCG.List();
  public Types : SCG.List[ContinuationType] = SCG.List();
  public Scopes : SCG.List[ContinuationScope] = SCG.List();
  /// The spaces, stored next to the scopes they use.
  public Spaces : SCG.List[ContinuationSpace] = SCG.List();

  public IsEmpty : bool
  { get { GrammarImage == null && Grammars.Count == 0 && Macros.Count == 0 && Types.Count == 0 && Scopes.Count == 0 && Spaces.Count == 0 } }

  /// Offsets in the source text of a location (lines and columns are 1-based), or (-1, -1) when unknown.
  public static Span(text : string, location : Nemerle.Compiler.AST.Location) : int * int
  {
    def offset(line : int, column : int) : int
    {
      mutable at = 0;
      mutable l = 1;
      while (l < line && at >= 0)
      {
        at = text.IndexOf('\n', at);
        when (at >= 0) { ++at; ++l; }
      }
      if (at < 0) -1 else Math.Min(text.Length, at + column - 1)
    }
    if (text == null || location.Line <= 0) (-1, -1)
    else (offset(location.Line, location.Column), offset(location.EndLine, location.EndColumn))
  }

  /// The marks of a grammar's declarations, depth first, each with its parent's index. `delta` moves the document's
  /// offsets to positions in the source file; declarations that start before `bodyStart` are synthetic wrappers (not
  /// source text) and are skipped, their children recorded in their place.
  public static Marks(document : NitraDocument, delta : int, bodyStart : int) : SCG.List[ContinuationMark]
  {
    def result = SCG.List();
    def walk(declarations : SCG.IEnumerable[NitraDeclaration], parent : int) : void
    {
      foreach (d in declarations)
        if (d.Start + delta < bodyStart) walk(d.Children, parent)
        else
        {
          def text = d.Text ?? "";
          def own = StringBuilder();
          mutable at = d.Start;
          foreach (c in d.Children)
            when (c.Start >= at && c.End <= d.End)
            {
              _ = own.Append(text, at - d.Start, c.Start - at).Append(' ');
              at = c.End;
            }
          when (at <= d.End) _ = own.Append(text, at - d.Start, d.End - at);
          def m = ContinuationMark();
          m.Kind = d.Kind ?? ""; m.Name = d.Name ?? ""; m.Scope = d.Scope ?? "";
          m.Start = d.Start + delta; m.End = d.End + delta; m.Hash = Hash(Normalize(text)); m.Own = Hash(Normalize(own.ToString()));
          m.Parent = parent; m.Declaration = d;
          result.Add(m);
          walk(d.Children, result.Count - 1);
        }
    }
    walk(document.Declarations, -1);
    result
  }

  /// Collapses every whitespace run outside "..." and '...' literals to one space and trims the ends, so layout-only
  /// edits do not change a mark.
  public static Normalize(text : string) : string
  {
    def b = StringBuilder(text.Length);
    mutable quote = '\0';
    mutable space = false;
    for (mutable i = 0; i < text.Length; ++i)
    {
      def c = text[i];
      if (quote != '\0')
      {
        _ = b.Append(c);
        if (c == '\\' && i + 1 < text.Length) { ++i; _ = b.Append(text[i]); }
        else when (c == quote) quote = '\0';
      }
      else if (char.IsWhiteSpace(c)) space = true
      else
      {
        when (space && b.Length > 0) _ = b.Append(' ');
        space = false;
        _ = b.Append(c);
        when (c == '"' || c == '\'') quote = c;
      }
    }
    b.ToString()
  }

  /// What changed between the stored marks of a grammar and its current source: declarations whose own text changed,
  /// added declarations and removed ones (only the outermost of an added or removed subtree). Matching is by the path
  /// of (kind, name) from the root, with an ordinal among same-named siblings.
  public static Diff(stored : ContinuationGrammar, current : ContinuationGrammar) : ContinuationDiff
  {
    def keys(marks : SCG.List[ContinuationMark]) : array[string]
    {
      def result = array(marks.Count);
      def seen = SCG.Dictionary.[string, int](StringComparer.Ordinal);
      for (mutable i = 0; i < marks.Count; ++i)
      {
        def m = marks[i];
        def prefix = (if (m.Parent < 0) "" else result[m.Parent]) + "/" + m.Kind + ":" + m.Name;
        mutable n;
        _ = seen.TryGetValue(prefix, out n);
        seen[prefix] = n + 1;
        result[i] = prefix + "#" + n.ToString();
      }
      result
    }
    def oldKeys = keys(stored.Marks);
    def newKeys = keys(current.Marks);
    def oldIndex = SCG.Dictionary.[string, int](StringComparer.Ordinal);
    for (mutable i = 0; i < oldKeys.Length; ++i) oldIndex[oldKeys[i]] = i;
    def newIndex = SCG.Dictionary.[string, int](StringComparer.Ordinal);
    for (mutable i = 0; i < newKeys.Length; ++i) newIndex[newKeys[i]] = i;
    def diff = ContinuationDiff();
    for (mutable i = 0; i < newKeys.Length; ++i)
    {
      def m = current.Marks[i];
      mutable j;
      if (oldIndex.TryGetValue(newKeys[i], out j))
      {
        if (stored.Marks[j].Own != m.Own) diff.Changed.Add(m) else ++diff.Unchanged;
      }
      else when (m.Parent < 0 || oldIndex.ContainsKey(newKeys[m.Parent])) diff.Added.Add(m);
    }
    for (mutable j = 0; j < oldKeys.Length; ++j)
    {
      def m = stored.Marks[j];
      when (!newIndex.ContainsKey(oldKeys[j]) && (m.Parent < 0 || newIndex.ContainsKey(oldKeys[m.Parent])))
        diff.Removed.Add(m);
    }
    diff
  }

  /// 64-bit FNV-1a over the UTF-16 code units of the text.
  public static Hash(text : string) : ulong
  {
    mutable h : ulong = 14695981039346656037UL;
    foreach (c in text)
      unchecked { h = (h ^ (c :> ulong)) * 1099511628211UL; }
    h
  }

  // ---- encoding: header, string table, subsections; numbers are ECMA-335 compressed integers ----

  public Write() : array[byte]
  {
    def strings = SCG.List.[string]();
    def index = SCG.Dictionary.[string, int](StringComparer.Ordinal);
    def str(s : string) : int
    {
      def s = s ?? "";
      mutable i;
      unless (index.TryGetValue(s, out i)) { i = strings.Count; strings.Add(s); index.Add(s, i); }
      i
    }
    // grammar subsection first, so its strings are interned before the table is written
    def grammar = MemoryStream();
    when (GrammarImage != null || Grammars.Count > 0)
    {
      def image = if (GrammarImage == null) array(0) else Nemerle.Platform.ClrCompilerSection.Compress(GrammarImage);
      WriteInt(grammar, if (GrammarImage == null) 0 else GrammarImage.Length);
      WriteBlob(grammar, image);
      WriteInt(grammar, Grammars.Count);
      foreach (g in Grammars)
      {
        WriteInt(grammar, str(g.Name)); WriteInt(grammar, str(g.Owner)); WriteInt(grammar, g.Marks.Count);
        foreach (m in g.Marks)
        {
          WriteInt(grammar, str(m.Kind)); WriteInt(grammar, str(m.Name)); WriteInt(grammar, str(m.Scope));
          WriteInt(grammar, m.Start); WriteInt(grammar, m.End - m.Start); WriteInt(grammar, m.Parent + 1);
          def hash = BitConverter.GetBytes(m.Hash); grammar.Write(hash, 0, hash.Length);
          def own = BitConverter.GetBytes(m.Own); grammar.Write(own, 0, own.Length);
        }
      }
    }
    def macros = MemoryStream();
    when (Macros.Count > 0)
    {
      WriteInt(macros, Macros.Count);
      foreach (m in Macros)
      {
        WriteInt(macros, str(m.Name)); WriteInt(macros, str(m.TypeName)); WriteInt(macros, str(m.File));
        WriteInt(macros, m.Start + 1); WriteInt(macros, m.End - m.Start + 1);
        def hash = BitConverter.GetBytes(m.Hash); macros.Write(hash, 0, hash.Length);
      }
    }
    def types = MemoryStream();
    when (Types.Count > 0)
    {
      WriteInt(types, Types.Count);
      foreach (t in Types)
      {
        WriteInt(types, str(t.TypeName)); WriteInt(types, t.Members.Count);
        foreach (m in t.Members) WriteInt(types, str(m));
      }
    }
    def scopes = MemoryStream();
    when (Scopes.Count > 0 || Spaces.Count > 0)
    {
      WriteInt(scopes, Scopes.Count);
      foreach (s in Scopes)
      {
        WriteInt(scopes, str(s.Name)); WriteInt(scopes, s.Bindings.Count);
        foreach (b in s.Bindings)
        {
          WriteInt(scopes, str(b.Name)); WriteInt(scopes, str(b.Type));
          WriteInt(scopes, str(b.Clr));
        }
      }
      WriteInt(scopes, Spaces.Count);
      foreach (s in Spaces)
      {
        WriteInt(scopes, s.Names.Count); foreach (n in s.Names) WriteInt(scopes, str(n));
        WriteInt(scopes, str(s.Path)); WriteInt(scopes, str(s.File)); WriteInt(scopes, str(s.Alias ?? ""));
        WriteInt(scopes, s.Scopes.Count); foreach (n in s.Scopes) WriteInt(scopes, str(n));
        WriteInt(scopes, str(s.Body));
      }
    }
    def output = MemoryStream();
    output.Write(Magic, 0, Magic.Length);
    WriteInt(output, FormatVersion);
    WriteString(output, CompilerVersion);
    WriteInt(output, strings.Count);
    foreach (s in strings) WriteString(output, s);
    def subsections = (if (grammar.Length > 0) 1 else 0) + (if (macros.Length > 0) 1 else 0) + (if (types.Length > 0) 1 else 0)
                      + (if (scopes.Length > 0) 1 else 0);
    WriteInt(output, subsections);
    when (grammar.Length > 0)
    {
      output.WriteByte(GrammarKind);
      WriteBlob(output, grammar.ToArray());
    }
    when (macros.Length > 0)
    {
      output.WriteByte(MacroKind);
      WriteBlob(output, macros.ToArray());
    }
    when (types.Length > 0)
    {
      output.WriteByte(TypeKind);
      WriteBlob(output, types.ToArray());
    }
    when (scopes.Length > 0)
    {
      output.WriteByte(ScopeKind);
      WriteBlob(output, scopes.ToArray());
    }
    output.ToArray()
  }

  public static Read(data : array[byte]) : ContinuationStore
  {
    def r = Reader(data);
    for (mutable i = 0; i < Magic.Length; ++i)
      unless (r.Byte() == Magic[i]) throw InvalidDataException("not a Nemerle continuation section");
    def version = r.Int();
    unless (version == FormatVersion) throw InvalidDataException($"continuation format $version is not supported (expected $FormatVersion)");
    def store = ContinuationStore();
    store.CompilerVersion = r.String();
    def strings = array(r.Int());
    for (mutable i = 0; i < strings.Length; ++i) strings[i] = r.String();
    def count = r.Int();
    repeat (count)
    {
      def kind = r.Byte();
      def payload = Reader(r.Blob());
      when (kind == GrammarKind)
      {
        def size = payload.Int();
        def image = payload.Blob();
        store.GrammarImage = if (size == 0) null else Nemerle.Platform.ClrCompilerSection.Decompress(image);
        repeat (payload.Int())
        {
          def g = ContinuationGrammar();
          g.Name = strings[payload.Int()]; g.Owner = strings[payload.Int()];
          repeat (payload.Int())
          {
            def m = ContinuationMark();
            m.Kind = strings[payload.Int()]; m.Name = strings[payload.Int()]; m.Scope = strings[payload.Int()];
            m.Start = payload.Int(); m.End = m.Start + payload.Int(); m.Parent = payload.Int() - 1;
            m.Hash = BitConverter.ToUInt64(payload.Bytes(8), 0);
            m.Own = BitConverter.ToUInt64(payload.Bytes(8), 0);
            g.Marks.Add(m);
          }
          store.Grammars.Add(g);
        }
      }
      when (kind == MacroKind)
        repeat (payload.Int())
        {
          def m = ContinuationMacro();
          m.Name = strings[payload.Int()]; m.TypeName = strings[payload.Int()]; m.File = strings[payload.Int()];
          m.Start = payload.Int() - 1; m.End = m.Start + payload.Int() - 1;
          m.Hash = BitConverter.ToUInt64(payload.Bytes(8), 0);
          store.Macros.Add(m);
        }
      when (kind == TypeKind)
        repeat (payload.Int())
        {
          def t = ContinuationType();
          t.TypeName = strings[payload.Int()];
          repeat (payload.Int()) t.Members.Add(strings[payload.Int()]);
          store.Types.Add(t);
        }
      when (kind == ScopeKind)
      {
        repeat (payload.Int())
        {
          def s = ContinuationScope();
          s.Name = strings[payload.Int()];
          repeat (payload.Int())
          {
            def b = ContinuationBinding();
            b.Name = strings[payload.Int()]; b.Type = strings[payload.Int()];
            b.Clr = strings[payload.Int()];
            s.Bindings.Add(b);
          }
          store.Scopes.Add(s);
        }
        repeat (payload.Int())
        {
          def s = ContinuationSpace();
          repeat (payload.Int()) s.Names.Add(strings[payload.Int()]);
          s.Path = strings[payload.Int()]; s.File = strings[payload.Int()];
          def alias = strings[payload.Int()]; s.Alias = if (alias.Length > 0) alias else null;
          repeat (payload.Int()) s.Scopes.Add(strings[payload.Int()]);
          s.Body = strings[payload.Int()];
          store.Spaces.Add(s);
        }
      }
      // unknown subsection kinds are skipped: newer writers may add them
    }
    store
  }

  /// The continuation of an image (file contents), or null when it carries none.
  public static FromImage(image : array[byte]) : ContinuationStore
  {
    def data = Nemerle.Platform.ClrCompilerSection.ReadBytes(image);
    if (data == null) null else Read(data)
  }

  /// Loads a stored grammar image so that it shares the given assemblies (the compiler, Nitra) with the caller.
  public static LoadImage(image : array[byte], shared : array[System.Reflection.Assembly], references : array[string]) : System.Reflection.Assembly
  {
    Nemerle.Platform.ClrScriptSupport.Load(image, null, shared, references)
  }

  static WriteInt(s : Stream, value : int) : void
  {
    when (value < 0) throw ArgumentOutOfRangeException("value");
    if (value < 0x80) s.WriteByte(value :> byte)
    else if (value < 0x4000) { s.WriteByte((0x80 | (value >> 8)) :> byte); s.WriteByte((value & 0xFF) :> byte); }
    else if (value < 0x20000000)
    {
      s.WriteByte((0xC0 | (value >> 24)) :> byte); s.WriteByte(((value >> 16) & 0xFF) :> byte);
      s.WriteByte(((value >> 8) & 0xFF) :> byte); s.WriteByte((value & 0xFF) :> byte);
    }
    else throw ArgumentOutOfRangeException("value", "too large for a compressed integer");
  }
  static WriteBlob(s : Stream, bytes : array[byte]) : void { WriteInt(s, bytes.Length); s.Write(bytes, 0, bytes.Length); }
  static WriteString(s : Stream, text : string) : void { WriteBlob(s, UTF8Encoding(false).GetBytes(text ?? "")); }

  sealed class Reader
  {
    data : array[byte];
    mutable pos : int;
    public this(data : array[byte]) { this.data = data; }
    public Byte() : byte
    {
      when (pos >= data.Length) throw InvalidDataException("truncated continuation section");
      def b = data[pos]; ++pos; b
    }
    public Int() : int
    {
      def b = Byte() :> int;
      if ((b & 0x80) == 0) b
      else if ((b & 0xC0) == 0x80) ((b & 0x3F) << 8) | (Byte() :> int)
      else if ((b & 0xE0) == 0xC0) ((b & 0x1F) << 24) | ((Byte() :> int) << 16) | ((Byte() :> int) << 8) | (Byte() :> int)
      else throw InvalidDataException("bad compressed integer")
    }
    public Bytes(n : int) : array[byte]
    {
      when (n < 0 || pos + n > data.Length) throw InvalidDataException("truncated continuation section");
      def result = array(n); Array.Copy(data, pos, result, 0, n); pos += n; result
    }
    public Blob() : array[byte] { Bytes(Int()) }
    public String() : string { UTF8Encoding(false, true).GetString(Blob()) }
  }
}
