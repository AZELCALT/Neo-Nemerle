using System;
using SCG = System.Collections.Generic;
using Nemerle.Collections;
using Nemerle.Compiler.Parsetree;
using Nemerle.Imperative;
using Nemerle.Compiler.AST;
using Nemerle.Compiler.nitra_compilation;
using Nemerle.Compiler.typer;

/// A dialect-owned type token; it need not have a CLR representation yet. `Clr`, when the grammar gives it, is the
/// Nemerle type the token stands for (a scope slot of this type reads as that type).
public sealed class NitraDialectType
{
  public Name : string;
  public mutable Clr : string;
  public mutable Metadata : object;
  public this(name : string) { when(String.IsNullOrEmpty(name)) throw ArgumentException("empty dialect type"); Name=name; }
  public this(name : string, clr : string) { this(name); Clr=clr; }
}
public sealed class NitraDialectSignature
{
  public Name : string;
  public Result : NitraDialectType;
  public Parameters : array[NitraDialectType];
  public mutable Metadata : object;
  public this(name : string, result : NitraDialectType, parameters : array[NitraDialectType])
  { Name=name; Result=result; Parameters=parameters; }
}
public sealed class NitraDialectRequest
{
  public Context : NitraDialectContext;
  public Name : string;
  public Arguments : array[PExpr];
  public IsCall : bool;
  public this(context : NitraDialectContext, name : string, arguments : array[PExpr], isCall : bool)
  { Context=context; Name=name; Arguments=arguments; IsCall=isCall; }
}
public sealed class NitraDialectResolution
{
  public Signatures : SCG.List[NitraDialectSignature] = SCG.List();
  public mutable Metadata : object;
  public mutable Lower : Func[NitraDialectRequest,PExpr];
}
public interface INitraDialectResolver
{
  Resolve(request : NitraDialectRequest) : NitraDialectResolution;
  ResolveType(name : string, context : NitraDialectContext) : NitraDialectType;
}
/// A resolved reference retains its inferred contracts, not a runtime function object.
public sealed class NitraDialectReference
{
  public Dialect : string;
  public Owner : string;
  public Name : string;
  public Resolution : NitraDialectResolution;
  public this(dialect : string, owner : string, name : string, resolution : NitraDialectResolution)
  { Dialect=dialect; Owner=owner; Name=name; Resolution=resolution; }
}
/// A binding of a scope: a storage slot (its value lives in the scope's storage when the program runs, see
/// Nemerle.Scopes.Scope), or a dial reference registered under a name.
public sealed class NitraScopeBinding
{
  public Name : string;
  public Type : NitraDialectType;
  public mutable Location : Location;
  /// A dial reference's target; null for a storage slot.
  public mutable Reference : NitraDialectReference;
  public mutable Metadata : object;
  /// The Nemerle type of a slot (null: not known yet, `object` when nothing gives one).
  public mutable SlotType : string;
  internal mutable Scope : NitraSharedScope;
  /// From a continued binary's layout: registering it again (a plugin appending the same slot) is not a duplicate.
  public mutable Continued : bool;
  public this(name : string, type : NitraDialectType, location : Location)
  { Name=name; Type=type; Location=location; }
  /// A reference's target, or for a slot the code that reads it (for mappings and resolvers).
  public Value : object { get { if(Reference!=null) Reference else Scope.Read(Name) } }
}
/// A scope: a dedicated global storage that the program and its spaces share. Here, at compile time, it is the
/// layout (its slots and their types); the values live in Nemerle.Scopes.Scope when the program runs.
public sealed class NitraSharedScope : NitraSemanticScope
{
  public Name : string;
  bindings : SCG.Dictionary[string,NitraScopeBinding] = SCG.Dictionary();
  internal mutable Registry : NitraDialectRegistry;
  public this(name : string) { Name=name; }
  public Register(name : string, type : NitraDialectType, location : Location) : NitraScopeBinding
  {
    when(String.IsNullOrEmpty(name) || type==null) throw ArgumentException("scope registration requires a name and type");
    if(bindings.ContainsKey(name) && bindings[name].Continued) { def known=bindings[name]; known.Continued=false; known.Location=location; known }
    else
    {
      when(bindings.ContainsKey(name)) throw ArgumentException("duplicate scope binding: scope."+Name+"."+name);
      def binding=NitraScopeBinding(name,type,location); binding.Scope=this; bindings.Add(name,binding); binding
    }
  }
  public Register(name : string, reference : NitraDialectReference, location : Location) : NitraScopeBinding
  {
    when(reference==null) throw ArgumentNullException("reference");
    def binding=Register(name,NitraDialectType("dialect reference"),location);
    binding.Reference=reference; binding.Metadata=reference.Resolution; binding
  }
  public Get(name : string) : NitraScopeBinding
  { unless(bindings.ContainsKey(name)) throw ArgumentException("unknown scope binding: scope."+Name+"."+name); bindings[name] }
  public Contains(name : string) : bool { bindings.ContainsKey(name) }
  /// The Nemerle type of slot `name`, as text: the grammar's (`NitraDialectType.Clr`, from the resolver of a space
  /// that attaches this scope), or the token itself when it names a type, or `object`. Anything fits a slot; the
  /// code that uses it is type-checked as usual.
  public SlotType(name : string) : string { SlotType(name,null) }
  /// With `typer`, a space that attaches this scope and has no resolver yet runs its mapping first (as a dial into
  /// it does), so the grammar can give the type.
  public SlotType(name : string, typer : Typer) : string
  {
    def binding=Get(name);
    if(binding.SlotType!=null) binding.SlotType
    else if(binding.Reference!=null) { binding.SlotType=ReferenceType(binding.Reference,typer); binding.SlotType }
    else
    {
      def token=binding.Type.Name;
      mutable clr=binding.Type.Clr;
      when(clr==null && Registry!=null)
        foreach(space when Array.IndexOf(space.Scopes,Name)>=0 in Registry.AllSpaces)
          when(clr==null)
          {
            when(space.Resolver==null && typer!=null && Registry.PrepareSpace!=null) Registry.PrepareSpace.Invoke(space,typer);
            when(space.Resolver!=null)
            {
              def resolved=try { space.Resolver.ResolveType(token,NitraDialectContext(Registry,space,typer,binding.Location)) } catch { | _ is ArgumentException => null };
              when(resolved!=null) clr=resolved.Clr;
            }
          }
      when(clr==null && NamesType(token)) clr=token;
      // a type the grammar has not given yet may still come once a space is prepared: only a typed answer, or one
      // made with every chance, is kept
      when(clr!=null || typer!=null) binding.SlotType=clr ?? "object";
      clr ?? "object"
    }
  }
  /// The Nemerle types (parameters, then result) of each signature of a dial member whose types the grammar gives.
  public ReferenceForms(reference : NitraDialectReference, typer : Typer) : SCG.List[SCG.List[string]]
  {
    def forms=SCG.List();
    def space=if(Registry!=null) try { Registry.Space(reference.Owner) } catch { | _ is ArgumentException => null } else null;
    def clr(type : NitraDialectType) : string
    {
      if(type==null) null
      else if(type.Clr!=null) type.Clr
      else
      {
        def resolved=if(space!=null && space.Resolver!=null)
                       try { space.Resolver.ResolveType(type.Name,NitraDialectContext(Registry,space,typer,Location.Default)) }
                       catch { | _ is ArgumentException => null }
                     else null;
        if(resolved!=null && resolved.Clr!=null) resolved.Clr else if(NamesType(type.Name)) type.Name else null
      }
    }
    when(reference.Resolution!=null)
      foreach(s in reference.Resolution.Signatures)
      {
        def types=SCG.List.[string](); foreach(p in s.Parameters) types.Add(clr(p)); types.Add(clr(s.Result));
        unless(types.Contains(null)) forms.Add(types);
      }
    forms
  }
  /// A slot holding a dial member is a function value: with one signature whose types the grammar gives, of that
  /// function type, else a Content holding every form.
  ReferenceType(reference : NitraDialectReference, typer : Typer) : string
  {
    def signatures=if(reference.Resolution!=null) reference.Resolution.Signatures else SCG.List();
    def space=if(Registry!=null) try { Registry.Space(reference.Owner) } catch { | _ is ArgumentException => null } else null;
    def clr(type : NitraDialectType) : string
    {
      if(type==null) null
      else if(type.Clr!=null) type.Clr
      else
      {
        def resolved=if(space!=null && space.Resolver!=null)
                       try { space.Resolver.ResolveType(type.Name,NitraDialectContext(Registry,space,typer,Location.Default)) }
                       catch { | _ is ArgumentException => null }
                     else null;
        if(resolved!=null && resolved.Clr!=null) resolved.Clr else if(NamesType(type.Name)) type.Name else null
      }
    }
    if(signatures.Count!=1) "object"
    else
    {
      def s=signatures[0]; def result=clr(s.Result); def types=SCG.List.[string]();
      foreach(p in s.Parameters) types.Add(clr(p));
      if(result==null || types.Contains(null)) "object"
      else "("+(if(types.Count==0) "void" else String.Join(" * ",types.ToArray()))+" -> "+result+")"
    }
  }
  static NamesType(token : string) : bool
  {
    def aliases=["object","string","int","uint","long","ulong","short","ushort","byte","sbyte","char","bool","float","double","decimal"];
    def manager=Nemerle.Compiler.manager_class.ManagerClass.Instance;
    aliases.Contains(token)
    || manager!=null && token.Length>0 && char.IsLetter(token[0]) && !token.Contains(" ")
       && (manager.CoreEnv.LookupType(NList.FromArray(token.Split('.'))).IsSome
           // (a generic type's instance, `shapes.Box[int]': a type expression)
           || token.Contains("[") && manager.CoreEnv.LookupType(NList.FromArray(token.Substring(0, token.IndexOf('[')).Split('.'))).IsSome)
  }
  // every use reaches the one storage that the declaration (`scope A;', Declare) created: access, never a new one
  storage() : PExpr { <[ Nemerle.Scopes.Scope.Access($(Name : string)) ]> }
  static typeExpr(type : string) : PExpr
  { Nemerle.Compiler.main_parser.MainParser.ParseExpr(Nemerle.Compiler.manager_class.ManagerClass.Instance.CoreEnv,type,Location.Default,false) }
  /// The code that appends slot `name` to the storage (with its type's default value).
  public RegisterCode(name : string) : PExpr { RegisterCode(name,null) }
  public RegisterCode(name : string, typer : Typer) : PExpr
  {
    def type=SlotType(name,typer);
    if(type=="object") <[ $(storage()).Register($(name : string), null) ]>
    else <[ $(storage()).Register($(name : string), Nemerle.Scopes.Scope.Default(typeof($(typeExpr(type)))), typeof($(typeExpr(type)))) ]>
  }
  /// The code that reads slot `name`, as its type.
  public Read(name : string) : PExpr { Read(name,null) }
  public Read(name : string, typer : Typer) : PExpr
  {
    _=Get(name); def type=SlotType(name,typer);
    // a slot of no fixed type holds a Content: its value and the type it currently is
    if(type=="object") <[ Nemerle.Scopes.Content.Of($(storage()).Get($(name : string), null)) ]>
    else <[ $(storage()).Read.[$(typeExpr(type))]($(name : string)) ]>
  }
  /// The code that writes `value` into slot `name` (as the slot's type).
  public Write(name : string, value : PExpr) : PExpr { Write(name,value,null) }
  public Write(name : string, value : PExpr, typer : Typer) : PExpr
  {
    _=Get(name); def type=SlotType(name,typer);
    if(type=="object") <[ $(storage()).Set($(name : string), Nemerle.Scopes.Content.Of($value)) ]>
    else <[ $(storage()).Set($(name : string), ($value : $(typeExpr(type)))) ]>
  }
  /// The bindings in registration order (the continuation section stores them).
  public Bindings : SCG.IEnumerable[NitraScopeBinding] { get { bindings.Values } }
  public override Lookup(name : string) : SCG.List[NitraSemanticSymbol]
  {
    def result=SCG.List.[NitraSemanticSymbol]();
    when(bindings.ContainsKey(name))
    { def symbol=NitraSemanticSymbol(); symbol.Name=name; symbol.Kind="shared binding"; symbol.Value=bindings[name]; result.Add(symbol); }
    result
  }
}
public sealed class NitraDialectSpace
{
  public Dialect : string;
  public Owner : string;
  public mutable Location : Location;
  /// The scopes attached to the space (their full names, `file.A`).
  public mutable Scopes : array[string];
  mutable resolver : object;
  public Resolver : INitraDialectResolver
  { get { resolver :> INitraDialectResolver } set { resolver=value; } }
  internal Zone : int;
  /// What the continuation section stores of the space: its grammars, file, `as` name and body.
  public mutable Names : array[string];
  public mutable File : string;
  public mutable Alias : string;
  public mutable Body : string;
  /// Rebuilt from a continued binary's section (it is that binary's space, not this compilation's).
  public mutable Continued : bool;
  public this(dialect : string, owner : string, location : Location, scopes : array[string], zone : int)
  { Dialect=dialect; Owner=owner; Location=location; Scopes=scopes; Zone=zone; }
}
public sealed class NitraDialectRegistry
{
  spaces : SCG.Dictionary[string,NitraDialectSpace] = SCG.Dictionary();
  /// Runs a space's mapping so that it registers its resolver (set by the compilation that owns the spaces).
  public mutable PrepareSpace : Action[NitraDialectSpace,Typer];
  scopes : SCG.Dictionary[string,NitraSharedScope] = SCG.Dictionary();
  public Trace : SCG.List[string] = SCG.List();
  /// A space's path is where it stands: `file` for the file's plain `space { }`, `file.G` for its `space G { }`,
  /// `file.(A,B)` for the mixing `space (A, B) { }` (the order of the grammars does not matter), and `file.Name`
  /// for a second name given with `as Name`. A dial `dial:.path::member` reaches the space at that path.
  public static Canonical(path : string) : string
  {
    def open=path.IndexOf(".(",StringComparison.Ordinal);
    if(open<0 || !path.EndsWith(")",StringComparison.Ordinal)) path
    else
    {
      def names=path.Substring(open+2,path.Length-open-3).Split(',');
      for(mutable i=0;i<names.Length;++i) names[i]=names[i].Trim();
      Array.Sort(names,StringComparer.Ordinal);
      path.Substring(0,open)+".("+String.Join(",",names)+")"
    }
  }
  internal AddSpace(space : NitraDialectSpace) : void { AddPath(space.Owner,space) }
  /// Registers `space` at `path` as well (its `as` name).
  internal AddPath(path : string, space : NitraDialectSpace) : void
  {
    def key=Canonical(path);
    when(spaces.ContainsKey(key)) throw ArgumentException("duplicate space: "+key+"; first registered at "+spaces[key].Location.ToString());
    spaces.Add(key,space); Trace.Add("register "+key+" at "+space.Location.ToString());
  }
  /// The space at `path` (see Canonical).
  public Space(path : string) : NitraDialectSpace
  { def key=Canonical(path); unless(spaces.ContainsKey(key)) throw ArgumentException("unknown space: dial:."+key); spaces[key] }
  public RegisterResolver(path : string, resolver : INitraDialectResolver) : void
  {
    when(resolver==null) throw ArgumentNullException("resolver"); def space=Space(path);
    when(space.Resolver!=null && space.Resolver : object != resolver : object) throw ArgumentException("resolver already registered for "+path);
    space.Resolver=resolver;
  }
  public RegisterScope(name : string) : NitraSharedScope
  {
    unless(scopes.ContainsKey(name)) { def scope=NitraSharedScope(name); scope.Registry=this; scopes.Add(name,scope); }
    scopes[name]
  }
  public Scope(name : string) : NitraSharedScope
  { unless(scopes.ContainsKey(name)) throw ArgumentException("unknown shared scope: "+name); scopes[name] }
  /// Whether scope `name` (its full name, `file.A`) exists.
  public HasScope(name : string) : bool { scopes.ContainsKey(name) }
  /// Every space of the compilation, once each (a mixing space or an `as` name registers one space more than once).
  public AllSpaces : SCG.IEnumerable[NitraDialectSpace]
  {
    get
    {
      def seen=SCG.HashSet.[NitraDialectSpace]();
      foreach(space in spaces.Values) when(seen.Add(space)) yield space;
    }
  }
  /// Every shared scope of the compilation (the continuation section stores them).
  public Scopes : SCG.IEnumerable[NitraSharedScope] { get { scopes.Values } }
}
/// Current is dynamically scoped to a mapping/resolver invocation, not a global registry.
public sealed class NitraDialectContext
{
  [ThreadStatic] internal static mutable Active : NitraDialectContext;
  public static Current : NitraDialectContext
  { get { when(Active==null) throw InvalidOperationException("no active native mapping context"); Active } }
  public Registry : NitraDialectRegistry;
  public Space : NitraDialectSpace;
  public Typer : Typer;
  public mutable Location : Location;
  public this(registry : NitraDialectRegistry, space : NitraDialectSpace, typer : Typer, location : Location)
  { Registry=registry; Space=space; Typer=typer; Location=location; }
  public RegisterResolver(resolver : INitraDialectResolver) : void
  { Registry.RegisterResolver(Space.Owner,resolver); }
  /// An attached scope, by its name as the space attaches it (`A`) or its full name (`file.A`).
  public Scope(name : string) : NitraSharedScope
  {
    def found=SCG.List.[string]();
    foreach(key in Space.Scopes) when(key==name || key.EndsWith("."+name,StringComparison.Ordinal)) found.Add(key);
    when(found.Count==0) throw ArgumentException("scope is not attached to this space: "+name);
    when(found.Count>1) throw ArgumentException("scope "+name+" is ambiguous here: "+String.Join(", ",found.ToArray()));
    Registry.Scope(found[0])
  }
  public Reference(name : string) : NitraDialectReference
  { NitraDialectReference(Space.Dialect,Space.Owner,name,Resolve(name,array[],false)) }
  public ResolveType(name : string) : NitraDialectType
  {
    when(Space.Resolver==null) throw ArgumentException("space has no dialect resolver");
    def type=Space.Resolver.ResolveType(name,this);
    when(type==null) throw ArgumentException("unknown dialect type: "+name); type
  }
  public Resolve(name : string, args : array[PExpr], isCall : bool) : NitraDialectResolution
  {
    when(Space.Resolver==null) throw ArgumentException("space has no dialect resolver: dial:."+Space.Owner);
    Registry.Trace.Add("resolve dial:."+Space.Owner+"::"+name+" at "+this.Location.ToString());
    def answer=Space.Resolver.Resolve(NitraDialectRequest(this,name,args,isCall));
    when(answer==null) throw ArgumentException("unreachable dialect member: "+name);
    answer
  }
}
