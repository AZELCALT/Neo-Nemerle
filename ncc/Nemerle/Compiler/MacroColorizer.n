/** A class responsible for assigning new colors to macro contexts. */
public class MacroColorizator
{
  // The compiling thread's colors. (Fields: prebuilt macros read them; they run on that thread only.)
  public mutable Color : int;
  public mutable UseColor : int;
  public mutable UseContext : GlobalEnv;

  mutable max_macro_color : int;
  mutable colors_stack : list [int * int * GlobalEnv]; // FIXME: use Stack

  /// A thread typing in parallel (-parallel) has colors of its own, from the same counter.
  class WorkerColors
  {
    public Owner : MacroColorizator;
    public mutable Color : int;
    public mutable UseColor : int;
    public mutable UseContext : GlobalEnv;
    public mutable Stack : list [int * int * GlobalEnv] = [];
    public this(owner : MacroColorizator) { Owner = owner; Color = owner.Color; UseColor = owner.UseColor; UseContext = owner.UseContext }
  }
  [System.ThreadStatic] static mutable worker : WorkerColors;
  Worker : WorkerColors { get { def w = worker; if (w != null && w.Owner : object == this) w else null } }

  /// Gives the current thread colors of its own (-parallel's workers), starting from the compiling thread's; false
  /// gives it this colorizer's again.
  public UseWorkerColors(own : bool) : void { worker = if (own) WorkerColors(this) else null }

  /// The colors of the current thread (its own on a worker, else the fields): what the compiler's own code reads.
  public CurrentColor : int
  {
    get { def w = Worker; if (w != null) w.Color else Color }
    set { def w = Worker; if (w != null) w.Color = value else Color = value }
  }
  public CurrentUseColor : int
  {
    get { def w = Worker; if (w != null) w.UseColor else UseColor }
    set { def w = Worker; if (w != null) w.UseColor = value else UseColor = value }
  }
  public CurrentUseContext : GlobalEnv
  {
    get { def w = Worker; if (w != null) w.UseContext else UseContext }
    set { def w = Worker; if (w != null) w.UseContext = value else UseContext = value }
  }
  Stack : list [int * int * GlobalEnv]
  {
    get { def w = Worker; if (w != null) w.Stack else colors_stack }
    set { def w = Worker; if (w != null) w.Stack = value else colors_stack = value }
  }

  public this () 
  { 
    Color = 1;
    UseColor = 1;
    UseContext = null;
    max_macro_color = 1;
    colors_stack = [];
  }
                         
  public NewColor () : int
  {
    System.Threading.Interlocked.Increment(ref max_macro_color)   // (atomically: one counter for all threads)
  }


  public InGlobalColor['a] (fn : void -> 'a) : 'a
  {
    try
    {
      Stack = (CurrentColor, CurrentUseColor, CurrentUseContext) :: Stack;
      CurrentColor = 1;
      CurrentUseColor = 1;
      CurrentUseContext = ManagerClass.Instance.CoreEnv;
      fn()
    }
    finally { PopColor (); }
  }

  public InGlobalColor(fn : void -> void) : void
  {
    try
    {
      Stack = (CurrentColor, CurrentUseColor, CurrentUseContext) :: Stack;
      CurrentColor = 1;
      CurrentUseColor = 1;
      CurrentUseContext = ManagerClass.Instance.CoreEnv;
      fn();
    }
    finally { PopColor(); }
  }
  
  /** Creates new color for execution of macro expansion, stores
      this color as top of the stack, together with [macro_use]
      as context color of currently executed macro.
   */   
  public PushNewColor (use_color : int, use_context : GlobalEnv) : void
  {
    Stack = (CurrentColor, CurrentUseColor, CurrentUseContext) :: Stack;
    CurrentColor = NewColor ();
    CurrentUseColor = use_color;
    CurrentUseContext = use_context;
  }


  public PushUseSiteColor () : void
  {
    Stack = (CurrentColor, CurrentUseColor, CurrentUseContext) :: Stack;
    CurrentColor = CurrentUseColor;
  }
  

  /** Bring color context of previous execution of macro
      (occurs when macro expansion execution finishes).

      Assumes that [PushNewColor] was called before
   */    
  public PopColor () : void
  {
    match (Stack) {
      | (col, use_col, use_ctx) :: rest =>
        Stack = rest;
        CurrentColor = col;
        CurrentUseColor = use_col;
        CurrentUseContext = use_ctx;
      | [] =>
        Nemerle.Compiler.UtilMacros.ice ("pop from empty stack of macro colors...")
    }
  }
}
