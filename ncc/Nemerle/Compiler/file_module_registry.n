using System;
using System.IO;
using System.Text.RegularExpressions;
using Nemerle;
using Nemerle.Utility;
using Nemerle.Collections;
using Nemerle.Imperative;
using Nemerle.Compiler.Parsetree;
using Nemerle.Compiler.AST;
using Nemerle.Compiler.global_env;
using Nemerle.Compiler.manager_class;
using Nemerle.Compiler.namespace_tree;
using Nemerle.Compiler.type_builder;
using Nemerle.Compiler.Utility;
using Nemerle.Compiler.Typedtree;
using Nemerle.Compiler.ClassMembers;
using Nemerle.Compiler.Lexer;
using Nemerle.Compiler.MacroClassGen;
using Nemerle.Compiler.syntax_definition;
using Nemerle.Compiler.typer;
using Nemerle.Compiler.type_info;
using Nemerle.Compiler.expr_walker;
using Nemerle.Compiler.fixed_type;

/// Compilation-local file ownership. Index before parsing ordinary imports.
public sealed class FileModuleRegistry
{
  manager : ManagerClass;
  paths : Hashtable[int, list[string]] = Hashtable();
  owners : Hashtable[string, int] = Hashtable();

  public this(manager : ManagerClass) { this.manager = manager; }

  /// Source root: -source-root, else the project path (its directory when it names a project file), else the
  /// current directory.
  public Root : string
  {
    get
    {
      def options = manager.Options;
      def project = options.ProjectPath;
      def root = if (options.SourceRoot != null) options.SourceRoot
                 else if (project != null && File.Exists(project)) Path.GetDirectoryName(Path.GetFullPath(project))
                 else project ?? System.Environment.CurrentDirectory;
      Path.GetFullPath(root)
    }
  }

  public IndexSources() : void
  {
    paths.Clear(); owners.Clear();
    def root = Root;
    def prefix = root.TrimEnd(array[Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar]) + Path.DirectorySeparatorChar;
    def shortNames = manager.Options.FileNameNamespaces;
    def files = Hashtable.[string, string]();
    foreach (source in manager.Options.Sources)
    {
      def file = Path.GetFullPath(Location.GetFileName(source.FileIndex));
      // Only Nemerle sources (.n, and .ns scripts) are file modules; other parsers (e.g. .nitra) keep their own rules.
      unless (String.Equals(Path.GetExtension(file), ".n", StringComparison.OrdinalIgnoreCase)
              || String.Equals(Path.GetExtension(file), ".ns", StringComparison.OrdinalIgnoreCase)) continue;
      def loc = Location(source.FileIndex, 1, 1);
      unless (shortNames || file.StartsWith(prefix, StringComparison.Ordinal))
      {
        Message.Error(loc, "file module source is outside the source root: " + file + " (root " + root + "; use -source-root)");
        continue;
      }
      def relative = if (shortNames) Path.GetFileNameWithoutExtension(file) else Path.ChangeExtension(file.Substring(prefix.Length), null);
      def parts = NString.Split(relative.Replace(Path.DirectorySeparatorChar, '.'), '.');
      // Splitting dots would silently change a dotted filename into a directory.
      def components = NString.Split(relative, Path.DirectorySeparatorChar);
      unless (components.ForAll(part => Regex.IsMatch(part, "^[A-Za-z_][A-Za-z0-9_]*$")))
      {
        Message.Error(loc, "file module path components must be identifiers: " + relative);
        continue;
      }
      def name = parts.ToString(".");
      when (owners.Contains(name))
      {
        Message.Error(loc, "duplicate file module identity: " + name
          + (if (files.Contains(name)) " (" + files[name] + " and " + file + ")" else ""));
        continue;
      }
      // A module path may not also be a directory of other modules: the file would be a type and the directory a
      // namespace of the same name, which C# and other .NET languages reject (CS0434).
      foreach (existing in owners.Keys)
        when (name.StartsWith(existing + ".", StringComparison.Ordinal)
           || existing.StartsWith(name + ".", StringComparison.Ordinal))
          Message.Error(loc, "file module conflicts with a directory module path: " + name + " and " + existing
            + " (a file may not sit beside a directory of the same name)");
      owners.Add(name, source.FileIndex);
      files.Add(name, file);
      paths.Add(source.FileIndex, parts);
    }
  }

  /// True when the source was indexed as a file module (generated or synthetic sources are not).
  public IsModule(fileIndex : int) : bool { manager.Options.FileModules && paths.Contains(fileIndex) }

  /// The module's full name (`dir.file`).
  public Name(fileIndex : int) : string { String.Join(".", paths[fileIndex].ToArray()) }

  /// Whether the file starts the program: the file `-main:` names, else `main.n` (at the source root), else the
  /// only source file. A library has no start.
  public IsStart(fileIndex : int) : bool
  {
    def options = manager.Options;
    if (options.TargetIsLibrary || options.Script != null) false
    else if (options.MainClass != null) Name(fileIndex) == options.MainClass
    else if (paths.Values.Exists(p => p is ["main"])) paths[fileIndex] is ["main"]
    else paths.Count == 1
  }

  /// Every module's `using`s, in order (the files it imports).
  public Usings : Hashtable[string, list[string]] = Hashtable();
  /// The modules of this compilation with top-level code, and those of continued binaries (from their sections).
  public TopLevel : Hashtable[string, TopLevelRecord] = Hashtable();
  public External : Hashtable[string, TopLevelRecord] = Hashtable();

  /// The top-level state of the modules (`module.name`), and the files a script imports.
  public State : System.Collections.Generic.HashSet[string] = System.Collections.Generic.HashSet();
  /// Per module: the types it exports (global, at the top level).
  public Exports : Hashtable[string, list[string]] = Hashtable();
  /// Per exported name: the module that exports it.
  public ExportedBy : Hashtable[string, string] = Hashtable();
  public ScriptUsings : System.Collections.Generic.List[string] = System.Collections.Generic.List();

  /// Whether `member` may be reached from code in `parent`: a module's top-level state is reached bare only in its
  /// own file, and from another file only as `file.x`, by a file that imports it (`using file;`).
  public StateVisible(member : IMember, parent : TypeBuilder, qualified : bool) : bool
  {
    match (member)
    {
      | field is IField when parent != null && field.DeclaringType != null =>
        def owner = field.DeclaringType.FullName;
        def key = owner + "." + field.Name;
        def isState = State.Contains(key) || External.Contains(owner) && External[owner].State.Contains(field.Name);
        if (!isState) true
        else
        {
          def file = parent.Location.FileIndex;
          def here = if (IsModule(file)) Name(file) else null;
          def imports = if (here != null) (if (Usings.Contains(here)) Usings[here] else []) else ScriptUsings.NToList();
          here == owner || qualified && imports.Contains(owner)
        }
      | _ => true
    }
  }

  /// An exported type is global: its name is one type everywhere. Another type of that name (in any file, mask or
  /// referenced Nemerle binary) contradicts it, and is an error.
  public CheckExportConflicts(declarations : list[TopDeclaration]) : void
  {
    def global = Hashtable.[string, string]();
    foreach (pair in ExportedBy) global[pair.Key] = pair.Value;
    foreach (pair in External)
      foreach (name in pair.Value.Exports)
        if (global.Contains(name) && global[name] != pair.Key)
          foreach (declaration when declaration.Name == name && declaration.Location.FileIndex != 0 in declarations)
            Message.Error(declaration.Location, $"`$name' is already exported by $(pair.Key) (a referenced binary); an exported name is global, so one file exports it")
        else global[name] = pair.Key;
    def visit(members : list[ClassMember], owner : string) : void
    {
      foreach (member in members)
        match (member)
        {
          | ClassMember.TypeDeclaration(td) =>
            when (global.Contains(td.Name))
              Message.Error(td.Location, $"`$(td.Name)' is exported by $(global[td.Name]) as a global type, so no other type can have that name"
                                         + (if (owner != "") " (here in " + owner + ")" else ""));
            match (td) { | TopDeclaration.Class(decls = inner) | TopDeclaration.Variant(decls = inner) => visit(inner, owner) | _ => () }
          | _ => ()
        }
    }
    when (global.Count > 0)
      foreach (declaration in declarations)
        match (declaration)
        {
          | TopDeclaration.Class(decls = members) when IsModule(declaration.Location.FileIndex) => visit(members, Name(declaration.Location.FileIndex))
          | _ => ()
        }
  }

  /// Reports files that import each other while one of them has top-level code: one of them runs while the other
  /// is not set up yet.
  public ReportImportCycles() : void
  {
    def reported = System.Collections.Generic.HashSet.[string]();
    foreach (start in TopLevel.Keys.NToList())
    {
      // a path from `start` back to itself through this compilation's files
      def stack = System.Collections.Generic.List.[string]();
      def visiting = System.Collections.Generic.HashSet.[string]();
      def visit(name : string) : void
      {
        if (name == start && stack.Count > 0)
        {
          def cycle = String.Join(" -> ", stack.ToArray()) + " -> " + start;
          def members = stack.ToArray(); System.Array.Sort(members, System.StringComparer.Ordinal);
          when (reported.Add(String.Join(",", members)))
            Message.Warning(if (TopLevel[start].File != "") Location(Location.GetFileIndex(TopLevel[start].File), 1, 1) else Location.Default,
              $"files import each other ($cycle): one runs its top-level code while the other is not set up yet");
        }
        else when (visiting.Add(name) && Usings.Contains(name))
        {
          stack.Add(name);
          foreach (u in Usings[name]) visit(u);
          stack.RemoveAt(stack.Count - 1);
        }
      }
      visit(start);
    }
  }

  /// The modules whose top-level code a file importing `modules` runs first, in order: each imported module with
  /// top-level code, and through an imported module without any, the modules it imports.
  public Initializers(modules : list[string], self : string) : list[string]
  {
    def result = System.Collections.Generic.List.[string]();
    def seen = System.Collections.Generic.HashSet.[string]();
    def visit(name : string) : void
    {
      when (seen.Add(name) && name != self)
      {
        def record = if (TopLevel.Contains(name)) TopLevel[name] else if (External.Contains(name)) External[name] else null;
        if (record != null && record.Kind == "initializer") result.Add(name)
        else
        {
          def usings = if (record != null) record.Usings else if (Usings.Contains(name)) Usings[name] else [];
          foreach (u in usings) visit(u);
        }
      }
    }
    foreach (name in modules) visit(name);
    result.NToList()
  }

  public ModulePrefix(name : list[string]) : string
  {
    mutable prefix = "";
    mutable found = null;
    foreach (part in name)
    {
      prefix = if (prefix == "") part else prefix + "." + part;
      when (owners.Contains(prefix)) found = prefix;
    }
    found
  }

  public IsDirectory(name : list[string]) : bool
  {
    def prefix = name.ToString(".") + ".";
    ModulePrefix(name) == null && owners.Keys.NToList().Exists(_.StartsWith(prefix, StringComparison.Ordinal))
  }

  public HasClrNamespace(name : list[string]) : bool
  {
    def node = manager.NameTree.NamespaceTree.PassTo(name);
    def containsExternal(current : NamespaceTree.Node) : bool
    {
      when (current == null) return false;
      match (current.Value)
      {
        | NamespaceTree.TypeInfoCache.NotLoaded
        | NamespaceTree.TypeInfoCache.NotLoadedList
        | NamespaceTree.TypeInfoCache.MacroCall => return true;
        | NamespaceTree.TypeInfoCache.Cached(t) when !(t is TypeBuilder) => return true;
        | NamespaceTree.TypeInfoCache.CachedAmbiguous(types) when types.Exists(t => !(t is TypeBuilder)) => return true;
        | _ => ()
      }
      current.Children != null && current.Children.Values.NToList().Exists(containsExternal)
    }
    containsExternal(node)
  }

  /// The environment a file's own members are typed in (the file's, after its `using`s), by file.
  public MemberEnvironments : System.Collections.Generic.Dictionary[int, GlobalEnv] = System.Collections.Generic.Dictionary();

  /// The environment `method` is typed in: its file's, for a member of a file's class, else its type's.
  public MethodEnvironment(method : MethodBuilder) : GlobalEnv
  {
    def type = method.DeclaringType;
    mutable env;
    if (type.DeclaringType == null && MemberEnvironments.TryGetValue(type.Location.FileIndex, out env) && method.Env : object == env) env
    else type.GlobalEnv
  }

  public Environment(fileIndex : int) : GlobalEnv
  {
    // Only the module itself is entered: its directories are not opened, so sibling files are reached by explicit path.
    def core = GlobalEnv(manager.CoreEnv, ["mask"]);
    core.EnterIntoNamespace(manager.NameTree.ExactPath(paths[fileIndex]))
  }

  public Declaration(fileIndex : int, members : list[ClassMember]) : TopDeclaration
  {
    def (directory, filename) = NList.DivideLast(paths[fileIndex]);
    def env = if (directory.IsEmpty) manager.CoreEnv else manager.CoreEnv.EnterIntoNamespace(directory);
    def name = Name.NameInCurrentColor(filename, Location(fileIndex, 1, 1), env);
    // The file is a class: as in C# (CS0542), none of its members may have its name.
    foreach (member when member.Name == filename in members)
      Message.Error(member.Location, $"`$filename' names both the file module and one of its members; a member cannot "
                                     "have the name of its enclosing type (as in C#): rename the file or the member");
    ApplyDefaults(members);
    def declaration = TopDeclaration.Class(Location(fileIndex, 1, 1), Splicable.Name(name),
      AttributesAndModifiers(NemerleModifiers.Public | NemerleModifiers.Static, []),
      Typarms.Empty, [], members);
    foreach (member in members)
    {
      member._definedIn = declaration;
      match (member)
      {
        | ClassMember.TypeDeclaration(td) => td._definedIn = declaration;
        | ClassMember.Property(getter = Some(g), setter = Some(s)) =>
          g._definedIn = declaration; s._definedIn = declaration;
        | ClassMember.Property(getter = Some(g)) => g._definedIn = declaration;
        | ClassMember.Property(setter = Some(s)) => s._definedIn = declaration;
        | _ => ()
      }
    }
    declaration
  }

  public static ApplyDefaults(members : list[ClassMember]) : void
  {
    foreach (member when member.modifiers != null in members)
    {
      // a static constructor (a file's top-level code) takes no access modifier
      def staticConstructor = member is ClassMember.Function && (member.Name == ".ctor" || member.Name == "this" || member.Name == ".cctor")
                              && (member.modifiers.mods & NemerleModifiers.Static) != NemerleModifiers.None;
      when (!staticConstructor && (member.modifiers.mods & NemerleModifiers.AccessModifiers) == NemerleModifiers.None)
        member.modifiers.mods |= NemerleModifiers.Public;
      match (member)
      {
        | ClassMember.TypeDeclaration(td) => td.modifiers.mods = member.modifiers.mods;
        | _ => member.modifiers.mods |= NemerleModifiers.Static;
      }
    }
  }
}

/// A module's top-level code, as the continuation section records it: a fingerprint by which Nemerle binaries know
/// each other's modules. Kind is "initializer" (run by `using`), "start" (the program's Main) or "none".
public sealed class TopLevelRecord
{
  public mutable Module : string = "";
  public mutable Kind : string = "none";
  public mutable File : string = "";
  public mutable Start : int;
  public mutable End : int;
  /// A hash of the top-level code's text.
  public mutable Hash : long;
  public mutable Usings : list[string] = [];
  /// The names of the module's top-level state.
  public mutable State : list[string] = [];
  /// The types the module exports.
  public mutable Exports : list[string] = [];
}

/// `__module_init(self, imports...)` starts a file's top-level code: it runs the top-level code of the files it
/// imports (each module's static constructor, once), in `using` order.
internal sealed class ModuleInitMacro : IMacro
{
  public GetName() : string { "__module_init" }
  public GetNamespace() : string { "Nemerle.Compiler" }
  public IsInherited : bool { get { false } }
  public IsTailRecursionTransparent : bool { get { false } }
  public Keywords : list[string] { get { [] } }
  public Usage : MacroUsageAttribute { get { null } }
  public Location : Location { get { Location.Default } }
  public SyntaxExtension() : GrammarElement * (list[SyntaxElement] -> list[SyntaxElement]) { (null, null) }
  public CallTransform(args : list[PExpr]) : list[SyntaxElement] { args.Map(e => SyntaxElement.Expression(e) : SyntaxElement) }
  public Run(ctx : Typer, args : list[SyntaxElement]) : PExpr
  {
    def names = args.Map(fun (a) { | SyntaxElement.Expression(PExpr.Literal(Literal.String(s))) => s | _ => "" });
    match (names)
    {
      | self :: imports =>
        def calls = ctx.Manager.FileModuleRegistry.Initializers(imports, self).Map(name =>
        {
          def type = Nemerle.Compiler.main_parser.MainParser.ParseExpr(ctx.Env, name);
          <[ System.Runtime.CompilerServices.RuntimeHelpers.RunClassConstructor(typeof($type).TypeHandle) ]>
        });
        if (calls.IsEmpty) <[ () ]> else <[ { ..$calls } ]>
      | [] => <[ () ]>
    }
  }

  /// Registers the top-level code macros once per compiler instance.
  public static Register(manager : ManagerClass) : void
  {
    def ns = manager.NameTree.ExactPath(["Nemerle", "Compiler"]);
    when (ns.LookupMacro(["__module_init"]).IsNone) manager.MacrosRegistry.RegisterMacro(ModuleInitMacro());
    when (ns.LookupMacro(["__module_binding_value"]).IsNone) manager.MacrosRegistry.RegisterMacro(ModuleBindingMacro());
    foreach (macroName in ["__state_hole", "__state_type", "__state_bind", "__state_store", "__state_read"])
      when (ns.LookupMacro([macroName]).IsNone) manager.MacrosRegistry.RegisterMacro(StateMacro(macroName));
  }

  /// A fingerprint of top-level code (FNV-1a of its text), recorded in the continuation section.
  public static Fingerprint(statements : System.Collections.Generic.IEnumerable[PExpr]) : long
  {
    mutable hash = 0xcbf29ce484222325UL;
    foreach (statement in statements)
      foreach (c in statement.ToString()) { hash = unchecked((hash ^ (c :> ulong)) * 0x100000001b3UL); }
    unchecked(hash :> long)
  }
}

/// `__module_binding_value("module.name")`: the top-level code's assignment of a binding. Its initializer is typed here,
/// in the flow of the top-level code, which gives the field its type before the assignment is typed.
internal sealed class ModuleBindingMacro : IMacro
{
  public GetName() : string { "__module_binding_value" }
  public GetNamespace() : string { "Nemerle.Compiler" }
  public IsInherited : bool { get { false } }
  public IsTailRecursionTransparent : bool { get { false } }
  public Keywords : list[string] { get { [] } }
  public Usage : MacroUsageAttribute { get { null } }
  public Location : Location { get { Location.Default } }
  public SyntaxExtension() : GrammarElement * (list[SyntaxElement] -> list[SyntaxElement]) { (null, null) }
  public CallTransform(args : list[PExpr]) : list[SyntaxElement] { args.Map(e => SyntaxElement.Expression(e) : SyntaxElement) }
  public Run(ctx : Typer, args : list[SyntaxElement]) : PExpr
  {
    match (args)
    {
      | [SyntaxElement.Expression(PExpr.Literal(Literal.String(key)))] =>
        def name = key.Substring(key.LastIndexOf('.') + 1);
        foreach (field is FieldBuilder in ctx.CurrentType.LookupMember(name)) field.InferScriptType(ctx);
        <[ _N_skip_write_check($(name : dyn)) = $(ctx.Manager.ModuleTypedBindings[key] : typed) ]>
      | _ => Nemerle.Compiler.MessageMacros.FatalError("Invalid internal top-level binding"); null
    }
  }
}

/// The top-level state macros. In the inference copy of the top-level code, `__state_hole()` is a value of open type
/// and `__state_type(key, k, x)` records the type of a value's k-th binding. In the top-level code itself,
/// `__state_bind(key, k, field, value)` writes a binding to the storage and `__state_store(key, field, local)` writes a
/// rebound value's local to it (the storage is a Content when its type changes).
internal sealed class StateMacro : IMacro
{
  name : string;
  public this(name : string) { this.name = name; }
  public GetName() : string { name }
  public GetNamespace() : string { "Nemerle.Compiler" }
  public IsInherited : bool { get { false } }
  public IsTailRecursionTransparent : bool { get { false } }
  public Keywords : list[string] { get { [] } }
  public Usage : MacroUsageAttribute { get { null } }
  public Location : Location { get { Location.Default } }
  public SyntaxExtension() : GrammarElement * (list[SyntaxElement] -> list[SyntaxElement]) { (null, null) }
  public CallTransform(args : list[PExpr]) : list[SyntaxElement] { args.Map(e => SyntaxElement.Expression(e) : SyntaxElement) }
  public Run(ctx : Typer, args : list[SyntaxElement]) : PExpr
  {
    def manager = ctx.Manager;
    def exprs = args.Map(fun (a) { | SyntaxElement.Expression(e) => e | _ => null });
    def storage(key : string) : string { if (manager.StateStorage.ContainsKey(key)) manager.StateStorage[key] else null }
    def fieldOf(key : string) : FieldBuilder
    {
      def short = key.Substring(key.LastIndexOf('.') + 1);
      mutable found = null;
      foreach (f is FieldBuilder in ctx.CurrentType.LookupMember(short)) found = f;
      found
    }
    // a read of a top-level value by its name is the value unless a local of that name is in scope there: a
    // parameter, a lambda's parameter or a local of the function (the local of the top-level binding itself, in the
    // top-level code, is the value)
    def shadowing(key : string) : PExpr
    {
      def short = key.Substring(key.LastIndexOf('.') + 1);
      def method = ctx.CurrentMethodBuilder;
      def topLevelCode = method != null && (method.Name == "Main" || method.Name == ".cctor");
      def header = if (method != null) method.GetHeader() else null;
      mutable found = null;
      foreach ((n, v) in ctx.CurrentLocalContext.GetLocals())
        when (found == null && n.Id == short && !(topLevelCode && v.DefinedIn : object == header)) found = v;
      if (found == null) null else <[ $(TExpr.LocalRef(found.Type, found) : typed) ]>
    }
    match (name, exprs)
    {
      | ("__state_read", PExpr.Literal(Literal.String(key)) :: _) when shadowing(key) != null => shadowing(key)
      | ("__state_hole", []) =>
        <[ $(TExpr.DefaultValue(ctx.FreshTypeVar()) : typed) ]>
      | ("__state_type", [PExpr.Literal(Literal.String(key)), PExpr.Literal(Literal.Integer(k, _, _)), value]) =>
        def typed = ctx.TypeExpr(value);
        unless (manager.StateTypes.ContainsKey(key)) manager.StateTypes[key] = System.Collections.Generic.Dictionary();
        manager.StateTypes[key][k :> int] = typed.Type;
        <[ () ]>
      | ("__state_bind", [PExpr.Literal(Literal.String(key)), PExpr.Literal(Literal.Integer(k, _, _)), field, value]) =>
        match (storage(key))
        {
          | "content" => <[ _N_skip_write_check($field) = Nemerle.Scopes.Content.Of($value) ]>
          | "typed" => <[ _N_skip_write_check($field) = $value ]>
          | _ when k == 1UL && manager.ModuleBindings.ContainsKey(key) =>
            // the inference pass could not settle the type: the first initializer gives it
            match (fieldOf(key)) { | null => () | f => f.InferScriptType(ctx) }
            <[ _N_skip_write_check($field) = $(manager.ModuleTypedBindings[key] : typed) ]>
          | _ => <[ _N_skip_write_check($field) = $value ]>
        }
      | ("__state_read", [PExpr.Literal(Literal.String(key)), field, PExpr.Literal(Literal.Bool(true))]) =>
        // a member of the value is used: the read is of the value's final type
        match (storage(key))
        {
          | "content" when manager.StateTypes.ContainsKey(key) =>
            def types = System.Collections.Generic.List.[FixedType]();
            foreach (pair in manager.StateTypes[key]) types.Add(pair.Value.Fix());
            <[ $field.As.[$(PExpr.TypedType(types[types.Count - 1]))]() ]>
          | _ => field
        }
      | ("__state_read", [PExpr.Literal(Literal.String(key)), field]) =>
        match (storage(key))
        {
          | "content" =>
            // the type the read needs is inferred from its use, and checked once everything is typed; a use that
            // takes any object gets the Content itself (Read), with its type
            def needed = ctx.FreshTypeVar();
            manager.StateReads.Add((key, needed, field.Location));
            <[ $field.Read.[$(PExpr.TypedType(needed))]() ]>
          | _ => field
        }
      | ("__state_store", [PExpr.Literal(Literal.String(key)), field, local]) =>
        match (storage(key))
        {
          | "content" => <[ _N_skip_write_check($field) = Nemerle.Scopes.Content.Of($local) ]>
          | _ => <[ _N_skip_write_check($field) = $local ]>
        }
      | _ => Nemerle.Compiler.MessageMacros.FatalError("Invalid internal top-level state macro"); null
    }
  }

  /// An imported file's top-level code runs in its type initializer, which holds the type's lock until it ends.
  /// Starting a thread or task there is warned; when the started work uses the file and the top-level code waits
  /// for it (Parallel always waits), it can never finish: an error. The calls are the resolved ones, whatever the
  /// spelling.
  /// What a typed method touches, for the thread check's proof across files: the file modules it refers to (their
  /// classes' full names) and the methods of this compilation it calls. Recorded while each method is typed (its
  /// typed body is gone once it is emitted).
  public static Summarize(typer : Typer, body : TExpr) : void
  {
    def manager = typer.Manager;
    def method = typer.CurrentMethodBuilder;
    when (method != null)
    {
      def (files, callees) = Touches(manager, [body]);
      manager.MethodFiles[method] = files;
      manager.MethodCallees[method] = callees;
    }
  }

  /// The file module a type belongs to (the outermost file class around it), or null.
  static FileOf(manager : ManagerClass, t : TypeInfo) : string
  {
    mutable at = t;
    while (at != null && at.DeclaringType != null) at = at.DeclaringType;
    if (at != null && manager.FileModuleRegistry.Usings.Contains(at.FullName)) at.FullName else null
  }

  static Touches(manager : ManagerClass, exprs : list[TExpr]) : System.Collections.Generic.HashSet[string] * System.Collections.Generic.HashSet[IMethod]
  {
    def files = System.Collections.Generic.HashSet();
    def callees = System.Collections.Generic.HashSet();
    def member(m : IMember) : void
    {
      when (m != null && m.DeclaringType != null)
      {
        match (FileOf(manager, m.DeclaringType)) { | null => () | f => _ = files.Add(f) }
        match (m) { | b is MethodBuilder => _ = callees.Add(b) | _ => () }
      }
    }
    foreach (e in exprs)
      ExprWalker().Walk(e, info =>
        match (info.Node)
        {
          | TExpr.StaticRef(_, m, _) => member(m)
          | TExpr.MethodRef(_, m, _, _) => member(m)
          | TExpr.FieldMember(_, f) => member(f)
          | TExpr.PropertyMember(_, p) => member(p)
          | TExpr.StaticPropertyRef(_, p) => member(p)
          | _ => ()
        });
    (files, callees)
  }

  /// Threads started in an imported file's top-level code (its static constructor, which holds the type's lock):
  /// each start is recorded with what its work touches, and whether the top-level code waits for that very task (or
  /// thread); the verdict is given once every method is typed (FinishThreads), when the calls the work makes can be
  /// followed into other files.
  public static CheckThreads(typer : Typer, body : TExpr) : void
  {
    def manager = typer.Manager;
    def home = typer.CurrentTypeBuilder;
    def threading(owner : string) : bool
    {
      owner == "System.Threading.Thread" || owner == "System.Threading.ThreadPool" || owner == "System.Threading.Timer"
      || owner.StartsWith("System.Threading.Tasks.", System.StringComparison.Ordinal)
    }
    def waiting(name : string) : bool { ["Wait", "WaitAll", "WaitAny", "Join", "get_Result", "GetResult", "RunSynchronously"].Contains(name) }
    // the method a call resolves to (an overloaded call is a resolved delayed typing)
    def callee(f : TExpr) : IMethod
    {
      | TExpr.StaticRef(_, m is IMethod, _) => m
      | TExpr.MethodRef(_, m, _, _) => m
      | TExpr.Delayed(susp) when susp.IsResolved => callee(susp.ResolutionResult)
      | _ => null
    }
    def receiver(f : TExpr) : TExpr
    {
      | TExpr.MethodRef(obj, _, _, _) => obj
      | TExpr.Delayed(susp) when susp.IsResolved => receiver(susp.ResolutionResult)
      | _ => null
    }
    def strip(e : TExpr) : TExpr
    {
      | TExpr.DebugInfo(inner, _) => strip(inner)
      | TExpr.TypeConversion(inner, _, _, _) => strip(inner)
      | TExpr.MacroEnvelope(_, _, inner, _) => strip(inner)
      | _ => e
    }
    def starts = System.Collections.Generic.List.[ManagerClass.ThreadStart]();
    def startOf = System.Collections.Generic.Dictionary.[object, ManagerClass.ThreadStart](); // a start, by its call node
    def boundTo = System.Collections.Generic.Dictionary.[object, TExpr]();                 // a local, by the value bound to it
    def isStart(owner : string, name : string) : bool
    {
      threading(owner) && !waiting(name) && name != "GetAwaiter" && name != "Start" && name != "ConfigureAwait"
      && !name.StartsWith("get_", System.StringComparison.Ordinal)
    }
    // the start a waited-on expression is: a local that holds one, a start call itself, or one reached through
    // GetAwaiter / ConfigureAwait
    def started(e : TExpr) : ManagerClass.ThreadStart
    {
      match (strip(e))
      {
        | TExpr.LocalRef(decl) => mutable v; if (boundTo.TryGetValue(decl, out v)) started(v) else null
        // a top-level value is the file's state: a field written by its binding
        | TExpr.StaticRef(_, field is IField, _) => mutable v; if (boundTo.TryGetValue(field, out v)) started(v) else null
        | TExpr.Call(f, _, _) as call =>
          mutable s;
          if (startOf.TryGetValue(call, out s)) s
          else match (callee(f)) { | m when m != null && (m.Name == "GetAwaiter" || m.Name == "ConfigureAwait") => started(receiver(f)) | _ => null }
        | _ => null
      }
    }
    mutable untraced = false; // a wait whose task is not one started here
    def wait(on : TExpr) : void
    {
      match (started(on)) { | null => untraced = true | s => s.Waited = true }
    }
    def visit(node : object) : void
    {
      match (node)
      {
        | TExpr.Call(func, parms, _) as call =>
          def meth = callee(func);
          when (meth != null && meth.DeclaringType != null)
          {
            def owner = meth.DeclaringType.FullName;
            if (owner == "System.Threading.Thread" && meth.Name == "Start") ()      // the thread's work came with its constructor
            else if ((threading(owner) || owner == "System.Runtime.CompilerServices.TaskAwaiter") && waiting(meth.Name))
            {
              // Task.WaitAll(a, b) / WaitAny: its arguments; t.Wait(), th.Join(), awaiter.GetResult(): its receiver
              if (meth.Name == "WaitAll" || meth.Name == "WaitAny")
                foreach (p in parms)
                  match (strip(p.expr))
                  {
                    | TExpr.Array(items, _) => foreach (i in items) wait(i)
                    | other => wait(other)
                  }
              else wait(receiver(func))
            }
            else when (isStart(owner, meth.Name))
            {
              def (files, callees) = Touches(manager, parms.Map(p => p.expr));
              def s = ManagerClass.ThreadStart(call.Location, meth.DeclaringType.Name + "." + (if (meth.Name == ".ctor") "new" else meth.Name),
                                               owner == "System.Threading.Tasks.Parallel", home.FullName, files, callees);
              starts.Add(s); startOf[call] = s;
            }
          }
        | TExpr.DefValIn(local, value, _) => boundTo[local] = value
        | TExpr.Assign(target, value) =>
          match (strip(target))
          {
            | TExpr.LocalRef(decl) => boundTo[decl] = value
            | TExpr.StaticRef(_, field is IField, _) => boundTo[field] = value
            | _ => ()
          }
        | TExpr.PropertyMember(obj, p) when p.Name == "Result" && p.DeclaringType != null && threading(p.DeclaringType.FullName) => wait(obj)
        | _ => ()
      }
    }
    // in source order: a start before the wait on it, its local bound in between
    ExprWalker().Walk(body, info => visit(info.Node));
    foreach (s in starts) { s.UntracedWait = untraced; manager.ThreadStarts.Add(s) }
  }

  /// The verdict on the threads of every imported file's top-level code, once every method is typed: work that uses
  /// the file (directly, or through calls into other files that reach it) while the top-level code waits for that
  /// very work can never run, an error; any other start is a warning.
  public static FinishThreads(manager : ManagerClass) : void
  {
    def reaches(start : ManagerClass.ThreadStart) : bool
    {
      if (start.Files.Contains(start.Home)) true
      else
      {
        def seen = System.Collections.Generic.HashSet.[IMethod]();
        def queue = System.Collections.Generic.Queue.[IMethod](start.Callees);
        mutable found = false;
        while (!found && queue.Count > 0)
        {
          def m = queue.Dequeue();
          when (seen.Add(m))
          {
            mutable files; mutable callees;
            when (manager.MethodFiles.TryGetValue(m, out files) && files.Contains(start.Home)) found = true;
            when (manager.MethodCallees.TryGetValue(m, out callees)) foreach (c in callees) queue.Enqueue(c);
          }
        }
        found
      }
    }
    foreach (s in manager.ThreadStarts)
      if (reaches(s) && (s.ImplicitWait || s.Waited))
        Message.Error(s.At, $"$(s.What) runs work that uses this file while its top-level code waits for it; that code holds "
                                  "the file's type initializer lock, so the work can never run: move it out of the top-level code")
      else
        Message.Warning(s.At, $"$(s.What) in the top-level code of an imported file: that code runs in the file's type initializer, "
                                    "so work that calls into the file waits until the top-level code ends");
    manager.ThreadStarts.Clear();
  }

  /// A top-level value that changes type is a Content; code that needs one of its earlier types depends on what is
  /// no longer there, so the type change is an error (where the type changes) naming that code.
  public static CheckReads(manager : ManagerClass) : void
  {
    foreach ((key, needed, at) in manager.StateReads)
      when (manager.StateStorage.ContainsKey(key) && manager.StateStorage[key] == "content" && manager.StateTypes.ContainsKey(key))
      {
        def types = System.Collections.Generic.List.[FixedType]();
        foreach (pair in manager.StateTypes[key]) types.Add(pair.Value.Fix());
        def final = types[types.Count - 1];
        def wanted = needed.Fix();
        unless (wanted.Equals(final) || wanted.Equals(manager.InternalType.Object))
        {
          // where the type changes away from the one this code needs
          mutable change = 1;
          for (mutable i = 1; i < types.Count; i++) when (!types[i].Equals(types[i - 1]) && types[i - 1].Equals(wanted)) change = i;
          def name = key.Substring(key.LastIndexOf('.') + 1);
          def lines = if (manager.StateLines.ContainsKey(key)) manager.StateLines[key] else System.Collections.Generic.List();
          def place = if (change < lines.Count) lines[change] else at;
          Message.Error(place, $"`$name' changes type here (from $(types[change - 1]) to $(types[change])), but line $(at.Line) uses it as $wanted");
        }
      }
  }
}
