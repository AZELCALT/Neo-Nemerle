using System;
using System.IO;
using System.Text.RegularExpressions;
using Nemerle;
using Nemerle.Utility;
using Nemerle.Collections;
using Nemerle.Imperative;
using Nemerle.Compiler.Parsetree;
using Nemerle.Compiler.AST;
using Nemerle.Compiler.global_env;
using Nemerle.Compiler.manager_class;
using Nemerle.Compiler.namespace_tree;
using Nemerle.Compiler.type_builder;
using Nemerle.Compiler.Utility;
using Nemerle.Compiler.Typedtree;
using Nemerle.Compiler.SolverMacros;
using Nemerle.Compiler.ClassMembers;
using Nemerle.Compiler.Lexer;
using Nemerle.Compiler.MacroClassGen;
using Nemerle.Compiler.syntax_definition;
using Nemerle.Compiler.typer;
using Nemerle.Compiler.type_info;
using Nemerle.Compiler.expr_walker;
using Nemerle.Compiler.fixed_type;
using Nemerle.Compiler.Source;

/// Compilation-local file ownership. Index before parsing ordinary imports.
public sealed class FileModuleRegistry
{
  manager : ManagerClass;
  paths : Hashtable[int, list[string]] = Hashtable();
  owners : Hashtable[string, int] = Hashtable();
  mutable standaloneStart : int;

  public this(manager : ManagerClass) { this.manager = manager; }

  public IsScriptSource(fileIndex : int) : bool
  {
    manager.Options.Script != null && !manager.Options.Sources.IsEmpty
      && manager.Options.Sources.Head.FileIndex == fileIndex
  }

  /// Discover only named imports, starting beside each importing file. The queue also handles transitive imports.
  public DiscoverSources() : void
  {
    when (manager.Options.Script == null && manager.Options.Sources.Length == 1 && !manager.Options.TargetIsLibrary)
      standaloneStart = manager.Options.Sources.Head.FileIndex;
    def sources = System.Collections.Generic.List.[ISource]();
    sources.AddRange(manager.Options.Sources);
    def selected = System.Collections.Generic.HashSet.[string](StringComparer.Ordinal);
    foreach (source in sources) _ = selected.Add(Path.GetFullPath(Location.GetFileName(source.FileIndex)));
    def directories = Hashtable.[string, list[ISource]]();
    def registrations = Hashtable.[int, list[string]]();
    def registration(source : ISource) : list[string]
    {
      unless (registrations.Contains(source.FileIndex)) registrations[source.FileIndex] = RegisteredFolder(source, false);
      registrations[source.FileIndex]
    }
    def candidates(directory : string) : list[ISource]
    {
      unless (directories.Contains(directory))
      {
        mutable found = [];
        when (Directory.Exists(directory))
        {
          def files = Directory.GetFiles(directory, "*.n");
          System.Array.Sort(files, StringComparer.Ordinal);
          foreach (file in files)
            found ::= FileSource(file, false, false) : ISource;
        }
        directories[directory] = found.Rev();
      }
      directories[directory]
    }
    for (mutable i = 0; i < sources.Count; i++)
    {
      def source = sources[i];
      def extension = Path.GetExtension(Location.GetFileName(source.FileIndex));
      unless (extension.Equals(".n", StringComparison.OrdinalIgnoreCase) || extension.Equals(".ns", StringComparison.OrdinalIgnoreCase)) continue;
      def here = Path.GetDirectoryName(Path.GetFullPath(Location.GetFileName(source.FileIndex)));
      foreach (name in SourceUsings(source))
      {
        def relative = name.ToString(Path.DirectorySeparatorChar.ToString());
        def search = if (here == Root) [here] else [here, Root];
        mutable imported = false;
        foreach (directory in search)
        {
          when (imported) break;
          def target = Path.Combine(directory, relative);
          def direct = target + ".n";
          def external = manager.NameTree != null && HasClrNamespace(name);
          def choices = if (external) []
                        else if (File.Exists(direct)) [FileSource(direct, false, false) : ISource]
                        else if (Directory.Exists(target) && !external) candidates(target)
                        else candidates(directory).Filter(candidate =>
                        {
                          def folder = registration(candidate);
                          !folder.IsEmpty && (folder == name
                            || folder + [Path.GetFileNameWithoutExtension(Location.GetFileName(candidate.FileIndex))] == name)
                        });
          foreach (candidate in choices)
          {
            imported = true;
            def path = Path.GetFullPath(Location.GetFileName(candidate.FileIndex));
            when (selected.Add(path)) sources.Add(candidate);
          }
        }
      }
    }
    manager.Options.Sources = NList.FromArray(sources.ToArray());
  }

  SourceUsings(source : ISource) : list[list[string]]
  {
    def lexer = LexerString(manager, source.GetText(), Location(source.FileIndex, 1, 1));
    lexer.Keywords = LexerBase.BaseKeywords;
    def read() : Token
    {
      try { lexer.GetToken() } catch { | _ is LexerBase.PragmaIndent => read() }
    }
    mutable imports = [];
    mutable depth = 0;
    mutable ended = false;
    while (!ended)
    {
      match (read())
      {
        | Token.EndOfFile => ended = true;
        | Token.BeginBrace | Token.BeginRound | Token.BeginSquare | Token.BeginQuote => depth++;
        | Token.EndBrace | Token.EndRound | Token.EndSquare | Token.EndQuote => depth--;
        | Token.Keyword("using") when depth == 0 =>
          mutable name = [];
          mutable done = false;
          while (!done)
            match (read())
            {
              | Token.Identifier(part) => name ::= part;
              | Token.Operator("=") => name = [];
              | Token.Operator(".") | Token.WhiteSpace | Token.NewLine | Token.Comment => ();
              | Token.EndOfFile => ended = true; done = true;
              | _ => done = true;
            }
          unless (name.IsEmpty) imports ::= name.Rev();
        | _ => ();
      }
    }
    imports.Rev()
  }

  public ResolveUsing(name : list[string], loc : Location) : list[string]
  {
    when (loc.FileIndex == 0) return name;
    def directory = Path.GetDirectoryName(Path.GetFullPath(loc.File));
    def target = Path.Combine(directory, name.ToString(Path.DirectorySeparatorChar.ToString()));
    foreach (pair in paths)
    {
      def physical = Path.GetFullPath(Location.GetFileName(pair.Key));
      def modulePath = pair.Value;
      // A registration replaces the physical identity; local lookup must not create a second name for it.
      def defaultName = Path.ChangeExtension(Path.GetRelativePath(Root, physical), null).Replace(Path.DirectorySeparatorChar, '.');
      when (modulePath.ToString(".") == defaultName && physical == target + ".n") return modulePath;
    }
    def relative = Path.GetRelativePath(Root, target);
    def folder = NString.Split(relative.Replace(Path.DirectorySeparatorChar, '.'), '.');
    if (IsDirectory(folder)) folder else name
  }

  /// A registration is the first directive and names the logical folder of the entire file.
  /// Use the lexer rather than matching source text: comments, strings and conditionals keep their normal meaning.
  public RegisteredFolder(source : ISource, reportErrors : bool = true) : list[string]
  {
    def lexer = LexerString(manager, source.GetText(), Location(source.FileIndex, 1, 1));
    lexer.Keywords = LexerBase.BaseKeywords;
    def read() : Token
    {
      try { lexer.GetToken() }
      catch { | _ is LexerBase.PragmaIndent => read() }
    }
    def next() : Token
    {
      mutable token = read();
      while (token is Token.WhiteSpace || token is Token.NewLine || token is Token.Comment || token is Token.Indent)
        token = read();
      token
    }
    unless (next() is Token.Identifier("register")) return [];
    mutable parts = [];
    mutable wantName = true;
    mutable finished = false;
    while (!finished)
    {
      def token = next();
      match (token)
      {
        | Token.Identifier(name) when wantName => parts ::= name; wantName = false;
        | Token.Operator(".") when !wantName => wantName = true;
        | Token.Semicolon when !wantName => finished = true;
        | _ =>
          when (reportErrors) Message.Error(token.Location, "register requires a dotted logical folder followed by `;'; it applies to the whole file, without a block");
          return [];
      }
    }
    parts.Rev()
  }

  /// Immediate files only; opening a folder never opens the members inside those files.
  public FolderModules(folder : list[string], loc : Location) : list[string]
  {
    def prefix = folder.ToString(".") + ".";
    def names = System.Collections.Generic.SortedSet.[string](StringComparer.Ordinal);
    foreach (name in owners.Keys.NToList() + External.Keys.NToList())
      when (name.StartsWith(prefix, StringComparison.Ordinal) && name.IndexOf('.', prefix.Length) < 0)
        _ = names.Add(name);
    NList.FromArray(System.Linq.Enumerable.ToArray(names))
  }

  /// Source root: -source-root, else the project path (its directory when it names a project file), else the
  /// current directory.
  public Root : string
  {
    get
    {
      def options = manager.Options;
      def project = options.ProjectPath;
      def root = if (options.SourceRoot != null) options.SourceRoot
                 else if (project != null && File.Exists(project)) Path.GetDirectoryName(Path.GetFullPath(project))
                 else project ?? System.Environment.CurrentDirectory;
      Path.GetFullPath(root)
    }
  }

  public IndexSources() : void
  {
    paths.Clear(); owners.Clear();
    def root = Root;
    def prefix = root.TrimEnd(array[Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar]) + Path.DirectorySeparatorChar;
    def shortNames = manager.Options.FileNameNamespaces;
    def files = Hashtable.[string, string]();
    foreach (source in manager.Options.Sources)
    {
      when (IsScriptSource(source.FileIndex)) continue;
      def file = Path.GetFullPath(Location.GetFileName(source.FileIndex));
      // Only Nemerle sources (.n, and .ns scripts) are file modules; other parsers (e.g. .nitra) keep their own rules.
      unless (String.Equals(Path.GetExtension(file), ".n", StringComparison.OrdinalIgnoreCase)
              || String.Equals(Path.GetExtension(file), ".ns", StringComparison.OrdinalIgnoreCase)) continue;
      def loc = Location(source.FileIndex, 1, 1);
      unless (shortNames || file.StartsWith(prefix, StringComparison.Ordinal))
      {
        Message.Error(loc, "file module source is outside the source root: " + file + " (root " + root + "; use -source-root)");
        continue;
      }
      def relative = if (shortNames) Path.GetFileNameWithoutExtension(file) else Path.ChangeExtension(file.Substring(prefix.Length), null);
      def registered = RegisteredFolder(source);
      def parts = if (registered.IsEmpty) NString.Split(relative.Replace(Path.DirectorySeparatorChar, '.'), '.')
                  else registered + [Path.GetFileNameWithoutExtension(file)];
      // Splitting dots would silently change a dotted filename into a directory.
      def components = if (registered.IsEmpty) NString.Split(relative, Path.DirectorySeparatorChar) else parts;
      unless (components.ForAll(part => Regex.IsMatch(part, "^[A-Za-z_][A-Za-z0-9_]*$")))
      {
        Message.Error(loc, "file module path components must be identifiers: " + relative);
        continue;
      }
      def name = parts.ToString(".");
      when (owners.Contains(name))
      {
        Message.Error(loc, "duplicate file module identity: " + name
          + (if (files.Contains(name)) " (" + files[name] + " and " + file + ")" else ""));
        continue;
      }
      // A module path may not also be a directory of other modules: the file would be a type and the directory a
      // namespace of the same name, which C# and other .NET languages reject (CS0434).
      foreach (existing in owners.Keys)
        when (name.StartsWith(existing + ".", StringComparison.Ordinal)
           || existing.StartsWith(name + ".", StringComparison.Ordinal))
          Message.Error(loc, "file module conflicts with a directory module path: " + name + " and " + existing
            + " (a file may not sit beside a directory of the same name)");
      owners.Add(name, source.FileIndex);
      files.Add(name, file);
      paths.Add(source.FileIndex, parts);
    }
    // Project `main` settings and -main:file identify a physical source; emission needs its registered CLR name.
    when (manager.Options.MainClass != null)
      foreach (fileIndex in paths.Keys)
        when (Path.ChangeExtension(Path.GetRelativePath(root, Location.GetFileName(fileIndex)), null)
                .Replace(Path.DirectorySeparatorChar, '.') == manager.Options.MainClass)
        {
          manager.Options.MainClass = Name(fileIndex);
          break;
        }
  }

  /// True when the source was indexed as a file module (generated or synthetic sources are not).
  public IsModule(fileIndex : int) : bool { manager.Options.FileModules && paths.Contains(fileIndex) }

  /// The module's full name (`dir.file`).
  public Name(fileIndex : int) : string { String.Join(".", paths[fileIndex].ToArray()) }

  /// Whether the file starts the program: the file `-main:` names, else `main.n` (at the source root), else the
  /// only source file. A library has no start.
  public IsStart(fileIndex : int) : bool
  {
    def options = manager.Options;
    if (options.TargetIsLibrary || options.Script != null) false
    else if (options.MainClass != null) Name(fileIndex) == options.MainClass
      || Path.ChangeExtension(Path.GetRelativePath(Root, Location.GetFileName(fileIndex)), null).Replace(Path.DirectorySeparatorChar, '.') == options.MainClass
    else if (standaloneStart != 0) fileIndex == standaloneStart
    else if (paths.Keys.NToList().Exists(i => Path.GetFullPath(Location.GetFileName(i)) == Path.Combine(Root, "main.n")))
      Path.GetFullPath(Location.GetFileName(fileIndex)) == Path.Combine(Root, "main.n")
    else paths.Count == 1
  }

  /// Every module's `using`s, in order (the files it imports).
  public Usings : Hashtable[string, list[string]] = Hashtable();
  /// The modules of this compilation with top-level code, and those of continued binaries (from their sections).
  public TopLevel : Hashtable[string, TopLevelRecord] = Hashtable();
  /// Each file's top-level code (by module name), as parsed.
  public Code : Hashtable[string, TopLevelCode] = Hashtable();
  /// The modules whose top-level code is async (it waits, or runs an async module's first).
  public Async : System.Collections.Generic.HashSet[string] = System.Collections.Generic.HashSet();
  /// The async modules whose public state the saved assembly reaches through properties that wait for their
  /// top-level code (TypesManager.SaveAssembly, ClrEmission.GuardStateField).
  public GuardedModules : System.Collections.Generic.List[string] = System.Collections.Generic.List();
  public External : Hashtable[string, TopLevelRecord] = Hashtable();

  /// The top-level state of the modules (`module.name`), and the files a script imports.
  public State : System.Collections.Generic.HashSet[string] = System.Collections.Generic.HashSet();
  /// Per module: the types it exports (global, at the top level).
  public Exports : Hashtable[string, list[string]] = Hashtable();
  /// The untyped top-level `mutable's (`module.name'): their type follows the flow; the top-level code has each as a
  /// local, and its nested code (lambdas) checks one of several types before using it, as the file's functions do.
  public Flowing : System.Collections.Generic.HashSet[string] = System.Collections.Generic.HashSet();

  /// A file whose module is a referenced binary's (the same file, see ManagerClass.SharedModules): not one of this
  /// compilation's modules, which uses the binary's.
  public Forget(fileIndex : int) : void
  {
    when (paths.Contains(fileIndex))
    {
      def name = Name(fileIndex);
      paths.Remove(fileIndex);
      when (owners.Contains(name) && owners[name] == fileIndex) owners.Remove(name)
    }
  }
  /// Per exported name: the module that exports it.
  public ExportedBy : Hashtable[string, string] = Hashtable();
  /// The `extend T { ... }' blocks of the files, with the module of each: parts of the global type `T', added to it
  /// once every file is parsed (AddExtensions).
  public Extensions : System.Collections.Generic.List[TopDeclaration * string] = System.Collections.Generic.List();
  /// Whether a function of this compilation returns one of several types (MethodBuilder.ResultTypes): its calls are
  /// then looked for in uses (Typer.FlowResultCall).
  public mutable SeveralResults : bool;
  /// How many times code met a function whose result is not decided yet (MethodBuilder.GetMemType): a file's
  /// inference copy that does is inferred again once those functions are typed.
  public mutable UndecidedResults : int;
  /// The inference copies' locals for top-level values bound to the result of such a function (Typer.FlowUndecided),
  /// and the values: each holds one of the types the function gives, in a Content (DecideModuleState).
  public UndecidedLocals : System.Collections.Generic.HashSet[string] = System.Collections.Generic.HashSet();
  public UndecidedStates : System.Collections.Generic.HashSet[string] = System.Collections.Generic.HashSet();
  /// Those locals, once the function is typed: the types its result can be (the value's types, recorded for it).
  public LocalSets : System.Collections.Generic.Dictionary[string, list[Nemerle.Compiler.type_var.TypeVar]] = System.Collections.Generic.Dictionary();
  /// The extension slots of the exported classes (SlotPart), added with the extensions.
  public Slots : System.Collections.Generic.List[TopDeclaration] = System.Collections.Generic.List();

  /// An exported class's extension slot, as a part of it (Nemerle.Extend.IExtensible): what an `extend' compiled after
  /// the type adds to an object lives there. Null for a type that has none: a struct (a copy would not keep it), a
  /// module, an interface, or a compilation without the runtime that defines the slot.
  public SlotPart(td : TopDeclaration) : TopDeclaration
  {
    def slotted = match (td)
      {
        | TopDeclaration.Class as c => !(c.modifiers.mods %&& (NemerleModifiers.Struct | NemerleModifiers.Static))
        | TopDeclaration.Variant => true
        | _ => false
      };
    if (!slotted || manager.CoreEnv.LookupType(["Nemerle", "Extend", "IExtensible"]).IsNone) null
    else
    {
      def part = match (<[ decl:
        partial class Slot : Nemerle.Extend.IExtensible
        {
          private mutable _N_extensions : object;
          private _N_ExtensionSlot : object implements Nemerle.Extend.IExtensible.ExtensionSlot
          {
            get { _N_extensions }
            set { _N_extensions = value }
          }
        } ]>) { | ClassMember.TypeDeclaration(td = d) => d | _ => null };
      part.name = td.name;
      part.typarms = td.typarms;
      part
    }
  }

  /// Whether `part' is one an `extend' adds.
  public IsExtension(part : TopDeclaration) : bool { Extensions.Exists((d, _) => d : object == part) }

  /// The parts `extend' adds, joined to their types (`add', the type tree's scan of a declaration) after every file's
  /// own: a type is built from its export first, then what each extension adds, and checked whole.
  public AddExtensions(add : TopDeclaration -> void) : void
  {
    foreach (slot in Slots) add(slot);
    foreach ((part, owner) in Extensions)
      if (ExportedBy.Contains(part.Name)) add(part)
      else
        match (manager.CoreEnv.LookupType([part.Name]))
        {
          // a type compiled already (a host's, which a script extends): its extension slot holds what this adds
          | Some(ti) when !(ti is TypeBuilder) =>
            match (manager.CoreEnv.LookupType(["Nemerle", "Extend", "IExtensible"]))
            {
              | Some(slot) when ti.IsDerivedFrom(slot) => match (LateExtension(part, ti, owner)) { | null => () | block => add(block) }
              | _ =>
                Message.Error(part.Location, $"`extend $(part.Name)': `$(ti.FullName)' is compiled without an extension slot (an exported class has one, compiled with this version)")
            }
          | _ =>
            Message.Error(part.Location, $"`extend $(part.Name)': no type `$(part.Name)' is exported; `extend' adds to a global type (`export class $(part.Name)' in its file)")
        }
  }

  /// What `extend' adds to a type compiled already, by the type's full name and the member's name: the extension
  /// block that holds it (the typer reads `x.member' as the block's, see Typer.LateExtension).
  public LateMembers : Hashtable[string, Hashtable[string, string]] = Hashtable();

  /// The extension block of an `extend' of the compiled `target': a class with the fields, properties and methods it
  /// adds, whose `this' is the object it is attached to (`_N_self'), and, so they can be named as in the type, the
  /// type's own public instance members forwarded to it. Null after an error.
  LateExtension(part : TopDeclaration, target : TypeInfo, owner : string) : TopDeclaration
  {
    def self = <[ $("_N_self" : dyn) ]>;
    def targetType = PExpr.TypedType(FixedType.Class(target, []));
    def members = match (part) { | TopDeclaration.Class(decls = decls) => decls | _ => [] };
    mutable ok = true;
    def error(loc : Location, message : string) : void { Message.Error(loc, message); ok = false }
    when (target.TyparmsCount > 0) error(part.Location, $"`extend $(part.Name)': a generic type compiled already is extended where it is compiled");
    match (part) { | TopDeclaration.Class(t_extends = _ :: _) => error(part.Location, $"`extend $(part.Name)': an interface is added where `$(part.Name)' is compiled; an extension of a compiled type adds members") | _ => () }
    def own = Hashtable();
    foreach (member in members)
    {
      when (member is ClassMember.TypeDeclaration || member.modifiers.mods %&& NemerleModifiers.Static || member.Name == ".ctor" || member.Name == "this")
        error(member.Location, $"`extend $(part.Name)': an extension of a compiled type adds instance fields, properties and methods");
      unless (target.LookupMember(member.Name).IsEmpty)
        error(member.Location, $"`$(part.Name)' has `$(member.Name)' already");
      own[member.Name] = member;
    }
    if (!ok) null
    else
    {
      // (`this' in what it adds is the object)
      def rebind(f : ClassMember.Function) : void
      {
        match (f.body)
        {
          | FunBody.Parsed(body) =>
            f.body = FunBody.Parsed(Nemerle.Compiler.macros.Macros.TraverseExpr(None(), body, false, (_, after, e) => if (after && e is PExpr.This) self else e))
          | _ => ()
        }
      }
      foreach (member in members)
        match (member)
        {
          | ClassMember.Function as f => rebind(f)
          | ClassMember.Property(getter = getter, setter = setter) =>
            when (getter is Some(g)) rebind(g);
            when (setter is Some(s)) rebind(s)
          | _ => ()
        }
      // (the type's own members, by their names as in it)
      def forwarded = System.Collections.Generic.List();
      foreach (m in target.GetMembers(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance))
        // (what every object has, `ToString', `Equals', is the block's own as well: not forwarded)
        when (!own.Contains(m.Name) && m.DeclaringType != null && !m.Name.StartsWith("_N_")
              && !["ToString", "Equals", "GetHashCode", "GetType", "Finalize", "MemberwiseClone"].Contains(m.Name))
          match (m)
          {
            | f is IField =>
              def ty = PExpr.TypedType(f.GetMemType());
              forwarded.Add(if (f.IsMutable) <[ decl: public $(m.Name : dyn) : $ty { get { $self.$(m.Name : dyn) } set { $self.$(m.Name : dyn) = value } } ]>
                            else <[ decl: public $(m.Name : dyn) : $ty { get { $self.$(m.Name : dyn) } } ]>)
            | p is IProperty when !p.IsIndexer && p.GetGetter() != null =>
              def ty = PExpr.TypedType(p.GetMemType());
              forwarded.Add(if (p.GetSetter() != null) <[ decl: public $(m.Name : dyn) : $ty { get { $self.$(m.Name : dyn) } set { $self.$(m.Name : dyn) = value } } ]>
                            else <[ decl: public $(m.Name : dyn) : $ty { get { $self.$(m.Name : dyn) } } ]>)
            | meth is IMethod when !meth.IsConstructor && meth.Header.TypeParameters.IsEmpty && !["get_", "set_", "add_", "remove_", "op_"].Exists(meth.Name.StartsWith)
                                   && meth.GetParameters().ForAll(x => x.Kind == ParmKind.Normal) =>
              def parameters = meth.GetParameters().Map(x => <[ parameter: $(x.Name : dyn) : $(PExpr.TypedType(x.Type)) ]>);
              def arguments = meth.GetParameters().Map(x => <[ $(x.Name : dyn) ]>);
              forwarded.Add(<[ decl: public $(m.Name : dyn) (..$parameters) : $(PExpr.TypedType(meth.ReturnType)) { $self.$(m.Name : dyn) (..$arguments) } ]>)
            | _ => ()
          }
      def blockName = "_N_" + part.Name + "_extension_" + owner.Replace('.', '_');
      def all = <[ decl: private mutable $("_N_self" : dyn) : $targetType; ]>
                :: <[ decl: public Attach(owner : object) : void { $self = owner :> $targetType } ]>
                :: members + forwarded.NToList();
      def block = match (<[ decl: public sealed class Block : Nemerle.Extend.IExtension { ..$all } ]>) { | ClassMember.TypeDeclaration(td = d) => d | _ => null };
      block.name = Splicable.Name(Name.NameInCurrentColor(blockName, part.Location, manager.CoreEnv));
      unless (LateMembers.Contains(target.FullName)) LateMembers[target.FullName] = Hashtable();
      foreach (member in members) LateMembers[target.FullName][member.Name] = blockName;
      block
    }
  }

  /// The extension block holding what an `extend' of this compilation adds to the compiled type `type' by `name'
  /// (null when none does).
  public LateBlock(type : string, name : string) : string
  {
    if (LateMembers.Contains(type) && LateMembers[type].Contains(name)) LateMembers[type][name] else null
  }
  public ScriptUsings : System.Collections.Generic.List[string] = System.Collections.Generic.List();

  /// Whether `member` may be reached from code in `parent`: a module's top-level state is reached bare only in its
  /// own file, and from another file only as `file.x`, by a file that imports it (`using file;`).
  public StateVisible(member : IMember, parent : TypeBuilder, qualified : bool) : bool
  {
    match (member)
    {
      | field is IField when parent != null && field.DeclaringType != null =>
        def owner = field.DeclaringType.FullName;
        def key = owner + "." + field.Name;
        def isState = State.Contains(key) || External.Contains(owner) && External[owner].State.Contains(field.Name);
        if (!isState) true
        else
        {
          def file = parent.Location.FileIndex;
          def here = if (IsModule(file)) Name(file) else null;
          def imports = if (here != null) (if (Usings.Contains(here)) Usings[here] else []) else ScriptUsings.NToList();
          here == owner || qualified && imports.Contains(owner)
        }
      | _ => true
    }
  }

  /// An exported type is global: its name is one type everywhere. Another type of that name (in any file, mask or
  /// referenced Nemerle binary) contradicts it, and is an error.
  public CheckExportConflicts(declarations : list[TopDeclaration]) : void
  {
    def global = Hashtable.[string, string]();
    foreach (pair in ExportedBy) global[pair.Key] = pair.Value;
    foreach (pair in External)
      foreach (name in pair.Value.Exports)
        if (global.Contains(name) && global[name] != pair.Key)
          foreach (declaration when declaration.Name == name && declaration.Location.FileIndex != 0 in declarations)
            Message.Error(declaration.Location, $"`$name' is already exported by $(pair.Key) (a referenced binary); an exported name is global, so one file exports it")
        else global[name] = pair.Key;
    def visit(members : list[ClassMember], owner : string) : void
    {
      foreach (member in members)
        match (member)
        {
          | ClassMember.TypeDeclaration(td) =>
            when (global.Contains(td.Name))
              Message.Error(td.Location, $"`$(td.Name)' is exported by $(global[td.Name]) as a global type, so no other type can have that name"
                                         + (if (owner != "") " (here in " + owner + ")" else ""));
            match (td) { | TopDeclaration.Class(decls = inner) | TopDeclaration.Variant(decls = inner) => visit(inner, owner) | _ => () }
          | _ => ()
        }
    }
    when (global.Count > 0)
      foreach (declaration in declarations)
        match (declaration)
        {
          | TopDeclaration.Class(decls = members) when IsModule(declaration.Location.FileIndex) => visit(members, Name(declaration.Location.FileIndex))
          | _ => ()
        }
  }

  /// Reports files that import each other while one of them has top-level code: one of them runs while the other
  /// is not set up yet.
  public ReportImportCycles() : void
  {
    def reported = System.Collections.Generic.HashSet.[string]();
    foreach (start in TopLevel.Keys.NToList())
    {
      // a path from `start` back to itself through this compilation's files
      def stack = System.Collections.Generic.List.[string]();
      def visiting = System.Collections.Generic.HashSet.[string]();
      def visit(name : string) : void
      {
        if (name == start && stack.Count > 0)
        {
          def cycle = String.Join(" -> ", stack.ToArray()) + " -> " + start;
          def members = stack.ToArray(); System.Array.Sort(members, System.StringComparer.Ordinal);
          when (reported.Add(String.Join(",", members)))
            Message.Warning(if (TopLevel[start].File != "") Location(Location.GetFileIndex(TopLevel[start].File), 1, 1) else Location.Default,
              $"files import each other ($cycle): one runs its top-level code while the other is not set up yet");
        }
        else when (visiting.Add(name) && Usings.Contains(name))
        {
          stack.Add(name);
          foreach (u in Usings[name]) visit(u);
          stack.RemoveAt(stack.Count - 1);
        }
      }
      visit(start);
    }
  }

  /// The modules whose top-level code a file importing `modules` runs first, in order: each imported module with
  /// top-level code, and through an imported module without any, the modules it imports.
  public Initializers(modules : list[string], self : string) : list[string]
  {
    def result = System.Collections.Generic.List.[string]();
    def seen = System.Collections.Generic.HashSet.[string]();
    def visit(name : string) : void
    {
      when (seen.Add(name) && name != self)
      {
        def record = if (TopLevel.Contains(name)) TopLevel[name] else if (External.Contains(name)) External[name] else null;
        if (record != null && (record.Kind == "initializer" || record.Kind == "async-initializer")) result.Add(name)
        else
        {
          def usings = if (record != null) record.Usings else if (Usings.Contains(name)) Usings[name] else [];
          foreach (u in usings) visit(u);
        }
      }
    }
    foreach (name in modules) visit(name);
    result.NToList()
  }

  /// Whether `method' runs a file's top-level code: the static constructor, the start file's Main, or an async file's
  /// top-level function (the iterator its body is in, see MakeAsyncFiles).
  public static IsTopLevelCode(method : MethodBuilder) : bool
  {
    method != null && (method.Name == ".cctor" || method.Name == "Main" || method.Name == "_N_state_flow"
                       || method.Name.StartsWith("_N_async_") && method.Name.Contains("_N_top_level"))
  }

  /// Whether `e' has an `await' (as the parser writes it), outside a lambda.
  public static HasAwait(e : PExpr) : bool
  {
    mutable found = false;
    mutable lambdas = 0;   // (an async lambda's `await' is its own)
    _ = Nemerle.Compiler.macros.Macros.TraverseExpr(None(), e, false, (_, after, node) =>
      {
        match (node)
        {
          | PExpr.Call(PExpr.Member(_, name), [_]) when name.ToString() == "__async_lambda" => lambdas += if (after) -1 else 1
          | PExpr.Call(PExpr.Member(_, name), [_]) when !after && lambdas == 0 && (name.ToString() == "__await" || name.ToString() == "__await_each") => found = true
          | _ => ()
        }
        node
      });
    found
  }

  /// Async files: a file whose top-level code waits (has an `await'), or runs an async file's top-level code first
  /// (imports it), has its top-level code in an async function. The start file's Main waits for it; another file's
  /// runs once, the first time a file importing it asks (`__module_init', which awaits it), and the file's state is
  /// ready when it ends. Run after the files are scanned, when what each file imports is known.
  public MakeAsyncFiles() : void
  {
    // a module imported from a library is async when its record says so
    def isAsync(name : string) : bool
    {
      Async.Contains(name) || External.Contains(name) && External[name].Kind == "async-initializer"
    }
    foreach (pair in Code) when (pair.Value.Awaits) _ = Async.Add(pair.Key);
    mutable changed = true;
    while (changed)
    {
      changed = false;
      foreach (pair in Code)
        when (!Async.Contains(pair.Key) && Initializers(if (Usings.Contains(pair.Key)) Usings[pair.Key] else [], pair.Key).Exists(isAsync))
        {
          _ = Async.Add(pair.Key);
          changed = true;
        }
    }
    foreach (name in Async)
    {
      def code = Code[name];
      def type = manager.NameTree.LookupInternalType(NList.FromArray(name.Split('.'))) :> TypeBuilder;
      def body = code.Body;
      def task = <[ System.Threading.Tasks.Task ]>;
      // (at the code's place: a method without one has no document in the debug information; a program's main file
      // records none, its code's statements have theirs)
      def place = if (code.Location.FileIndex != 0) code.Location
                  else match (body) { | first :: _ when first.Location.FileIndex != 0 => first.Location + body.Last.Location | _ => code.Location };
      def define(decl : ClassMember) : void { decl.Location = place; type.Define(decl) }
      // the code as it would be without waiting, never run: typed first, as a file's Main and static constructor are
      // (in import order), it gives the file's state its types before the fields are made (the async function's
      // code is typed later, in its state machine)
      if (code.WithArgs) define(<[ decl: private static _N_state_flow(args : array[string]) : void { _ = args; ..$body } ]>)
      else define(<[ decl: private static _N_state_flow() : void { ..$body } ]>);
      if (code.Start)
      {
        // Main waits for the program's top-level code (what it throws comes out as it is, not wrapped)
        if (code.WithArgs)
        {
          define(<[ decl: [Nemerle.AsyncMacros.AsyncFunction] private static _N_top_level(args : array[string]) : $task { _ = args; ..$body } ]>);
          code.Runner.body = FunBody.Parsed(Nemerle.Compiler.UtilMacros.locate(code.Location, <[ _N_top_level(args).GetAwaiter().GetResult() ]>));
        }
        else
        {
          define(<[ decl: [Nemerle.AsyncMacros.AsyncFunction] private static _N_top_level() : $task { ..$body } ]>);
          code.Runner.body = FunBody.Parsed(Nemerle.Compiler.UtilMacros.locate(code.Location, <[ _N_top_level().GetAwaiter().GetResult() ]>));
        }
      }
      else
      {
        // (it says when it has ended, and the code it runs, which goes on in what it starts, knows it is its own: see below)
        define(<[ decl: [Nemerle.AsyncMacros.AsyncFunction] private static _N_top_level() : $task
                  {
                    _N_initializing.Value = true;
                    ..$body;
                    _N_state_ready = true
                  } ]>);
        define(<[ decl: private static mutable _N_top_level_run : System.Lazy[$task]; ]>);
        define(<[ decl: private static mutable _N_initializing : System.Threading.AsyncLocal[bool]; ]>);
        define(<[ decl: private static mutable _N_state_ready : bool; ]>);
        define(<[ decl: public static _N_top_level_ready() : $task { _N_top_level_run.Value } ]>);
        // (what the properties of its public state call first)
        define(<[ decl: private static _N_state_wait() : void
                  {
                    unless (_N_state_ready || _N_initializing.Value) _N_top_level_ready().GetAwaiter().GetResult()
                  } ]>);
        GuardedModules.Add(name);
        code.Runner.body = FunBody.Parsed(Nemerle.Compiler.UtilMacros.locate(code.Location,
          <[ _N_initializing = System.Threading.AsyncLocal(); _N_top_level_run = System.Lazy(() => _N_top_level()) ]>));
        // a function of the file called before its top-level code has ended (by reflection, from C#, from a file that
        // does not import it) waits for it, as a type's members wait for its type initializer: an async one awaits
        // it, another blocks until it has ended (and throws what it threw); the code's own calls do not wait
        foreach (f is ClassMember.Function in type.GetParsedMembers(true))
          when (!f.Name.StartsWith("_N_") && f : object != code.Runner && f.Name != ".ctor" && f.Name != ".cctor"
                && (f.modifiers.mods & NemerleModifiers.Private) == NemerleModifiers.None && f.Body != null)
          {
            def async = f.modifiers.custom_attrs.Exists(a => a.ToString().Contains("AsyncFunction"));
            def wait = if (async) <[ Nemerle.AsyncMacros.__await(_N_top_level_ready()) ]>
                       else <[ _N_top_level_ready().GetAwaiter().GetResult() ]>;
            def guard = Nemerle.Compiler.UtilMacros.locate(f.Body.Location.AsGenerated(),
              <[ unless (_N_state_ready || _N_initializing.Value) $wait ]>);
            f.Body = PExpr.Sequence(f.Body.Location, [guard, f.Body])
          }
        when (TopLevel.Contains(name)) TopLevel[name].Kind = "async-initializer";
      }
    }
  }

  public ModulePrefix(name : list[string]) : string
  {
    mutable prefix = "";
    mutable found = null;
    foreach (part in name)
    {
      prefix = if (prefix == "") part else prefix + "." + part;
      when (owners.Contains(prefix)) found = prefix;
    }
    found
  }

  public IsDirectory(name : list[string]) : bool
  {
    def prefix = name.ToString(".") + ".";
    ModulePrefix(name) == null && (owners.Keys.NToList() + External.Keys.NToList()).Exists(_.StartsWith(prefix, StringComparison.Ordinal))
  }

  public HasClrNamespace(name : list[string]) : bool
  {
    def node = manager.NameTree.NamespaceTree.PassTo(name);
    def containsExternal(current : NamespaceTree.Node) : bool
    {
      when (current == null) return false;
      match (current.Value)
      {
        | NamespaceTree.TypeInfoCache.NotLoaded
        | NamespaceTree.TypeInfoCache.NotLoadedList
        | NamespaceTree.TypeInfoCache.MacroCall => return true;
        | NamespaceTree.TypeInfoCache.Cached(t) when !(t is TypeBuilder) => return true;
        | NamespaceTree.TypeInfoCache.CachedAmbiguous(types) when types.Exists(t => !(t is TypeBuilder)) => return true;
        | _ => ()
      }
      current.Children != null && current.Children.Values.NToList().Exists(containsExternal)
    }
    containsExternal(node)
  }

  /// The environment a file's own members are typed in (the file's, after its `using`s), by file.
  public MemberEnvironments : System.Collections.Generic.Dictionary[int, GlobalEnv] = System.Collections.Generic.Dictionary();

  /// The environment `method` is typed in: its file's, for a member of a file's class, else its type's.
  public MethodEnvironment(method : MethodBuilder) : GlobalEnv
  {
    def type = method.DeclaringType;
    mutable env;
    if (type.DeclaringType == null && MemberEnvironments.TryGetValue(type.Location.FileIndex, out env) && method.Env : object == env) env
    else type.GlobalEnv
  }

  public Environment(fileIndex : int) : GlobalEnv
  {
    // Only the module itself is entered: its directories are not opened, so sibling files are reached by explicit path.
    def core = GlobalEnv(manager.CoreEnv, ["mask"]);
    core.EnterIntoNamespace(manager.NameTree.ExactPath(paths[fileIndex]))
  }

  public Declaration(fileIndex : int, members : list[ClassMember]) : TopDeclaration
  {
    def (directory, filename) = NList.DivideLast(paths[fileIndex]);
    def env = if (directory.IsEmpty) manager.CoreEnv else manager.CoreEnv.EnterIntoNamespace(directory);
    def name = Name.NameInCurrentColor(filename, Location(fileIndex, 1, 1), env);
    // The file is a class: as in C# (CS0542), none of its members may have its name.
    foreach (member when member.Name == filename in members)
      Message.Error(member.Location, $"`$filename' names both the file module and one of its members; a member cannot "
                                     "have the name of its enclosing type (as in C#): rename the file or the member");
    ApplyDefaults(members);
    def declaration = TopDeclaration.Class(Location(fileIndex, 1, 1), Splicable.Name(name),
      AttributesAndModifiers(NemerleModifiers.Public | NemerleModifiers.Static, []),
      Typarms.Empty, [], members);
    foreach (member in members)
    {
      member._definedIn = declaration;
      match (member)
      {
        | ClassMember.TypeDeclaration(td) => td._definedIn = declaration;
        | ClassMember.Property(getter = Some(g), setter = Some(s)) =>
          g._definedIn = declaration; s._definedIn = declaration;
        | ClassMember.Property(getter = Some(g)) => g._definedIn = declaration;
        | ClassMember.Property(setter = Some(s)) => s._definedIn = declaration;
        | _ => ()
      }
    }
    declaration
  }

  public static ApplyDefaults(members : list[ClassMember]) : void
  {
    foreach (member when member.modifiers != null in members)
    {
      // a static constructor (a file's top-level code) takes no access modifier
      def staticConstructor = member is ClassMember.Function && (member.Name == ".ctor" || member.Name == "this" || member.Name == ".cctor")
                              && (member.modifiers.mods & NemerleModifiers.Static) != NemerleModifiers.None;
      when (!staticConstructor && (member.modifiers.mods & NemerleModifiers.AccessModifiers) == NemerleModifiers.None)
        member.modifiers.mods |= NemerleModifiers.Public;
      match (member)
      {
        | ClassMember.TypeDeclaration(td) => td.modifiers.mods = member.modifiers.mods;
        | _ => member.modifiers.mods |= NemerleModifiers.Static;
      }
    }
  }
}

/// A module's top-level code, as the continuation section records it: a fingerprint by which Nemerle binaries know
/// each other's modules. Kind is "initializer" (run by `using`), "start" (the program's Main) or "none".
/// A file's top-level code as the parser made it: the member that runs it (Main or the static constructor) and its
/// body, which MakeAsyncFiles moves into an async function when the file is async.
public sealed class TopLevelCode
{
  public mutable Runner : ClassMember.Function;
  public mutable Body : list[PExpr];
  public mutable Location : Location;
  public mutable Start : bool;
  public mutable WithArgs : bool;
  /// Whether the code itself has an `await'.
  public mutable Awaits : bool;
}

public sealed class TopLevelRecord
{
  public mutable Module : string = "";
  public mutable Kind : string = "none";
  public mutable File : string = "";
  public mutable Start : int;
  public mutable End : int;
  /// A hash of the top-level code's text.
  public mutable Hash : long;
  public mutable Usings : list[string] = [];
  /// The names of the module's top-level state.
  public mutable State : list[string] = [];
  /// The types the module exports.
  public mutable Exports : list[string] = [];
}

/// `__module_init(self, imports...)` starts a file's top-level code: it runs the top-level code of the files it
/// imports (each module's static constructor, once), in `using` order.
internal sealed class ModuleInitMacro : IMacro
{
  public GetName() : string { "__module_init" }
  public GetNamespace() : string { "Nemerle.Compiler" }
  public IsInherited : bool { get { false } }
  public IsTailRecursionTransparent : bool { get { false } }
  public Keywords : list[string] { get { [] } }
  public Usage : MacroUsageAttribute { get { null } }
  public Location : Location { get { Location.Default } }
  public SyntaxExtension() : GrammarElement * (list[SyntaxElement] -> list[SyntaxElement]) { (null, null) }
  public CallTransform(args : list[PExpr]) : list[SyntaxElement] { args.Map(e => SyntaxElement.Expression(e) : SyntaxElement) }
  public Run(ctx : Typer, args : list[SyntaxElement]) : PExpr
  {
    def names = args.Map(fun (a) { | SyntaxElement.Expression(PExpr.Literal(Literal.String(s))) => s | _ => "" });
    match (names)
    {
      | self :: imports =>
        def calls = ctx.Manager.FileModuleRegistry.Initializers(imports, self).Map(name =>
        {
          def type = Nemerle.Compiler.main_parser.MainParser.ParseExpr(ctx.Env, name);
          def registry = ctx.Manager.FileModuleRegistry;
          if (registry.Async.Contains(name) || registry.External.Contains(name) && registry.External[name].Kind == "async-initializer")
          {
            def script = ctx.Manager.Options.Script;
            // A synchronous script constructor can import a waiting module too. Its host already waits for
            // construction; imported source modules still use the normal async-file lowering.
            if (script != null && ctx.CurrentType.FullName == script.TypeName && !script.Waits)
              <[ $type._N_top_level_ready().GetAwaiter().GetResult() ]>
            else <[ Nemerle.AsyncMacros.__await($type._N_top_level_ready()) ]>
          }
          else
            <[ System.Runtime.CompilerServices.RuntimeHelpers.RunClassConstructor(typeof($type).TypeHandle) ]>
        });
        if (calls.IsEmpty) <[ () ]> else <[ { ..$calls } ]>
      | [] => <[ () ]>
    }
  }

  /// Registers the top-level code macros once per compiler instance.
  public static Register(manager : ManagerClass) : void
  {
    def ns = manager.NameTree.ExactPath(["Nemerle", "Compiler"]);
    when (ns.LookupMacro(["__module_init"]).IsNone) manager.MacrosRegistry.RegisterMacro(ModuleInitMacro());
    when (ns.LookupMacro(["__module_binding_value"]).IsNone) manager.MacrosRegistry.RegisterMacro(ModuleBindingMacro());
    foreach (macroName in ["__state_hole", "__state_type", "__state_bind", "__state_store", "__state_read", "__state_subject", "__state_reload"])
      when (ns.LookupMacro([macroName]).IsNone) manager.MacrosRegistry.RegisterMacro(StateMacro(macroName));
  }

  /// A fingerprint of top-level code (FNV-1a of its text), recorded in the continuation section.
  public static Fingerprint(statements : System.Collections.Generic.IEnumerable[PExpr]) : long
  {
    mutable hash = 0xcbf29ce484222325UL;
    foreach (statement in statements)
      foreach (c in statement.ToString()) { hash = unchecked((hash ^ (c :> ulong)) * 0x100000001b3UL); }
    unchecked(hash :> long)
  }
}

/// `__function_result(e, point)`: a return point of a function written without its result's type
/// (MethodBuilder.InferredResult), numbered: its value typed once, compiled once the body's return points are typed as
/// the one type they give, or a Content holding one of them when they differ.
internal sealed class FunctionResultMacro : IMacro
{
  public GetName() : string { "__function_result" }
  public GetNamespace() : string { "Nemerle.Compiler" }
  public IsInherited : bool { get { false } }
  public IsTailRecursionTransparent : bool { get { false } }
  public Keywords : list[string] { get { [] } }
  public Usage : MacroUsageAttribute { get { null } }
  public Location : Location { get { Location.Default } }
  public SyntaxExtension() : GrammarElement * (list[SyntaxElement] -> list[SyntaxElement]) { (null, null) }
  public CallTransform(args : list[PExpr]) : list[SyntaxElement] { args.Map(e => SyntaxElement.Expression(e) : SyntaxElement) }
  public Run(ctx : Typer, args : list[SyntaxElement]) : PExpr
  {
    match (args)
    {
      | [SyntaxElement.Expression(e), SyntaxElement.Expression(point)] =>
        def m = ctx.CurrentMethodBuilder;
        def index = match (point) { | PExpr.Literal(Literal.Integer(i, _, _)) => i :> int | _ => 0 };
        // the value, typed once where it is, and the types it gives: a value of several types gives each of them
        def several = ctx.FlowTypesOf(e);
        def typed = match (several) { | _ :: _ :: _ => null | _ => ctx.TypeExpr(e) };
        def types = if (typed == null) several else [typed.Type];
        foreach (t in types) m.CollectedResults.Add(t);
        m.PointTypes[index] = types;
        m.PointLocations[index] = e.Location;
        // what it is compiled as waits for the body's other return points: the one type they give, or a Content
        // holding one of them (a type still unknown at the end, as a recursion's, adds nothing: NotYet's)
        ctx.DelayMacro(last =>
          if (!m.ResultBodyTyped || !last && m.CollectedResults.Exists(t => t.Hint.IsNone)) None()
          else
          {
            when (m.ResultTypes == null) DecideResult(ctx, m);
            match ((m.ResultTypes, typed))
            {
              | (_ :: _ :: _, null) => Some(<[ Nemerle.Scopes.Content.Of($e) ]>)
              | (_ :: _ :: _, _) => Some(<[ Nemerle.Scopes.Content.Of($(typed : typed)) ]>)
              | _ => Some(<[ $(typed : typed) ]>)
            }
          })
      | _ => Nemerle.Compiler.MessageMacros.FatalError("Invalid internal function result"); null
    }
  }

  /// The function's result, once its return points' types are known: their distinct types (more than one, a
  /// Content holding one of them, said on the result for other languages and, with -flow-log, where each comes from).
  static DecideResult(ctx : Typer, m : MethodBuilder) : void
  {
    mutable distinct = [];
    foreach (t in m.CollectedResults)
      when (t.Hint.IsSome)
      {
        def fixed = t.DeepFix();
        unless (distinct.Exists(d => d.Equals(fixed))) distinct ::= fixed
      }
    m.ResultTypes = distinct.Rev();
    when (distinct is _ :: _ :: _)
    {
      ctx.Manager.FileModuleRegistry.SeveralResults = true;
      when (ctx.Manager.CoreEnv.LookupType(["Nemerle", "Scopes", "ContentTypesAttribute"]) is Some(_))
        m.AddResultAttribute(<[ Nemerle.Scopes.ContentTypes(..$(m.ResultTypes.Map(t => <[ typeof($(t : typed)) ]>))) ]>);
      when (ctx.Manager.Options.FlowLog)
        foreach (pair in m.PointTypes)
          foreach (t when t.Hint.IsSome in pair.Value)
            Message.Hint(if (m.PointLocations.ContainsKey(pair.Key)) m.PointLocations[pair.Key] else m.Location,
                         $"flow: `$(m.Name)' gives $(t.DeepFix()) here")
    }
  }

  /// Registers it once per compiler instance.
  public static Register(manager : ManagerClass) : void
  {
    when (manager.NameTree.ExactPath(["Nemerle", "Compiler"]).LookupMacro(["__function_result"]).IsNone)
      manager.MacrosRegistry.RegisterMacro(FunctionResultMacro())
  }
}

/// `__module_binding_value("module.name")`: the top-level code's assignment of a binding. Its initializer is typed here,
/// in the flow of the top-level code, which gives the field its type before the assignment is typed.
internal sealed class ModuleBindingMacro : IMacro
{
  public GetName() : string { "__module_binding_value" }
  public GetNamespace() : string { "Nemerle.Compiler" }
  public IsInherited : bool { get { false } }
  public IsTailRecursionTransparent : bool { get { false } }
  public Keywords : list[string] { get { [] } }
  public Usage : MacroUsageAttribute { get { null } }
  public Location : Location { get { Location.Default } }
  public SyntaxExtension() : GrammarElement * (list[SyntaxElement] -> list[SyntaxElement]) { (null, null) }
  public CallTransform(args : list[PExpr]) : list[SyntaxElement] { args.Map(e => SyntaxElement.Expression(e) : SyntaxElement) }
  public Run(ctx : Typer, args : list[SyntaxElement]) : PExpr
  {
    match (args)
    {
      | [SyntaxElement.Expression(PExpr.Literal(Literal.String(key)))] =>
        def name = key.Substring(key.LastIndexOf('.') + 1);
        foreach (field is FieldBuilder in ctx.CurrentType.LookupMember(name)) field.InferScriptType(ctx);
        // (through a local: the value of an async file's binding may wait, which a field's assignment cannot hold)
        <[ def value = $(ctx.Manager.ModuleTypedBindings[key] : typed); _N_skip_write_check($(name : dyn)) = value ]>
      | _ => Nemerle.Compiler.MessageMacros.FatalError("Invalid internal top-level binding"); null
    }
  }
}

/// The top-level state macros. In the inference copy of the top-level code, `__state_hole()` is a value of open type
/// and `__state_type(key, k, x)` records the type of a value's k-th binding. In the top-level code itself,
/// `__state_bind(key, k, field, value)` writes a binding to the storage and `__state_store(key, field, local)` writes a
/// rebound value's local to it (the storage is a Content when its type changes).
internal sealed class StateMacro : IMacro
{
  name : string;
  public this(name : string) { this.name = name; }
  public GetName() : string { name }
  public GetNamespace() : string { "Nemerle.Compiler" }
  public IsInherited : bool { get { false } }
  public IsTailRecursionTransparent : bool { get { false } }
  public Keywords : list[string] { get { [] } }
  public Usage : MacroUsageAttribute { get { null } }
  public Location : Location { get { Location.Default } }
  public SyntaxExtension() : GrammarElement * (list[SyntaxElement] -> list[SyntaxElement]) { (null, null) }
  public CallTransform(args : list[PExpr]) : list[SyntaxElement] { args.Map(e => SyntaxElement.Expression(e) : SyntaxElement) }
  public Run(ctx : Typer, args : list[SyntaxElement]) : PExpr
  {
    def manager = ctx.Manager;
    def exprs = args.Map(fun (a) { | SyntaxElement.Expression(e) => e | _ => null });
    def storage(key : string) : string { if (manager.StateStorage.ContainsKey(key)) manager.StateStorage[key] else null }
    def fieldOf(key : string) : FieldBuilder
    {
      def short = key.Substring(key.LastIndexOf('.') + 1);
      mutable found = null;
      foreach (f is FieldBuilder in ctx.CurrentType.LookupMember(short)) found = f;
      found
    }
    // a read of a top-level value by its name is the value unless a local of that name is in scope there: a
    // parameter, a lambda's parameter or a local of the function (the local of the top-level binding itself, in the
    // top-level code, is the value)
    def shadowing(key : string) : PExpr
    {
      def short = key.Substring(key.LastIndexOf('.') + 1);
      def method = ctx.CurrentMethodBuilder;
      def script = manager.Options.Script;
      // (a script's statements are its top-level code: its constructor, or its async top-level code)
      def topLevelCode = FileModuleRegistry.IsTopLevelCode(method)
        || script != null && method != null && ctx.CurrentType.FullName == script.TypeName && (method.IsConstructor || method.Name.Contains("top_level"));
      def header = if (method != null) method.GetHeader() else null;
      // (an async file's top-level code is typed in its state machine's function)
      def inTopLevel(v : Nemerle.Compiler.local_value.LocalValue) { v.DefinedIn : object == header || v.DefinedIn != null && v.DefinedIn.Name == "_N_yielding_function" }
      mutable found = null;
      foreach ((n, v) in ctx.CurrentLocalContext.GetLocals())
        when (found == null && n.Id == short && !(topLevelCode && inTopLevel(v))) found = v;
      if (found == null) null else <[ $(TExpr.LocalRef(found.Type, found) : typed) ]>
    }
    match (name, exprs)
    {
      | ("__state_read", PExpr.Literal(Literal.String(key)) :: _) when shadowing(key) != null => shadowing(key)
      // (a local of that name where the code is: the code's own, as a read's)
      | ("__state_store", [PExpr.Literal(Literal.String(key)), _, value]) when shadowing(key) != null => <[ $(shadowing(key)) = $value ]>
      | ("__state_subject", [PExpr.Literal(Literal.String(key)), _]) when shadowing(key) != null => shadowing(key)
      | ("__state_hole", []) =>
        <[ $(TExpr.DefaultValue(ctx.FreshTypeVar()) : typed) ]>
      | ("__state_type", [PExpr.Literal(Literal.String(key)), PExpr.Literal(Literal.Integer(k, _, _)), value]) =>
        unless (manager.StateTypes.ContainsKey(key)) manager.StateTypes[key] = System.Collections.Generic.Dictionary();
        // (bound to the result of a function whose result is not decided yet: one of its types, a Content)
        match (value) { | PExpr.Ref (n) when manager.FileModuleRegistry.UndecidedLocals.Contains (n.Id) => _ = manager.FileModuleRegistry.UndecidedStates.Add (key) | _ => () }
        // (a value whose type changes has all its types: each is recorded; so has one bound to a result of several)
        def bound = match (value) { | PExpr.Ref (n) when manager.FileModuleRegistry.LocalSets.ContainsKey (n.Id) => manager.FileModuleRegistry.LocalSets[n.Id] | _ => null };
        match (if (bound != null) bound else ctx.FlowTypesOf(value))
        {
          | null => manager.StateTypes[key][k :> int] = ctx.TypeExpr(value).Type
          | types => foreach (t in types with i) manager.StateTypes[key][(k :> int) * 1000 - i - 1] = t
        }
        <[ () ]>
      | ("__state_bind", [PExpr.Literal(Literal.String(key)), PExpr.Literal(Literal.Integer(k, _, _)), field, value]) =>
        match (storage(key))
        {
          | "content" => <[ _N_skip_write_check($field) = Nemerle.Scopes.Content.Of($value) ]>
          | "typed" => <[ _N_skip_write_check($field) = $value ]>
          | _ when k == 1UL && manager.ModuleBindings.ContainsKey(key) =>
            // the inference pass could not settle the type: the first initializer gives it
            match (fieldOf(key)) { | null => () | f => f.InferScriptType(ctx) }
            <[ def value = $(manager.ModuleTypedBindings[key] : typed); _N_skip_write_check($field) = value ]>
          | _ => <[ _N_skip_write_check($field) = $value ]>
        }
      // a read outside the top-level code (a function, a lambda) of a value of several types: it runs whenever it is
      // called, so it checks the value first (`match (x) { | n is int => ... }', `if (x is int)'), see __state_subject
      | ("__state_read", PExpr.Literal(Literal.String(key)) :: field :: _) =>
        match (storage(key))
        {
          | "content" =>
            def name = key.Substring(key.LastIndexOf('.') + 1);
            def types = System.Collections.Generic.List.[string]();
            when (manager.StateTypes.ContainsKey(key))
              foreach (pair in manager.StateTypes[key])
                unless (types.Contains(pair.Value.ToString())) types.Add(pair.Value.ToString());
            def listed = match (types.Count) { | 0 => "of several types" | 1 => types[0]
                                               | n => string.Join(", ", types.GetRange(0, n - 1).ToArray()) + " or " + types[n - 1] };
            def lines = if (manager.StateLines.ContainsKey(key)) manager.StateLines[key].ConvertAll(l => l.Line.ToString()) else System.Collections.Generic.List();
            def declared = match (lines.Count) { | 0 => "" | 1 => $" (declared at line $(lines[0]))" | _ => " (declared at lines " + string.Join(", ", lines.ToArray()) + ")" };
            def check = $"match ($name) { " + string.Join(" ", types.ConvertAll(t => $"| v is $t => ...").ToArray()) + " }";
            // (as the typer reports: in its pass that reports, once)
            ReportLocatedError(field.Location, manager.Solver.CurrentMessenger,
              $"`$name' is $listed$declared: it is a top-level value, and this code can run at any time, so check which it is "
               $"first: $check");
            // (reported where it is: what uses it then is not an error of its own)
            <[ $(Nemerle.Compiler.Typedtree.TExpr.Error() : typed) ]>
          | _ => field
        }
      // what a check of a top-level value matches on: its content when it is of several types
      | ("__state_subject", [PExpr.Literal(Literal.String(key)), field]) =>
        match (storage(key)) { | "content" => <[ $field.Value ]> | _ => field }
      // the top-level code reads a value back after a call that may have assigned it: its content when it is of several
      // types (which the code then checks)
      | ("__state_reload", [PExpr.Literal(Literal.String(key)), field]) =>
        match (storage(key)) { | "content" => <[ $field.Value ]> | _ => field }
      | ("__state_store", [PExpr.Literal(Literal.String(key)), field, local]) =>
        match (storage(key))
        {
          | "content" => <[ _N_skip_write_check($field) = Nemerle.Scopes.Content.Of($local) ]>
          | _ => <[ _N_skip_write_check($field) = $local ]>
        }
      | _ => Nemerle.Compiler.MessageMacros.FatalError("Invalid internal top-level state macro"); null
    }
  }

  /// An imported file's top-level code runs in its type initializer, which holds the type's lock until it ends.
  /// Starting a thread or task there is warned; when the started work uses the file and the top-level code waits
  /// for it (Parallel always waits), it can never finish: an error. The calls are the resolved ones, whatever the
  /// spelling.
  /// What a typed method touches, for the thread check's proof across files: the file modules it refers to (their
  /// classes' full names) and the methods of this compilation it calls. Recorded while each method is typed (its
  /// typed body is gone once it is emitted).
  public static Summarize(typer : Typer, body : TExpr) : void
  {
    def manager = typer.Manager;
    def method = typer.CurrentMethodBuilder;
    when (method != null)
    {
      def (files, callees) = Touches(manager, [body]);
      manager.MethodFiles[method] = files;
      manager.MethodCallees[method] = callees;
    }
  }

  /// The file module a type belongs to (the outermost file class around it), or null.
  static FileOf(manager : ManagerClass, t : TypeInfo) : string
  {
    mutable at = t;
    while (at != null && at.DeclaringType != null) at = at.DeclaringType;
    if (at != null && manager.FileModuleRegistry.Usings.Contains(at.FullName)) at.FullName else null
  }

  static Touches(manager : ManagerClass, exprs : list[TExpr]) : System.Collections.Generic.HashSet[string] * System.Collections.Generic.HashSet[IMethod]
  {
    def files = System.Collections.Generic.HashSet();
    def callees = System.Collections.Generic.HashSet();
    def member(m : IMember) : void
    {
      when (m != null && m.DeclaringType != null)
      {
        match (FileOf(manager, m.DeclaringType)) { | null => () | f => _ = files.Add(f) }
        match (m) { | b is MethodBuilder => _ = callees.Add(b) | _ => () }
      }
    }
    foreach (e in exprs)
      ExprWalker().Walk(e, info =>
        match (info.Node)
        {
          | TExpr.StaticRef(_, m, _) => member(m)
          | TExpr.MethodRef(_, m, _, _) => member(m)
          | TExpr.FieldMember(_, f) => member(f)
          | TExpr.PropertyMember(_, p) => member(p)
          | TExpr.StaticPropertyRef(_, p) => member(p)
          | _ => ()
        });
    (files, callees)
  }

  /// Threads started in an imported file's top-level code (its static constructor, which holds the type's lock):
  /// each start is recorded with what its work touches, and whether the top-level code waits for that very task (or
  /// thread); the verdict is given once every method is typed (FinishThreads), when the calls the work makes can be
  /// followed into other files.
  public static CheckThreads(typer : Typer, body : TExpr) : void
  {
    def manager = typer.Manager;
    def home = typer.CurrentTypeBuilder;
    def threading(owner : string) : bool
    {
      owner == "System.Threading.Thread" || owner == "System.Threading.ThreadPool" || owner == "System.Threading.Timer"
      || owner.StartsWith("System.Threading.Tasks.", System.StringComparison.Ordinal)
    }
    def waiting(name : string) : bool { ["Wait", "WaitAll", "WaitAny", "Join", "get_Result", "GetResult", "RunSynchronously"].Contains(name) }
    // the method a call resolves to (an overloaded call is a resolved delayed typing)
    def callee(f : TExpr) : IMethod
    {
      | TExpr.StaticRef(_, m is IMethod, _) => m
      | TExpr.MethodRef(_, m, _, _) => m
      | TExpr.Delayed(susp) when susp.IsResolved => callee(susp.ResolutionResult)
      | _ => null
    }
    def receiver(f : TExpr) : TExpr
    {
      | TExpr.MethodRef(obj, _, _, _) => obj
      | TExpr.Delayed(susp) when susp.IsResolved => receiver(susp.ResolutionResult)
      | _ => null
    }
    def strip(e : TExpr) : TExpr
    {
      | TExpr.DebugInfo(inner, _) => strip(inner)
      | TExpr.TypeConversion(inner, _, _, _) => strip(inner)
      | TExpr.MacroEnvelope(_, _, inner, _) => strip(inner)
      | _ => e
    }
    def starts = System.Collections.Generic.List.[ManagerClass.ThreadStart]();
    def startOf = System.Collections.Generic.Dictionary.[object, ManagerClass.ThreadStart](); // a start, by its call node
    def boundTo = System.Collections.Generic.Dictionary.[object, TExpr]();                 // a local, by the value bound to it
    def isStart(owner : string, name : string) : bool
    {
      threading(owner) && !waiting(name) && name != "GetAwaiter" && name != "Start" && name != "ConfigureAwait"
      && !name.StartsWith("get_", System.StringComparison.Ordinal)
    }
    // the start a waited-on expression is: a local that holds one, a start call itself, or one reached through
    // GetAwaiter / ConfigureAwait
    def started(e : TExpr) : ManagerClass.ThreadStart
    {
      match (strip(e))
      {
        | TExpr.LocalRef(decl) => mutable v; if (boundTo.TryGetValue(decl, out v)) started(v) else null
        // a top-level value is the file's state: a field written by its binding
        | TExpr.StaticRef(_, field is IField, _) => mutable v; if (boundTo.TryGetValue(field, out v)) started(v) else null
        | TExpr.Call(f, _, _) as call =>
          mutable s;
          if (startOf.TryGetValue(call, out s)) s
          else match (callee(f)) { | m when m != null && (m.Name == "GetAwaiter" || m.Name == "ConfigureAwait") => started(receiver(f)) | _ => null }
        | _ => null
      }
    }
    mutable untraced = false; // a wait whose task is not one started here
    def wait(on : TExpr) : void
    {
      match (started(on)) { | null => untraced = true | s => s.Waited = true }
    }
    def visit(node : object) : void
    {
      match (node)
      {
        | TExpr.Call(func, parms, _) as call =>
          def meth = callee(func);
          when (meth != null && meth.DeclaringType != null)
          {
            def owner = meth.DeclaringType.FullName;
            if (owner == "System.Threading.Thread" && meth.Name == "Start") ()      // the thread's work came with its constructor
            else if ((threading(owner) || owner == "System.Runtime.CompilerServices.TaskAwaiter") && waiting(meth.Name))
            {
              // Task.WaitAll(a, b) / WaitAny: its arguments; t.Wait(), th.Join(), awaiter.GetResult(): its receiver
              if (meth.Name == "WaitAll" || meth.Name == "WaitAny")
                foreach (p in parms)
                  match (strip(p.expr))
                  {
                    | TExpr.Array(items, _) => foreach (i in items) wait(i)
                    | other => wait(other)
                  }
              else wait(receiver(func))
            }
            else when (isStart(owner, meth.Name))
            {
              def (files, callees) = Touches(manager, parms.Map(p => p.expr));
              def s = ManagerClass.ThreadStart(call.Location, meth.DeclaringType.Name + "." + (if (meth.Name == ".ctor") "new" else meth.Name),
                                               owner == "System.Threading.Tasks.Parallel", home.FullName, files, callees);
              starts.Add(s); startOf[call] = s;
            }
          }
        | TExpr.DefValIn(local, value, _) => boundTo[local] = value
        | TExpr.Assign(target, value) =>
          match (strip(target))
          {
            | TExpr.LocalRef(decl) => boundTo[decl] = value
            | TExpr.StaticRef(_, field is IField, _) => boundTo[field] = value
            | _ => ()
          }
        | TExpr.PropertyMember(obj, p) when p.Name == "Result" && p.DeclaringType != null && threading(p.DeclaringType.FullName) => wait(obj)
        | _ => ()
      }
    }
    // in source order: a start before the wait on it, its local bound in between
    ExprWalker().Walk(body, info => visit(info.Node));
    foreach (s in starts) { s.UntracedWait = untraced; manager.ThreadStarts.Add(s) }
  }

  /// The verdict on the threads of every imported file's top-level code, once every method is typed: work that uses
  /// the file (directly, or through calls into other files that reach it) while the top-level code waits for that
  /// very work can never run, an error; any other start is a warning.
  public static FinishThreads(manager : ManagerClass) : void
  {
    def reaches(start : ManagerClass.ThreadStart) : bool
    {
      if (start.Files.Contains(start.Home)) true
      else
      {
        def seen = System.Collections.Generic.HashSet.[IMethod]();
        def queue = System.Collections.Generic.Queue.[IMethod](start.Callees);
        mutable found = false;
        while (!found && queue.Count > 0)
        {
          def m = queue.Dequeue();
          when (seen.Add(m))
          {
            mutable files; mutable callees;
            when (manager.MethodFiles.TryGetValue(m, out files) && files.Contains(start.Home)) found = true;
            when (manager.MethodCallees.TryGetValue(m, out callees)) foreach (c in callees) queue.Enqueue(c);
          }
        }
        found
      }
    }
    foreach (s in manager.ThreadStarts)
      if (reaches(s) && (s.ImplicitWait || s.Waited))
        Message.Error(s.At, $"$(s.What) runs work that uses this file while its top-level code waits for it; that code holds "
                                  "the file's type initializer lock, so the work can never run: move it out of the top-level code")
      else
        Message.Warning(s.At, $"$(s.What) in the top-level code of an imported file: that code runs in the file's type initializer, "
                                    "so work that calls into the file waits until the top-level code ends");
    manager.ThreadStarts.Clear();
  }

  /// A top-level value that changes type is a Content; code that needs one of its earlier types depends on what is
  /// no longer there, so the type change is an error (where the type changes) naming that code.
  public static CheckReads(manager : ManagerClass) : void
  {
    foreach ((key, needed, at) in manager.StateReads)
      when (manager.StateStorage.ContainsKey(key) && manager.StateStorage[key] == "content" && manager.StateTypes.ContainsKey(key))
      {
        def types = System.Collections.Generic.List.[FixedType]();
        foreach (pair in manager.StateTypes[key]) types.Add(pair.Value.Fix());
        def final = types[types.Count - 1];
        def wanted = needed.Fix();
        unless (wanted.Equals(final) || wanted.Equals(manager.InternalType.Object))
        {
          // where the type changes away from the one this code needs
          mutable change = 1;
          for (mutable i = 1; i < types.Count; i++) when (!types[i].Equals(types[i - 1]) && types[i - 1].Equals(wanted)) change = i;
          def name = key.Substring(key.LastIndexOf('.') + 1);
          def lines = if (manager.StateLines.ContainsKey(key)) manager.StateLines[key] else System.Collections.Generic.List();
          def place = if (change < lines.Count) lines[change] else at;
          Message.Error(place, $"`$name' changes type here (from $(types[change - 1]) to $(types[change])), but line $(at.Line) uses it as $wanted");
        }
      }
  }
}
