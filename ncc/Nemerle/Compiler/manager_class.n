    internal UpdateMethodsStatistics(currentMethodKey : string, timeSpan : TimeSpan) : void
    {
      mutable value;
      MethodsStatistics[currentMethodKey] =
        if (MethodsStatistics.TryGetValue(currentMethodKey, out value))
          (value[0] + 1, value[1] + timeSpan)
        else
          (1, timeSpan);
    }

    ShowStatistics() : void
    {
      when (Options.ShowCompilerStatistics && MethodsStatistics.Count > 1)
        foreach ((key, (count, timeSpan)) in MethodsStatistics.KeyValuePairs.OrderBy((_, (_, timeSpan)) => timeSpan))
        {
          def msg = $"$key: $timeSpan  $count";
          Message.Hint(msg);
        }
    }

    private WrapWithCurrentContext(fn : void -> void) : void -> void
    {
      def location = LocationStack.Top();
      def color    = MacroColors.Color;
      def context  = MacroColors.UseContext;

      fun ()
      {
        MacroColors.PushNewColor(color, context);
        try
          Nemerle.Compiler.UtilMacros.locate(location, fn());
        finally
          MacroColors.PopColor();
      }
    }

    private static CallAndResetList(fancs : ref list[void -> void]) : void
    {
      when (fancs != null)
      {
        foreach (f in fancs)
          f();

        fancs = null;
      }
    }

    private mutable _beforeAddMembers : list[void -> void];

    internal OnBeforeAddMembers() : void { CallAndResetList(ref _beforeAddMembers); }

    public ExecBeforeAddMembers(fn : void -> void) : void
    {
      _beforeAddMembers ::= WrapWithCurrentContext(fn)
    }

    private mutable _beforeWithTypedMembers : list[void -> void];

    internal OnBeforeWithTypedMembers() : void { CallAndResetList(ref _beforeWithTypedMembers); }

    public ExecBeforeWithTypedMembers(fn : void -> void) : void
    {
      _beforeWithTypedMembers ::= WrapWithCurrentContext(fn)
    }

    mutable _userData : SC.IDictionary;

    /// What this compilation writes into its continuation section.
    public Continuation : Nemerle.Compiler.continuation.ContinuationStore { get; private set; }
    /// The binaries this compilation continues from: -continue entries and every reference with a continuation section.
    public ContinueFrom : list[string] { get; private set; }
    /// Whether a binary continued from stores shared scopes: `scope.A.x` in a source then reads them, although
    /// `scope` is an ordinary name elsewhere.
    public ContinuesScopes : bool { get; private set; }
    /// Top-level `def`/`mutable` of file modules (`module.name`) whose field type is their initializer's.
    public ModuleBindings : System.Collections.Generic.Dictionary[string, Nemerle.Compiler.Parsetree.PExpr] = System.Collections.Generic.Dictionary();
    public ModuleTypedBindings : System.Collections.Generic.Dictionary[string, Nemerle.Compiler.Typedtree.TExpr] = System.Collections.Generic.Dictionary();
    /// While above zero, messages are not reported, only errors counted (a pass that only learns types).
    public mutable QuietMessages : int;
    public mutable QuietErrors : int;
    /// The labels a `yield' resumes at (Typer.HandleYield): an async state machine's are its resume points, which the
    /// debug information lists (ILEmitter, AsyncStepping).
    public YieldLabels : System.Collections.Generic.HashSet[int] = System.Collections.Generic.HashSet();
    /// The state machines made (an iterator's or async function's MoveNext, and the function that starts it, or null
    /// for a lambda's), for the debug information (the PDB's StateMachineMethod table).
    public StateMachines : System.Collections.Generic.List[Nemerle.Compiler.ClassMembers.MethodBuilder * Nemerle.Compiler.ClassMembers.MethodBuilder] = System.Collections.Generic.List();
    /// The classes of async state machines (an async function's, lambda's or stream's).
    public AsyncStateMachineTypes : System.Collections.Generic.HashSet[Nemerle.Compiler.type_builder.TypeBuilder] = System.Collections.Generic.HashSet();
    /// For each async MoveNext, where it suspends and where it resumes (IL offsets, in pairs): the debugger steps over
    /// an `await' with them.
    public AsyncStepping : System.Collections.Generic.Dictionary[Nemerle.Compiler.ClassMembers.MethodBuilder, System.Collections.Generic.List[int]] = System.Collections.Generic.Dictionary();
    /// How many async lambdas were taken as `void' delegates (Typer.NonLiteralCast), for overload resolution.
    public mutable AsyncVoidAdaptations : int;
    /// Per top-level value (`module.name`): the type of each of its bindings, learned by the inference pass.
    public StateTypes : System.Collections.Generic.Dictionary[string, System.Collections.Generic.Dictionary[int, Nemerle.Compiler.type_var.TypeVar]] = System.Collections.Generic.Dictionary();
    /// The target's reference assemblies, when the target is not the compiler's own .NET: what the typed code uses
    /// from the framework is checked against them (an error at the code that uses what the target lacks).
    public mutable TargetContracts : Nemerle.Platform.ClrTargetContracts;
    public TargetReported : System.Collections.Generic.HashSet[string] = System.Collections.Generic.HashSet();
    /// Above 0 while the quiet copy of a file's top-level code is typed to infer its values' types.
    public mutable StateInference : int;
    /// The calls written as statements of a file's top-level code (where they are), and the files that have them: a
    /// macro's expansion there is top-level code too, so what it declares is the file's state (Typer.LiftDeclarations),
    /// and such a file's top-level code is typed before its fields are emitted.
    public TopLevelCalls : SCG.HashSet[string] = SCG.HashSet();
    /// The key of a location in TopLevelCalls.
    public static CallKey(at : Location) : string
    { at.FileIndex.ToString() + ":" + at.Line.ToString() + ":" + at.Column.ToString() + ":" + at.EndLine.ToString() + ":" + at.EndColumn.ToString() }
    public TopLevelCallModules : SCG.HashSet[string] = SCG.HashSet();
    /// For the thread check: what each typed method touches (file modules) and calls (methods of this compilation).
    public MethodFiles : System.Collections.Generic.Dictionary[IMethod, System.Collections.Generic.HashSet[string]] = System.Collections.Generic.Dictionary();
    public MethodCallees : System.Collections.Generic.Dictionary[IMethod, System.Collections.Generic.HashSet[IMethod]] = System.Collections.Generic.Dictionary();
    /// Threads started in imported files' top-level code, judged once every method is typed.
    public ThreadStarts : System.Collections.Generic.List[ThreadStart] = System.Collections.Generic.List();

    public class ThreadStart
    {
      public mutable At : Location;
      public What : string;
      public ImplicitWait : bool;
      public Home : string;
      public Files : System.Collections.Generic.HashSet[string];
      public Callees : System.Collections.Generic.HashSet[IMethod];
      public mutable Waited : bool;
      public mutable UntracedWait : bool;
      public this(location : Location, what : string, implicitWait : bool, home : string,
                  files : System.Collections.Generic.HashSet[string], callees : System.Collections.Generic.HashSet[IMethod])
      { At = location; What = what; ImplicitWait = implicitWait; Home = home; Files = files; Callees = callees; }
    }
    /// Per top-level value: "typed" (one type) or "content" (its type changes; the storage is a Content).
    public StateStorage : System.Collections.Generic.Dictionary[string, string] = System.Collections.Generic.Dictionary();
    /// Reads of a top-level value whose storage may be a Content: the type each one needs, checked after typing.
    public StateReads : System.Collections.Generic.List[string * Nemerle.Compiler.type_var.TypeVar * Location] = System.Collections.Generic.List();
    /// Where each top-level value is bound.
    public StateLines : System.Collections.Generic.Dictionary[string, System.Collections.Generic.List[Location]] = System.Collections.Generic.Dictionary();

    public UserData : SC.IDictionary
    {
      get
      {
        when (_userData == null)
          _userData = ListDictionary();

        _userData
      }
    }

    #region Source change notifications

    sourceChangedHandlers : Hashtable[int, SourceChangedHandler] = Hashtable(10);

    public NotifySourceChanged(source : ISource) : void
    {
      match(sourceChangedHandlers.TryGetValue(source.FileIndex))
      {
        | (handler, true) => handler(source)
        | _ => ();
      }
    }

    public SubscribeSourceChanged(fileIndex : int, handler : SourceChangedHandler, invokeAfterSubscription : bool = true) : void
    {
      def newHandler = match(sourceChangedHandlers.TryGetValue(fileIndex))
      {
        | (currentHandler, true) =>
          System.Delegate.Combine(currentHandler, handler) :> SourceChangedHandler
        | _ => handler
      };
      sourceChangedHandlers[fileIndex] = newHandler;
      when(invokeAfterSubscription)
      {
        def source = GetSource(fileIndex);
        handler(source);
      }
    }

    public UnsubscribeSourceChanged(fileIndex : int, handler : SourceChangedHandler) : void
    {
      match(sourceChangedHandlers.TryGetValue(fileIndex))
      {
        | (currentHandler, true) =>
          match(System.Delegate.Remove(currentHandler, handler) :> SourceChangedHandler)
          {
            | null       => sourceChangedHandlers.Remove(fileIndex)
            | newHandler => sourceChangedHandlers[fileIndex] = newHandler
          }
        | _ => ()
      }
    }

    public HasSourceChangedSubscribers(fileIndex : int) : bool
    {
      sourceChangedHandlers.ContainsKey(fileIndex)
    }

    protected UnsubscribeSourceChangedHandler(fileIndex : int) : void
    {
      sourceChangedHandlers.Remove(fileIndex);
    }

    protected UnsubscribeSourceChangedHandlers() : void
    {
      sourceChangedHandlers.Clear();
    }

    public virtual GetSource(fileIndex : int) : ISource
    {
      FileSource.ReadFile(Location.GetFileName(fileIndex),
        checkDuplicatedFiles  = false,
        checkLastLineForLF    = false)
    }

    #endregion

