// Shared lexical helpers of the grammar/space source integration (envelope reader, diagnostics, JSON quoting).

using System;
using System.Text;
using System.IO;
using SCG = System.Collections.Generic;
using Nemerle;
using Nemerle.Collections;
using Nemerle.Imperative;
using Nemerle.Compiler.Parsetree;
using Nemerle.Compiler.AST;
using Nemerle.Compiler.GrammarModel;
using Nemerle.Compiler.Source;
using Nemerle.Compiler.Utility;

public sealed class GrammarDiagnostic
{
  public mutable File : string;
  public mutable Offset : int;
  public mutable Message : string;
  public this(file : string, offset : int, message : string) { File=file; Offset=offset; Message=message; }
}
internal sealed class GLexeme
{
  public mutable Text : string;
  public mutable Value : string;
  public mutable Start : int;
  public mutable End : int;
  public mutable Quoted : bool;
}
/// An error in grammar/space source, at a position of a file: reported at its line and column.
public sealed class NitraSourceException : ArgumentException
{
  public mutable Location : Location;
  /// The offset in the file's text.
  public Offset : int;
  public this(file : string, text : string, offset : int, message : string)
  {
    base(message);
    mutable line=1; mutable column=1;
    for(mutable i=0;i<offset && i<text.Length;++i) if(text[i]=='\n') { ++line; column=1; } else ++column;
    Location=Nemerle.Compiler.AST.Location(Nemerle.Compiler.AST.Location.GetFileIndex(file),line,column); Offset=offset;
  }
}

internal sealed class GReader
{
  public mutable Text : string;
  public mutable Pos : int;
  public mutable Limit : int;
  public mutable File : string;
  public mutable SqlComments : bool;
  private mutable cached : GLexeme;
  public this(text : string, file : string, start : int, end : int)
  { Text=text; File=file; Pos=start; Limit=end; }
  public Reset() : void { cached=null; }
  public Fail(message : string) : void { throw NitraSourceException(File, Text, Pos, message); }
  public Skip() : void
  {
    mutable again=true;
    while (again)
    {
      again=false;
      while (Pos < Limit && char.IsWhiteSpace(Text[Pos])) ++Pos;
      when (SqlComments && Pos+1 < Limit && Text[Pos]=='-' && Text[Pos+1]=='-')
      { while(Pos<Limit && Text[Pos]!='\n') ++Pos; again=true; }
      when (Pos+1 < Limit && Text[Pos]=='/' && Text[Pos+1]=='/')
      { while (Pos < Limit && Text[Pos]!='\n') ++Pos; again=true; }
      when (Pos+1 < Limit && Text[Pos]=='/' && Text[Pos+1]=='*')
      {
        Pos+=2;
        while (Pos+1 < Limit && !(Text[Pos]=='*' && Text[Pos+1]=='/')) ++Pos;
        when (Pos+1 >= Limit) Fail("unterminated comment");
        Pos+=2; again=true;
      }
    }
  }
  public Peek() : GLexeme
  {
    when (cached==null) cached=Read();
    cached
  }
  public Take() : GLexeme { def t=Peek(); cached=null; t }
  public Is(value : string) : bool { Peek().Text==value }
  public Eat(value : string) : bool { if (Is(value)) { _=Take(); true } else false }
  public Need(value : string) : void { unless (Eat(value)) Fail("expected '"+value+"', found '"+Peek().Text+"'"); }
  public Name() : string
  {
    def t=Take();
    unless (t.Text.Length>0 && (char.IsLetter(t.Text[0]) || t.Text[0]=='_')) Fail("expected identifier");
    mutable value=t.Text;
    while (Eat(".")) value=value+"."+Take().Text;
    value
  }
  private Read() : GLexeme
  {
    Skip(); def t=GLexeme(); t.Start=Pos;
    if (Pos>=Limit) { t.Text="<eof>"; t.Value=t.Text; t.End=Pos; t }
    else
    {
      def c=Text[Pos]; ++Pos;
      if (c=='\"' || c=='\'')
      {
        t.Quoted=true; def b=StringBuilder(); mutable closed=false;
        while (Pos<Limit && !closed)
        {
          def ch=Text[Pos]; ++Pos;
          if (ch==c) closed=true;
          else if (ch=='\\')
          {
            when (Pos>=Limit) Fail("unterminated escape");
            def e=Text[Pos]; ++Pos;
            match (e)
            {
              | 'n' => _=b.Append('\n');
              | 'r' => _=b.Append('\r');
              | 't' => _=b.Append('\t');
              | 'u' =>
                when (Pos+4>Limit) Fail("incomplete unicode escape");
                _=b.Append(Convert.ToChar(Convert.ToInt32(Text.Substring(Pos,4),16))); Pos+=4;
              | _ => _=b.Append(e);
            }
          }
          else _=b.Append(ch);
        }
        unless (closed) Fail("unterminated quoted literal");
        t.Value=b.ToString();
      }
      else if (char.IsLetterOrDigit(c) || c=='_')
      { while (Pos<Limit && (char.IsLetterOrDigit(Text[Pos]) || Text[Pos]=='_')) ++Pos; }
      else when (c=='.' && Pos<Limit && Text[Pos]=='.')
      { ++Pos; when (Pos<Limit && Text[Pos]=='.') ++Pos; }
      t.Text=Text.Substring(t.Start,Pos-t.Start); t.End=Pos;
      when (t.Value==null) t.Value=t.Text;
      t
    }
  }
  // Only declaration/action envelopes use this scanner. Foreign space endings are
  // recognized by the grammar engine, not by Nemerle's lexer or this method.
  public Block() : GLexeme
  {
    def open=Take(); unless (open.Text=="{") Fail("expected block");
    mutable depth=1; mutable end=open.End;
    while (depth>0)
    {
      def t=Take(); when (t.Text=="<eof>") Fail("unterminated declaration/action block");
      unless (t.Quoted)
      { when (t.Text=="{") ++depth; when (t.Text=="}") --depth; }
      end=t.End;
    }
    def result=GLexeme(); result.Start=open.Start; result.End=end;
    result.Text=Text.Substring(open.Start,end-open.Start); result
  }

  // The envelope is owned by the host's indentation, not by braces occurring
  // in a foreign language. Keep original offsets and pass the untouched body
  // to its grammar.
  public IndentedBlock(headerStart : int) : GLexeme
  {
    def open=Take(); unless(open.Text==":") Fail("expected ':' before indented space body");
    mutable lineStart=headerStart;
    while(lineStart>0 && Text[lineStart-1]!='\n') --lineStart;
    mutable headerEnd=lineStart;
    while(headerEnd<headerStart && (Text[headerEnd]==' ' || Text[headerEnd]=='\t')) ++headerEnd;
    def headerIndent=Text.Substring(lineStart,headerEnd-lineStart);
    // Nothing except a comment may follow the colon on its line.
    mutable first=open.End;
    while(first<Limit && (Text[first]==' ' || Text[first]=='\t' || Text[first]=='\r')) ++first;
    when(first+1<Limit && Text[first]=='/' && Text[first+1]=='/')
      while(first<Limit && Text[first]!='\n') ++first;
    when(first<Limit && Text[first]!='\n') Fail("indented space body must start on the next line");
    when(first<Limit) ++first;
    mutable bodyIndent : string = null;
    mutable cursor=first;
    mutable end=Limit;
    mutable done=false;
    while(cursor<Limit && !done)
    {
      mutable content=cursor;
      while(content<Limit && (Text[content]==' ' || Text[content]=='\t')) ++content;
      mutable next=content;
      while(next<Limit && Text[next]!='\n') ++next;
      when(next<Limit) ++next;
      def blank=content>=Limit || Text[content]=='\r' || Text[content]=='\n';
      def comment=content+1<Limit &&
        ((Text[content]=='/' && Text[content+1]=='/') || (Text[content]=='-' && Text[content+1]=='-'));
      unless(blank || comment)
      {
        def indent=Text.Substring(cursor,content-cursor);
        if(indent.Length<=headerIndent.Length)
        { end=cursor; done=true; }
        else
        {
          unless(indent.StartsWith(headerIndent)) Fail("inconsistent indentation in space body");
          if(bodyIndent==null) bodyIndent=indent;
          else unless(indent.StartsWith(bodyIndent)) Fail("inconsistent indentation in space body");
        }
      }
      cursor=next;
    }
    when(bodyIndent==null) Fail("expected an indented block after ':'");
    Pos=end; Reset();
    def result=GLexeme(); result.Start=open.Start; result.End=end;
    result.Text=Text.Substring(open.Start,end-open.Start); result
  }
}
internal module GrammarJson
{
  public Quote(value : string) : string
  {
    when (value==null) return "null";
    def b=StringBuilder("\"");
    foreach (c in value)
      match(c)
      {
        | '\"' => _=b.Append("\\\""); | '\\' => _=b.Append("\\\\");
        | '\n' => _=b.Append("\\n"); | '\r' => _=b.Append("\\r"); | '\t' => _=b.Append("\\t");
        | _ => if (c<' ') _=b.Append("\\u"+(c :> int).ToString("x4")); else _=b.Append(c);
      }
    _=b.Append('"'); b.ToString()
  }
  public MatchJson(m : GrammarMatch) : string
  {
    // Iterative output avoids a CLR stack overflow on long left-associated trees.
    def b=StringBuilder(); def stack=SCG.Stack.[GrammarMatch * int](); stack.Push((m,-1));
    while(stack.Count>0)
    {
      def (n,index)=stack.Pop();
      if(index<0)
      {
        _=b.Append("{\"kind\":"+Quote(n.Kind)+",\"name\":"+Quote(n.Name)+",\"grammar\":"+Quote(n.Grammar)
          +",\"module\":"+Quote(n.Module)+",\"variant\":"+Quote(n.Variant)+",\"capture\":"+Quote(n.Capture)
          +",\"file\":"+Quote(n.File)+",\"start\":"+n.Start.ToString()+",\"end\":"+n.End.ToString()+",\"children\":[");
        stack.Push((n,0));
      }
      else if(index<n.Children.Count)
      {
        when(index>0) _=b.Append(','); stack.Push((n,index+1)); stack.Push((n.Children[index],-1));
      }
      else _=b.Append("]}");
    }
    b.ToString()
  }
  public Result(r : GrammarParseResult) : string
  {
    def b=StringBuilder("{\"version\":1,\"success\":"+(if(r.Success) "true" else "false")+",\"matches\":[");
    mutable first=true;
    foreach(m in r.Matches) { unless(first) _=b.Append(','); first=false; _=b.Append(MatchJson(m)); }
    _=b.Append("],\"diagnostics\":["); first=true;
    foreach(d in r.Diagnostics)
    { unless(first) _=b.Append(','); first=false; _=b.Append("{\"file\":"+Quote(d.File)+",\"offset\":"+d.Offset.ToString()+",\"message\":"+Quote(d.Message)+"}"); }
    _=b.Append("],\"actions\":["); first=true;
    foreach(a in r.Actions)
    { unless(first) _=b.Append(','); first=false; _=b.Append("{\"file\":"+Quote(a.File)+",\"start\":"+a.Start.ToString()+",\"end\":"+a.End.ToString()+",\"text\":"+Quote(a.Text)+",\"parsed\":"+(if(a.Ast!=null) "true" else "false")+"}"); }
    _=b.Append("],\"ruleEvaluations\":"+r.RuleEvaluations.ToString()+",\"memoHits\":"+r.MemoHits.ToString()+"}"); b.ToString()
  }
}
/// Finds the first grammar/space block, scope declaration or dial of a source file (envelope pre-scan only).
public module NitraSourceScan
{
  internal HasIndentPragma(text : string) : bool
  {
    def reader=GReader(text,"",0,text.Length);
    try {
      while(!reader.Is("<eof>")) {
        def token=reader.Take();
        when(!token.Quoted && token.Text=="#" && reader.Eat("pragma") && reader.Eat("indent")) return true;
      }
    } catch {
      | _ is ArgumentException => ()
      | _ is FormatException => ()
      | _ is OverflowException => ()
    }
    false
  }
  internal FindConstruct(source : ISource) : Location { FindConstruct(source,false) }
  /// `scopeUses`: also count `scope.A.x`. `scope` is an ordinary name in files without spaces, so that use counts
  /// only when a referenced binary stores scopes; `scope A;` and a dial `dial:.` are never ordinary Nemerle.
  internal FindConstruct(source : ISource, scopeUses : bool, indentation : bool = false) : Location
  {
    def text=source.GetText();
    unless(text.Contains("grammar") || text.Contains("space") || text.Contains("scope") || text.Contains(":.")) return Location.Default;
    def indented=indentation || HasIndentPragma(text);
    def at(start : int) : Location
    {
      mutable line=1; mutable column=1;
      for(mutable i=0;i<start;++i) if(text[i]=='\n') { ++line; column=1; } else ++column;
      Location(source.FileIndex,line,column)
    }
    def reader=GReader(text,Location.GetFileName(source.FileIndex),0,text.Length);
    try
    {
      mutable previous="";
      while(!reader.Is("<eof>"))
      {
        def token=reader.Take();
        def after=previous; previous=token.Text;
        // scopes and dials belong to the grammar path too: `scope A;`, `scope.A.x`, `dial:.file::member`
        when(!token.Quoted && after!="." && token.Text=="scope")
        {
          when(scopeUses && reader.Is(".")) return at(token.Start);
          when(reader.Peek().Text.Length>0 && char.IsLetter(reader.Peek().Text[0]))
          { _=reader.Name(); when(reader.Is(";") || reader.Is("{")) return at(token.Start); }
        }
        when(!token.Quoted && after!="." && token.Text=="dial" && reader.Is(":"))
        { _=reader.Take(); when(reader.Is(".")) return at(token.Start); }
        when(!token.Quoted && (token.Text=="grammar" || token.Text=="space"))
        {
          def bodyStart() { reader.Is("{") || (token.Text=="space" && indented && reader.Is(":")) }
          mutable found=bodyStart();
          when(reader.Is("("))
          {
            _=reader.Take();
            while(!reader.Is(")") && !reader.Is("<eof>")) _=reader.Take();
            _=reader.Eat(")"); found=bodyStart();
          }
          when(reader.Peek().Text.Length>0 && char.IsLetter(reader.Peek().Text[0]) && !(token.Text=="space" && reader.Is("as")))
          { _=reader.Name(); found=bodyStart(); }
          // `space G as Name [A] { ... }`: an alias and attached scopes may stand before the body
          when(token.Text=="space" && reader.Eat("as")) { _=reader.Name(); found=bodyStart(); }
          when(token.Text=="space" && reader.Is("["))
          {
            while(!reader.Is("]") && !reader.Is("<eof>")) _=reader.Take();
            _=reader.Eat("]"); found=bodyStart();
          }
          when(found) return at(token.Start);
        }
      }
    }
    // This is only an envelope pre-scan. Nemerle quotations and escapes need
    // the real lexer; a failed pre-scan must not crash ordinary compilation.
    catch
    {
      | _ is ArgumentException => ()
      | _ is FormatException => ()
      | _ is OverflowException => ()
    }
    Location.Default
  }
}
