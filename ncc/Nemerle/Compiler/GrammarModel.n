// Previous grammar/space design (source-only prototype). Result types stay (ManagerClass.ParseGrammarSources is a host
// entry point); the recognizer model is parked: compiled only with -define:OLD_GRAMMAR_DESIGN.

using System;
using System.Text;
using System.IO;
using SCG = System.Collections.Generic;
using Nemerle;
using Nemerle.Collections;
using Nemerle.Imperative;
using Nemerle.Compiler.Parsetree;
using Nemerle.Compiler.GlobalEnv;
using Nemerle.Compiler.NitraShared;
using Nemerle.Compiler.Source;

  public sealed class GrammarMatch
  {
    public mutable Kind : string;
    public mutable Name : string;
    public mutable Grammar : string;
    public mutable Module : string;
    public mutable Variant : string;
    public mutable Capture : string;
    public mutable File : string;
    public mutable Start : int;
    public mutable End : int;
    public Children : SCG.List[GrammarMatch] = SCG.List();
    public this(kind : string, name : string, start : int, end : int)
    { Kind=kind; Name=name; Start=start; End=end; }
  }
  public sealed class GrammarAction
  {
    public mutable File : string;
    public mutable Start : int;
    public mutable End : int;
    public mutable Text : string;
    public mutable Ast : PExpr;
    public mutable Scope : GlobalEnv;
  }
  public sealed class GrammarParseResult
  {
    public Matches : SCG.List[GrammarMatch] = SCG.List();
    public Diagnostics : SCG.List[GrammarDiagnostic] = SCG.List();
    public Actions : SCG.List[GrammarAction] = SCG.List();
    public mutable RuleEvaluations : int;
    public mutable MemoHits : int;
    public Success : bool { get { Diagnostics.Count == 0 } }
    public ToJson() : string { GrammarJson.Result(this) }
  }
#if OLD_GRAMMAR_DESIGN
  internal sealed class GExpr
  {
    public mutable Kind : string;
    public mutable Text : string;
    public mutable Min : int;
    public mutable Max : int = -1;
    public Items : SCG.List[GExpr] = SCG.List();
    public this(kind : string, text : string) { Kind=kind; Text=text; }
  }
  internal sealed class GAlternative
  {
    public mutable Owner : GRule;
    public mutable Name : string;
    public mutable Expr : GExpr;
    public mutable Precedence : string = "0";
    public mutable Right : bool;
  }
  internal sealed class GRule
  {
    public mutable Id : int;
    public mutable Target : GRule;
    public mutable Name : string;
    public mutable Grammar : GDefinition;
    public mutable Module : string;
    public mutable Kind : string;
    public mutable Lexical : bool;
    public mutable StartRule : bool;
    public mutable Form : string;
    public mutable Offset : int;
    public Alternatives : SCG.List[GAlternative] = SCG.List();
    public this(name : string, grammar : GDefinition, moduleName : string, kind : string)
    { Name=name; Grammar=grammar; Module=moduleName; Kind=kind; }
    public Key : string { get { Grammar.FullName + "." + Module + "." + Name } }
  }
  internal sealed class GDefinition
  {
    public mutable Name : string;
    public mutable FullName : string;
    public mutable File : GFile;
    public Rules : SCG.List[GRule] = SCG.List();
    public Forms : SCG.Dictionary[string, GExpr] = SCG.Dictionary();
    public Bindings : SCG.Dictionary[string, string] = SCG.Dictionary();
    public Imports : SCG.Dictionary[string, string] = SCG.Dictionary();
    public Precedences : SCG.List[string] = SCG.List();
    public Orders : SCG.List[string] = SCG.List();
    public Extensions : SCG.List[GRule] = SCG.List();
  }
  internal sealed class GFile
  {
    public mutable Source : ISource;
    public mutable Path : string;
    public mutable Owner : string;
    public mutable Text : string;
    public Usings : SCG.Dictionary[string, string] = SCG.Dictionary();
    public Definitions : SCG.List[GDefinition] = SCG.List();
    public Zones : SCG.List[GZone] = SCG.List();
  }
  internal sealed class GZone
  {
    public mutable File : GFile;
    public mutable Start : int;
    public mutable Body : int;
    public mutable End : int;
    public Names : SCG.List[string] = SCG.List();
  }
#endif
