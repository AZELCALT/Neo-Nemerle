// `ncc init`, `ncc build`, `ncc run` and `ncc clean`: the project commands (see Nemerle/Compiler/project.n for the
// project file). A build compiles the project in a compiler process of its own, after the projects it uses, and
// skips the compilation when nothing it depends on changed.
using System;
using System.IO;
using System.Diagnostics;
using System.Linq;
using System.Reflection;
using SCG = System.Collections.Generic;
using Nemerle.Collections;
using Nemerle.Imperative;
using Nemerle.Compiler.project;

internal module Projects
{
  Commands : list[string] = ["init", "build", "run", "pack", "clean"];

  /// A failed step, already reported.
  class Failed : Exception { public Code : int; public this(code : int) { Code = code } }

  /// The command among the arguments: the first argument that is not an option, when it names a command.
  public IsCommand(args : list[string]) : bool
  {
    match (args.Find(a => !a.StartsWith("-", StringComparison.Ordinal)))
    {
      | Some(word) => Commands.Contains(word)
      | None => false
    }
  }

  Usage : string = "usage: ncc init [folder] [--lib] [--name NAME]\n"
                 + "       ncc build [project] [compiler options] [--offline]\n"
                 + "       ncc run [project] [compiler options] [--offline] [-- program arguments]\n"
                 + "       ncc pack [project] [compiler options] [--offline]\n"
                 + "       ncc clean [project]\n"
                 + "A project is a folder with one .nproj file; [project] is that folder or file (default: the current folder).";

  public Run(args : list[string]) : int
  {
    // options before the command (the launcher's -target-references) apply to every compilation
    def all = args.ToArray();
    mutable at = 0;
    while (at < all.Length && all[at].StartsWith("-", StringComparison.Ordinal)) at++;
    def before = all.Take(at).NToList();
    def command = all[at];
    def rest = all.Skip(at + 1).NToList();
    try
    {
      match (command)
      {
        | "init" => Init(rest)
        | _ =>
          def split = Array.IndexOf(all, "--", at + 1);
          def (own, programArgs) = if (split < 0) (rest, []) else (all.Skip(at + 1).Take(split - at - 1).NToList(), all.Skip(split + 1).NToList());
          def positional = own.Filter(a => !a.StartsWith("-", StringComparison.Ordinal));
          def options = own.Filter(a => a.StartsWith("-", StringComparison.Ordinal) && a != "--offline");
          def offline = own.Contains("--offline");
          when (positional.Length > 1) { Console.Error.WriteLine(Usage); throw Failed(2) }
          def place = match (positional) { | [p] => p | _ => "." };
          def file = match (Project.Find(place))
          {
            | null =>
              Console.Error.WriteLine("ncc: no project in " + Path.GetFullPath(place) + " (a folder with one " + Project.Extension + " file; `ncc init' makes one)");
              throw Failed(1)
            | f => f
          };
          match (command)
          {
            | "clean" => Clean(Project.Load(file))
            | "build" => _ = Build(file, before + options, offline, []); 0
            | "pack" => Pack(file, before + options, offline)
            | _ =>
              def project = Project.Load(file);
              unless (project.IsProgram)
              {
                Console.Error.WriteLine("ncc: " + project.Name + " is a library: there is nothing to run (a program has " + project.Main + ")");
                throw Failed(1)
              }
              def binary = Build(file, before + options, offline, []);
              def info = ProcessStartInfo("dotnet"); info.UseShellExecute = false;
              info.ArgumentList.Add(binary);
              foreach (a in programArgs) info.ArgumentList.Add(a);
              def process = Process.Start(info);
              process.WaitForExit();
              process.ExitCode
          }
      }
    }
    catch
    {
      | e is ProjectException => Console.Error.WriteLine(e.ToString()); 1
      | e is Failed => e.Code
    }
  }

  // ---- init ----

  Init(args : list[string]) : int
  {
    mutable folder = ".";
    mutable name = null;
    mutable library = false;
    def loop(a)
    {
      | "--lib" :: more => library = true; loop(more)
      | "--name" :: n :: more => name = n; loop(more)
      | o :: _ when o.StartsWith("-", StringComparison.Ordinal) => Console.Error.WriteLine(Usage); throw Failed(2)
      | f :: more => folder = f; loop(more)
      | [] => ()
    }
    loop(args);
    def root = Path.GetFullPath(folder);
    when (name == null) name = Path.GetFileName(root.TrimEnd(Path.DirectorySeparatorChar));
    def valid(n : string) { n.Length > 0 && (char.IsLetter(n[0]) || n[0] == '_') && n.ToCharArray().ForAll(c => char.IsLetterOrDigit(c) || c == '_' || c == '-' || c == '.') }
    unless (valid(name))
    {
      Console.Error.WriteLine("ncc: `" + name + "' is not a project name (letters, digits, `_', `-', `.'); give one with --name");
      throw Failed(1)
    }
    when (Directory.Exists(root) && Directory.GetFiles(root, "*" + Project.Extension).Length > 0)
    {
      Console.Error.WriteLine("ncc: " + root + " is already a project");
      throw Failed(1)
    }
    _ = Directory.CreateDirectory(root);
    def write(file : string, text : string) : void
    {
      def path = Path.Combine(root, file);
      if (File.Exists(path)) Console.WriteLine("  kept " + file + " (it exists)")
      else { File.WriteAllText(path, text); Console.WriteLine("  " + file) }
    }
    Console.WriteLine("Created " + (if (library) "library" else "program") + " " + name + " in " + root + ":");
    write(name + Project.Extension, Project.Template(name, library));
    if (library)
    {
      // a library's file is its module: `using <file>;` imports it
      def moduleName = if (name.ToCharArray().ForAll(c => char.IsLetterOrDigit(c) || c == '_')) name else "library";
      write(moduleName + ".n",
            "// A library. Every file is a module named by its path (this one is `" + moduleName + "'); a program imports it\n"
            "// with `using " + moduleName + ";` and calls `" + moduleName + ".Greet(...)`.\n\n"
            "public Greet(who : string) : string\n{\n  $\"Hello, $who!\"\n}\n")
    }
    else
      write("main.n",
            "// The program starts here: the top-level code of main.n is its Main.\n\n"
            "System.Console.WriteLine(\"Hello from " + name + "!\");\n");
    write(".gitignore", "out/\n");
    def go = if (folder == ".") "" else "cd " + folder + " && ";
    Console.WriteLine("Next: " + go + (if (library) "ncc build" else "ncc run"));
    0
  }

  // ---- clean ----

  Clean(project : Project) : int
  {
    def output = project.OutputDirectory;
    // only a folder inside the project
    if (output.StartsWith(project.Root + Path.DirectorySeparatorChar, StringComparison.Ordinal) && Directory.Exists(output))
    {
      Directory.Delete(output, true);
      Console.WriteLine(project.Name + ": removed " + Path.GetRelativePath(project.Root, output));
    }
    else Console.WriteLine(project.Name + ": nothing to clean");
    0
  }

  // ---- build ----

  /// Builds the project of `file` (after the projects it uses) and returns its binary.
  Build(file : string, options : list[string], offline : bool, building : list[string]) : string
  {
    def project = Project.Load(file);
    foreach (w in project.Warnings) Console.Error.WriteLine("warning: " + w);
    when (building.Contains(project.File))
      throw ProjectException(project.File, 1, 1, "the projects use each other in a cycle: " + string.Join(" -> ", (project.File :: building).Reverse().Map(Path.GetFileName).ToArray()));
    def compileReferences = SCG.List.[string]();
    def runtimeFiles = SCG.List.[string]();   // to copy next to the binary
    // the projects it uses
    foreach (reference in project.Projects)
    {
      def found = match (Project.Find(Path.Combine(project.Root, reference)))
      {
        | null => throw project.Error("references.projects", reference, "the project `" + reference + "' does not exist (no folder with a " + Project.Extension + " file there)")
        | f => f
      };
      def used = Project.Load(found);
      when (used.IsProgram)
        throw project.Error("references.projects", reference, "`" + reference + "' is a program; a project uses libraries only");
      // what this project runs on must be able to load the used one
      def mine = TargetOf(project); def theirs = TargetOf(used);
      def host = Nemerle.Platform.ClrTarget.Host;
      def usable = match ((mine, theirs))
      {
        | (_, t) when t != null && t.Family == "netstandard" => mine == null || mine.Family != "netstandard" || t.Version <= mine.Version
        | (null, null) => true
        | (null, t) => t.Family == "netcore" && t.Version.Major <= host.Version.Major && t.Platform == null
        | (m, null) => m.Family == "netcore" && m.Version.Major >= host.Version.Major
        | (m, t) => m.Family == t.Family && t.Version <= m.Version && (t.Platform == null || t.Platform == m.Platform)
      };
      unless (usable)
        throw project.Error("references.projects", reference, "`" + reference + "' is built for " + (if (theirs == null) host.Name else theirs.Name)
                            + ", which " + (if (mine == null) host.Name else mine.Name) + " cannot load; give it a target this project can use, such as netstandard2.0");
      def binary = Build(found, options, offline, project.File :: building);
      compileReferences.Add(binary); runtimeFiles.Add(binary);
      runtimeFiles.AddRange(ReadList(Path.Combine(used.OutputDirectory, used.Name + ".runtime")));
      compileReferences.AddRange(ReadList(used.ReferencesFile));
    }
    foreach (assembly in project.Assemblies)
    {
      def path = Path.GetFullPath(Path.Combine(project.Root, assembly));
      unless (File.Exists(path)) throw project.Error("references.assemblies", assembly, "the assembly `" + assembly + "' does not exist");
      compileReferences.Add(path); runtimeFiles.Add(path);
    }
    // an MSBuild project's references to the toolchain's own assemblies (Nemerle.Compiler, ...)
    def toolchainDir = Path.GetDirectoryName(Assembly.GetEntryAssembly().Location);
    foreach (name in project.Toolchain)
    {
      def path = Path.Combine(toolchainDir, name + ".dll");
      // Nemerle.dll and the standard macros are always there
      when (File.Exists(path) && name != "Nemerle" && name != "Nemerle.Macros") { compileReferences.Add(path); runtimeFiles.Add(path) }
    }
    unless (project.Packages.Count == 0) ResolvePackages(project, offline, compileReferences, runtimeFiles);
    // a target other than the compiler's own .NET: its reference assemblies (fetched once), and the runtime library
    // built for .NET Standard 2.0, which every target can load
    def target = TargetOf(project);
    def targetOptions = SCG.List.[string]();
    mutable runtimeLibrary = Path.Combine(toolchainDir, "Nemerle.dll");
    when (target != null)
    {
      targetOptions.Add("-target-framework:" + target.Name);
      // the base .NET's reference assemblies: the compiler's own when the base is its .NET (net10.0-windows)
      unless (target.Base.SameAs(Nemerle.Platform.ClrTarget.Host))
        targetOptions.Add("-target-references:" + FetchReferences(project, target, offline));
      // a platform's own assemblies are compiled against; its workload (or the desktop runtime) provides them
      match (FetchPlatform(project, target, offline))
      {
        | null => ()
        | folder =>
          // what the base .NET's references have too (the desktop pack repeats Microsoft.VisualBasic, ...) comes
          // from the base; a name the base has only as a facade (WindowsBase) is the platform's
          def host = Path.GetDirectoryName(typeof(object).Assembly.Location);
          def facade(path : string) { try { System.Reflection.Metadata.PEReaderExtensions.GetMetadataReader(System.Reflection.PortableExecutable.PEReader(File.OpenRead(path))).TypeDefinitions.Count <= 1 } catch { | _ => false } }
          foreach (dll in Directory.GetFiles(folder, "*.dll"))
          {
            def same = Path.Combine(host, Path.GetFileName(dll));
            when (!File.Exists(same) || facade(same) && !facade(dll)) compileReferences.Add(dll)
          }
      }
      runtimeLibrary = Path.Combine(toolchainDir, "netstandard2.0", "Nemerle.dll");
      unless (File.Exists(runtimeLibrary))
        throw project.Error("target", null, "this toolchain has no Nemerle.dll for .NET Standard 2.0 (netstandard2.0/Nemerle.dll), which " + target.Name + " programs need; rebuild it with ./bootstrap while online");
    }
    def references = compileReferences.Distinct().ToList();

    def sources = project.Sources();
    when (sources.Count == 0) throw ProjectException(project.File, 1, 1, "the project has no .n files");
    def output = project.OutputDirectory;
    _ = Directory.CreateDirectory(output);
    def stampFile = Path.Combine(output, project.Name + ".stamp");
    def stamp = Stamp(project, sources, references, options + targetOptions.NToList());
    def binary = project.Binary;
    if (File.Exists(binary) && File.Exists(stampFile) && File.ReadAllText(stampFile) == stamp)
      Console.WriteLine(project.Name + ": up to date")
    else
    {
      def started = Stopwatch.StartNew();
      def arguments = SCG.List.[string]();
      arguments.AddRange(options);
      arguments.AddRange(targetOptions); // after the launcher's -target-references, which they replace
      arguments.Add("-source-root:" + project.Root);
      arguments.Add("-out:" + binary);
      arguments.Add(if (project.IsProgram) "-target:exe" else "-target:library");
      when (project.IsProgram && project.Main != "main.n")
      {
        def main = Path.GetFullPath(Path.Combine(project.Root, project.Main));
        unless (File.Exists(main)) throw project.Error("main", null, "the main file `" + project.Main + "' does not exist");
        def relative = Path.GetRelativePath(project.Root, main);
        arguments.Add("-main:" + Path.ChangeExtension(relative, null).Replace(Path.DirectorySeparatorChar, '.'));
      }
      foreach (r in references) arguments.Add("-r:" + r);
      arguments.AddRange(project.Options);
      arguments.AddRange(sources);
      File.Delete(stampFile);
      def info = ProcessStartInfo("dotnet"); info.UseShellExecute = false;
      info.ArgumentList.Add(Assembly.GetEntryAssembly().Location);
      foreach (a in arguments) info.ArgumentList.Add(a);
      def process = Process.Start(info);
      process.WaitForExit();
      unless (process.ExitCode == 0 && File.Exists(binary))
      {
        Console.Error.WriteLine(project.Name + ": the build failed");
        throw Failed(if (process.ExitCode == 0) 1 else process.ExitCode)
      }
      File.WriteAllText(stampFile, stamp);
      Console.WriteLine(project.Name + ": built " + Path.GetRelativePath(Environment.CurrentDirectory, binary)
                        + " (" + sources.Count.ToString() + " file" + (if (sources.Count == 1) "" else "s") + ", "
                        + (started.ElapsedMilliseconds / 100 / 10.0).ToString(Globalization.CultureInfo.InvariantCulture) + " s)");
    }
    // the runtime: Nemerle.dll and what the references need, next to the binary
    def runtime = runtimeLibrary :: runtimeFiles.Distinct().NToList();
    foreach (f in runtime)
    {
      def target = Path.Combine(output, Path.GetFileName(f));
      unless (string.Equals(Path.GetFullPath(f), target, StringComparison.Ordinal) || File.Exists(target) && File.GetLastWriteTimeUtc(target) == File.GetLastWriteTimeUtc(f) && FileInfo(target).Length == FileInfo(f).Length)
        File.Copy(f, target, true);
    }
    // a program's launcher, next to its .dll
    when (project.Launcher != null) MakeLauncher(project, binary, offline);
    File.WriteAllLines(project.ReferencesFile, references);
    File.WriteAllLines(Path.Combine(output, project.Name + ".runtime"), runtimeFiles.Distinct());
    binary
  }

  /// The project's target, or null when it is the compiler's own .NET.
  TargetOf(project : Project) : Nemerle.Platform.ClrTarget
  {
    if (project.Target == null) null
    else
    {
      def target = try { Nemerle.Platform.ClrTarget.Parse(project.Target) } catch { | e is ArgumentException => throw project.Error("target", null, e.Message) };
      if (target.SameAs(Nemerle.Platform.ClrTarget.Host) && target.Platform == null) null else target
    }
  }

  /// The cache of reference packages (in the user's data folder).
  CacheRoot : string
  {
    get
    {
      def data = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData, Environment.SpecialFolderOption.Create);
      Path.Combine(if (data == "") Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".local", "share") else data,
                   "Nemerle", "references")
    }
  }

  Feed : string { get { (Environment.GetEnvironmentVariable("NEMERLE_REFERENCE_FEED") ?? "https://api.nuget.org/v3-flatcontainer/").TrimEnd('/') } }

  /// The base .NET's reference assemblies of the target.
  FetchReferences(project : Project, target : Nemerle.Platform.ClrTarget, offline : bool) : string
  {
    mutable id; mutable version; mutable folder;
    target.Base.ReferencePackage(out id, out version, out folder);
    FetchPackage(project, target.Name + " reference assemblies", id, version, folder, offline)
  }

  /// A package from the feed, downloaded once into the cache; the path of `folder` inside it.
  FetchPackage(project : Project, what : string, id : string, version : string, folder : string, offline : bool) : string
  {
    def cache = Path.Combine(CacheRoot, id.ToLowerInvariant(), version);
    def references = Path.Combine(cache, folder.Replace('/', Path.DirectorySeparatorChar));
    unless (Directory.Exists(references))
    {
      def fail(message : string) : Exception
      {
        if (project == null) ProjectException("", 1, 1, message) else project.Error("target", null, message)
      }
      when (offline) throw fail("the " + what + " (" + id + " " + version + ") are not in the cache, and --offline does not download them");
      def lower = id.ToLowerInvariant();
      def url = Feed + "/" + lower + "/" + version + "/" + lower + "." + version + ".nupkg";
      Console.WriteLine((if (project == null) "ncc" else project.Name) + ": fetching the " + what + " (" + id + " " + version + ")");
      def pending = cache + ".partial";
      try
      {
        when (Directory.Exists(pending)) Directory.Delete(pending, true);
        _ = Directory.CreateDirectory(pending);
        def bytes = if (File.Exists(url)) File.ReadAllBytes(url)
                    else using (client = Client()) client.GetByteArrayAsync(url).GetAwaiter().GetResult();
        using (archive = IO.Compression.ZipArchive(MemoryStream(bytes)))
          foreach (entry in archive.Entries)
          {
            def destination = Path.GetFullPath(Path.Combine(pending, entry.FullName));
            when (destination.StartsWith(pending + Path.DirectorySeparatorChar, StringComparison.Ordinal) && entry.Name.Length > 0)
            {
              _ = Directory.CreateDirectory(Path.GetDirectoryName(destination));
              using (input = entry.Open(), output = File.Create(destination)) input.CopyTo(output);
            }
          }
        unless (Directory.Exists(Path.Combine(pending, folder.Replace('/', Path.DirectorySeparatorChar))))
          throw InvalidDataException(id + " " + version + " has no " + folder);
        when (Directory.Exists(cache)) Directory.Delete(cache, true);
        Directory.Move(pending, cache);
      }
      catch
      {
        | e is ProjectException => throw e
        | e => throw fail("could not fetch the " + what + " from " + url + ": " + e.Message)
      }
    }
    references
  }

  // ---- platform reference packs (net8.0-windows, net9.0-android35.0, net9.0-ios18.0, ...) ----

  Get(url : string) : string { using (client = Client()) client.GetStringAsync(url).GetAwaiter().GetResult() }

  // reference packs are large (an Android one is 60 MB): a long timeout
  Client() : Net.Http.HttpClient { def c = Net.Http.HttpClient(); c.Timeout = TimeSpan(0, 20, 0); c }

  /// The stable versions of a package on the feed (offline: the ones in the cache), lowest first.
  Versions(id : string, offline : bool) : list[string]
  {
    def stable(v : string) { !v.Contains("-") }
    def all = if (offline)
      {
        def dir = Path.Combine(CacheRoot, id.ToLowerInvariant());
        if (Directory.Exists(dir)) Directory.GetDirectories(dir).Map(Path.GetFileName).Filter(v => !v.EndsWith(".partial", StringComparison.Ordinal)).NToList() else []
      }
      else try
      {
        def json = Text.Json.JsonDocument.Parse(Get(Feed + "/" + id.ToLowerInvariant() + "/index.json"));
        json.RootElement.GetProperty("versions").EnumerateArray().Map(e => e.GetString()).NToList()
      }
      catch { | _ => [] };
    def parse(v : string) { mutable x; if (Version.TryParse(v, out x)) x else Version(0, 0) }
    all.Filter(stable).Sort((a, b) => parse(a).CompareTo(parse(b)))
  }

  /// The ids of the packages whose id starts with `prefix` (nuget.org's search; offline: the cache's).
  Ids(prefix : string, offline : bool) : list[string]
  {
    if (offline)
    {
      if (Directory.Exists(CacheRoot)) Directory.GetDirectories(CacheRoot).Map(Path.GetFileName).Filter(d => d.StartsWith(prefix.ToLowerInvariant(), StringComparison.Ordinal)).NToList() else []
    }
    else try
    {
      def index = Text.Json.JsonDocument.Parse(Get("https://api.nuget.org/v3/index.json"));
      def search = index.RootElement.GetProperty("resources").EnumerateArray()
        .Find(r => r.GetProperty("@type").GetString().StartsWith("SearchQueryService", StringComparison.Ordinal));
      def result = Text.Json.JsonDocument.Parse(Get(search.Value.GetProperty("@id").GetString() + "?q=" + Uri.EscapeDataString(prefix) + "&prerelease=false&take=200"));
      result.RootElement.GetProperty("data").EnumerateArray().Map(e => e.GetProperty("id").GetString())
        .Filter(i => i.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) && !i.EndsWith(".Msi.x64", StringComparison.OrdinalIgnoreCase) && !i.EndsWith(".Msi.arm64", StringComparison.OrdinalIgnoreCase)).NToList()
    }
    catch { | _ => [] }
  }

  /// The platform's reference assemblies (Mono.Android, Microsoft.iOS, WinForms and WPF, ...) for a platform
  /// target, which its code compiles against; null for a target without a platform.
  FetchPlatform(project : Project, target : Nemerle.Platform.ClrTarget, offline : bool) : string
  {
    if (target.Platform == null) null
    else
    {
      def net = target.Version.Major.ToString() + "." + target.Version.Minor.ToString();
      def folder = "ref/net" + net;
      def failed(message : string) : ProjectException { project.Error("target", null, message) }
      def newest(id : string, prefix : string) : string
      {
        match (Versions(id, offline).Filter(v => prefix == null || v.StartsWith(prefix, StringComparison.Ordinal)).Rev())
        {
          | v :: _ => v
          | [] => throw failed("no version of " + id + (if (prefix != null) " " + prefix + "*" else "") + " is " + (if (offline) "in the cache (--offline)" else "on the feed"))
        }
      }
      def (id, version) = match (target.Platform)
      {
        | "windows" => ("Microsoft.WindowsDesktop.App.Ref", newest("Microsoft.WindowsDesktop.App.Ref", net + "."))
        | "android" =>
          // one package per API level: the one named, else the newest that has this .NET's folder
          def level = if (target.PlatformVersion != null) target.PlatformVersion.Split('.')[0] else null;
          def candidates = if (level != null) ["Microsoft.Android.Ref." + level]
                           else Ids("Microsoft.Android.Ref.", offline).Filter(i => { mutable n; int.TryParse(i.Substring("Microsoft.Android.Ref.".Length), out n) })
                                  .Sort((a, b) => int.Parse(b.Substring(22)).CompareTo(int.Parse(a.Substring(22))));
          def fits = candidates.Find(i => !Versions(i, offline).IsEmpty);
          match (fits) { | Some(i) => (i, newest(i, null)) | None => throw failed("no Android reference package for " + target.Name + " is on the feed") }
        | apple =>
          def name = match (apple) { | "ios" => "iOS" | "maccatalyst" => "MacCatalyst" | "macos" => "macOS" | _ => "tvOS" };
          if (target.Version.Major < 9)
          {
            def id = "Microsoft." + name + ".Ref";
            (id, newest(id, null))
          }
          else
          {
            // from .NET 9 one package per .NET and OS version: Microsoft.iOS.Ref.net9.0_18.0
            def prefix = "Microsoft." + name + ".Ref.net" + net + "_";
            def ids = if (target.PlatformVersion != null) [prefix + target.PlatformVersion] else Ids(prefix, offline);
            def osVersion(i : string) { mutable v; if (Version.TryParse(i.Substring(prefix.Length), out v)) v else Version(0, 0) };
            match (ids.Filter(i => !Versions(i, offline).IsEmpty).Sort((a, b) => osVersion(b).CompareTo(osVersion(a))))
            {
              | i :: _ => (i, newest(i, null))
              | [] => throw failed("no " + name + " reference package for " + target.Name + " is " + (if (offline) "in the cache (--offline)" else "on the feed"))
            }
          }
      };
      FetchPackage(project, target.Platform + " reference assemblies", id, version, folder, offline)
    }
  }

  // ---- pack ----

  /// The id of the package that carries the runtime library (upstream's packages took Nemerle and Nemerle.Runtime).
  RuntimePackage : string = "Neo.Nemerle.Runtime";

  /// Builds a library project and writes its NuGet package (and the runtime package it depends on) into out/.
  Pack(file : string, options : list[string], offline : bool) : int
  {
    def project = Project.Load(file);
    when (project.IsProgram)
      throw ProjectException(project.File, 1, 1, project.Name + " is a program; `ncc pack' packs libraries (kind = \"library\")");
    def binary = Build(file, options, offline, []);
    def toolchain = Path.GetDirectoryName(Assembly.GetEntryAssembly().Location);
    def runtimeVersion = AssemblyName.GetAssemblyName(Path.Combine(toolchain, "Nemerle.dll")).Version.ToString();
    def target = TargetOf(project);
    def tfm = if (target == null) Nemerle.Platform.ClrTarget.Host.Name else target.Name;
    def escape(s : string) { Security.SecurityElement.Escape(s) }
    // dependencies: the runtime, the NuGet packages, and the projects it uses (as their packages)
    def dependencies = Text.StringBuilder();
    def dependency(id : string, version : string) : void
    {
      _ = dependencies.Append("        <dependency id=\"").Append(escape(id)).Append("\" version=\"").Append(escape(version)).Append("\" exclude=\"Build,Analyzers\" />\n")
    }
    dependency(RuntimePackage, runtimeVersion);
    foreach (p in project.Packages) dependency(p.Id, p.Version);
    foreach (reference in project.Projects)
    {
      def used = Project.Load(Project.Find(Path.Combine(project.Root, reference)));
      dependency(used.Name, used.Version)
    }
    def nuspec = Text.StringBuilder();
    _ = nuspec.Append("<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<package xmlns=\"http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd\">\n  <metadata>\n");
    _ = nuspec.Append("    <id>").Append(escape(project.Name)).Append("</id>\n");
    _ = nuspec.Append("    <version>").Append(escape(project.Version)).Append("</version>\n");
    _ = nuspec.Append("    <authors>").Append(escape(project.Authors ?? project.Name)).Append("</authors>\n");
    _ = nuspec.Append("    <description>").Append(escape(project.Description ?? project.Name + ", a Nemerle library")).Append("</description>\n");
    when (project.License != null) _ = nuspec.Append("    <license type=\"expression\">").Append(escape(project.License)).Append("</license>\n");
    when (project.Repository != null) _ = nuspec.Append("    <repository type=\"git\" url=\"").Append(escape(project.Repository)).Append("\" />\n");
    _ = nuspec.Append("    <tags>").Append(escape(string.Join(" ", ("nemerle" :: project.Tags.NToList()).ToArray()))).Append("</tags>\n");
    // the package's icon, from the [package] section
    mutable icon = null;
    when (project.Icon != null)
    {
      icon = Path.GetFullPath(Path.Combine(project.Root, project.Icon));
      unless (File.Exists(icon)) throw project.Error("package.icon", null, "the icon `" + project.Icon + "' does not exist");
      unless ([".png", ".jpg", ".jpeg"].Contains(Path.GetExtension(icon).ToLowerInvariant()))
        throw project.Error("package.icon", null, "a package icon is a PNG or JPEG file");
      _ = nuspec.Append("    <icon>").Append(escape(Path.GetFileName(icon))).Append("</icon>\n");
    }
    _ = nuspec.Append("    <dependencies>\n      <group targetFramework=\"").Append(tfm).Append("\">\n").Append(dependencies.ToString()).Append("      </group>\n    </dependencies>\n");
    _ = nuspec.Append("  </metadata>\n</package>\n");
    def files = SCG.List.[string * string](); // (path in the package, file)
    files.Add(("lib/" + tfm + "/" + Path.GetFileName(binary), binary));
    when (icon != null) files.Add((Path.GetFileName(icon), icon));
    def pdb = Path.ChangeExtension(binary, ".pdb");
    when (File.Exists(pdb)) files.Add(("lib/" + tfm + "/" + Path.GetFileName(pdb), pdb));
    def output = Path.Combine(project.OutputDirectory, project.Name + "." + project.Version + ".nupkg");
    WritePackage(output, project.Name, nuspec.ToString(), files);
    Console.WriteLine(project.Name + ": packed " + Path.GetRelativePath(Environment.CurrentDirectory, output));
    // the runtime package, for every target the toolchain has a Nemerle.dll for
    def runtime = Path.Combine(project.OutputDirectory, RuntimePackage + "." + runtimeVersion + ".nupkg");
    unless (File.Exists(runtime))
    {
      def lib = SCG.List.[string * string]();
      lib.Add(("lib/" + Nemerle.Platform.ClrTarget.Host.Name + "/Nemerle.dll", Path.Combine(toolchain, "Nemerle.dll")));
      def standard = Path.Combine(toolchain, "netstandard2.0", "Nemerle.dll");
      when (File.Exists(standard)) lib.Add(("lib/netstandard2.0/Nemerle.dll", standard));
      // Nemerle's logo, which the toolchain carries
      def logo = Path.Combine(toolchain, "nemerle-icon.png");
      def hasLogo = File.Exists(logo);
      when (hasLogo) lib.Add(("icon.png", logo));
      def spec = "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<package xmlns=\"http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd\">\n  <metadata>\n"
               + "    <id>" + RuntimePackage + "</id>\n    <version>" + runtimeVersion + "</version>\n    <authors>Neo-Nemerle</authors>\n"
               + "    <description>The Nemerle runtime library (Nemerle.dll), which libraries and programs written in Nemerle use.</description>\n"
               + "    <license type=\"expression\">BSD-3-Clause</license>\n    <repository type=\"git\" url=\"https://github.com/AZELCALT/Neo-Nemerle\" />\n"
               + "    <tags>nemerle runtime</tags>\n" + (if (hasLogo) "    <icon>icon.png</icon>\n" else "") + "  </metadata>\n</package>\n";
      WritePackage(runtime, RuntimePackage, spec, lib);
      Console.WriteLine(project.Name + ": packed " + Path.GetRelativePath(Environment.CurrentDirectory, runtime) + " (the runtime it depends on)");
    }
    0
  }

  /// A .nupkg: an Open Packaging zip with the nuspec at its root.
  WritePackage(path : string, id : string, nuspec : string, files : SCG.IEnumerable[string * string]) : void
  {
    when (File.Exists(path)) File.Delete(path);
    using (archive = IO.Compression.ZipFile.Open(path, IO.Compression.ZipArchiveMode.Create))
    {
      def text(name : string, content : string) : void
      {
        def entry = archive.CreateEntry(name);
        def bytes = Text.UTF8Encoding(false).GetBytes(content);
        using (stream = entry.Open()) stream.Write(bytes, 0, bytes.Length);
      }
      text(id + ".nuspec", nuspec);
      foreach ((name, file) in files)
        _ = IO.Compression.ZipFileExtensions.CreateEntryFromFile(archive, file, name);
      def extensions = files.Map(f => Path.GetExtension(f[0]).TrimStart('.')).Distinct().ToArray();
      text("[Content_Types].xml", "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\">"
           + "<Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\" />"
           + "<Default Extension=\"nuspec\" ContentType=\"application/octet\" />"
           + string.Concat(extensions.Map(e => "<Default Extension=\"" + e + "\" ContentType=\"application/octet\" />")) + "</Types>\n");
      text("_rels/.rels", "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">"
           + "<Relationship Type=\"http://schemas.microsoft.com/packaging/2010/07/manifest\" Target=\"/" + id + ".nuspec\" Id=\"R1\" /></Relationships>\n");
    }
  }

  // ---- the launcher (the .NET apphost) ----

  /// The placeholder in the apphost template where the app's file name is written.
  static AppPlaceholder : string = "c3ab8ff13720e8ad9047dd39466b3c8974e592c2fa383d4a3960714caef0c4f2";

  /// The runtime identifier the launcher is built for: the target's platform (windows) or this machine's.
  static LauncherRid(target : string) : string
  {
    def arch = match (Runtime.InteropServices.RuntimeInformation.OSArchitecture)
    {
      | Runtime.InteropServices.Architecture.Arm64 => "arm64" | Runtime.InteropServices.Architecture.X86 => "x86"
      | Runtime.InteropServices.Architecture.Arm => "arm" | _ => "x64"
    };
    def os = if (WindowsTarget(target)) "win"
             else if (Runtime.InteropServices.RuntimeInformation.IsOSPlatform(Runtime.InteropServices.OSPlatform.Windows)) "win"
             else if (Runtime.InteropServices.RuntimeInformation.IsOSPlatform(Runtime.InteropServices.OSPlatform.OSX)) "osx"
             else "linux";
    os + "-" + arch
  }

  /// The apphost template for a runtime identifier: from an installed SDK's host pack, else from nuget.org (into the
  /// cache); null when there is none to be had.
  static LauncherTemplate(project : Project, rid : string, offline : bool) : string
  {
    def file = if (rid.StartsWith("win", StringComparison.Ordinal)) "apphost.exe" else "apphost";
    // an SDK's host packs (dotnet/packs/Microsoft.NETCore.App.Host.<rid>/<version>/runtimes/<rid>/native); a Linux
    // distribution may name its own (artix-x64), which serves the same machine
    def runtimeDir = Path.GetDirectoryName(typeof(object).Assembly.Location);              // shared/Microsoft.NETCore.App/<v>
    def packs = Path.Combine(Path.GetDirectoryName(Path.GetDirectoryName(Path.GetDirectoryName(runtimeDir))), "packs");
    def arch = rid.Substring(rid.IndexOf('-') + 1);
    def local = if (!Directory.Exists(packs)) null else
    {
      def mine = Directory.GetDirectories(packs, "Microsoft.NETCore.App.Host.*")
        .Where(d => { def r = Path.GetFileName(d).Substring("Microsoft.NETCore.App.Host.".Length);
                      r == rid || !rid.StartsWith("win", StringComparison.Ordinal) && !rid.StartsWith("osx", StringComparison.Ordinal)
                                  && !r.StartsWith("win", StringComparison.Ordinal) && !r.StartsWith("osx", StringComparison.Ordinal) && r.EndsWith("-" + arch, StringComparison.Ordinal) });
      mine.SelectMany(d => Directory.GetFiles(d, file, SearchOption.AllDirectories)).OrderByDescending(f => f).FirstOrDefault()
    };
    if (local != null) local
    else
    {
      def id = "Microsoft.NETCore.App.Host." + rid;
      def wanted = Environment.Version.Major.ToString() + "." + Environment.Version.Minor.ToString() + ".";
      def version = match (Versions(id, offline).Filter(v => v.StartsWith(wanted, StringComparison.Ordinal)).Rev())
      {
        | v :: _ => v
        | [] => null
      };
      if (version == null) null
      else
        try { Path.Combine(FetchPackage(project, "launcher (" + rid + ")", id, version, "runtimes/" + rid + "/native", offline), file) }
        catch { | _ is ProjectException => null }
    }
  }

  /// Writes the program's launcher: the apphost template with the .dll's name in its placeholder (as the .NET SDK
  /// does), executable, re-signed on macOS. Without a template the program still runs with `dotnet name.dll`.
  /// A target for Windows (`net10.0-windows`): its launcher is a Windows one, whatever builds it.
  public static WindowsTarget(target : string) : bool
  {
    target != null && target.IndexOf("-windows", StringComparison.OrdinalIgnoreCase) >= 0
  }

  static MakeLauncher(project : Project, binary : string, offline : bool) : void
  {
    WriteLauncher(project.Launcher, binary, project.Target, project, offline)
  }

  /// Writes `launcher` for the program `binary` (a .NET assembly, which the launcher names by its file name); a
  /// warning instead when there is no template. `project` may be null (a single-file compile).
  public static WriteLauncher(launcher : string, binary : string, target : string, project : Project, offline : bool) : void
  {
    def label = if (project == null) "ncc" else project.Name;
    def rid = LauncherRid(target);
    match (LauncherTemplate(project, rid, offline))
    {
      | null => Console.Error.WriteLine("warning: " + label + ": no launcher for " + rid + " (no .NET SDK host pack here, and none could be fetched); run it with `dotnet " + Path.GetFileName(binary) + "`")
      | template =>
        def bytes = File.ReadAllBytes(template);
        def placeholder = Text.Encoding.UTF8.GetBytes(AppPlaceholder);
        def name = Text.Encoding.UTF8.GetBytes(Path.GetFileName(binary));
        def at = IndexOf(bytes, placeholder);
        def file = if (project == null) "" else project.File;
        when (at < 0) throw ProjectException(file, 1, 1, "the launcher template " + template + " has no app placeholder");
        when (name.Length >= 1024) throw ProjectException(file, 1, 1, "the program's file name is too long for its launcher");
        for (mutable i = 0; i < placeholder.Length; i++) bytes[at + i] = 0;
        Array.Copy(name, 0, bytes, at, name.Length);
        // only rewrite a launcher that differs (an unchanged one keeps its time stamp)
        unless (File.Exists(launcher) && File.ReadAllBytes(launcher).SequenceEqual(bytes))
        {
          File.WriteAllBytes(launcher, bytes);
          unless (Runtime.InteropServices.RuntimeInformation.IsOSPlatform(Runtime.InteropServices.OSPlatform.Windows))
            File.SetUnixFileMode(launcher, File.GetUnixFileMode(launcher) | UnixFileMode.UserExecute | UnixFileMode.GroupExecute | UnixFileMode.OtherExecute);
          // macOS refuses a patched binary whose ad-hoc signature no longer matches: sign it again
          when (Runtime.InteropServices.RuntimeInformation.IsOSPlatform(Runtime.InteropServices.OSPlatform.OSX))
            try { def sign = Process.Start("codesign", "-s - -f \"" + launcher + "\""); sign.WaitForExit() } catch { | _ => () }
        }
    }
  }

  static IndexOf(haystack : array[byte], needle : array[byte]) : int
  {
    mutable found = -1;
    for (mutable i = 0; found < 0 && i <= haystack.Length - needle.Length; i++)
    {
      mutable j = 0;
      while (j < needle.Length && haystack[i + j] == needle[j]) j++;
      when (j == needle.Length) found = i;
    }
    found
  }

  ReadList(path : string) : SCG.IEnumerable[string]
  {
    if (File.Exists(path)) File.ReadAllLines(path).Filter(l => l.Length > 0) else []
  }

  /// What the build depends on: the compiler, the project file, the sources, the references and the options.
  Stamp(project : Project, sources : SCG.List[string], references : SCG.IEnumerable[string], options : list[string]) : string
  {
    def b = Text.StringBuilder();
    def file(path : string) : void
    {
      def info = FileInfo(path);
      _ = b.Append(path).Append('|').Append(if (info.Exists) info.Length.ToString() + "|" + info.LastWriteTimeUtc.Ticks.ToString() else "missing").Append('\n');
    }
    file(Assembly.GetEntryAssembly().Location);
    file(typeof(Project).Assembly.Location);
    _ = b.Append(File.ReadAllText(project.File)).Append('\n');
    foreach (s in sources) file(s);
    foreach (r in references) file(r);
    foreach (o in options) _ = b.Append(o).Append('\n');
    // a hash of it, so the stamp file stays small
    mutable h : ulong = 14695981039346656037UL;
    unchecked foreach (c in b.ToString()) { h = (h ^ (c :> ulong)) * 1099511628211UL; }
    h.ToString("x16")
  }

  /// The project's NuGet packages, through the toolchain's NuGet adapter (the one nscript uses; its cache is shared).
  ResolvePackages(project : Project, offline : bool, compile : SCG.List[string], runtime : SCG.List[string]) : void
  {
    def toolchain = Path.GetDirectoryName(Assembly.GetEntryAssembly().Location);
    def adapter = Path.Combine(toolchain, "Nemerle.Scripting.NuGet.dll");
    unless (File.Exists(adapter))
      throw project.Error("references.packages", null, "packages need the NuGet adapter (Nemerle.Scripting.NuGet.dll), which this toolchain does not have");
    def scripting = Assembly.LoadFrom(Path.Combine(toolchain, "Nemerle.Scripting.dll"));
    def type(name : string) : Type
    {
      match (scripting.GetTypes().Find(t => t.Name == name)) { | Some(t) => t | None => throw InvalidOperationException("Nemerle.Scripting has no " + name) }
    }
    def resolverType = Assembly.LoadFrom(adapter).GetType("Nemerle.Scripting.NuGet.NuGetScriptResolver", true);
    def data = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData, Environment.SpecialFolderOption.Create);
    def cache = Path.Combine(if (data == "") Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".local", "share") else data,
                             "Nemerle", "scripting", "packages");
    // a feed folder is relative to the project
    def feeds = project.Repositories.Select(r => { mutable uri; if (Uri.TryCreate(r, UriKind.Absolute, out uri) && !uri.IsFile) r else Path.GetFullPath(Path.Combine(project.Root, r)) }).ToArray();
    def resolver = Activator.CreateInstance(resolverType, array[cache : object, feeds : object]);
    resolverType.GetProperty("Offline").SetValue(resolver, offline);
    def source = Activator.CreateInstance(type("ScriptSource"), array["" : object, project.File]);
    def data = Activator.CreateInstance(type("ScriptCollectedData"), array[source]);
    def requests = type("ScriptCollectedData").GetField("Packages").GetValue(data) :> Collections.IList;
    foreach (p in project.Packages)
    {
      def at = Activator.CreateInstance(type("ScriptDiagnostic"), array[project.File : object, 1 : object, 1 : object, "" : object, false : object]);
      _ = requests.Add(Activator.CreateInstance(type("PackageRequest"), array[p.Id : object, p.Version, at]));
    }
    def definition = Activator.CreateInstance(type("ScriptDefinition"));
    def result = try
      {
        resolverType.GetMethod("Resolve").Invoke(resolver, array[data, definition, Threading.CancellationToken.None : object])
      }
      catch
      {
        | e is TargetInvocationException =>
          def message = if (e.InnerException != null) e.InnerException.Message else e.Message;
          // at the package the message names
          def named = project.Packages.Find(p => message.IndexOf(p.Id + "/", StringComparison.OrdinalIgnoreCase) >= 0);
          throw project.Error("references.packages", if (named != null) named.Id else null, "packages: " + message)
      };
    def list(field : string) : SCG.List[string] { result.GetType().GetField(field).GetValue(result) :> SCG.List[string] }
    // the runtime library is the toolchain's own (a package of a Nemerle library depends on Neo.Nemerle.Runtime)
    def own(path : string) { Path.GetFileName(path) == "Nemerle.dll" }
    compile.AddRange(list("CompilationReferences").Filter(p => !own(p)));
    runtime.AddRange(list("RuntimeReferences").Filter(p => !own(p)));
    runtime.AddRange(list("NativeReferences"));
  }
}
