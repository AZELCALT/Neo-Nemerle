// `ncc init`, `ncc build`, `ncc run` and `ncc clean`: the project commands (see Nemerle/Compiler/project.n for the
// project file). A build compiles the project in a compiler process of its own, after the projects it uses, and
// skips the compilation when nothing it depends on changed.
using System;
using System.IO;
using System.Diagnostics;
using System.Linq;
using System.Reflection;
using SCG = System.Collections.Generic;
using Nemerle.Collections;
using Nemerle.Imperative;
using Nemerle.Compiler.project;

internal module Projects
{
  Commands : list[string] = ["init", "build", "run", "clean"];

  /// A failed step, already reported.
  class Failed : Exception { public Code : int; public this(code : int) { Code = code } }

  /// The command among the arguments: the first argument that is not an option, when it names a command.
  public IsCommand(args : list[string]) : bool
  {
    match (args.Find(a => !a.StartsWith("-", StringComparison.Ordinal)))
    {
      | Some(word) => Commands.Contains(word)
      | None => false
    }
  }

  Usage : string = "usage: ncc init [folder] [--lib] [--name NAME]\n"
                 + "       ncc build [project] [compiler options] [--offline]\n"
                 + "       ncc run [project] [compiler options] [--offline] [-- program arguments]\n"
                 + "       ncc clean [project]\n"
                 + "A project is a folder with one .nproj file; [project] is that folder or file (default: the current folder).";

  public Run(args : list[string]) : int
  {
    // options before the command (the launcher's -target-references) apply to every compilation
    def all = args.ToArray();
    mutable at = 0;
    while (at < all.Length && all[at].StartsWith("-", StringComparison.Ordinal)) at++;
    def before = all.Take(at).NToList();
    def command = all[at];
    def rest = all.Skip(at + 1).NToList();
    try
    {
      match (command)
      {
        | "init" => Init(rest)
        | _ =>
          def split = Array.IndexOf(all, "--", at + 1);
          def (own, programArgs) = if (split < 0) (rest, []) else (all.Skip(at + 1).Take(split - at - 1).NToList(), all.Skip(split + 1).NToList());
          def positional = own.Filter(a => !a.StartsWith("-", StringComparison.Ordinal));
          def options = own.Filter(a => a.StartsWith("-", StringComparison.Ordinal) && a != "--offline");
          def offline = own.Contains("--offline");
          when (positional.Length > 1) { Console.Error.WriteLine(Usage); throw Failed(2) }
          def place = match (positional) { | [p] => p | _ => "." };
          def file = match (Project.Find(place))
          {
            | null =>
              Console.Error.WriteLine("ncc: no project in " + Path.GetFullPath(place) + " (a folder with one " + Project.Extension + " file; `ncc init' makes one)");
              throw Failed(1)
            | f => f
          };
          match (command)
          {
            | "clean" => Clean(Project.Load(file))
            | "build" => _ = Build(file, before + options, offline, []); 0
            | _ =>
              def project = Project.Load(file);
              unless (project.IsProgram)
              {
                Console.Error.WriteLine("ncc: " + project.Name + " is a library: there is nothing to run (a program has " + project.Main + ")");
                throw Failed(1)
              }
              def binary = Build(file, before + options, offline, []);
              def info = ProcessStartInfo("dotnet"); info.UseShellExecute = false;
              info.ArgumentList.Add(binary);
              foreach (a in programArgs) info.ArgumentList.Add(a);
              def process = Process.Start(info);
              process.WaitForExit();
              process.ExitCode
          }
      }
    }
    catch
    {
      | e is ProjectException => Console.Error.WriteLine(e.ToString()); 1
      | e is Failed => e.Code
    }
  }

  // ---- init ----

  Init(args : list[string]) : int
  {
    mutable folder = ".";
    mutable name = null;
    mutable library = false;
    def loop(a)
    {
      | "--lib" :: more => library = true; loop(more)
      | "--name" :: n :: more => name = n; loop(more)
      | o :: _ when o.StartsWith("-", StringComparison.Ordinal) => Console.Error.WriteLine(Usage); throw Failed(2)
      | f :: more => folder = f; loop(more)
      | [] => ()
    }
    loop(args);
    def root = Path.GetFullPath(folder);
    when (name == null) name = Path.GetFileName(root.TrimEnd(Path.DirectorySeparatorChar));
    def valid(n : string) { n.Length > 0 && (char.IsLetter(n[0]) || n[0] == '_') && n.ToCharArray().ForAll(c => char.IsLetterOrDigit(c) || c == '_' || c == '-' || c == '.') }
    unless (valid(name))
    {
      Console.Error.WriteLine("ncc: `" + name + "' is not a project name (letters, digits, `_', `-', `.'); give one with --name");
      throw Failed(1)
    }
    when (Directory.Exists(root) && Directory.GetFiles(root, "*" + Project.Extension).Length > 0)
    {
      Console.Error.WriteLine("ncc: " + root + " is already a project");
      throw Failed(1)
    }
    _ = Directory.CreateDirectory(root);
    def write(file : string, text : string) : void
    {
      def path = Path.Combine(root, file);
      if (File.Exists(path)) Console.WriteLine("  kept " + file + " (it exists)")
      else { File.WriteAllText(path, text); Console.WriteLine("  " + file) }
    }
    Console.WriteLine("Created " + (if (library) "library" else "program") + " " + name + " in " + root + ":");
    write(name + Project.Extension, Project.Template(name, library));
    if (library)
    {
      // a library's file is its module: `using <file>;` imports it
      def moduleName = if (name.ToCharArray().ForAll(c => char.IsLetterOrDigit(c) || c == '_')) name else "library";
      write(moduleName + ".n",
            "// A library. Every file is a module named by its path (this one is `" + moduleName + "'); a program imports it\n"
            "// with `using " + moduleName + ";` and calls `" + moduleName + ".Greet(...)`.\n\n"
            "public Greet(who : string) : string\n{\n  $\"Hello, $who!\"\n}\n")
    }
    else
      write("main.n",
            "// The program starts here: the top-level code of main.n is its Main.\n\n"
            "System.Console.WriteLine(\"Hello from " + name + "!\");\n");
    write(".gitignore", "out/\n");
    def go = if (folder == ".") "" else "cd " + folder + " && ";
    Console.WriteLine("Next: " + go + (if (library) "ncc build" else "ncc run"));
    0
  }

  // ---- clean ----

  Clean(project : Project) : int
  {
    def output = project.OutputDirectory;
    // only a folder inside the project
    if (output.StartsWith(project.Root + Path.DirectorySeparatorChar, StringComparison.Ordinal) && Directory.Exists(output))
    {
      Directory.Delete(output, true);
      Console.WriteLine(project.Name + ": removed " + Path.GetRelativePath(project.Root, output));
    }
    else Console.WriteLine(project.Name + ": nothing to clean");
    0
  }

  // ---- build ----

  /// Builds the project of `file` (after the projects it uses) and returns its binary.
  Build(file : string, options : list[string], offline : bool, building : list[string]) : string
  {
    def project = Project.Load(file);
    when (building.Contains(project.File))
      throw ProjectException(project.File, 1, 1, "the projects use each other in a cycle: " + string.Join(" -> ", (project.File :: building).Reverse().Map(Path.GetFileName).ToArray()));
    def compileReferences = SCG.List.[string]();
    def runtimeFiles = SCG.List.[string]();   // to copy next to the binary
    // the projects it uses
    foreach (reference in project.Projects)
    {
      def found = match (Project.Find(Path.Combine(project.Root, reference)))
      {
        | null => throw project.Error("references.projects", reference, "the project `" + reference + "' does not exist (no folder with a " + Project.Extension + " file there)")
        | f => f
      };
      def used = Project.Load(found);
      when (used.IsProgram)
        throw project.Error("references.projects", reference, "`" + reference + "' is a program; a project uses libraries only");
      // what this project runs on must be able to load the used one
      def mine = TargetOf(project); def theirs = TargetOf(used);
      def host = Nemerle.Platform.ClrTarget.Host;
      def usable = match ((mine, theirs))
      {
        | (_, t) when t != null && t.Family == "netstandard" => mine == null || mine.Family != "netstandard" || t.Version <= mine.Version
        | (null, null) => true
        | (null, t) => t.Family == "netcore" && t.Version.Major <= host.Version.Major
        | (m, null) => m.Family == "netcore" && m.Version.Major >= host.Version.Major
        | (m, t) => m.Family == t.Family && t.Version <= m.Version
      };
      unless (usable)
        throw project.Error("references.projects", reference, "`" + reference + "' is built for " + (if (theirs == null) host.Name else theirs.Name)
                            + ", which " + (if (mine == null) host.Name else mine.Name) + " cannot load; give it a target this project can use, such as netstandard2.0");
      def binary = Build(found, options, offline, project.File :: building);
      compileReferences.Add(binary); runtimeFiles.Add(binary);
      runtimeFiles.AddRange(ReadList(Path.Combine(used.OutputDirectory, used.Name + ".runtime")));
      compileReferences.AddRange(ReadList(used.ReferencesFile));
    }
    foreach (assembly in project.Assemblies)
    {
      def path = Path.GetFullPath(Path.Combine(project.Root, assembly));
      unless (File.Exists(path)) throw project.Error("references.assemblies", assembly, "the assembly `" + assembly + "' does not exist");
      compileReferences.Add(path); runtimeFiles.Add(path);
    }
    // an MSBuild project's references to the toolchain's own assemblies (Nemerle.Compiler, ...)
    def toolchainDir = Path.GetDirectoryName(Assembly.GetEntryAssembly().Location);
    foreach (name in project.Toolchain)
    {
      def path = Path.Combine(toolchainDir, name + ".dll");
      // Nemerle.dll and the standard macros are always there
      when (File.Exists(path) && name != "Nemerle" && name != "Nemerle.Macros") { compileReferences.Add(path); runtimeFiles.Add(path) }
    }
    unless (project.Packages.Count == 0) ResolvePackages(project, offline, compileReferences, runtimeFiles);
    // a target other than the compiler's own .NET: its reference assemblies (fetched once), and the runtime library
    // built for .NET Standard 2.0, which every target can load
    def target = TargetOf(project);
    def targetOptions = SCG.List.[string]();
    mutable runtimeLibrary = Path.Combine(toolchainDir, "Nemerle.dll");
    when (target != null)
    {
      targetOptions.Add("-target-framework:" + target.Name);
      targetOptions.Add("-target-references:" + FetchReferences(project, target, offline));
      runtimeLibrary = Path.Combine(toolchainDir, "netstandard2.0", "Nemerle.dll");
      unless (File.Exists(runtimeLibrary))
        throw project.Error("target", null, "this toolchain has no Nemerle.dll for .NET Standard 2.0 (netstandard2.0/Nemerle.dll), which " + target.Name + " programs need; rebuild it with ./bootstrap while online");
    }
    def references = compileReferences.Distinct().ToList();

    def sources = project.Sources();
    when (sources.Count == 0) throw ProjectException(project.File, 1, 1, "the project has no .n files");
    def output = project.OutputDirectory;
    _ = Directory.CreateDirectory(output);
    def stampFile = Path.Combine(output, project.Name + ".stamp");
    def stamp = Stamp(project, sources, references, options + targetOptions.NToList());
    def binary = project.Binary;
    if (File.Exists(binary) && File.Exists(stampFile) && File.ReadAllText(stampFile) == stamp)
      Console.WriteLine(project.Name + ": up to date")
    else
    {
      def started = Stopwatch.StartNew();
      def arguments = SCG.List.[string]();
      arguments.AddRange(options);
      arguments.AddRange(targetOptions); // after the launcher's -target-references, which they replace
      arguments.Add("-source-root:" + project.Root);
      arguments.Add("-out:" + binary);
      arguments.Add(if (project.IsProgram) "-target:exe" else "-target:library");
      when (project.IsProgram && project.Main != "main.n")
      {
        def main = Path.GetFullPath(Path.Combine(project.Root, project.Main));
        unless (File.Exists(main)) throw project.Error("main", null, "the main file `" + project.Main + "' does not exist");
        def relative = Path.GetRelativePath(project.Root, main);
        arguments.Add("-main:" + Path.ChangeExtension(relative, null).Replace(Path.DirectorySeparatorChar, '.'));
      }
      foreach (r in references) arguments.Add("-r:" + r);
      arguments.AddRange(project.Options);
      arguments.AddRange(sources);
      File.Delete(stampFile);
      def info = ProcessStartInfo("dotnet"); info.UseShellExecute = false;
      info.ArgumentList.Add(Assembly.GetEntryAssembly().Location);
      foreach (a in arguments) info.ArgumentList.Add(a);
      def process = Process.Start(info);
      process.WaitForExit();
      unless (process.ExitCode == 0 && File.Exists(binary))
      {
        Console.Error.WriteLine(project.Name + ": the build failed");
        throw Failed(if (process.ExitCode == 0) 1 else process.ExitCode)
      }
      File.WriteAllText(stampFile, stamp);
      Console.WriteLine(project.Name + ": built " + Path.GetRelativePath(Environment.CurrentDirectory, binary)
                        + " (" + sources.Count.ToString() + " file" + (if (sources.Count == 1) "" else "s") + ", "
                        + (started.ElapsedMilliseconds / 100 / 10.0).ToString(Globalization.CultureInfo.InvariantCulture) + " s)");
    }
    // the runtime: Nemerle.dll and what the references need, next to the binary
    def runtime = runtimeLibrary :: runtimeFiles.Distinct().NToList();
    foreach (f in runtime)
    {
      def target = Path.Combine(output, Path.GetFileName(f));
      unless (string.Equals(Path.GetFullPath(f), target, StringComparison.Ordinal) || File.Exists(target) && File.GetLastWriteTimeUtc(target) == File.GetLastWriteTimeUtc(f) && FileInfo(target).Length == FileInfo(f).Length)
        File.Copy(f, target, true);
    }
    File.WriteAllLines(project.ReferencesFile, references);
    File.WriteAllLines(Path.Combine(output, project.Name + ".runtime"), runtimeFiles.Distinct());
    binary
  }

  /// The project's target, or null when it is the compiler's own .NET.
  TargetOf(project : Project) : Nemerle.Platform.ClrTarget
  {
    if (project.Target == null) null
    else
    {
      def target = try { Nemerle.Platform.ClrTarget.Parse(project.Target) } catch { | e is ArgumentException => throw project.Error("target", null, e.Message) };
      if (target.SameAs(Nemerle.Platform.ClrTarget.Host)) null else target
    }
  }

  /// The target's reference assemblies: its reference package from nuget.org, downloaded once into the cache.
  FetchReferences(project : Project, target : Nemerle.Platform.ClrTarget, offline : bool) : string
  {
    mutable id; mutable version; mutable folder;
    target.ReferencePackage(out id, out version, out folder);
    def data = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData, Environment.SpecialFolderOption.Create);
    def cache = Path.Combine(if (data == "") Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".local", "share") else data,
                             "Nemerle", "references", id.ToLowerInvariant(), version);
    def references = Path.Combine(cache, folder.Replace('/', Path.DirectorySeparatorChar));
    unless (Directory.Exists(references))
    {
      when (offline) throw project.Error("target", null, "the reference assemblies of " + target.Name + " (" + id + " " + version + ") are not in the cache, and --offline does not download them");
      def feed = Environment.GetEnvironmentVariable("NEMERLE_REFERENCE_FEED") ?? "https://api.nuget.org/v3-flatcontainer/";
      def lower = id.ToLowerInvariant();
      def url = feed.TrimEnd('/') + "/" + lower + "/" + version + "/" + lower + "." + version + ".nupkg";
      Console.WriteLine(project.Name + ": fetching the " + target.Name + " reference assemblies (" + id + " " + version + ")");
      def pending = cache + ".partial";
      try
      {
        when (Directory.Exists(pending)) Directory.Delete(pending, true);
        _ = Directory.CreateDirectory(pending);
        def bytes = if (File.Exists(url)) File.ReadAllBytes(url)
                    else using (client = Net.Http.HttpClient()) client.GetByteArrayAsync(url).GetAwaiter().GetResult();
        using (archive = IO.Compression.ZipArchive(MemoryStream(bytes)))
          foreach (entry in archive.Entries)
          {
            def destination = Path.GetFullPath(Path.Combine(pending, entry.FullName));
            when (destination.StartsWith(pending + Path.DirectorySeparatorChar, StringComparison.Ordinal) && entry.Name.Length > 0)
            {
              _ = Directory.CreateDirectory(Path.GetDirectoryName(destination));
              using (input = entry.Open(), output = File.Create(destination)) input.CopyTo(output);
            }
          }
        unless (Directory.Exists(Path.Combine(pending, folder.Replace('/', Path.DirectorySeparatorChar))))
          throw InvalidDataException(id + " " + version + " has no " + folder);
        when (Directory.Exists(cache)) Directory.Delete(cache, true);
        Directory.Move(pending, cache);
      }
      catch
      {
        | e is ProjectException => throw e
        | e => throw project.Error("target", null, "could not fetch the " + target.Name + " reference assemblies from " + url + ": " + e.Message)
      }
    }
    references
  }

  ReadList(path : string) : SCG.IEnumerable[string]
  {
    if (File.Exists(path)) File.ReadAllLines(path).Filter(l => l.Length > 0) else []
  }

  /// What the build depends on: the compiler, the project file, the sources, the references and the options.
  Stamp(project : Project, sources : SCG.List[string], references : SCG.IEnumerable[string], options : list[string]) : string
  {
    def b = Text.StringBuilder();
    def file(path : string) : void
    {
      def info = FileInfo(path);
      _ = b.Append(path).Append('|').Append(if (info.Exists) info.Length.ToString() + "|" + info.LastWriteTimeUtc.Ticks.ToString() else "missing").Append('\n');
    }
    file(Assembly.GetEntryAssembly().Location);
    file(typeof(Project).Assembly.Location);
    _ = b.Append(File.ReadAllText(project.File)).Append('\n');
    foreach (s in sources) file(s);
    foreach (r in references) file(r);
    foreach (o in options) _ = b.Append(o).Append('\n');
    // a hash of it, so the stamp file stays small
    mutable h : ulong = 14695981039346656037UL;
    unchecked foreach (c in b.ToString()) { h = (h ^ (c :> ulong)) * 1099511628211UL; }
    h.ToString("x16")
  }

  /// The project's NuGet packages, through the toolchain's NuGet adapter (the one nscript uses; its cache is shared).
  ResolvePackages(project : Project, offline : bool, compile : SCG.List[string], runtime : SCG.List[string]) : void
  {
    def toolchain = Path.GetDirectoryName(Assembly.GetEntryAssembly().Location);
    def adapter = Path.Combine(toolchain, "Nemerle.Scripting.NuGet.dll");
    unless (File.Exists(adapter))
      throw project.Error("references.packages", null, "packages need the NuGet adapter (Nemerle.Scripting.NuGet.dll), which this toolchain does not have");
    def scripting = Assembly.LoadFrom(Path.Combine(toolchain, "Nemerle.Scripting.dll"));
    def type(name : string) : Type
    {
      match (scripting.GetTypes().Find(t => t.Name == name)) { | Some(t) => t | None => throw InvalidOperationException("Nemerle.Scripting has no " + name) }
    }
    def resolverType = Assembly.LoadFrom(adapter).GetType("Nemerle.Scripting.NuGet.NuGetScriptResolver", true);
    def data = Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData, Environment.SpecialFolderOption.Create);
    def cache = Path.Combine(if (data == "") Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), ".local", "share") else data,
                             "Nemerle", "scripting", "packages");
    // a feed folder is relative to the project
    def feeds = project.Repositories.Select(r => { mutable uri; if (Uri.TryCreate(r, UriKind.Absolute, out uri) && !uri.IsFile) r else Path.GetFullPath(Path.Combine(project.Root, r)) }).ToArray();
    def resolver = Activator.CreateInstance(resolverType, array[cache : object, feeds : object]);
    resolverType.GetProperty("Offline").SetValue(resolver, offline);
    def source = Activator.CreateInstance(type("ScriptSource"), array["" : object, project.File]);
    def data = Activator.CreateInstance(type("ScriptCollectedData"), array[source]);
    def requests = type("ScriptCollectedData").GetField("Packages").GetValue(data) :> Collections.IList;
    foreach (p in project.Packages)
    {
      def at = Activator.CreateInstance(type("ScriptDiagnostic"), array[project.File : object, 1 : object, 1 : object, "" : object, false : object]);
      _ = requests.Add(Activator.CreateInstance(type("PackageRequest"), array[p.Id : object, p.Version, at]));
    }
    def definition = Activator.CreateInstance(type("ScriptDefinition"));
    def result = try
      {
        resolverType.GetMethod("Resolve").Invoke(resolver, array[data, definition, Threading.CancellationToken.None : object])
      }
      catch
      {
        | e is TargetInvocationException =>
          def message = if (e.InnerException != null) e.InnerException.Message else e.Message;
          // at the package the message names
          def named = project.Packages.Find(p => message.IndexOf(p.Id + "/", StringComparison.OrdinalIgnoreCase) >= 0);
          throw project.Error("references.packages", if (named != null) named.Id else null, "packages: " + message)
      };
    def list(field : string) : SCG.List[string] { result.GetType().GetField(field).GetValue(result) :> SCG.List[string] }
    compile.AddRange(list("CompilationReferences"));
    runtime.AddRange(list("RuntimeReferences"));
    runtime.AddRange(list("NativeReferences"));
  }
}
